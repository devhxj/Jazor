<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    </PropertyGroup>
    <ItemGroup>
        <ProjectCapability Include="CreateVsixContainer" />
        <!-- Ship both MEF components in the existing extension. C# navigation loads independently of the Jolt language client. -->
        <ProjectReference Include="../jazor-visual-studio/Jazor.VisualStudio.csproj"
                          ReferenceOutputAssembly="false" IncludeOutputGroupsInVSIX="BuiltProjectOutputGroup" />
        <Reference Include="System.ComponentModel.Composition" />
        <Reference Include="System.Web.Extensions" />
        <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VisualStudio.CoreUtility" Version="17.14.249" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VisualStudio.Text.Logic" Version="17.14.249" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.12.1606" PrivateAssets="all" />
        <Content Include="Jolt.pkgdef" IncludeInVSIX="true" />
        <Content Include="../jolt/jazor.tmLanguage.json" Link="Grammars/jazor.tmLanguage.json" IncludeInVSIX="true" />
    </ItemGroup>
</Project>

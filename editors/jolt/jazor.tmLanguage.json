{
    "name": "Jolt",
    "scopeName": "text.html.jazor",
    "fileTypes": ["jazor"],
    "patterns": [
        {
            "begin": "(@code)\\s*(\\{)",
            "beginCaptures": {
                "1": { "name": "keyword.control.jazor" },
                "2": { "name": "punctuation.section.block.begin.cs" }
            },
            "end": "\\}",
            "endCaptures": { "0": { "name": "punctuation.section.block.end.cs" } },
            "contentName": "source.cs",
            "patterns": [{ "include": "source.cs#class-members" }, { "include": "#csharp" }]
        },
        {
            "begin": "(@using)\\s+",
            "beginCaptures": { "1": { "name": "keyword.control.jazor" } },
            "end": "$",
            "patterns": [{ "match": "[\\w.]+", "name": "entity.name.namespace.cs" }]
        },
        {
            "begin": "(@typeparam)\\s+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
            "end": "$",
            "beginCaptures": {
                "1": { "name": "keyword.control.jazor" },
                "2": { "name": "entity.name.type.cs" }
            },
            "patterns": [{ "include": "#csharp" }]
        },
        {
            "begin": "<style\\s+scoped\\s*>",
            "end": "</style\\s*>",
            "beginCaptures": { "0": { "name": "meta.tag.html" } },
            "endCaptures": { "0": { "name": "meta.tag.html" } },
            "contentName": "source.css",
            "patterns": [{ "include": "source.css" }]
        },
        {
            "begin": "(@(?:if|for|foreach|switch))\\s*(\\()",
            "beginCaptures": {
                "1": { "name": "keyword.control.jazor" },
                "2": { "name": "punctuation.section.parens.begin.cs" }
            },
            "end": "\\)",
            "endCaptures": { "0": { "name": "punctuation.section.parens.end.cs" } },
            "contentName": "source.cs",
            "patterns": [{ "include": "#parentheses" }, { "include": "#csharp" }]
        },
        {
            "begin": "(@)(\\{)",
            "beginCaptures": {
                "1": { "name": "keyword.control.jazor" },
                "2": { "name": "punctuation.section.block.begin.cs" }
            },
            "end": "\\}",
            "endCaptures": { "0": { "name": "punctuation.section.block.end.cs" } },
            "contentName": "source.cs",
            "patterns": [{ "include": "#template-code" }]
        },
        { "include": "#transition" },
        { "include": "#markup" }
    ],
    "repository": {
        "template-code": {
            "patterns": [
                { "include": "#tag" },
                {
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [{ "include": "#template-code" }]
                },
                { "include": "#csharp" }
            ]
        },
        "markup": {
            "patterns": [
                { "begin": "<!--", "end": "-->", "name": "comment.block.html" },
                { "begin": "@\\*", "end": "\\*@", "name": "comment.block.jazor" },
                { "include": "#tag" },
                { "include": "#entity" },
                { "include": "text.html.basic" }
            ]
        },
        "tag": {
            "begin": "(</?)([A-Za-z][\\w.:-]*)",
            "beginCaptures": {
                "1": { "name": "punctuation.definition.tag.begin.html" },
                "2": { "name": "entity.name.tag.html" }
            },
            "end": "/?>",
            "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
            "name": "meta.tag.html",
            "patterns": [
                {
            "begin": "(@(?:key|attributes|ref|bind(?:-[\\w-]+)?(?::(?:get|set|after))?|on[\\w-]+(?::[\\w-]+)*))\\s*=\\s*(\")",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.jazor" },
                        "2": { "name": "punctuation.definition.string.begin.html" }
                    },
                    "end": "\"",
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
                    "contentName": "source.cs",
                    "patterns": [{ "include": "#transition" }, { "include": "#csharp" }]
                },
                {
            "begin": "(@(?:key|attributes|ref|bind(?:-[\\w-]+)?(?::(?:get|set|after))?|on[\\w-]+(?::[\\w-]+)*))\\s*=\\s*(')",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.jazor" },
                        "2": { "name": "punctuation.definition.string.begin.html" }
                    },
                    "end": "'",
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
                    "contentName": "source.cs",
                    "patterns": [{ "include": "#transition" }, { "include": "#csharp" }]
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.html",
                    "patterns": [{ "include": "#transition" }, { "include": "#entity" }]
                },
                {
                    "begin": "'",
                    "end": "'",
                    "name": "string.quoted.single.html",
                    "patterns": [{ "include": "#transition" }, { "include": "#entity" }]
                },
                { "match": "[@#]?[A-Za-z_][\\w.:-]*", "name": "entity.other.attribute-name.html" }
            ]
        },
        "entity": {
            "match": "&(?:#[0-9]+|#[xX][0-9A-Fa-f]+|[A-Za-z][A-Za-z0-9]*);",
            "name": "constant.character.entity.html"
        },
        "transition": {
            "patterns": [
                { "match": "@@", "name": "constant.character.escape.jazor" },
                {
                    "begin": "(@)(\\()",
                    "beginCaptures": {
                        "1": { "name": "keyword.control.jazor" },
                        "2": { "name": "punctuation.section.parens.begin.cs" }
                    },
                    "end": "\\)",
                    "endCaptures": { "0": { "name": "punctuation.section.parens.end.cs" } },
                    "contentName": "source.cs",
                    "patterns": [{ "include": "#parentheses" }, { "include": "#csharp" }]
                },
                {
                    "match": "(@)((?:[\\p{L}_][\\p{L}\\p{Nd}_]*)(?:\\.[\\p{L}_][\\p{L}\\p{Nd}_]*)*)",
                    "captures": {
                        "1": { "name": "keyword.control.jazor" },
                        "2": { "name": "variable.other.readwrite.cs" }
                    }
                }
            ]
        },
        "parentheses": {
            "begin": "\\(",
            "end": "\\)",
            "patterns": [{ "include": "#parentheses" }, { "include": "#csharp" }]
        },
        "csharp": {
            "patterns": [
                { "include": "source.cs" },
                { "begin": "/\\*", "end": "\\*/", "name": "comment.block.cs" },
                { "match": "//.*$", "name": "comment.line.double-slash.cs" },
                { "begin": "\"{3,}", "end": "\"{3,}", "name": "string.quoted.double.cs" },
                { "begin": "@\"", "end": "\"(?!\")", "name": "string.quoted.double.cs", "patterns": [{ "match": "\"\"", "name": "constant.character.escape.cs" }] },
                { "match": "\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])+'", "name": "string.quoted.cs" },
                { "begin": "\\{", "end": "\\}", "patterns": [{ "include": "#csharp" }] },
                { "match": "\\b(?:public|private|protected|internal|static|readonly|const|async|partial|override|sealed|abstract|virtual)\\b", "name": "storage.modifier.cs" },
                { "match": "\\b(?:bool|byte|char|decimal|double|float|int|long|nint|nuint|object|sbyte|short|string|uint|ulong|ushort|var|void)\\b", "name": "storage.type.cs" },
                { "match": "\\b(?:await|break|case|catch|continue|default|else|foreach|for|if|in|is|new|return|switch|throw|try|while|yield)\\b", "name": "keyword.control.cs" },
                { "match": "\\b(?:true|false|null)\\b", "name": "constant.language.cs" },
                { "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(?:[uUlLfFdDmM]+)?\\b", "name": "constant.numeric.cs" }
            ]
        }
    }
}

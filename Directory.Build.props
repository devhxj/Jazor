<Project>
  <PropertyGroup>
    <AcornimaVersion>1.8.0</AcornimaVersion>
    <AngleSharpVersion>1.7.2</AngleSharpVersion>
    <NodeApiVersion>0.9.36</NodeApiVersion>
    <LibNodeVersion>20.1800.215</LibNodeVersion>
    <PnpmEngineVersion>12.5.1</PnpmEngineVersion>
    <NodeToolAppHostVersion>11.0.0</NodeToolAppHostVersion>
    <!-- NodeApi embeds libnode in repository hosts and runtime tests. V8 stack
         switching in this supported combination requires CET compatibility off. -->
    <CETCompat>false</CETCompat>
    <!-- Host metadata and SSR envelopes use reflection-based JSON serialization. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <JsonNetVersion>11.0.0</JsonNetVersion>
    <!-- The .NET 11 GA SDK embeds this prerelease-labelled Roslyn build, published to dotnet-tools. Keep the exact SDK match for preview language features. -->
    <CodeAnalysisVersion>5.12.0-1.26529.118</CodeAnalysisVersion>
    <!-- 1.8.15 contains the .NET 11 GA reference assemblies. -->
    <Net110AssembliesVersion>1.8.15</Net110AssembliesVersion>
    <CoverletVersion>10.0.1</CoverletVersion>
    <MinVerPackageVersion>7.0.0</MinVerPackageVersion>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!--
    Isolated build roots are evaluated inside each project so referenced projects
    get their own stable bin/obj locations. Avoid composing $(MSBuildProjectName)
    or $(TargetFramework) directly in command-line global properties because those
    tokens do not rebind reliably across project-to-project builds.
  -->
  <PropertyGroup Condition="'$(JazorIsolatedBaseOutputRoot)' != ''">
    <BaseOutputPath>$([MSBuild]::EnsureTrailingSlash('$(JazorIsolatedBaseOutputRoot)'))$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JazorIsolatedBaseIntermediateOutputRoot)' != ''">
    <BaseIntermediateOutputPath>$([MSBuild]::EnsureTrailingSlash('$(JazorIsolatedBaseIntermediateOutputRoot)'))$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <ProjectExtensionsPath>$(BaseIntermediateOutputPath)</ProjectExtensionsPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JazorIsolatedBaseOutputRoot)' != '' or '$(JazorIsolatedBaseIntermediateOutputRoot)' != ''">
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>

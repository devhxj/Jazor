<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Format>cobertura</Format>
          <Format>json</Format>
          <Format>lcov</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- Code Coverage 覆盖率阈值配置 -->
  <CodeCoverage>
    <!-- 模块排除 -->
    <ModulePaths>
      <Exclude>
        <!-- 排除测试项目本身 -->
        *Tests*
        *Test*
        <!-- 排除第三方库 -->
        *Acornima*
        *Microsoft.CodeAnalysis*
        *System.*
      </Exclude>
    </ModulePaths>

    <!-- 函数排除规则 -->
    <Functions>
      <Exclude>
        <!-- 排除属性访问器生成器代码 -->
        *.get_*
        *.set_*
        <!-- 排除 ToString、Equals 等 Object 方法 -->
        *.ToString
        *.Equals
        *.GetHashCode
        <!-- 排除异常类 -->
        *Exception.*
      </Exclude>
    </Functions>

    <!-- 覆盖率阈值 -->
    <CoverageThreshold>
      <!-- 行覆盖率阈值 -->
      <LineMinimum>85</LineMinimum>
      <!-- 分支覆盖率阈值 -->
      <BranchMinimum>80</BranchMinimum>
      <!-- 是否允许阈值降低 -->
      <IncludeTestAssembly>false</IncludeTestAssembly>
    </CoverageThreshold>
  </CodeCoverage>
</RunSettings>

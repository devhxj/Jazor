<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="tooling\toolchain.cjs" LogicalName="Jazor.NodeHost.toolchain.cjs" />
    <AssemblyMetadata Include="PnpmEngineVersion" Value="$(PnpmEngineVersion)" />
    <AssemblyMetadata Include="LightningCssWasmVersion" Value="$(LightningCssWasmVersion)" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="$(NodeApiVersion)" />
    <!-- Keep the NuGet runtime closure aligned with the supported tool hosts. -->
    <PackageReference Include="Microsoft.JavaScript.LibNode.win-x64" Version="[$(LibNodeVersion)]" />
    <PackageReference Include="Microsoft.JavaScript.LibNode.win-arm64" Version="[$(LibNodeVersion)]" />
    <PackageReference Include="Microsoft.JavaScript.LibNode.linux-x64" Version="[$(LibNodeVersion)]" />
    <PackageReference Include="Microsoft.JavaScript.LibNode.linux-arm64" Version="[$(LibNodeVersion)]" />
  </ItemGroup>
</Project>

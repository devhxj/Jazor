<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="tooling\toolchain.cjs" LogicalName="Jazor.NodeHost.toolchain.cjs" />
    <AssemblyMetadata Include="PnpmEngineVersion" Value="$(PnpmEngineVersion)" />
    <AssemblyMetadata Include="LightningCssWasmVersion" Value="$(LightningCssWasmVersion)" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="$(NodeApiVersion)" />
    <PackageReference Include="Microsoft.JavaScript.LibNode" Version="$(LibNodeVersion)" />
  </ItemGroup>
</Project>

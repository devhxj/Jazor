<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseJazorSdkRoslyn>true</UseJazorSdkRoslyn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Class1.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.5" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Basic.Reference.Assemblies.Net100">
      <HintPath>$(PkgBasic_Reference_Assemblies_Net100)\lib\netstandard2.0\Basic.Reference.Assemblies.Net100.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jazor.Analyzer\Jazor.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ECMAScript\ECMAScript.csproj" />
    <ProjectReference Include="..\ECMAScript.Internal\ECMAScript.Internal.csproj" />
    <ProjectReference Include="..\Jazor.Compiler\Jazor.Compiler.csproj" />
  </ItemGroup>
</Project>

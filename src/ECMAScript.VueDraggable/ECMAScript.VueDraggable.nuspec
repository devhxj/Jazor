<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$packageId$</id>
    <version>$version$</version>
    <authors>$packageAuthors$</authors>
    <description>$packageDescription$</description>
    <projectUrl>$repositoryUrl$</projectUrl>
    <repository type="$repositoryType$" url="$repositoryUrl$" />
    <readme>$packageReadmeFile$</readme>
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="Jazor" version="$dependencyVersion$" exclude="Build,Analyzers" />
        <dependency id="Jazor.Vue" version="$dependencyVersion$" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net11.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="$buildOutputDir$ECMAScript.VueDraggable.dll" target="lib/net11.0" />
    <file src="$buildOutputDir$ECMAScript.VueDraggable.pdb" target="lib/net11.0" />
    <file src="$buildOutputDir$ECMAScript.VueDraggable.xml" target="lib/net11.0" />
    <file src="$projectDir$buildTransitive\ECMAScript.VueDraggable.targets" target="buildTransitive\ECMAScript.VueDraggable.targets" />
    <file src="$projectDir$manifest.json" target="jazor\vue-draggable" />
    <file src="$projectDir$inventory.json" target="jazor\vue-draggable" />
    <file src="$projectDir$dist\**\*" target="jazor\vue-draggable\dist" />
    <file src="$projectDir$licenses\**\*" target="jazor\vue-draggable\licenses" />
    <file src="$projectDir$$packageReadmeFile$" target="" />
  </files>
</package>

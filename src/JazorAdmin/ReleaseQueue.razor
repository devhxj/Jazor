@inherits AppComponentBase

<section class="@SectionClass">
    <h2>Release Queue</h2>
    <p class="jazor-admin__selection">
        Selected release: <strong>@SelectedRowKey</strong>
        Bulk selected: <strong>@(SelectedRowKeys?.Length ?? 0)</strong>
    </p>

    <ReleaseTable Columns="@Columns"
                  Rows="@Rows"
                  SelectedRowKey="@SelectedRowKey"
                  SelectedRowKeyChanged="@SelectedRowKeyChanged"
                  SelectedRowKeys="@SelectedRowKeys"
                  SelectedRowKeysChanged="@SelectedRowKeysChanged"
                  MultiSelectable
                  SearchText="@SearchText"
                  SearchTextChanged="@SearchTextChanged"
                  SearchPlaceholder="Filter releases"
                  PageIndex="@PageIndex"
                  PageIndexChanged="@PageIndexChanged"
                  PageSize="2"
                  SortColumnKey="@SortColumnKey"
                  SortColumnKeyChanged="@SortColumnKeyChanged"
                  SortDescending="@SortDescending"
                  SortDescendingChanged="@SortDescendingChanged"
                  Loading="@Loading"
                  LoadingText="Refreshing releases" />
</section>

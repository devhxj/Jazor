@inherits AdminContentComponentBase

<TCard CssClass="@RootCssClass"
       CssStyle="@CssStyle"
       data-page-container=""
       @attributes="AdditionalAttributes">
    <div class='@("jazor-admin-tdesign-page-container__header")'>
        <div class='@("jazor-admin-tdesign-page-container__titles")'>
            @if (BreadcrumbItems is { Length: > 0 })
            {
                <TBreadcrumb data-page-region="breadcrumb">
                    @foreach (var item in BreadcrumbItems)
                    {
                        <TBreadcrumbItem Text="@item.Title"
                                         Disabled="@(item.Disabled ?? false)"
                                         Href="@MapHref(item.Href, item.RouteTarget)"
                                         To="@MapRoute(item.RouteTarget)" />
                    }
                </TBreadcrumb>
            }

            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class='@("jazor-admin-tdesign-page-container__title")'
                     data-page-region="title">@Title</div>
            }

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class='@("jazor-admin-tdesign-page-container__subtitle")'>@Subtitle</div>
            }
        </div>

        @if ((Actions?.Length ?? 0) > 0 || Extra is not null)
        {
            <TSpace Align="@TDesignSpaceAlign.Center">
                @if (Actions is not null)
                {
                    @foreach (var action in Actions)
                    {
                        <TButton Theme="@MapTheme(action.Kind)"
                                 Disabled="@(action.Disabled ?? false)"
                                 Href="@MapActionHref(action)"
                                 Text="@action.Text"
                                 data-action-key="@action.Key"
                                 OnClick="@(_ => InvokeAction(action))" />
                    }
                }
                @Extra
            </TSpace>
        }
    </div>

    <div class='@("jazor-admin-tdesign-page-container__body")'
         data-page-region="body">
        @ChildContent
    </div>
</TCard>

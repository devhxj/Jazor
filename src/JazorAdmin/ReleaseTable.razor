@inherits AppComponentBase

@{
    var columns = GetEffectiveColumns();
    var filteredRows = FilterRows(GetEffectiveRows(), columns, SearchText);
    var sortedRows = SortRows(filteredRows, columns, SortColumnKey, SortDescending);
    var pageSize = NormalizePageSize(PageSize);
    var pageIndex = NormalizePageIndex(PageIndex, sortedRows.Length, pageSize);
    var pageRows = SliceRows(sortedRows, pageIndex, pageSize);
    var pageCount = GetPageCount(sortedRows.Length, pageSize);
}

<div class="@RootCssClass" style="@CssStyle" aria-busy="@Loading">
    <div class="jazor-admin-release-table__toolbar">
        <input class="jazor-admin-release-table__search"
               type="search"
               placeholder="@(Text.Normalize(SearchPlaceholder) ?? "Search")"
               disabled="@Loading"
               @bind:get="SearchText"
               @bind:set="OnSearchTextChanged"
               @bind:event="oninput" />
        <span class="jazor-admin-release-table__summary">@filteredRows.Length rows</span>
    </div>

    @if (columns.Length > 0)
    {
        <table class="jazor-admin-release-table__table">
            <thead class="jazor-admin-release-table__head">
                <tr>
                    @if (MultiSelectable)
                    {
                        <th class="jazor-admin-release-table__heading jazor-admin-release-table__selection-heading">
                            <input class="jazor-admin-release-table__select-all"
                                   type="checkbox"
                                   checked="@PageSelectionIsComplete(pageRows)"
                                   aria-label="Select visible rows"
                                   disabled="@Loading"
                                   @onclick="@(() => OnVisibleSelectionToggled(pageRows))" />
                        </th>
                    }

                    @foreach (var column in columns)
                    {
                        var columnIsSorted = ColumnIsSorted(column);
                        <th @key="column.Key"
                            class="@BuildHeadingCssClass(column, columnIsSorted)"
                            data-column-key="@column.Key"
                            style="@column.Width"
                            aria-sort="@(columnIsSorted ? (SortDescending ? "descending" : "ascending") : "none")">
                            @if (column.Sortable)
                            {
                                <button type="button"
                                        class="jazor-admin-release-table__sort-button"
                                        disabled="@Loading"
                                        @onclick="@(() => OnSortRequested(column))">
                                    @column.Title
                                    @if (columnIsSorted)
                                    {
                                        <span class="jazor-admin-release-table__sort-indicator" aria-hidden="true">@(SortDescending ? "desc" : "asc")</span>
                                    }
                                </button>
                            }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="jazor-admin-release-table__body">
                @if (Loading)
                {
                    <tr class="jazor-admin-release-table__loading-row">
                        <td class="jazor-admin-release-table__loading" colspan="@(MultiSelectable ? columns.Length + 1 : columns.Length)">@NormalizedLoadingText</td>
                    </tr>
                }
                else if (pageRows.Length > 0)
                {
                    @foreach (var row in pageRows)
                    {
                        <tr @key="row.Key"
                            class="@BuildRowCssClass(RowIsSelected(row) || RowIsMultiSelected(row), row.Source.Disabled ?? false)"
                            data-row-key="@row.Key"
                            tabindex="0"
                            @onclick="@(() => OnRowSelected(row))">
                            @if (MultiSelectable)
                            {
                                <td class="jazor-admin-release-table__cell jazor-admin-release-table__selection-cell">
                                    <input class="jazor-admin-release-table__row-select"
                                           type="checkbox"
                                           checked="@RowIsMultiSelected(row)"
                                           disabled="@(row.Source.Disabled ?? false)"
                                           data-row-select-key="@row.Key"
                                           aria-label="@("Select row " + row.Key)"
                                           @onclick="@(() => OnRowSelectionToggled(row))" />
                                </td>
                            }

                            @foreach (var column in columns)
                            {
                                <td @key="column.Key" class="jazor-admin-release-table__cell" data-column-key="@column.Key">@ResolveCellText(row, column)</td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr class="jazor-admin-release-table__empty-row">
                        <td class="jazor-admin-release-table__empty" colspan="@(MultiSelectable ? columns.Length + 1 : columns.Length)">@NormalizedEmptyText</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="@(Loading ? "jazor-admin-release-table__loading" : "jazor-admin-release-table__empty")">@(Loading ? NormalizedLoadingText : NormalizedEmptyText)</div>
    }

    @if (pageCount > 1)
    {
        <div class="jazor-admin-release-table__pagination">
            <button type="button"
                    class="jazor-admin-release-table__page-button"
                    disabled="@(Loading || pageIndex == 0)"
                    @onclick="OnPreviousPage">Previous</button>
            <span class="jazor-admin-release-table__page-status">@(pageIndex + 1) / @pageCount</span>
            <button type="button"
                    class="jazor-admin-release-table__page-button"
                    disabled="@(Loading || pageIndex >= pageCount - 1)"
                    @onclick="OnNextPage">Next</button>
        </div>
    }
</div>

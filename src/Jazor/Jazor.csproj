<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Jazor</PackageId>
    <Version>0.1.13</Version>
    <Authors>hanxj</Authors>
    <Description>Jazor SDK with runtime, analyzer, source generator, emit tool and MSBuild integration.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(DOTNET_CLI_HOME)' != ''">$([System.IO.Path]::Combine('$(DOTNET_CLI_HOME)', '.nuget', 'packages'))\</NuGetPackageRoot>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(UserProfile)' != ''">$([System.IO.Path]::Combine('$(UserProfile)', '.nuget', 'packages'))\</NuGetPackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="buildTransitive\Jazor.props" Pack="true" PackagePath="buildTransitive\Jazor.props" />
    <None Include="buildTransitive\Jazor.targets" Pack="true" PackagePath="buildTransitive\Jazor.targets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Acornima.Extras" Version="$(AcornimaVersion)" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ECMAScript\bin\$(Configuration)\net10.0\ECMAScript.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\ECMAScript\bin\$(Configuration)\net10.0\ECMAScript.pdb" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\ECMAScript.Internal\bin\$(Configuration)\netstandard2.0\ECMAScript.Internal.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\ECMAScript.Internal\bin\$(Configuration)\netstandard2.0\ECMAScript.Internal.pdb" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\ECMAScript.Vuetify\bin\$(Configuration)\net10.0\ECMAScript.Vuetify.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\ECMAScript.Vuetify\bin\$(Configuration)\net10.0\ECMAScript.Vuetify.pdb" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.pdb" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.Name\bin\$(Configuration)\netstandard2.0\Jazor.Name.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.Name\bin\$(Configuration)\netstandard2.0\Jazor.Name.pdb" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.Razor\bin\$(Configuration)\netstandard2.0\Jazor.Razor.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.Razor\bin\$(Configuration)\netstandard2.0\Jazor.Razor.pdb" Pack="true" PackagePath="lib\net10.0\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Analyzer.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Analyzer.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\ECMAScript.Internal.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\ECMAScript.Internal.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Name.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Name.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <!-- 跟随 Directory.Build.props 中的统一版本，避免升级 Acornima 后打包仍读取旧缓存路径。 -->
    <None Include="$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Jazor.Emit\bin\$(Configuration)\net10.0\publish\**\*" Pack="true" PackagePath="tools\net10.0\" />
  </ItemGroup>
</Project>

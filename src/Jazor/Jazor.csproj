<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Jazor</PackageId>
    <Version>0.1.13</Version>
    <Authors>hanxj</Authors>
    <Description>Jazor SDK with runtime, analyzer, source generator, emit tool and MSBuild integration.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(DOTNET_CLI_HOME)' != ''">$([System.IO.Path]::Combine('$(DOTNET_CLI_HOME)', '.nuget', 'packages'))\</NuGetPackageRoot>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(UserProfile)' != ''">$([System.IO.Path]::Combine('$(UserProfile)', '.nuget', 'packages'))\</NuGetPackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="buildTransitive\Jazor.props" Pack="true" PackagePath="buildTransitive\Jazor.props" />
    <None Include="buildTransitive\Jazor.targets" Pack="true" PackagePath="buildTransitive\Jazor.targets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.3.1" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Acornima.Extras" Version="1.3.1" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ECMAScript\bin\$(Configuration)\net10.0\*.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\ECMAScript\bin\$(Configuration)\net10.0\*.pdb" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.RazorVue\bin\$(Configuration)\net10.0\*.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\Jazor.RazorVue\bin\$(Configuration)\net10.0\*.pdb" Pack="true" PackagePath="lib\net10.0\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Analyzer.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Analyzer.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Common.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Name.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Name.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.Analysis.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.Analysis.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="..\Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.pdb" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="$(NuGetPackageRoot)acornima\1.3.1\lib\netstandard2.0\Acornima.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
    <None Include="$(NuGetPackageRoot)acornima.extras\1.3.1\lib\netstandard2.0\Acornima.Extras.dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Jazor.Emit\bin\$(Configuration)\net10.0\publish\**\*" Pack="true" PackagePath="tools\net10.0\" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Jazor</PackageId>
    <Authors>hanxj</Authors>
    <Description>Deterministic C# to ECMAScript compiler SDK with analyzer, source generator, Emit tooling, MSBuild integration, and support for both library carriers: manifest.json plus dist resources and the Jazor.Generated.ModuleCatalog for Jazor-generated modules.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/devhxj/Jazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/Jazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>jazor;csharp;javascript;compiler;analyzer;source-generator</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- NU5129 assumes every buildTransitive target has a matching build target. The
         resource locator is intentionally the only transitive target; tooling remains
         direct-reference-only through build/Jazor.targets. -->
    <NoWarn>$(NoWarn);NU5129</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddJazorEmitPublishOutputToPackage</TargetsForTfmSpecificContentInPackage>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(DOTNET_CLI_HOME)' != ''">$([System.IO.Path]::Combine('$(DOTNET_CLI_HOME)', '.nuget', 'packages'))\</NuGetPackageRoot>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(UserProfile)' != ''">$([System.IO.Path]::Combine('$(UserProfile)', '.nuget', 'packages'))\</NuGetPackageRoot>
    <JazorPackageBuildOutputRoot Condition="'$(JazorPackageBuildOutputRoot)' == '' and '$(JazorIsolatedBaseOutputRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(JazorIsolatedBaseOutputRoot)'))</JazorPackageBuildOutputRoot>
    <JazorPackageBuildOutputRoot Condition="'$(JazorPackageBuildOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\</JazorPackageBuildOutputRoot>
    <JazorEmitPublishOutputRoot Condition="'$(JazorEmitPublishOutputRoot)' == '' and '$(JazorIsolatedBaseOutputRoot)' != ''">$([System.IO.Path]::Combine('$([MSBuild]::EnsureTrailingSlash($(JazorIsolatedBaseOutputRoot)))', 'Jazor.Emit', 'bin', '$(Configuration)', 'net11.0', 'publish'))\</JazorEmitPublishOutputRoot>
    <JazorEmitPublishOutputRoot Condition="'$(JazorEmitPublishOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\Jazor.Emit\bin\$(Configuration)\net11.0\publish\</JazorEmitPublishOutputRoot>
    <JazorPackageArtifactRestoreProperties>Configuration=$(Configuration);BuildInParallel=false</JazorPackageArtifactRestoreProperties>
    <JazorPackageArtifactBuildProperties>$(JazorPackageArtifactRestoreProperties);BuildProjectReferences=false</JazorPackageArtifactBuildProperties>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE.txt" Pack="true" PackagePath="" />
    <None Include="$(NuGetPackageRoot)microsoft.javascript.libnode\$(LibNodeVersion)\LICENSE" Pack="true" PackagePath="licenses/libnode/%(Filename)%(Extension)" />
    <None Include="$(NuGetPackageRoot)microsoft.javascript.libnode\$(LibNodeVersion)\NOTICE.txt" Pack="true" PackagePath="licenses/libnode/%(Filename)%(Extension)" />
    <!-- Tooling is a direct-reference capability. Only resource manifest location propagates. -->
    <None Include="build\Jazor.props" Pack="true" PackagePath="build\Jazor.props" />
    <None Include="build\Jazor.targets" Pack="true" PackagePath="build\Jazor.targets" />
    <None Include="build\Jazor.CompilationTiming.targets" Pack="true" PackagePath="build\Jazor.CompilationTiming.targets" />
    <None Include="buildTransitive\Jazor.Resources.targets"
          Pack="true"
          PackagePath="buildTransitive\Jazor.Resources.targets" />
    <!-- ECMAScript is an external JS-resource library. Keep its managed projection and its
         manifest/clr carrier separate so Emit discovers it through the same locator contract as
         Vue, Vuetify and other resource packages. -->
    <None Include="$(MSBuildThisFileDirectory)..\ECMAScript\manifest.json"
          Pack="true"
          PackagePath="jazor\ecmascript\manifest.json" />
    <None Include="$(MSBuildThisFileDirectory)..\ECMAScript\clr\**\*"
          Pack="true"
          PackagePath="jazor\ecmascript\clr\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="$(MinVerPackageVersion)" PrivateAssets="All" />
    <PackageReference Include="Acornima.Extras" Version="$(AcornimaVersion)" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="$(NodeApiVersion)" />
    <PackageReference Include="Microsoft.JavaScript.LibNode" Version="$(LibNodeVersion)" />
    <PackageReference Include="Microsoft.NETCore.App.Host.win-x64" Version="$(NodeToolAppHostVersion)" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NETCore.App.Host.win-arm64" Version="$(NodeToolAppHostVersion)" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript\bin\$(Configuration)\net11.0\ECMAScript.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript\bin\$(Configuration)\net11.0\ECMAScript.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript\bin\$(Configuration)\net11.0\ECMAScript.xml" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.xml" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.AspNetCore\bin\$(Configuration)\net11.0\Jazor.AspNetCore.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.AspNetCore\bin\$(Configuration)\net11.0\Jazor.AspNetCore.xml" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.AspNetCore\bin\$(Configuration)\net11.0\Jazor.AspNetCore.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.AspNetCore.Dev\bin\$(Configuration)\net11.0\Jazor.AspNetCore.Dev.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.AspNetCore.Dev\bin\$(Configuration)\net11.0\Jazor.AspNetCore.Dev.xml" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.AspNetCore.Dev\bin\$(Configuration)\net11.0\Jazor.AspNetCore.Dev.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.NodeHost\bin\$(Configuration)\net11.0\Jazor.NodeHost.dll" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.NodeHost\bin\$(Configuration)\net11.0\Jazor.NodeHost.pdb" Pack="true" PackagePath="lib/net11.0/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Do not use NuGet's automatic analyzers/ asset. build/Jazor.targets registers this
         analyzer dependency closure only for direct Jazor references. -->
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Analyzer.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Analyzer\bin\$(Configuration)\netstandard2.0\Jazor.Analyzer.pdb" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript\bin\$(Configuration)\net11.0\ECMAScript.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript\bin\$(Configuration)\net11.0\ECMAScript.pdb" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.pdb" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.pdb" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(JazorPackageBuildOutputRoot)Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.pdb" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <!-- 跟随 Directory.Build.props 中的统一版本，避免升级 Acornima 后打包仍读取旧缓存路径。 -->
    <None Include="$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
    <None Include="$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll" Pack="true" PackagePath="tools/net11.0/analyzers/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript.Contract\ECMAScript.Contract.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.Common\Jazor.Common.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript\ECMAScript.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.Compiler\Jazor.Compiler.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.Analyzer\Jazor.Analyzer.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.NodeHost\Jazor.NodeHost.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.AspNetCore\Jazor.AspNetCore.csproj" />
    <_JazorPackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.AspNetCore.Dev\Jazor.AspNetCore.Dev.csproj" />
    <_JazorEmitProject Include="$(MSBuildThisFileDirectory)..\Jazor.Emit\Jazor.Emit.csproj" />
  </ItemGroup>

  <Target Name="PrepareJazorPackageArtifacts"
          BeforeTargets="GenerateNuspec"
          Condition="'$(JazorPreparePackageArtifacts)' != 'false'">
    <MSBuild Projects="@(_JazorPackageBuildProject)"
             Targets="Restore"
             BuildInParallel="false"
             Properties="$(JazorPackageArtifactRestoreProperties)"
             RemoveProperties="TargetFramework;TargetFrameworkIdentifier;TargetFrameworkVersion;TargetFrameworkProfile;TargetPlatformIdentifier;TargetPlatformVersion;RuntimeIdentifier;SelfContained;PublishSingleFile;PackOnBuild;GeneratePackageOnBuild;NoBuild;PackageOutputPath;ExcludeRestorePackageImports" />

    <MSBuild Projects="@(_JazorEmitProject)"
             Targets="Restore"
             BuildInParallel="false"
             Properties="$(JazorPackageArtifactRestoreProperties);SelfContained=false"
             RemoveProperties="TargetFramework;TargetFrameworkIdentifier;TargetFrameworkVersion;TargetFrameworkProfile;TargetPlatformIdentifier;TargetPlatformVersion;RuntimeIdentifier;PackOnBuild;GeneratePackageOnBuild;NoBuild;PackageOutputPath;ExcludeRestorePackageImports" />

    <MSBuild Projects="@(_JazorPackageBuildProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="$(JazorPackageArtifactBuildProperties)"
             RemoveProperties="TargetFramework;TargetFrameworkIdentifier;TargetFrameworkVersion;TargetFrameworkProfile;TargetPlatformIdentifier;TargetPlatformVersion;RuntimeIdentifier;SelfContained;PublishSingleFile;PackOnBuild;GeneratePackageOnBuild;NoBuild;PackageOutputPath;ExcludeRestorePackageImports" />

    <MSBuild Projects="@(_JazorEmitProject)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="$(JazorPackageArtifactBuildProperties);SelfContained=false"
             RemoveProperties="TargetFramework;TargetFrameworkIdentifier;TargetFrameworkVersion;TargetFrameworkProfile;TargetPlatformIdentifier;TargetPlatformVersion;RuntimeIdentifier;PackOnBuild;GeneratePackageOnBuild;NoBuild;PackageOutputPath;ExcludeRestorePackageImports" />
  </Target>

  <UsingTask TaskName="CreateAppHost" AssemblyFile="$(MicrosoftNETBuildTasksAssembly)" />
  <Target Name="CreateJazorToolAppHosts" DependsOnTargets="PrepareJazorPackageArtifacts">
    <ItemGroup>
      <_JazorWindowsToolHost Include="win-x64;win-arm64" />
    </ItemGroup>
    <!-- dotnet.exe's CET flag cannot be changed by the managed tool. Package a
         framework-dependent CET=false apphost for each Windows build-host RID. -->
    <CreateAppHost
      AppHostSourcePath="$(NuGetPackageRoot)microsoft.netcore.app.host.%(_JazorWindowsToolHost.Identity)\$(NodeToolAppHostVersion)\runtimes\%(_JazorWindowsToolHost.Identity)\native\apphost.exe"
      AppHostDestinationPath="$(JazorEmitPublishOutputRoot)Jazor.Emit.%(_JazorWindowsToolHost.Identity).exe"
      AppBinaryName="Jazor.Emit.dll"
      IntermediateAssembly="$(JazorEmitPublishOutputRoot)Jazor.Emit.dll"
      DisableCetCompat="true" />
  </Target>
  <Target Name="AddJazorEmitPublishOutputToPackage"
          DependsOnTargets="PrepareJazorPackageArtifacts;CreateJazorToolAppHosts">
    <ItemGroup>
      <!-- Tool libnode assets cover the build host independently of the
           consumer's target RID. Runtime NuGet assets follow normal RID rules. -->
      <TfmSpecificPackageFile Include="$(JazorEmitPublishOutputRoot)**\*"
                              Exclude="$(JazorEmitPublishOutputRoot)tooling\vue\**\*;$(JazorEmitPublishOutputRoot)runtimes\**\*;$(JazorEmitPublishOutputRoot)Jazor.Emit.exe;$(JazorEmitPublishOutputRoot)Jazor.Emit">
        <PackagePath>tools\net11.0\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
      <!-- Use literal filenames here: unqualified metadata inside this target
           batches against existing tool items and duplicates native payloads. -->
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.win-x64\$(LibNodeVersion)\runtimes\win-x64\native\libnode.dll">
        <PackagePath>tools/net11.0/runtimes/win-x64/native/libnode.dll</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.win-arm64\$(LibNodeVersion)\runtimes\win-arm64\native\libnode.dll">
        <PackagePath>tools/net11.0/runtimes/win-arm64/native/libnode.dll</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.win-x86\$(LibNodeVersion)\runtimes\win-x86\native\libnode.dll">
        <PackagePath>tools/net11.0/runtimes/win-x86/native/libnode.dll</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.linux-x64\$(LibNodeVersion)\runtimes\linux-x64\native\libnode.so">
        <PackagePath>tools/net11.0/runtimes/linux-x64/native/libnode.so</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.linux-arm64\$(LibNodeVersion)\runtimes\linux-arm64\native\libnode.so">
        <PackagePath>tools/net11.0/runtimes/linux-arm64/native/libnode.so</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.osx-x64\$(LibNodeVersion)\runtimes\osx-x64\native\libnode.dylib">
        <PackagePath>tools/net11.0/runtimes/osx-x64/native/libnode.dylib</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(NuGetPackageRoot)microsoft.javascript.libnode.osx-arm64\$(LibNodeVersion)\runtimes\osx-arm64\native\libnode.dylib">
        <PackagePath>tools/net11.0/runtimes/osx-arm64/native/libnode.dylib</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>

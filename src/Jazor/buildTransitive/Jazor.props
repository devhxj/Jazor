<Project>
  <PropertyGroup>
    <JazorCompile Condition="'$(JazorCompile)' == ''">true</JazorCompile>
    <JazorEmit Condition="'$(JazorEmit)' == '' and '$(OutputType)' == 'Exe'">true</JazorEmit>
    <JazorEmit Condition="'$(JazorEmit)' == '' and '$(OutputType)' != 'Exe'">false</JazorEmit>
    <JazorRazorVueOutputMode Condition="'$(JazorRazorVueOutputMode)' == ''">sfc</JazorRazorVueOutputMode>
    <JazorRazorVueEnableRazorSgIntegration Condition="'$(JazorRazorVueEnableRazorSgIntegration)' == ''">false</JazorRazorVueEnableRazorSgIntegration>
    <JazorDevOutDir Condition="'$(JazorDevOutDir)' == ''">$(MSBuildProjectDirectory)\jazor\</JazorDevOutDir>
    <JazorPublishOutDir Condition="'$(JazorPublishOutDir)' == ''">$(MSBuildProjectDirectory)\wwwroot\jazor\</JazorPublishOutDir>
    <JazorOutDir Condition="'$(JazorOutDir)' == ''">$(JazorDevOutDir)</JazorOutDir>
    <JazorBundle Condition="'$(JazorBundle)' == ''">false</JazorBundle>
    <JazorBundleOut Condition="'$(JazorBundleOut)' == ''">$(OutDir)jazor\app.js</JazorBundleOut>
    <JazorCleanEmit Condition="'$(JazorCleanEmit)' == ''">true</JazorCleanEmit>
    <JazorFailOnPathConflict Condition="'$(JazorFailOnPathConflict)' == ''">true</JazorFailOnPathConflict>
    <JazorPublishMaterializeEnabled Condition="'$(JazorPublishMaterializeEnabled)' == ''">false</JazorPublishMaterializeEnabled>
    <JazorConsumerBuildTask Condition="'$(JazorConsumerBuildTask)' == ''">build</JazorConsumerBuildTask>
    <JazorConsumerBuildArguments Condition="'$(JazorConsumerBuildArguments)' == ''"></JazorConsumerBuildArguments>
    <JazorConsumerEnvironmentVariables Condition="'$(JazorConsumerEnvironmentVariables)' == ''"></JazorConsumerEnvironmentVariables>
    <JazorPublishMaterializedRoot Condition="'$(JazorPublishMaterializedRoot)' == ''"></JazorPublishMaterializedRoot>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Public Jazor/Vue authoring surfaces expose native C# unions to consumers. -->
    <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="JazorRazorVueOutputMode" />
    <CompilerVisibleProperty Include="JazorRazorVueEnableRazorSgIntegration" />
  </ItemGroup>
</Project>

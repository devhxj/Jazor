<Project>
  <Target Name="_ResolveJazorEmitTool">
    <PropertyGroup>
      <_JazorPackagedToolPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\net11.0\Jazor.Emit.dll'))</_JazorPackagedToolPath>
      <_JazorToolPath Condition="Exists('$(_JazorPackagedToolPath)')">$(_JazorPackagedToolPath)</_JazorToolPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(_JazorToolPath)' == ''">
      <_JazorEmitToolProjectReference Include="@(ProjectReference)"
                                      Condition="'%(ProjectReference.Filename)' == 'Jazor.Emit'" />
    </ItemGroup>

    <MSBuild Projects="@(_JazorEmitToolProjectReference)"
             Targets="GetTargetPath"
             BuildInParallel="false"
             Condition="'$(_JazorToolPath)' == '' and '@(_JazorEmitToolProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_JazorEmitToolTarget" />
    </MSBuild>

    <PropertyGroup>
      <_JazorToolPath Condition="'$(_JazorToolPath)' == '' and '@(_JazorEmitToolTarget)' != ''">@(_JazorEmitToolTarget)</_JazorToolPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_JazorToolPath)')"
           Text="Could not locate Jazor.Emit. Install the Jazor package with its tools assets, or add a ProjectReference to Jazor.Emit for repository source builds." />
  </Target>

  <Target Name="JazorDebug"
          AfterTargets="Build"
          DependsOnTargets="_ResolveJazorEmitTool"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(JazorMode)' == 'debug' and Exists('$(TargetPath)')">
    <PropertyGroup>
      <_JazorDebugOutputDir>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(JazorDir)')), '[\\/]+$', ''))</_JazorDebugOutputDir>
      <_JazorDebugManifestPath>$(_JazorDebugOutputDir)\jazor-manifest.json</_JazorDebugManifestPath>
    </PropertyGroup>

    <ItemGroup>
      <JazorDebugAssembly Include="$(TargetPath)" />
      <JazorDebugAssembly Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.AssetType)' != 'native'" />
    </ItemGroup>

    <!-- Emit reflects managed assemblies only. Native runtime DLLs can also use a .dll extension on Windows. -->
    <!-- Emit 仅反射托管程序集；Windows 的原生 runtime DLL 也会使用 .dll 扩展名，必须在此排除。 -->

    <MakeDir Directories="$(_JazorDebugOutputDir)" />

    <Exec Command="dotnet &quot;$(_JazorToolPath)&quot; --root &quot;$(TargetPath)&quot; --out &quot;$(_JazorDebugOutputDir)&quot; --write-manifest &quot;$(_JazorDebugManifestPath)&quot; --clean true --fail-on-path-conflict true @(JazorDebugAssembly->'--assembly &quot;%(Identity)&quot;', ' ')" />
  </Target>

  <Target Name="JazorRelease"
          AfterTargets="Build"
          DependsOnTargets="_ResolveJazorEmitTool"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(JazorMode)' == 'release' and Exists('$(TargetPath)')">
    <PropertyGroup>
      <_JazorReleaseArtifactDir>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)jazor-release')), '[\\/]+$', ''))</_JazorReleaseArtifactDir>
      <_JazorReleaseManifestPath>$(_JazorReleaseArtifactDir)\jazor-manifest.json</_JazorReleaseManifestPath>
      <_JazorReleaseOutputDir>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(JazorDir)')), '[\\/]+$', ''))</_JazorReleaseOutputDir>
      <_JazorToolSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))</_JazorToolSourceRoot>
    </PropertyGroup>

    <ItemGroup>
      <JazorReleaseAssembly Include="$(TargetPath)" />
      <JazorReleaseAssembly Include="@(ReferenceCopyLocalPaths)"
                           Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.AssetType)' != 'native'" />
    </ItemGroup>

    <!-- Keep release emission consistent with the debug managed-assembly boundary above. -->
    <!-- Release 与 Debug 保持同一托管程序集边界，避免发布构建重新传入原生库。 -->

    <RemoveDir Directories="$(_JazorReleaseOutputDir)" Condition="Exists('$(_JazorReleaseOutputDir)')" />
    <MakeDir Directories="$(_JazorReleaseArtifactDir);$(_JazorReleaseOutputDir)" />

    <Exec Command="dotnet &quot;$(_JazorToolPath)&quot; --root &quot;$(TargetPath)&quot; --out &quot;$(_JazorReleaseArtifactDir)&quot; --write-manifest &quot;$(_JazorReleaseManifestPath)&quot; --clean true --fail-on-path-conflict true @(JazorReleaseAssembly->'--assembly &quot;%(Identity)&quot;', ' ')" />
    <Exec Command="dotnet &quot;$(_JazorToolPath)&quot; toolchain build --toolchain &quot;$(JazorTool)&quot; --manifest &quot;$(_JazorReleaseManifestPath)&quot; --artifacts &quot;$(_JazorReleaseArtifactDir)&quot; --source-root &quot;$(_JazorToolSourceRoot)&quot; --out-root &quot;$(_JazorReleaseOutputDir)&quot;" />
  </Target>

</Project>

<Project>
  <PropertyGroup>
    <JazorEmitToolTargetFramework Condition="'$(JazorEmitToolTargetFramework)' == ''">net11.0</JazorEmitToolTargetFramework>
  </PropertyGroup>

  <!-- Emit must run after a successful Build so analyzer/source-generator output and TargetPath are both finalized. -->
  <Target Name="JazorEmit"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(JazorEmit)' == 'true' and Exists('$(TargetPath)')">
    <PropertyGroup>
      <_JazorDefaultDevOutDir>$([System.IO.Path]::GetFullPath('$(JazorDevOutDir)'))</_JazorDefaultDevOutDir>
      <_JazorResolvedRequestedOutDir>$([System.IO.Path]::GetFullPath('$(JazorOutDir)'))</_JazorResolvedRequestedOutDir>
      <_JazorSelectedOutDir Condition="'$(_IsPublishing)' == 'true' and '$(_JazorResolvedRequestedOutDir)' == '$(_JazorDefaultDevOutDir)' and '$(JazorPublishMaterializeEnabled)' != 'true'">$(JazorPublishOutDir)</_JazorSelectedOutDir>
      <_JazorSelectedOutDir Condition="'$(_JazorSelectedOutDir)' == ''">$(JazorOutDir)</_JazorSelectedOutDir>
      <_JazorEmitOutDir>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(_JazorSelectedOutDir)')), '[\\/]+$', ''))</_JazorEmitOutDir>
      <JazorEmitToolPath Condition="'$(JazorEmitToolPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\$(JazorEmitToolTargetFramework)\Jazor.Emit.dll'))</JazorEmitToolPath>
      <JazorManifestPath Condition="'$(JazorManifestPath)' == ''">$(_JazorEmitOutDir)\jazor-manifest.json</JazorManifestPath>
      <_JazorEmitManifestPath>$([System.IO.Path]::GetFullPath('$(JazorManifestPath)'))</_JazorEmitManifestPath>
    </PropertyGroup>

    <ItemGroup>
      <JazorEmitAssembly Include="$(TargetPath)" />
      <JazorEmitAssembly Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>

    <MakeDir Directories="$(_JazorEmitOutDir)" />

    <Exec Command="dotnet &quot;$(JazorEmitToolPath)&quot; --root &quot;$(TargetPath)&quot; --out &quot;$(_JazorEmitOutDir)&quot; --write-manifest &quot;$(_JazorEmitManifestPath)&quot; --clean &quot;$(JazorCleanEmit)&quot; --fail-on-path-conflict &quot;$(JazorFailOnPathConflict)&quot; @(JazorEmitAssembly->'--assembly &quot;%(Identity)&quot;', ' ')" />
  </Target>

  <Target Name="JazorBundle"
          DependsOnTargets="JazorEmit"
          AfterTargets="JazorEmit"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(JazorBundle)' == 'true' and '$(JazorEmit)' == 'true'">
    <PropertyGroup>
      <_JazorDefaultDevOutDir>$([System.IO.Path]::GetFullPath('$(JazorDevOutDir)'))</_JazorDefaultDevOutDir>
      <_JazorResolvedRequestedOutDir>$([System.IO.Path]::GetFullPath('$(JazorOutDir)'))</_JazorResolvedRequestedOutDir>
      <_JazorSelectedOutDir Condition="'$(_IsPublishing)' == 'true' and '$(_JazorResolvedRequestedOutDir)' == '$(_JazorDefaultDevOutDir)' and '$(JazorPublishMaterializeEnabled)' != 'true'">$(JazorPublishOutDir)</_JazorSelectedOutDir>
      <_JazorSelectedOutDir Condition="'$(_JazorSelectedOutDir)' == ''">$(JazorOutDir)</_JazorSelectedOutDir>
      <JazorManifestPath Condition="'$(JazorManifestPath)' == ''">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(_JazorSelectedOutDir)')), '[\\/]+$', ''))\jazor-manifest.json</JazorManifestPath>
      <_JazorBundleOut>$([System.IO.Path]::GetFullPath('$(JazorBundleOut)'))</_JazorBundleOut>
      <_JazorEmitOutDirForBundle>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(_JazorSelectedOutDir)')), '[\\/]+$', ''))</_JazorEmitOutDirForBundle>
      <_JazorManifestPathForBundle>$([System.IO.Path]::GetFullPath('$(JazorManifestPath)'))</_JazorManifestPathForBundle>
      <JazorEmitToolPath Condition="'$(JazorEmitToolPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\$(JazorEmitToolTargetFramework)\Jazor.Emit.dll'))</JazorEmitToolPath>
    </PropertyGroup>

    <Exec Command="dotnet &quot;$(JazorEmitToolPath)&quot; bundle --in &quot;$(_JazorEmitOutDirForBundle)&quot; --manifest &quot;$(_JazorManifestPathForBundle)&quot; --out &quot;$(_JazorBundleOut)&quot;" />
  </Target>

  <Target Name="JazorPublishMaterialize"
          AfterTargets="Publish"
          Condition="'$(JazorEmit)' == 'true'
            and '$(JazorPublishMaterializeEnabled)' == 'true'
            and Exists('$(JazorOutDir)')">
    <PropertyGroup>
      <_JazorMaterializedSourceRoot>$([System.IO.Path]::GetFullPath('$(JazorOutDir)'))</_JazorMaterializedSourceRoot>
      <_JazorMaterializedTargetRoot Condition="'$(JazorPublishMaterializedRoot)' == ''">$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot', 'jazor'))</_JazorMaterializedTargetRoot>
      <_JazorMaterializedTargetRoot Condition="'$(JazorPublishMaterializedRoot)' != ''">$([System.IO.Path]::GetFullPath('$(JazorPublishMaterializedRoot)'))</_JazorMaterializedTargetRoot>
      <_JazorPublishedShadowRoot>$([System.IO.Path]::Combine('$(PublishDir)', 'jazor'))</_JazorPublishedShadowRoot>
    </PropertyGroup>

    <ItemGroup>
      <_JazorMaterializedArtifact Include="$(_JazorMaterializedSourceRoot)\**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(_JazorMaterializedTargetRoot)" />
    <MakeDir Directories="$(_JazorMaterializedTargetRoot)" />
    <Copy SourceFiles="@(_JazorMaterializedArtifact)"
          DestinationFiles="@(_JazorMaterializedArtifact->'$(_JazorMaterializedTargetRoot)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(_JazorPublishedShadowRoot)"
               Condition="Exists('$(_JazorPublishedShadowRoot)')" />
  </Target>

</Project>

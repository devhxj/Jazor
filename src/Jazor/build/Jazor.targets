<Project>
  <!-- Set while the direct Jazor package target is imported. Opt-in packages can use this
       marker to avoid registering the same shared analyzer closure a second time. -->
  <PropertyGroup>
    <_JazorDirectToolingActive>true</_JazorDirectToolingActive>
    <!-- Defaults belong after the project body so conditional consumer settings can opt in. -->
    <JazorMode Condition="'$(JazorMode)' == ''">none</JazorMode>
    <JazorPublishSourceMaps Condition="'$(JazorPublishSourceMaps)' == ''">false</JazorPublishSourceMaps>
    <_JazorGeneratedRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(JazorDir)'))</_JazorGeneratedRoot>
  </PropertyGroup>

  <!--
    This direct-reference target owns tooling activation. The transitive import is deliberately
    limited to resource-manifest locators, so an assembly reference cannot grant Emit/analyzer use.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\buildTransitive\Jazor.Resources.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Jazor.CompilationTiming.targets"
          Condition="'$(_JazorCompilationTimingTargetsImported)' != 'true'" />

  <ItemGroup>
    <!-- Roslyn resolves analyzer dependencies only from registered analyzer paths. Register the
         packaged closure here, inside the direct-only target, so generators cannot fail silently. -->
    <Analyzer Include="$(MSBuildThisFileDirectory)..\tools\net11.0\analyzers\*.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)..\tools\net11.0\analyzers')" />
  </ItemGroup>

  <!--
    Exclude the actual generated root, including relative/custom roots. C# and Razor source
    remain authored inputs even when a case-insensitive filesystem places them in Jazor/.
  -->
  <ItemGroup Condition="'$(JazorDir)' != ''">
    <!-- Glob by generated artifact extensions. Keeping source extensions (.cs/.razor/.resx)
         in the SDK item graph prevents a case-insensitive Jazor/ author directory from vanishing. -->
    <Content Remove="$(_JazorGeneratedRoot)**\*.js;$(_JazorGeneratedRoot)**\*.mjs;$(_JazorGeneratedRoot)**\*.map;$(_JazorGeneratedRoot)**\*.json;$(_JazorGeneratedRoot)**\*.lock;$(_JazorGeneratedRoot)**\*.css;$(_JazorGeneratedRoot)**\*.html" />
    <None Remove="$(_JazorGeneratedRoot)**\*.js;$(_JazorGeneratedRoot)**\*.mjs;$(_JazorGeneratedRoot)**\*.map;$(_JazorGeneratedRoot)**\*.json;$(_JazorGeneratedRoot)**\*.lock;$(_JazorGeneratedRoot)**\*.css;$(_JazorGeneratedRoot)**\*.html" />
  </ItemGroup>

  <Target Name="_ResolveJazorRuntimeIdentifier">
    <PropertyGroup>
      <_JazorTargetRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_JazorTargetRuntimeIdentifier>
      <_JazorTargetRuntimeIdentifier Condition="'$(_JazorTargetRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_JazorTargetRuntimeIdentifier>
      <_JazorRuntimeIdentifierArgument Condition="'$(_JazorTargetRuntimeIdentifier)' != ''">--runtime-identifier &quot;$(_JazorTargetRuntimeIdentifier)&quot;</_JazorRuntimeIdentifierArgument>
      <_JazorRuntimeIdentifierGraphArgument Condition="'$(RuntimeIdentifierGraphPath)' != ''">--runtime-identifier-graph &quot;$(RuntimeIdentifierGraphPath)&quot;</_JazorRuntimeIdentifierGraphArgument>
      <_JazorPnpmStoreArgument Condition="'$(JazorPnpmStoreDirectory)' != ''">--pnpm-store &quot;$([System.IO.Path]::GetFullPath('$(JazorPnpmStoreDirectory)'))&quot;</_JazorPnpmStoreArgument>
    </PropertyGroup>
  </Target>

  <Target Name="_ResolveJazorEmitTool">
    <PropertyGroup>
      <_JazorPackagedToolPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\net11.0\Jazor.Emit.dll'))</_JazorPackagedToolPath>
      <_JazorToolPath Condition="Exists('$(_JazorPackagedToolPath)')">$(_JazorPackagedToolPath)</_JazorToolPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(_JazorToolPath)' == ''">
      <_JazorEmitToolProjectReference Include="@(ProjectReference)"
                                      Condition="'%(ProjectReference.Filename)' == 'Jazor.Emit'" />
    </ItemGroup>

    <MSBuild Projects="@(_JazorEmitToolProjectReference)"
             Targets="GetTargetPath"
             BuildInParallel="false"
             Condition="'$(_JazorToolPath)' == '' and '@(_JazorEmitToolProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_JazorEmitToolTarget" />
    </MSBuild>

    <PropertyGroup>
      <_JazorToolPath Condition="'$(_JazorToolPath)' == '' and '@(_JazorEmitToolTarget)' != ''">@(_JazorEmitToolTarget)</_JazorToolPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_JazorToolPath)')"
           Text="Could not locate Jazor.Emit. Install the Jazor package with its tools assets, or add a ProjectReference to Jazor.Emit for repository source builds." />
    <PropertyGroup>
      <_JazorPackagedAppHost>$([System.IO.Path]::Combine('$([System.IO.Path]::GetDirectoryName($(_JazorToolPath)))', 'Jazor.Emit.$(NETCoreSdkRuntimeIdentifier).exe'))</_JazorPackagedAppHost>
      <_JazorSourceAppHost>$([System.IO.Path]::ChangeExtension('$(_JazorToolPath)', '.exe'))</_JazorSourceAppHost>
      <_JazorToolCommand Condition="'$(OS)' == 'Windows_NT' and Exists('$(_JazorPackagedAppHost)')">&quot;$(_JazorPackagedAppHost)&quot;</_JazorToolCommand>
      <_JazorToolCommand Condition="'$(OS)' == 'Windows_NT' and '$(_JazorToolCommand)' == '' and Exists('$(_JazorSourceAppHost)')">&quot;$(_JazorSourceAppHost)&quot;</_JazorToolCommand>
      <_JazorToolCommand Condition="'$(OS)' != 'Windows_NT'">dotnet &quot;$(_JazorToolPath)&quot;</_JazorToolCommand>
    </PropertyGroup>
    <Error Condition="'$(_JazorToolCommand)' == ''"
           Text="Jazor.Emit requires its CETCompat=false apphost for the current build-host RID '$(NETCoreSdkRuntimeIdentifier)'." />
    <Error Condition="'$(JazorDenoPath)' != ''"
           Text="JazorDenoPath has been removed. Jazor now uses the packaged in-process NodeApi toolchain." />
  </Target>

  <Target Name="JazorDebug"
          AfterTargets="Build"
          DependsOnTargets="_ResolveJazorEmitTool;_ResolveJazorRuntimeIdentifier"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(JazorMode)' == 'debug' and Exists('$(TargetPath)')">
    <PropertyGroup>
      <_JazorDebugOutputDir>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(JazorDir)')), '[\\/]+$', ''))</_JazorDebugOutputDir>
      <_JazorDebugManifestPath>$(IntermediateOutputPath)jazor-manifest.json</_JazorDebugManifestPath>
      <_JazorDebugAssemblyListPath>$(IntermediateOutputPath)jazor-assemblies.txt</_JazorDebugAssemblyListPath>
      <_JazorDebugModuleAssemblyListPath>$(IntermediateOutputPath)jazor-module-assemblies.txt</_JazorDebugModuleAssemblyListPath>
      <_JazorDebugLibraryManifestListPath>$(IntermediateOutputPath)jazor-library-manifests.txt</_JazorDebugLibraryManifestListPath>
      <_JazorDebugBrowserEntryListPath>$(IntermediateOutputPath)jazor-browser-entries.txt</_JazorDebugBrowserEntryListPath>
      <_JazorDebugSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))</_JazorDebugSourceRoot>
    </PropertyGroup>

    <ItemGroup>
      <JazorDebugAssembly Include="$(TargetPath)" />
      <JazorDebugAssembly Include="@(JazorAdditionalAssembly)" />
      <JazorDebugAssembly Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.AssetType)' != 'native'" />
    </ItemGroup>

    <!-- Emit reflects managed assemblies only. Native runtime DLLs can also use a .dll extension on Windows. -->
    <!-- Emit 仅反射托管程序集；Windows 的原生 runtime DLL 也会使用 .dll 扩展名，必须在此排除。 -->

    <!-- A single Emit invocation owns collection, dependency resolution and the atomic output commit. -->
    <!-- Large applications can carry hundreds of references. Keep those paths out of the Windows
         command line; these obj files are process-input transport, not runtime manifests. -->
    <WriteLinesToFile File="$(_JazorDebugAssemblyListPath)" Lines="@(JazorDebugAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_JazorDebugModuleAssemblyListPath)" Lines="@(JazorAdditionalAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_JazorDebugLibraryManifestListPath)" Lines="@(JazorLibraryManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <!-- Browser roots select only entry.js; all catalog modules remain available for lazy imports and SSR. -->
    <WriteLinesToFile File="$(_JazorDebugBrowserEntryListPath)" Lines="@(JazorBrowserEntry)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec Command="$(_JazorToolCommand) --root &quot;$(TargetPath)&quot; --out &quot;$(_JazorDebugOutputDir)&quot; --write-manifest &quot;$(_JazorDebugManifestPath)&quot; --mode debug --source-root &quot;$(_JazorDebugSourceRoot)&quot; --ssr &quot;$(JazorSSR)&quot; $(_JazorPnpmStoreArgument) $(_JazorRuntimeIdentifierArgument) $(_JazorRuntimeIdentifierGraphArgument) --assembly-list &quot;$(_JazorDebugAssemblyListPath)&quot; --module-assembly-list &quot;$(_JazorDebugModuleAssemblyListPath)&quot; --library-manifest-list &quot;$(_JazorDebugLibraryManifestListPath)&quot; --browser-entry-list &quot;$(_JazorDebugBrowserEntryListPath)&quot;" ConsoleToMSBuild="true" />
  </Target>

  <Target Name="JazorRelease"
          AfterTargets="Build"
          DependsOnTargets="_JazorEmitRelease"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(JazorMode)' == 'release' and Exists('$(TargetPath)')" />

  <!-- Folder Publish always materializes the runtime bundle, even after a Debug build.
       Both callers share this target so a Release publish emits only once. -->
  <Target Name="JazorPreparePublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="_JazorEmitRelease"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(JazorMode)' != 'none' and Exists('$(TargetPath)')" />

  <Target Name="_JazorEmitRelease"
          DependsOnTargets="_ResolveJazorEmitTool;_ResolveJazorRuntimeIdentifier">
    <PropertyGroup>
      <_JazorReleaseOutputDir>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(JazorDir)')), '[\\/]+$', ''))</_JazorReleaseOutputDir>
      <_JazorReleaseManifestPath>$(IntermediateOutputPath)jazor-manifest.json</_JazorReleaseManifestPath>
      <_JazorReleaseAssemblyListPath>$(IntermediateOutputPath)jazor-assemblies.txt</_JazorReleaseAssemblyListPath>
      <_JazorReleaseModuleAssemblyListPath>$(IntermediateOutputPath)jazor-module-assemblies.txt</_JazorReleaseModuleAssemblyListPath>
      <_JazorReleaseLibraryManifestListPath>$(IntermediateOutputPath)jazor-library-manifests.txt</_JazorReleaseLibraryManifestListPath>
      <_JazorReleaseBrowserEntryListPath>$(IntermediateOutputPath)jazor-browser-entries.txt</_JazorReleaseBrowserEntryListPath>
      <_JazorReleaseSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))</_JazorReleaseSourceRoot>
    </PropertyGroup>

    <ItemGroup>
      <JazorReleaseAssembly Include="$(TargetPath)" />
      <JazorReleaseAssembly Include="@(JazorAdditionalAssembly)" />
      <JazorReleaseAssembly Include="@(ReferenceCopyLocalPaths)"
                           Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.AssetType)' != 'native'" />
    </ItemGroup>

    <!-- Keep release emission consistent with the debug managed-assembly boundary above. -->
    <!-- Release 与 Debug 保持同一托管程序集边界，避免发布构建重新传入原生库。 -->

    <!-- Release uses the same managed assembly boundary and profile transaction as Debug. -->
    <WriteLinesToFile File="$(_JazorReleaseAssemblyListPath)" Lines="@(JazorReleaseAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_JazorReleaseModuleAssemblyListPath)" Lines="@(JazorAdditionalAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_JazorReleaseLibraryManifestListPath)" Lines="@(JazorLibraryManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_JazorReleaseBrowserEntryListPath)" Lines="@(JazorBrowserEntry)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec Command="$(_JazorToolCommand) --root &quot;$(TargetPath)&quot; --out &quot;$(_JazorReleaseOutputDir)&quot; --write-manifest &quot;$(_JazorReleaseManifestPath)&quot; --mode release --source-root &quot;$(_JazorReleaseSourceRoot)&quot; --ssr &quot;$(JazorSSR)&quot; $(_JazorPnpmStoreArgument) $(_JazorRuntimeIdentifierArgument) $(_JazorRuntimeIdentifierGraphArgument) --assembly-list &quot;$(_JazorReleaseAssemblyListPath)&quot; --module-assembly-list &quot;$(_JazorReleaseModuleAssemblyListPath)&quot; --library-manifest-list &quot;$(_JazorReleaseLibraryManifestListPath)&quot; --browser-entry-list &quot;$(_JazorReleaseBrowserEntryListPath)&quot;" ConsoleToMSBuild="true" />
  </Target>

  <!--
    Generated artifacts deliberately live beside the project rather than under wwwroot.
    Publish copies that graph explicitly so Web and non-Web SDK hosts get one identical
    /jazor layout without making the build output an authored static-file item.
  -->
  <Target Name="AddJazorArtifactsToPublish"
          DependsOnTargets="JazorPreparePublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish"
          Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(JazorMode)' != 'none' and Exists('$(JazorDir)')">
    <PropertyGroup>
      <_JazorPublishRoot>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.Path]::GetFullPath('$(JazorDir)')), '[\\/]+$', ''))</_JazorPublishRoot>
    </PropertyGroup>

    <FindUnderPath Path="$(_JazorPublishRoot)"
                   Files="@(ResolvedFileToPublish)"
                   UpdateToAbsolutePaths="true">
      <Output TaskParameter="InPath" ItemName="_JazorSdkPublishArtifact" />
    </FindUnderPath>

    <ItemGroup>
      <!--
        The SDK can discover JazorDir after JazorDebug/JazorRelease creates it during
        the same publish invocation. Run before its duplicate-output check so both SDK
        families publish exactly one copy at the intended jazor/ relative path.
      -->
      <!-- Remove the SDK's exact item identities; a glob remove does not reliably match its metadata-backed items. -->
      <ResolvedFileToPublish Remove="@(_JazorSdkPublishArtifact)" />
      <!-- RecursiveDir starts after each glob root. Retain the runtime subtree explicitly
           so identically named browser/server chunks do not collide during publish. -->
      <_JazorArtifactFile Include="$(_JazorPublishRoot)\dist\**\*">
        <JazorRuntimeSubtree>dist/</JazorRuntimeSubtree>
      </_JazorArtifactFile>
      <_JazorArtifactFile Include="$(_JazorPublishRoot)\ssr\**\*" Condition="'$(JazorSSR)' == 'true'">
        <JazorRuntimeSubtree>ssr/</JazorRuntimeSubtree>
      </_JazorArtifactFile>
      <_JazorArtifactFile Remove="@(_JazorArtifactFile)" Condition="'$(JazorPublishSourceMaps)' != 'true' and '%(_JazorArtifactFile.Extension)' == '.map'" />
      <ResolvedFileToPublish Include="@(_JazorArtifactFile)">
        <RelativePath>jazor/%(_JazorArtifactFile.JazorRuntimeSubtree)%(_JazorArtifactFile.RecursiveDir)%(_JazorArtifactFile.Filename)%(_JazorArtifactFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>ECMAScript.Style</PackageId>
    <RootNamespace>ECMAScript.Style</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>hanxj</Authors>
    <Description>Strongly typed, deterministic CSS-in-JS pure Jazor library for ECMAScript modules authored in C# and emitted through Jazor.Generated.ModuleCatalog.</Description>
    <PackageProjectUrl>https://github.com/devhxj/Jazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/Jazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuspecFile>ECMAScript.Style.nuspec</NuspecFile>
    <NoWarn>$(NoWarn);CS0626;CS0824;CS8981;IDE0130;CA1416;CA1822;IDE0060;IDE1006</NoWarn>
    <ECMAScriptStyleProjectOutputRoot Condition="'$(JazorIsolatedBaseOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\</ECMAScriptStyleProjectOutputRoot>
    <ECMAScriptStyleProjectOutputRoot Condition="'$(JazorIsolatedBaseOutputRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(JazorIsolatedBaseOutputRoot)'))</ECMAScriptStyleProjectOutputRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="$(MinVerPackageVersion)" PrivateAssets="All" />
    <ProjectReference Include="..\ECMAScript\ECMAScript.csproj" />
    <ProjectReference Include="..\Jazor.Compiler\Jazor.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Jazor.Analyzer\Jazor.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="AddLocalECMAScriptStyleAnalyzerDependencies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll" />
      <Analyzer Include="$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll" />
      <Analyzer Include="$(ECMAScriptStyleProjectOutputRoot)ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll" />
      <Analyzer Include="$(ECMAScriptStyleProjectOutputRoot)Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll" />
    </ItemGroup>
  </Target>

  <Import Project="..\Packaging\JazorPackage.targets" />
</Project>

@inherits VbenContentComponentBase
@{
    var header = BuildHeaderRenderState();
}

<section class="@RootCssClass" style="@CssStyle" @attributes="AdditionalAttributes">
    @if (header.HasHeader)
    {
        <div class='@("vben-page__header")'>
            @if (header.HasTitleRegion)
            {
                <div class='@("vben-page__titles")'>
                    @if (header.BreadcrumbItems.Length > 0)
                    {
                        <nav class='@("vben-page__breadcrumb")'>
                            @foreach (var item in header.BreadcrumbItems)
                            {
                                @RenderBreadcrumbItem(item)
                            }
                        </nav>
                    }

                    @if (NormalizedTitle is not null)
                    {
                        <h1 class='@("vben-page__title")'>@NormalizedTitle</h1>
                    }

                    @if (NormalizedSubtitle is not null)
                    {
                        <p class='@("vben-page__subtitle")'>@NormalizedSubtitle</p>
                    }
                </div>
            }

            @if (header.HasActionsRegion)
            {
            <div class='@("vben-page__actions")'>
                @foreach (var action in header.Actions)
                {
                    @RenderAction(action)
                }
                @header.Extra
            </div>
            }
        </div>
    }

    <div class='@("vben-page__body")'>
        @ChildContent
    </div>
</section>

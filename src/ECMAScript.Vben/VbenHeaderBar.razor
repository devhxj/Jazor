@inherits VbenComponentBase
@{
    var logo = VbenRenderFragmentHelper.Normalize(Logo);
    var actions = VbenRenderFragmentHelper.Normalize(Actions);
    var userRegion = VbenRenderFragmentHelper.Normalize(UserRegion);
    var hasMainRegion = logo is not null || HasTitles;
    var hasRightRegion = actions is not null || userRegion is not null;
    var hasContent = hasMainRegion || hasRightRegion;
}

@if (hasContent)
{
    <div class="@RootCssClass" style="@CssStyle" @attributes="AdditionalAttributes">
        @if (hasMainRegion)
        {
            <div class='@("vben-header__main")'>
                @if (logo is not null)
                {
                    <div class='@("vben-header__logo")'>@logo</div>
                }

                @if (HasTitles)
                {
                    <div class='@("vben-header__titles")'>
                        @if (NormalizedTitle is not null)
                        {
                            <div class='@("vben-header__title")'>@NormalizedTitle</div>
                        }
                        @if (NormalizedSubtitle is not null)
                        {
                            <div class='@("vben-header__subtitle")'>@NormalizedSubtitle</div>
                        }
                    </div>
                }
            </div>
        }

        @if (hasRightRegion)
        {
            <div class='@("vben-header__actions")'>
                @if (actions is not null)
                {
                    <div class='@("vben-header__toolbar")'>@actions</div>
                }

                @if (userRegion is not null)
                {
                    <div class='@("vben-header__user-region")'>@userRegion</div>
                }
            </div>
        }
    </div>
}

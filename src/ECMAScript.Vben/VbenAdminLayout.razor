@inherits VbenContentComponentBase
@{
    var logo = VbenRenderFragmentHelper.Normalize(Logo);
    var header = VbenRenderFragmentHelper.Normalize(Header);
    var sidebar = VbenRenderFragmentHelper.Normalize(Sidebar);
    var headerActions = VbenRenderFragmentHelper.Normalize(HeaderActions);
    var userRegion = VbenRenderFragmentHelper.Normalize(UserRegion);
    var hasDefaultSidebarContent = logo is not null || VbenNavItemRenderHelper.HasRenderableItems(NavItems);
    var hasSidebarRegion = IsSidebarLayout && (sidebar is not null || hasDefaultSidebarContent);
    var defaultHeaderLogo = IsSidebarLayout ? null : logo;
    var hasDefaultHeaderContent =
        !string.IsNullOrWhiteSpace(Title)
        || !string.IsNullOrWhiteSpace(Subtitle)
        || defaultHeaderLogo is not null
        || headerActions is not null
        || userRegion is not null;
    var hasHeaderRegion = header is not null || hasDefaultHeaderContent;
}

<div class="@RootCssClass" style="@CssStyle" @attributes="AdditionalAttributes">
    @if (hasSidebarRegion)
    {
        <aside class='@("vben-shell__sidebar")'>
            @if (sidebar is not null)
            {
                @sidebar
            }
            else
            {
                <VbenSidebarMenu Items="@NavItems"
                                 Collapsed="@Collapsed"
                                 SelectedKey="@SelectedKey"
                                 ExpandedKeys="@ExpandedKeys"
                                 SelectedKeyChanged="@SelectedKeyChanged"
                                 ExpandedKeysChanged="@ExpandedKeysChanged"
                                 Logo="@Logo" />
            }
        </aside>
    }

    <div class='@("vben-shell__main")'>
        @if (hasHeaderRegion)
        {
            <header class='@("vben-shell__header")'>
                @if (header is not null)
                {
                    @header
                }
                else
                {
                    <VbenHeaderBar Title="@Title"
                                   Subtitle="@Subtitle"
                                   Logo="@defaultHeaderLogo"
                                   Actions="@headerActions"
                                   UserRegion="@userRegion" />
                }
            </header>
        }

        <main class='@("vben-shell__content")'>
            @ChildContent
        </main>
    </div>
</div>

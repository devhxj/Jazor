@inherits VbenComponentBase
@{
    var logo = VbenRenderFragmentHelper.Normalize(Logo);
    var items = EffectiveItems;
    var hasContent = logo is not null || items.Length > 0;
}

@if (hasContent)
{
    <nav class="@RootCssClass" style="@CssStyle" @attributes="AdditionalAttributes">
        @if (logo is not null)
        {
            <div class='@("vben-sidebar__logo")'>@logo</div>
        }

        @if (items.Length > 0)
        {
            <ul class='@("vben-sidebar__list")'>
                @foreach (var item in items)
                {
                    @RenderEffectiveItem(item)
                }
            </ul>
        }
    </nav>
}

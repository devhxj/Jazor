<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DenoHostVersion>2.7.7</DenoHostVersion>
    <DenoHostRuntimePackageId Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' != ''">DenoHost.Runtime.$(NETCoreSdkPortableRuntimeIdentifier)</DenoHostRuntimePackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DenoHost.Core" Version="$(DenoHostVersion)" />
    <PackageReference Include="$(DenoHostRuntimePackageId)"
                      Version="$(DenoHostVersion)"
                      Condition="'$(DenoHostRuntimePackageId)' != ''" />
    <None Include="Frontend\Deno\Worker\frontend-worker.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Frontend\Deno\Worker\frontend-worker.ts</TargetPath>
    </None>
  </ItemGroup>
</Project>

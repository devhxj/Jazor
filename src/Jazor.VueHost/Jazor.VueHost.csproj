<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS1035</NoWarn>
    <DenoHostVersion>2.7.7</DenoHostVersion>
    <DenoHostRuntimePackageId Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' != ''">DenoHost.Runtime.$(NETCoreSdkPortableRuntimeIdentifier)</DenoHostRuntimePackageId>
    <DenoExecutableName Condition="$([MSBuild]::IsOsPlatform('Windows'))">deno.exe</DenoExecutableName>
    <DenoExecutableName Condition="'$(DenoExecutableName)' == ''">deno</DenoExecutableName>
    <VueHostBundledDenoPath>$(TargetDir)runtimes\$(NETCoreSdkPortableRuntimeIdentifier)\native\$(DenoExecutableName)</VueHostBundledDenoPath>
    <VueHostWorkerOutputPath>$(TargetDir)Frontend\Deno\Worker\frontend-worker.ts</VueHostWorkerOutputPath>
    <VueHostDenoCacheDir>$(TargetDir)Frontend\Deno\Cache</VueHostDenoCacheDir>
    <VueHostRoslynBinariesPath Condition="$([System.IO.Directory]::Exists('$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)\..\Roslyn\bincore'))'))">$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)\..\Roslyn\bincore'))</VueHostRoslynBinariesPath>
    <VueHostRoslynBinariesPath Condition="'$(VueHostRoslynBinariesPath)' == '' And '$(NETCoreSdkVersion)' != ''">$([System.IO.Path]::GetFullPath('$(ProgramFiles)\dotnet\sdk\$(NETCoreSdkVersion)\Roslyn\bincore'))</VueHostRoslynBinariesPath>
    <VueHostRazorSdkPath Condition="$([System.IO.Directory]::Exists('$(MSBuildSDKsPath)\Microsoft.NET.Sdk.Razor'))">$(MSBuildSDKsPath)</VueHostRazorSdkPath>
    <VueHostRazorSdkPath Condition="'$(VueHostRazorSdkPath)' == '' And '$(NETCoreSdkVersion)' != ''">$([System.IO.Path]::GetFullPath('$(ProgramFiles)\dotnet\sdk\$(NETCoreSdkVersion)\Sdks'))</VueHostRazorSdkPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Jazor.Emit\Jazor.Emit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DenoHost.Core" Version="2.7.12" />
    <PackageReference Include="$(DenoHostRuntimePackageId)" Version="$(DenoHostVersion)" Condition="'$(DenoHostRuntimePackageId)' != ''" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(VueHostRoslynBinariesPath)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(VueHostRoslynBinariesPath)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler">
      <HintPath>$(VueHostRazorSdkPath)\Microsoft.NET.Sdk.Razor\source-generators\Microsoft.CodeAnalysis.Razor.Compiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="Frontend\Deno\Worker\frontend-worker.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Frontend\Deno\Worker\frontend-worker.ts</TargetPath>
    </None>
    <None Include="Frontend\Deno\Worker\deno.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Frontend\Deno\Worker\deno.json</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="DenoHost.Runtime.win-x64" Version="2.7.12" />
  </ItemGroup>

  <Target Name="CacheVueHostFrontendWorkerDependencies" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(VueHostBundledDenoPath)') and Exists('$(VueHostWorkerOutputPath)')">
    <MakeDir Directories="$(VueHostDenoCacheDir)" />
    <Exec Command="&quot;$(VueHostBundledDenoPath)&quot; cache --quiet &quot;$(VueHostWorkerOutputPath)&quot;" WorkingDirectory="$(TargetDir)Frontend\Deno\Worker" EnvironmentVariables="DENO_DIR=$(VueHostDenoCacheDir)" />
  </Target>
</Project>

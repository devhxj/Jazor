{
  "name": "jolt",
  "displayName": "Jolt",
  "description": "Minimal VS Code integration for managing Jolt LSP process.",
  "version": "0.1.0",
  "publisher": "jazor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devhxj/Jazor.git",
    "directory": "src/Jazor.VSCodeExtension"
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "LICENSE",
    "node_modules/**"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:jazor",
    "onCommand:jolt.start",
    "onCommand:jolt.stop",
    "onCommand:jolt.restart",
    "onCommand:jolt.showExtensionDashboard"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jazor",
        "aliases": [
          "Jazor",
          "jazor"
        ],
        "extensions": [
          ".jazor"
        ]
      }
    ],
    "commands": [
      {
        "command": "jolt.start",
        "title": "Jolt: Start LSP"
      },
      {
        "command": "jolt.stop",
        "title": "Jolt: Stop LSP"
      },
      {
        "command": "jolt.restart",
        "title": "Jolt: Restart LSP"
      },
      {
        "command": "jolt.showExtensionDashboard",
        "title": "Jolt: Show Extension Dashboard"
      }
    ],
    "configuration": {
      "title": "Jolt",
      "properties": {
        "jolt.executable": {
          "type": "string",
          "default": "Jolt",
          "description": "Executable or command used to launch Jolt."
        },
        "jolt.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--lsp",
            "--stdio"
          ],
          "description": "Arguments passed to the Jolt executable."
        },
        "jolt.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start Jolt when the extension activates."
        }
      }
    }
  }
}

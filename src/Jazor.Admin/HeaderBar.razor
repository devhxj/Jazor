@inherits AdminComponentBase

@if (HasContent)
{
    <div class="@RootCssClass" style="@CssStyle" @attributes="AdditionalAttributes">
        @if (HasMainRegion)
        {
            <div class="ja-header__main">
                @if (Logo is not null)
                {
                    <div class="ja-header__logo">@Logo</div>
                }
                @if (HasTitles)
                {
                    <div class="ja-header__titles">
                        @if (NormalizedTitle is not null)
                        {
                            <div class="ja-header__title">@NormalizedTitle</div>
                        }
                        @if (NormalizedSubtitle is not null)
                        {
                            <div class="ja-header__subtitle">@NormalizedSubtitle</div>
                        }
                    </div>
                }
            </div>
        }
        @if (Navigation is not null)
        {
            <div class="ja-header__navigation">@Navigation</div>
        }
        @if (HasRightRegion)
        {
            <div class="ja-header__actions">
                @if (Actions is not null)
                {
                    <div class="ja-header__toolbar">@Actions</div>
                }
                @if (UserRegion is not null)
                {
                    <div class="ja-header__user-region">@UserRegion</div>
                }
            </div>
        }
    </div>
}

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Jazor.Admin</PackageId>
    <Authors>hanxj</Authors>
    <Description>Jazor admin-shell contracts and native RazorVue components.</Description>
    <PackageProjectUrl>https://github.com/devhxj/Jazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/Jazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuspecFile>Jazor.Admin.nuspec</NuspecFile>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <RazorLangVersion>11.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <NoWarn>CS0626,CS0824,IDE0130,CA1822,IDE0060,IDE1006</NoWarn>
    <JazorRazorVueOutputRoot Condition="'$(JazorRazorVueOutputRoot)' == '' and '$(JazorIsolatedBaseOutputRoot)' != ''">$([System.IO.Path]::Combine('$([MSBuild]::EnsureTrailingSlash($(JazorIsolatedBaseOutputRoot)))', 'Jazor.RazorVue', 'bin', '$(Configuration)', 'netstandard2.0'))\</JazorRazorVueOutputRoot>
    <JazorRazorVueOutputRoot Condition="'$(JazorRazorVueOutputRoot)' == ''">..\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\</JazorRazorVueOutputRoot>
  </PropertyGroup>

  <Import Project="..\Jazor\buildTransitive\Jazor.props" />

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECMAScript\ECMAScript.csproj" />
    <ProjectReference Include="..\ECMAScript.Style\ECMAScript.Style.csproj" />
    <ProjectReference Include="..\ECMAScript.Vue3\ECMAScript.Vue3.csproj" />
    <ProjectReference Include="..\ECMAScript.VueContract\ECMAScript.VueContract.csproj" />
    <ProjectReference Include="..\ECMAScript.VueRoute\ECMAScript.VueRoute.csproj" />
    <ProjectReference Include="..\Jazor.RazorVue\Jazor.RazorVue.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(JazorRazorVueOutputRoot)Jazor.RazorVue.dll" />
    <Analyzer Include="$(JazorRazorVueOutputRoot)Jazor.Compiler.dll" />
    <Analyzer Include="$(JazorRazorVueOutputRoot)Jazor.Common.dll" />
    <Analyzer Include="$(JazorRazorVueOutputRoot)ECMAScript.Contract.dll" />
    <Analyzer Include="$(JazorRazorVueOutputRoot)Acornima.dll" />
    <Analyzer Include="$(JazorRazorVueOutputRoot)Acornima.Extras.dll" />
  </ItemGroup>

  <Import Project="..\Packaging\JazorFrontendNuspec.targets" />
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ECMAScript.Vue3</PackageId>
    <RootNamespace>ECMAScript</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>hanxj</Authors>
    <Description>Vue 3 host bindings for ECMAScript runtime authoring.</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>CS0626,CS0824,IDE0130,CA1822,IDE0060,IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECMAScript\ECMAScript.csproj" />
    <ProjectReference Include="..\ECMAScript.VueContract\ECMAScript.VueContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\ECMAScript.Vue3.targets" Pack="true" PackagePath="buildTransitive\ECMAScript.Vue3.targets" />
    <None Include="manifest.json" Pack="true" PackagePath="jazor\vue3\manifest.json" />
    <None Include="dist\**\*" Pack="true" PackagePath="jazor\vue3\dist\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="licenses\LICENSE" Pack="true" PackagePath="jazor\vue3\licenses" />
    <None Include="licenses\VUE-DEVTOOLS-API-LICENSE" Pack="true" PackagePath="jazor\vue3\licenses" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$packageId$</id>
    <version>$packageVersion$</version>
    <authors>$packageAuthors$</authors>
    <description>$packageDescription$</description>
    <projectUrl>$repositoryUrl$</projectUrl>
    <repository type="$repositoryType$" url="$repositoryUrl$" />
    <readme>$packageReadmeFile$</readme>
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="ECMAScript.Pinia" version="$dependencyVersion$" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="$buildOutputDir$ECMAScript.Pinia.Testing.dll" target="lib/net11.0" />
    <file src="$buildOutputDir$ECMAScript.Pinia.Testing.pdb" target="lib/net11.0" />
    <file src="$projectDir$buildTransitive\ECMAScript.Pinia.Testing.targets" target="buildTransitive\ECMAScript.Pinia.Testing.targets" />
    <file src="$projectDir$frontend\**\*" target="jazor\pinia-testing" />
    <file src="$projectDir$$packageReadmeFile$" target="" />
  </files>
</package>

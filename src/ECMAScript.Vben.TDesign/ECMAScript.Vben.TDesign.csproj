<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>ECMAScript.Vben.TDesign</PackageId>
    <Authors>hanxj</Authors>
    <Description>TDesign-backed admin-shell adapter components for ECMAScript.Vben.</Description>
    <PackageProjectUrl>https://github.com/devhxj/Jazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/Jazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuspecFile>ECMAScript.Vben.TDesign.nuspec</NuspecFile>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <RazorLangVersion>11.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <JazorRazorVueOutputMode>sfc</JazorRazorVueOutputMode>
    <JazorRazorVueEnableRazorSgIntegration>true</JazorRazorVueEnableRazorSgIntegration>
    <NoWarn>CS0626,CS0824,IDE0130,CA1822,IDE0060,IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECMAScript.Vben\ECMAScript.Vben.csproj" />
    <ProjectReference Include="..\ECMAScript.TDesign\ECMAScript.TDesign.csproj" />
    <ProjectReference Include="..\Jazor\Jazor.csproj" />
  </ItemGroup>

  <Import Project="..\Packaging\JazorFrontendNuspec.targets" />
</Project>

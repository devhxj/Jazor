@inherits VbenContentComponentBase

<TCard CssClass="@RootCssClass"
       CssStyle="@CssStyle"
       @attributes="AdditionalAttributes">
    <div class='@("vben-tdesign-page-container__header")'>
        <div class='@("vben-tdesign-page-container__titles")'>
            @if (BreadcrumbItems is { Length: > 0 })
            {
                <TBreadcrumb>
                    @foreach (var item in BreadcrumbItems)
                    {
                        <TBreadcrumbItem Text="@item.Title"
                                         Disabled="@(item.Disabled ?? false)"
                                         Href="@item.Target?.AsHref"
                                         To="@MapRoute(item.Target?.AsRoute)" />
                    }
                </TBreadcrumb>
            }

            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class='@("vben-tdesign-page-container__title")'>@Title</div>
            }

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class='@("vben-tdesign-page-container__subtitle")'>@Subtitle</div>
            }
        </div>

        @if ((Actions?.Length ?? 0) > 0 || Extra is not null)
        {
            <TSpace Align="@TDesignSpaceAlign.Center">
                @if (Actions is not null)
                {
                    @foreach (var action in Actions)
                    {
                        <TButton Theme="@MapTheme(action.Kind)"
                                 Disabled="@(action.Disabled ?? false)"
                                 Href="@action.Target?.AsHref"
                                 Text="@action.Text" />
                    }
                }
                @Extra
            </TSpace>
        }
    </div>

    <div class='@("vben-tdesign-page-container__body")'>
        @ChildContent
    </div>
</TCard>

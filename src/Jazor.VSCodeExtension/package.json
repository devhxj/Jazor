{
  "name": "jazor-vuehost",
  "displayName": "Jazor VueHost",
  "description": "Minimal VS Code integration for managing Jazor.VueHost LSP process.",
  "version": "0.1.0",
  "publisher": "jazor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devhxj/Jazor.git",
    "directory": "src/Jazor.VSCodeExtension"
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "LICENSE",
    "node_modules/**"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:jazor",
    "onCommand:jazorVueHost.start",
    "onCommand:jazorVueHost.stop",
    "onCommand:jazorVueHost.restart",
    "onCommand:jazorVueHost.showExtensionDashboard"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jazor",
        "aliases": [
          "Jazor",
          "jazor"
        ],
        "extensions": [
          ".jazor"
        ]
      }
    ],
    "commands": [
      {
        "command": "jazorVueHost.start",
        "title": "Jazor VueHost: Start LSP"
      },
      {
        "command": "jazorVueHost.stop",
        "title": "Jazor VueHost: Stop LSP"
      },
      {
        "command": "jazorVueHost.restart",
        "title": "Jazor VueHost: Restart LSP"
      },
      {
        "command": "jazorVueHost.showExtensionDashboard",
        "title": "Jazor VueHost: Show Extension Dashboard"
      }
    ],
    "configuration": {
      "title": "Jazor VueHost",
      "properties": {
        "jazorVueHost.executable": {
          "type": "string",
          "default": "Jazor.VueHost",
          "description": "Executable or command used to launch Jazor.VueHost."
        },
        "jazorVueHost.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--lsp",
            "--stdio"
          ],
          "description": "Arguments passed to the Jazor.VueHost executable."
        },
        "jazorVueHost.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start Jazor.VueHost when the extension activates."
        }
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DenoHostVersion>2.7.5</DenoHostVersion>
    <DenoHostRuntimePackageId Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' != ''">DenoHost.Runtime.$(NETCoreSdkPortableRuntimeIdentifier)</DenoHostRuntimePackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DenoHost.Core" Version="2.7.11" />
    <PackageReference Include="$(DenoHostRuntimePackageId)" Version="$(DenoHostVersion)" Condition="'$(DenoHostRuntimePackageId)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DenoHost.Runtime.win-x64" Version="2.7.11" />
  </ItemGroup>
</Project>

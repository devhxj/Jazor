@page "/examples/{id}"

<div class="playground-page-detail">
    <VContainer Fluid="true">
    <VRow>
        <VCol Cols="12" Xl="8">
            <div class="playground-detail__back">
                <a href="@Model.BackHref">@Model.BackText</a>
            </div>

            <div class="playground-detail__hero">
                <div class="playground-detail__chips">
                    <VChip Color="primary" Text="@Model.Example.Category" />
                    <VChip Variant="@VuetifyVariant.Outlined" Text="@Model.Example.Runtime" />
                    <VChip Variant="@VuetifyVariant.Outlined" Text="@Model.Example.Difficulty" />
                </div>
                <h1 class="playground-detail__title">@Model.Example.Title</h1>
                <p class="playground-detail__summary">@Model.Example.Summary</p>
                <div class="playground-detail__actions">
                    <VBtn Color="secondary"
                          Variant="@VuetifyVariant.Flat"
                          Text="@Model.FavoriteText"
                          OnClick="@ToggleFavorite" />
                </div>
            </div>

            <VRow>
                <VCol Cols="12" Md="6">
                    <VCard Variant="@VuetifyVariant.Tonal">
                        <VCardTitle>价值说明</VCardTitle>
                        <VCardText>@Model.Example.WhyItMatters</VCardText>
                    </VCard>
                </VCol>
                <VCol Cols="12" Md="6">
                    <VCard Variant="@VuetifyVariant.Tonal">
                        <VCardTitle>关键亮点</VCardTitle>
                        <VCardText>
                            <VList Density="@VuetifyDensity.Compact">
                                @foreach (var item in Model.Example.Highlights)
                                {
                                    <VListItem Title="@item" />
                                }
                            </VList>
                        </VCardText>
                    </VCard>
                </VCol>
            </VRow>

            <VRow>
                <VCol Cols="12" Md="7">
                    <VCard Variant="@VuetifyVariant.Outlined">
                        <VCardTitle>落地步骤</VCardTitle>
                        <VCardText>
                            <VList Density="@VuetifyDensity.Compact">
                                @foreach (var step in Model.Example.Steps)
                                {
                                    <VListItem Title="@step" />
                                }
                            </VList>
                        </VCardText>
                    </VCard>
                </VCol>
                <VCol Cols="12" Md="5">
                    <VCard Variant="@VuetifyVariant.Outlined">
                        <VCardTitle>涉及文件</VCardTitle>
                        <VCardText>
                            <VList Density="@VuetifyDensity.Compact">
                                @foreach (var file in Model.Example.Files)
                                {
                                    <VListItem Title="@file" />
                                }
                            </VList>
                        </VCardText>
                    </VCard>
                </VCol>
            </VRow>
        </VCol>

        <VCol Cols="12" Xl="4">
            <VCard class="playground-detail__sidebar" Variant="@VuetifyVariant.Outlined">
                <VCardTitle>参考快照</VCardTitle>
                <VCardText>
                    <div class="playground-detail__sidebar-row">
                        <span>预计耗时</span>
                        <strong>@(Model.Example.EstimatedMinutes + " 分钟")</strong>
                    </div>
                    <div class="playground-detail__sidebar-row">
                        <span>更新时间</span>
                        <strong>@Model.Example.UpdatedAtUtc</strong>
                    </div>
                    <div class="playground-detail__sidebar-row">
                        <span>是否精选</span>
                        <strong>@(Model.Example.Featured ? "是" : "否")</strong>
                    </div>
                    <div class="playground-detail__tag-list">
                        @foreach (var tag in Model.Example.Tags)
                        {
                            <VChip Size='@("small")' Variant="@VuetifyVariant.Text" Text="@tag" />
                        }
                    </div>
                </VCardText>
            </VCard>
        </VCol>
    </VRow>
    </VContainer>
</div>

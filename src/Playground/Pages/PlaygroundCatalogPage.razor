@page "/"
@page "/catalog"

<div class="playground-page-catalog">
    <VContainer Fluid="true">
    <div class="playground-hero">
    <VRow Align="center">
        <VCol Cols="12" Lg="7">
            <div class="playground-hero__eyebrow">后台式验证场</div>
            <h1 class="playground-hero__title">RazorVue + Vuetify + Pinia + VueRoute on ASP.NET Core</h1>
            <p class="playground-hero__body">
                Playground 是一个面向生产验证的目录型后台界面：
                RazorVue 负责页面 authoring，ASP.NET Core 负责 API 与静态资源，consumer 构建层负责接上 Vue runtime 能力。
            </p>
        </VCol>
        <VCol Cols="12" Lg="5">
            <VRow>
                <VCol Cols="12" Sm="4">
                    <PlaygroundStatCard Eyebrow="示例数"
                                        Value="@Model.TotalExamples.ToString()"
                                        Caption="真实流程，不是玩具片段" />
                </VCol>
                <VCol Cols="12" Sm="4">
                    <PlaygroundStatCard Eyebrow="精选"
                                        Value="@Model.FeaturedCount.ToString()"
                                        Caption="收敛后的参考路径" />
                </VCol>
                <VCol Cols="12" Sm="4">
                    <PlaygroundStatCard Eyebrow="收藏"
                                        Value="@Model.FavoritesCount.ToString()"
                                        Caption="当前操作者已标记" />
                </VCol>
            </VRow>
        </VCol>
    </VRow>
    </div>

    <div class="playground-toolbar">
    <VRow Align="center">
        <VCol Cols="12" Md="7">
            <VTextField Label="搜索示例"
                        Placeholder="按分类、运行时、流程、API 搜索..."
                        Density="@VuetifyDensity.Comfortable"
                        ModelValue="@Model.Query"
                        ModelValueChanged="@QueryChanged" />
        </VCol>
        <VCol Cols="12" Md="5">
            <div class="playground-category-list">
                <VChipGroup Column="true"
                            Color="secondary"
                            ModelValue="@Model.ActiveCategory"
                            ModelValueChanged="@CategorySelected">
                    @foreach (var category in Model.Categories)
                    {
                        <div class="playground-category-list__chip">
                            <VChip class="playground-category-chip"
                                   Value="@category"
                                   Variant="@(category == Model.ActiveCategory ? VuetifyVariant.Flat : VuetifyVariant.Outlined)"
                                   Text="@category" />
                        </div>
                    }
                </VChipGroup>
            </div>
        </VCol>
    </VRow>
    </div>

    <div class="playground-results-summary">
    <VRow>
        <VCol Cols="12">
            <span>@("当前视图共匹配 " + Model.VisibleCount + " 条结果。")</span>
        </VCol>
    </VRow>
    </div>

    @if (Model.Examples.Count == 0)
    {
        <VRow>
            <VCol Cols="12">
                <PlaygroundEmptyState Title="@Model.EmptyStateTitle"
                                      Body="@Model.EmptyStateBody" />
            </VCol>
        </VRow>
    }
    else
    {
        <VRow>
            @foreach (var example in Model.Examples)
            {
                <VCol Cols="12" Md="6" Xl="4">
                    <PlaygroundExampleCard Example="@example"
                                           DetailHref="@example.DetailHref" />
                </VCol>
            }
        </VRow>
    }
    </VContainer>
</div>

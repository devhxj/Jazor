<Project>
  <!-- Jazor.Vue owns Vue's browser runtime assets; Jazor core stays framework-neutral. -->
  <ItemGroup>
    <JazorLibraryManifest Include="$(MSBuildThisFileDirectory)..\jazor\vue3\manifest.json"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\jazor\vue3\manifest.json')" />
  </ItemGroup>

  <!--
    Register the provider from its package/source contract. The provider happens to be
    deployed beside the analyzer today, but discovery is path/contract based and does not
    depend on the current Analyzer item metadata or a filename filter.
  -->
  <PropertyGroup>
    <_JazorVueProviderAssembly
      Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Jazor.RazorVue.dll')">$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Jazor.RazorVue.dll</_JazorVueProviderAssembly>
    <_JazorVueProviderAssembly
      Condition="'$(_JazorVueProviderAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll')">$(MSBuildThisFileDirectory)..\..\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll</_JazorVueProviderAssembly>
  </PropertyGroup>

  <Target Name="RegisterJazorVueArtifactProvider"
          BeforeTargets="JazorDebug;JazorRelease">
    <ItemGroup>
      <JazorArtifactProviderAssembly Include="$(_JazorVueProviderAssembly)"
                                     Condition="'$(_JazorVueProviderAssembly)' != ''" />
    </ItemGroup>
  </Target>
</Project>

<Project>
  <!--
    NuGet imports this one target for both direct and transitive references. Resource locators
    are intentionally transitive, while RazorVue analyzer activation is granted only when the
    consuming project explicitly names Jazor.Vue in its own PackageReference items.
  -->
  <!-- Jazor.Vue owns Vue's browser runtime assets; Jazor core stays framework-neutral. -->
  <ItemGroup>
    <JazorLibraryManifest Include="$(MSBuildThisFileDirectory)..\jazor\vue3\manifest.json"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\jazor\vue3\manifest.json')" />
    <JazorLibraryManifest Include="$(MSBuildThisFileDirectory)..\..\ECMAScript.Vue\manifest.json"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\..\ECMAScript.Vue\manifest.json')" />
    <JazorLibraryManifest Include="$(MSBuildThisFileDirectory)..\jazor\vue-runtime\manifest.json"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\jazor\vue-runtime\manifest.json')" />
    <!-- Source-tree builds use the same manifest locator contract as the packed package. -->
    <JazorLibraryManifest Include="$(MSBuildThisFileDirectory)..\manifest.json"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\manifest.json')" />
  </ItemGroup>

  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Jazor.Vue'))' != ''">
    <!-- Keep the RazorVue analyzer beside its parser and register it only for direct users. -->
    <Analyzer Include="$(MSBuildThisFileDirectory)..\tools\net11.0\analyzers\*.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)..\tools\net11.0\analyzers')" />
  </ItemGroup>
</Project>

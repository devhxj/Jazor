<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>Jazor.Vue</PackageId>
    <NuspecFile>Jazor.Vue.nuspec</NuspecFile>
    <Authors>hanxj</Authors>
    <Description>Vue authoring, Razor-to-Vue integration, bindings, and local Vue runtime assets for Jazor.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/devhxj/Jazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devhxj/Jazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>jazor;razor;vue;blazor;source-generator</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(DOTNET_CLI_HOME)' != ''">$([System.IO.Path]::Combine('$(DOTNET_CLI_HOME)', '.nuget', 'packages'))\</NuGetPackageRoot>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == '' and '$(UserProfile)' != ''">$([System.IO.Path]::Combine('$(UserProfile)', '.nuget', 'packages'))\</NuGetPackageRoot>
    <JazorVuePackageBuildOutputRoot Condition="'$(JazorVuePackageBuildOutputRoot)' == '' and '$(JazorIsolatedBaseOutputRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(JazorIsolatedBaseOutputRoot)'))</JazorVuePackageBuildOutputRoot>
    <JazorVuePackageBuildOutputRoot Condition="'$(JazorVuePackageBuildOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\</JazorVuePackageBuildOutputRoot>
    <JazorPackageBuildOutputRoot Condition="'$(JazorPackageBuildOutputRoot)' == ''">$(JazorVuePackageBuildOutputRoot)</JazorPackageBuildOutputRoot>
    <JazorVuePackageArtifactRestoreProperties>Configuration=$(Configuration);BuildInParallel=false</JazorVuePackageArtifactRestoreProperties>
    <JazorVuePackageArtifactBuildProperties>$(JazorVuePackageArtifactRestoreProperties);BuildProjectReferences=false</JazorVuePackageArtifactBuildProperties>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="$(MinVerPackageVersion)" PrivateAssets="All" />
    <PackageReference Include="AngleSharp" Version="$(AngleSharpVersion)" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Acornima.Extras" Version="$(AcornimaVersion)" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="false" />
    <None Include="..\..\LICENSE.txt" Pack="false" />
    <None Include="..\..\NOTICE.txt" Pack="false" />
    <None Include="buildTransitive\Jazor.Vue.targets" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(JazorVuePackageBuildOutputRoot)ECMAScript.Vue\bin\$(Configuration)\net11.0\ECMAScript.Vue.dll" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)ECMAScript.Vue\bin\$(Configuration)\net11.0\ECMAScript.Vue.pdb" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)ECMAScript.VueContract\bin\$(Configuration)\netstandard2.0\ECMAScript.VueContract.dll" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)ECMAScript.VueContract\bin\$(Configuration)\netstandard2.0\ECMAScript.VueContract.pdb" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)ECMAScript.Blazor\bin\$(Configuration)\net11.0\ECMAScript.Blazor.dll" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)ECMAScript.Blazor\bin\$(Configuration)\net11.0\ECMAScript.Blazor.pdb" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll" Pack="false" />
    <None Include="$(JazorVuePackageBuildOutputRoot)Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.pdb" Pack="false" />
    <!-- RazorVue parses static HTML fragments inside the analyzer process; ship its parser beside the analyzer. -->
    <None Include="$(NuGetPackageRoot)anglesharp\$(AngleSharpVersion)\lib\netstandard2.0\AngleSharp.dll" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript.Blazor\ECMAScript.Blazor.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript.Contract\ECMAScript.Contract.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.Common\Jazor.Common.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript.VueContract\ECMAScript.VueContract.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript\ECMAScript.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\ECMAScript.Vue\ECMAScript.Vue.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.Compiler\Jazor.Compiler.csproj" />
    <_JazorVuePackageBuildProject Include="$(MSBuildThisFileDirectory)..\Jazor.RazorVue\Jazor.RazorVue.csproj" />
  </ItemGroup>

  <Target Name="PrepareJazorVuePackageArtifacts"
          BeforeTargets="GenerateNuspec"
          Condition="'$(JazorVuePreparePackageArtifacts)' != 'false'">
    <MSBuild Projects="@(_JazorVuePackageBuildProject)"
             Targets="Restore"
             BuildInParallel="false"
             Properties="$(JazorVuePackageArtifactRestoreProperties)"
             RemoveProperties="TargetFramework;TargetFrameworkIdentifier;TargetFrameworkVersion;TargetFrameworkProfile;TargetPlatformIdentifier;TargetPlatformVersion;RuntimeIdentifier;SelfContained;PublishSingleFile;PackOnBuild;GeneratePackageOnBuild;NoBuild;PackageOutputPath;ExcludeRestorePackageImports" />
    <MSBuild Projects="@(_JazorVuePackageBuildProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="$(JazorVuePackageArtifactBuildProperties)"
             RemoveProperties="TargetFramework;TargetFrameworkIdentifier;TargetFrameworkVersion;TargetFrameworkProfile;TargetPlatformIdentifier;TargetPlatformVersion;RuntimeIdentifier;SelfContained;PublishSingleFile;PackOnBuild;GeneratePackageOnBuild;NoBuild;PackageOutputPath;ExcludeRestorePackageImports" />
  </Target>

  <Import Project="..\Packaging\JazorPackage.targets" />
</Project>

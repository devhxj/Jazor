<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$packageId$</id>
    <version>$version$</version>
    <authors>$packageAuthors$</authors>
    <description>$packageDescription$</description>
    <projectUrl>$repositoryUrl$</projectUrl>
    <repository type="$repositoryType$" url="$repositoryUrl$" />
    <license type="file">LICENSE.txt</license>
    <readme>$packageReadmeFile$</readme>
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="Jazor" version="$dependencyVersion$" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net11.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="$projectDir$README.md" target="" />
    <file src="$projectDir$..\..\LICENSE.txt" target="LICENSE.txt" />
    <file src="$projectDir$..\..\NOTICE.txt" target="NOTICE.txt" />
    <file src="$projectDir$buildTransitive\Jazor.Vue.targets" target="buildTransitive\Jazor.Vue.targets" />
    <file src="$buildOutputRoot$ECMAScript.Vue\bin\$configuration$\net11.0\ECMAScript.Vue.dll" target="lib/net11.0" />
    <file src="$buildOutputRoot$ECMAScript.Vue\bin\$configuration$\net11.0\ECMAScript.Vue.pdb" target="lib/net11.0" />
    <file src="$buildOutputRoot$ECMAScript.VueContract\bin\$configuration$\netstandard2.0\ECMAScript.VueContract.dll" target="lib/net11.0" />
    <file src="$buildOutputRoot$ECMAScript.VueContract\bin\$configuration$\netstandard2.0\ECMAScript.VueContract.pdb" target="lib/net11.0" />
    <file src="$buildOutputRoot$ECMAScript.Blazor\bin\$configuration$\net11.0\ECMAScript.Blazor.dll" target="lib/net11.0" />
    <file src="$buildOutputRoot$ECMAScript.Blazor\bin\$configuration$\net11.0\ECMAScript.Blazor.pdb" target="lib/net11.0" />
    <file src="$buildOutputRoot$Jazor.RazorVue\bin\$configuration$\netstandard2.0\Jazor.RazorVue.dll" target="tools/net11.0/analyzers" />
    <file src="$buildOutputRoot$Jazor.RazorVue\bin\$configuration$\netstandard2.0\Jazor.RazorVue.pdb" target="tools/net11.0/analyzers" />
    <file src="$nugetPackageRoot$anglesharp\$angleSharpVersion$\lib\netstandard2.0\AngleSharp.dll" target="tools/net11.0/analyzers" />
    <file src="$projectDir$..\ECMAScript.Vue\manifest.json" target="jazor/vue3/manifest.json" />
    <file src="$projectDir$..\ECMAScript.Vue\dist\**\*" target="jazor/vue3/dist" />
    <file src="$projectDir$..\ECMAScript.Vue\licenses\**\*" target="jazor/vue3/licenses" />
    <file src="$projectDir$manifest.json" target="jazor/vue-runtime/manifest.json" />
    <file src="$projectDir$dist\**\*" target="jazor/vue-runtime/dist" />
    <file src="$projectDir$..\Jazor.Emit\tooling\vue\compiler-sfc.esm-browser.js"
          target="tools/net11.0/tooling/vue/compiler-sfc.esm-browser.js" />
    <file src="$projectDir$..\Jazor.Emit\tooling\vue\licenses\LICENSE"
          target="tools/net11.0/tooling/vue/licenses/LICENSE" />
  </files>
</package>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler" HintPath="$(NetCoreSdkRoot)Sdks/Microsoft.NET.Sdk.Razor/source-generators/Microsoft.CodeAnalysis.Razor.Compiler.dll" />
        <Reference Include="Microsoft.AspNetCore.Razor.Utilities.Shared" HintPath="$(NetCoreSdkRoot)Sdks/Microsoft.NET.Sdk.Razor/source-generators/Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
        <Reference Include="Microsoft.CodeAnalysis" HintPath="$(NetCoreSdkRoot)Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
        <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(NetCoreSdkRoot)Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Libnode 20's V8 stack switching is incompatible with Windows CET shadow stacks.
         Keep this local to the experimental WebIDL embedding host. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodeAnalysisVersion)" PrivateAssets="All" />
    <ProjectReference Include="..\Jazor.NodeHost\Jazor.NodeHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ECMAScript.Vue.Generator\BindingAuthoringDocumentation.cs" Link="Shared\BindingAuthoringDocumentation.cs" />
    <EmbeddedResource Include="..\ECMAScript\internal\Number.cs" LogicalName="BindingAuthoring.Number.cs" />
  </ItemGroup>

</Project>

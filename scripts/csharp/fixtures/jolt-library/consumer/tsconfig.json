{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "jsx": "preserve",
        "jsxImportSource": "vue"
    },
    "vueCompilerOptions": { "strictTemplates": true },
    "include": ["src/**/*.vue", "src/**/*.ts", "src/**/*.tsx"]
}

{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "allowArbitraryExtensions": true,
        "rootDirs": [".", "./.jolt"],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["*.ts", "*.vue"]
}

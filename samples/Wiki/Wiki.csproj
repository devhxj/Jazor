<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <JazorMode>debug</JazorMode>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="jazor\**" />
    <Content Remove="jazor\**" />
    <EmbeddedResource Remove="jazor\**" />
    <None Remove="jazor\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="host\index.template.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!-- docs/ markdown 是官网内容单一事实来源：docs 变化时重新生成纯数据路由目录。 -->
  <PropertyGroup>
    <WikiDocsGeneratedFile>$(MSBuildProjectDirectory)\obj\wiki\WikiDocsContent.g.cs</WikiDocsGeneratedFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WikiDocsGeneratedFile)" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jazor" Version="2.2.0-preview.1" />
    <PackageReference Include="ECMAScript.Vue" Version="2.2.0-preview.1" />
    <PackageReference Include="ECMAScript.Style" Version="2.2.0-preview.1" />
  </ItemGroup>
  <Target Name="ImportWikiDocsCatalog"
          BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildProjectDirectory)\..\..\docs\**\*.md;$(MSBuildProjectDirectory)\..\..\scripts\csharp\wiki-import-docs.cs"
          Outputs="$(WikiDocsGeneratedFile)">
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)\..\..\scripts\csharp\wiki-import-docs.cs&quot;" />
  </Target>
</Project>

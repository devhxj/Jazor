{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowArbitraryExtensions": true,
        "rootDirs": [".", "./.jolt"],
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["main.ts", "probe.tsx", "App.vue", "editors/**/*.vue"]
}

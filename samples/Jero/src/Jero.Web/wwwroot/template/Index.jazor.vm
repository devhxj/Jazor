@@using ECMAScript
@@using Npm.ElementPlus
@@using @Model.FrontendNamespace
@@using static ECMAScript.Vue
@{ var config = (CustomViewEngine)Model; }

<section class="crud-page">
    <h2>@Model.BusName</h2>
    @@if (Can("page")) {
        <div class="crud-filters">
@if (Model.HasLikeQuery) {
            @:<label>关键字 <input type="search" @@bind="Query.Value.keyword" /></label>
}
@foreach (var column in Model.QueryWhetherList) {
    var field = "Query.Value.@" + column.LowerPropertyName;
    if (column.NetType.TrimEnd('?') == "DateTime" && column.QueryType == "~") {
            @:<label>@column.ColumnComment 起始 <input type="date" value="@@RangeStart@(column.PropertyName).Value" @@onchange='@@(e => RangeStart@(column.PropertyName).Value = InputText(e))' /></label>
            @:<label>@column.ColumnComment 结束 <input type="date" value="@@RangeEnd@(column.PropertyName).Value" @@onchange='@@(e => RangeEnd@(column.PropertyName).Value = InputText(e))' /></label>
    } else if (config.IsFrontendSelector(column)) {
            @:<label>@column.ColumnComment <select @@bind:get='@@(ChoiceValue(@field))' @@bind:set='@@((string value) => @field = @(config.SelectorAssignment(column)))'>
            @:    <option value="">全部</option>
            @:    @@foreach (var item in Choices@(column.PropertyName).Value) { <option value="@@item.Value">@@item.Label</option> }
            @:</select></label>
    } else if (Model.FrontendType(column) == "bool?") {
            @:<label>@column.ColumnComment <select @@bind:get='@@(BoolText(@field))' @@bind:set='@@((string value) => @field = ParseBool(value))'><option value="">全部</option><option value="true">是</option><option value="false">否</option></select></label>
    } else if (column.EffectType == "DatePicker") {
            @:<label>@column.ColumnComment <input type="date" value='@@(@field)' @@onchange='@@(e => @field = InputText(e))' /></label>
    } else {
    var inputType = Model.FrontendType(column) == "double?" ? "number" : "text";
            @:<label>@column.ColumnComment <input type="@inputType" @@bind:get='@@(@field)' @@bind:set='@@(value => @field = value)' /></label>
    }
}
            <ElButton type="primary" @@onclick="Search">查询</ElButton>
            <ElButton @@onclick="Reset">重置</ElButton>
        </div>
    }
    <div class="crud-actions">
        @@if (Can("add")) { <ElButton type="primary" @@onclick="Add">新增</ElButton> }
        @@if (Can("batchDelete")) { <ElButton type="danger" disabled='@@(Selected.Value.Length == 0)' @@onclick="DeleteSelected">批量删除</ElButton> }
@if (config.ImportFieldList.Count > 0) {
        @:@@if (Can("export")) {
            @:<ElButton @@onclick='@@(() => Export("page"))'>导出本页</ElButton>
            @:<ElButton @@onclick='@@(() => Export("all"))'>导出全部</ElButton>
            @:<ElButton disabled='@@(Selected.Value.Length == 0)' @@onclick='@@(() => Export("selected"))'>导出选中</ElButton>
        @:}
        @:@@if (Can("import")) {
            @:<ElButton @@onclick="DownloadTemplate">下载导入模板</ElButton>
            @:<label>导入 <input type="file" accept=".xlsx,.xls" @@onchange="Import" /></label>
        @:}
}
    </div>
    @@if (Error.Value.Length > 0) { <p role="alert">@@Error.Value</p> }
    @@if (Loading.Value) { <p role="status">正在加载…</p> }
    <ElTable border="true" stripe="true" @@attributes='@@(new CrudTableData(Rows.Value) { onSortChange = Sort, onSelectionChange = Select, rowKey = RowIdentity })'>
        @@if (Can("batchDelete")@if (config.ImportFieldList.Count > 0) {<text> || Can("export")</text>}) { <ElTableColumn type="selection" width="46" /> }
@foreach (var column in config.TableField.Where(value => value.WhetherTable == "Y")) {
    if (Model.IsStatus(column)) {
        @:<ElTableColumn label="@column.ColumnComment" prop="@column.LowerPropertyName">
        @:    <template #default context="cell">@@{ var row = ((Cell)(object)cell).row; }
        @:        @@if (Can("setStatus")) { <ElButton link="true" @@onclick='@@(() => ToggleStatus(row))'>@@(row.status == 1 ? "停用" : "启用")</ElButton> }
        @:        else { <span>@@(row.status == 1 ? "启用" : "停用")</span> }
        @:    </template>
        @:</ElTableColumn>
    } else if (column.WhetherSortable == "Y") {
        @:<ElTableColumn label="@column.ColumnComment" prop="@column.LowerPropertyName" sortable="custom" ShowOverflowTooltip="true" />
    } else {
        @:<ElTableColumn label="@column.ColumnComment" prop="@column.LowerPropertyName" ShowOverflowTooltip="true" />
    }
}
        @@if (Can("update") || Can("delete")@if (config.HasCustomPrint) {<text> || Can("print")</text>}) {
            <ElTableColumn label="操作" width="145" fixed="right">
                <template #default context="cell">@@{ var row = ((Cell)(object)cell).row; }
                    @@if (Can("update")) { <ElButton link="true" type="primary" @@onclick='@@(() => Edit(row))'>编辑</ElButton> }
                    @@if (Can("delete")) { <ElButton link="true" type="danger" @@onclick='@@(() => Delete(row))'>删除</ElButton> }
@if (config.HasCustomPrint) {
                    @:@@if (Can("print")) { <ElButton link="true" type="primary" @@onclick='@@(() => PreviewPrint(row))'>打印</ElButton> }
}
                </template>
            </ElTableColumn>
        }
    </ElTable>
    <ElPagination CurrentPage="@@Page.Value" PageSize="@@PageSize.Value" Total="@@Total.Value" PageSizes="@@(new double[] { 10, 20, 50, 100 })"
                  Layout="total, sizes, prev, pager, next" @@oncurrent-change="ChangePage" @@onsize-change="ChangePageSize" />
    @@if (Editing.Value is not null) {
        <EditDialog Value="@@Editing.Value" IsUpdate="@@IsUpdate.Value" Close="@@CloseEditor" Saved="@@OnSaved" />
    }
@if (config.HasCustomPrint) {
    @:<ElDialog ModelValue="@@ShowPrinting.Value" Title="打印预览" Width="760px" @@onopened="RenderPrint" @@onupdate:modelValue="ChangePrinting">
        @:<div id="@@PrintContainer"></div>
        @:<template #footer><ElButton type="primary" @@onclick="Print">打印</ElButton></template>
    @:</ElDialog>
}
</section>

<style>
    .crud-page { display: grid; gap: 16px; padding: 16px; }
    .crud-filters, .crud-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .crud-filters label { display: grid; gap: 4px; }
    .crud-filters input, .crud-filters select { min-height: 30px; }
</style>

@@code {
    private const string Api = "/api/@Model.LowerClassName/";
    private const string Resource = "@(Model.LowerClassName):";

    private readonly IVueRef<Row[]> Rows = ShallowRef(System.Array.Empty<Row>());
    private readonly IVueRef<Row[]> Selected = ShallowRef(System.Array.Empty<Row>());
    private readonly IVueRef<PageRequest> Query = Ref(new PageRequest());
    private readonly IVueRef<Row?> Editing = ShallowRef<Row?>(null);
    private readonly IVueRef<bool> IsUpdate = Ref(false);
    private readonly IVueRef<double> Page = Ref(1d);
    private readonly IVueRef<double> PageSize = Ref(20d);
    private readonly IVueRef<double> Total = Ref(0d);
    private readonly IVueRef<bool> Loading = Ref(false);
    private readonly IVueRef<string> Error = Ref("");
    private int request;
@if (config.HasCustomPrint) {
    @:private const string PrintContainer = "jero-crud-print-@config.LowerClassName";
    @:private readonly IVueRef<bool> ShowPrinting = Ref(false);
    @:private PrintTemplate? printTemplate;
    @:private Row? printRow;
}
@foreach (var column in config.QueryWhetherList.Where(column => column.NetType.TrimEnd('?') == "DateTime" && column.QueryType == "~")) {
    @:private readonly IVueRef<string> RangeStart@(column.PropertyName) = Ref("");
    @:private readonly IVueRef<string> RangeEnd@(column.PropertyName) = Ref("");
}
@foreach (var column in config.QueryWhetherList.Where(config.IsFrontendSelector)) {
    @:private readonly IVueRef<Choice[]> Choices@(column.PropertyName) = ShallowRef(System.Array.Empty<Choice>());
}

    [Setup]
    private void SetupPage() => OnMounted(() => { LoadChoices(); Load(); });
    private static bool Can(string action) => CrudPermissions.Has(Resource + action);

    private void LoadChoices()
    {
@foreach (var column in config.QueryWhetherList.Where(column => config.IsFrontendSelector(column) && column.EffectType is not ("ForeignKey" or "ApiTreeSelector"))) {
    var shape = column.EffectType == "EnumSelector" ? "EnumChoices" : column.EffectType == "ConstSelector" ? "ConstChoices" : "FlatChoices";
        @:CrudApi.Get(@(config.SourceString(config.SelectorEndpoint(column)))).Then(outcome =>
        @:{
            @:if (!Failed(outcome)) Choices@(column.PropertyName).Value = @(shape)(outcome.Data);
        @:});
}
@if (config.QueryWhetherList.Any(column => column.EffectType is "ForeignKey" or "ApiTreeSelector")) {
        @:CrudApi.Post(Api + "dropdownData", new DropdownRequest(true)).Then(outcome =>
        @:{
            @:if (Failed(outcome) || outcome.Data is null) return;
    foreach (var column in config.QueryWhetherList.Where(column => column.EffectType is "ForeignKey" or "ApiTreeSelector")) {
            @:Choices@(column.PropertyName).Value = FlatChoices(Reflect.Get(outcome.Data, "@column.LowerPropertyName"));
    }
        @:});
}
    }

    private static string ChoiceValue(object? value) => value is null ? "" : Global.StringValue(value);
    private static Choice[] EnumChoices(object? source) =>
        ((EnumChoice[]?)source ?? []).Select(item => new Choice(ChoiceValue(item.value), item.describe)).ToArray();
    private static Choice[] ConstChoices(object? source) =>
        ((ConstChoice[]?)source ?? []).Select(item => new Choice(ChoiceValue(item.code), item.name)).ToArray();
    private static Choice[] FlatChoices(object? source)
    {
        var items = new System.Collections.Generic.List<Choice>();
        CollectChoices((DropdownChoice[]?)source ?? [], "", items);
        return items.ToArray();
    }
    private static void CollectChoices(DropdownChoice[] source, string parent, System.Collections.Generic.List<Choice> result)
    {
        foreach (var item in source)
        {
            var label = parent + (item.label ?? "");
            result.Add(new Choice(ChoiceValue(item.value), label));
            if (item.children is not null) CollectChoices(item.children, label + " / ", result);
        }
    }

    private void Load()
    {
        if (!Can("page")) return;
        var revision = ++request;
        Error.Value = "";
        Loading.Value = true;
        var query = Query.Value;
        query.page = Page.Value;
        query.pageSize = PageSize.Value;
@foreach (var column in config.QueryWhetherList.Where(column => column.NetType.TrimEnd('?') == "DateTime" && column.QueryType == "~")) {
        @:query.@(column.LowerPropertyName)Range = RangeStart@(column.PropertyName).Value.Length > 0 || RangeEnd@(column.PropertyName).Value.Length > 0
        @:    ? [DateValue(RangeStart@(column.PropertyName).Value, " 00:00:00"), DateValue(RangeEnd@(column.PropertyName).Value, " 23:59:59")] : null;
}
        CrudApi.Post(Api + "page", query).Then(outcome =>
        {
            if (revision != request) return;
            Loading.Value = false;
            if (Failed(outcome)) return;
            var data = (PageData?)outcome.Data;
            Rows.Value = data?.items ?? [];
            Total.Value = data?.total ?? 0;
            Selected.Value = [];
        });
    }

    private static string? DateValue(string value, string time) => value.Length == 0 ? null : value + time;
    private static string InputText(EventRef e) => ((HTMLInputElement)e.Target!).Value;
    private static string BoolText(bool? value) => value == null ? "" : value == true ? "true" : "false";
    private static bool? ParseBool(string value) => value == "" ? null : value == "true";
    private void Search() { Page.Value = 1; Load(); }
    private void Reset()
    {
        Query.Value = new PageRequest();
@foreach (var column in config.QueryWhetherList.Where(column => column.NetType.TrimEnd('?') == "DateTime" && column.QueryType == "~")) {
        @:RangeStart@(column.PropertyName).Value = RangeEnd@(column.PropertyName).Value = "";
}
        Search();
    }
    private void ChangePage(double page) { Page.Value = page; Load(); }
    private void ChangePageSize(double size) { PageSize.Value = size; Search(); }
    private void Select(Row[] rows) => Selected.Value = rows;
    private void Sort(SortChange change)
    {
        Query.Value.field = change.prop ?? "";
        Query.Value.order = change.order ?? "descending";
        Search();
    }

    private void Add()
    {
        IsUpdate.Value = false;
        Editing.Value = new Row
        {
@foreach (var column in Model.AddUpdateFieldList) {
    var defaultValue = Model.FrontendDefault(column);
    if (defaultValue != null) {
            @:@@@(column.LowerPropertyName) = @defaultValue,
    }
}
        };
    }

    private void Edit(Row row)
    {
        var keys = new URLSearchParams();
@foreach (var column in Model.PrimaryKeyFieldList) {
        @:keys.Set("@column.LowerPropertyName", Global.StringValue(row.@@@(column.LowerPropertyName)));
}
        CrudApi.Get(Api + "detail?" + keys.ToString()).Then(outcome =>
        {
            if (Failed(outcome)) return;
            IsUpdate.Value = true;
            Editing.Value = (Row?)outcome.Data;
        });
    }

    private void CloseEditor() => Editing.Value = null;
    private void OnSaved() { CloseEditor(); Load(); }

    private static string RowIdentity(Row row) => JSON.Stringify(Key(row)) ?? "";
@{
    var keyArguments = Model.PrimaryKeysFormat(", ", "row.@{0}", true);
}
    private static RowKey Key(Row row) => new RowKey(@keyArguments);

@if (config.ImportFieldList.Count > 0) {
    var primaryKey = config.PrimaryKeyFieldList[0].LowerPropertyName;
    @:private void Export(string scope)
    @:{
        @:var query = Query.Value with { page = Page.Value, pageSize = PageSize.Value };
        @:if (scope != "page")
        @:    query = query with { page = 1, pageSize = 99999999 };
        @:if (scope == "selected")
        @:    query = query with { selectKeyList = Selected.Value.Select(row => row.@@@(primaryKey)).ToArray() };
        @:FileTransfer.Download(Api + "export", "导出记录.xlsx", query).Then(TransferFinished);
    @:}
    @:
    @:private void DownloadTemplate() => FileTransfer.Download(Api + "import", "导入模板.xlsx").Then(TransferFinished);
    @:
    @:private void Import(EventRef e)
    @:{
        @:var file = FileTransfer.SelectedFile(e);
        @:if (file is null) return;
        @:((HTMLInputElement)e.Target!).Value = "";
        @:FileTransfer.Upload(Api + "import", file, "导入结果.xlsx").Then(result =>
        @:{
            @:TransferFinished(result);
            @:if (result.Ok) Load();
        @:});
    @:}
    @:
    @:private void TransferFinished(TransferResult result)
    @:{
        @:if (!result.Ok) Error.Value = result.Error ?? "文件请求失败";
    @:}
}

@if (config.HasCustomPrint) {
    @:private void PreviewPrint(Row row)
    @:{
        @:var name = @(config.SourceString(config.PrintName));
        @:CrudApi.Get("/api/sysPrint/print/" + Global.EncodeURIComponent(name)).Then(outcome =>
        @:{
            @:if (Failed(outcome)) return;
            @:var templateText = outcome.Data is null ? null : (string?)Reflect.Get(outcome.Data, "template");
            @:var template = templateText is null ? null : JSON.Parse(templateText);
            @:if (template is null) { Error.Value = "打印模板为空"; return; }
            @:PrintExports.Load().Then(module =>
            @:{
                @:module.DisableAutoConnect();
                @:printTemplate = (PrintTemplate)Reflect.Construct(module.Default.hiprint.PrintTemplate, new object[] { new PrintOptions(template) });
                @:printRow = row with { };
                @:Reflect.Set(printRow, "printDate", new Date().ToLocaleString());
                @:ShowPrinting.Value = true;
            @:}, error => Error.Value = error.Message);
        @:});
    @:}
    @:
    @:private void RenderPrint()
    @:{
        @:if (printTemplate is null || printRow is null) return;
        @:var container = Global.Document.GetElementById(PrintContainer);
        @:if (container is null) return;
        @:container.TextContent = "";
        @:var rendered = printTemplate.GetHtml(printRow);
        @:if (rendered is null) return;
        @:var node = Reflect.Get(rendered, "0") as Node ?? rendered as Node;
        @:if (node is not null) container.AppendChild(node);
    @:}
    @:
    @:private void Print()
    @:{
        @:if (printTemplate is not null && printRow is not null) printTemplate.Print(printRow);
    @:}
    @:
    @:private void ChangePrinting(bool visible) => ShowPrinting.Value = visible;
}

    private void Delete(Row row)
    {
        if (Global.Window.Confirm("确定删除这条记录吗？"))
            CrudApi.Post(Api + "delete", Key(row)).Then(OnChanged);
    }

    private void DeleteSelected()
    {
        var selected = Selected.Value;
        if (selected.Length == 0 || !Global.Window.Confirm("确定删除所选记录吗？")) return;
        CrudApi.Post(Api + "batchDelete", selected.Select(Key).ToArray()).Then(OnChanged);
    }

@if (Model.HasSetStatus) {
    @:private void ToggleStatus(Row row)
    @:{
        @:var input = Key(row);
        @:Reflect.Set(input, "status", row.status == 1 ? 2 : 1);
        @:CrudApi.Post(Api + "setStatus", input).Then(OnChanged);
    @:}
}

    private void OnChanged(CrudOutcome outcome)
    {
        if (!Failed(outcome)) Load();
    }

    private bool Failed(CrudOutcome outcome)
    {
        if (outcome.Ok) return false;
        Error.Value = outcome.Error ?? "请求失败";
        return true;
    }
}

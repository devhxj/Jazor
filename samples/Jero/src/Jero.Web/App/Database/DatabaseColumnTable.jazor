@using Npm.ElementPlus
@using Jero.Web.App.Database
@using Jero.Web.App.Components

<ElTable @attributes="@(new TableData<DatabaseColumnView>(Rows))" border="true" stripe="true" RowKey="dbColumnName" EmptyText="暂无字段">
        <ElTableColumn type="index" label="序号" width="70" align="center" />
        <ElTableColumn prop="dbColumnName" label="列名" MinWidth="160" ShowOverflowTooltip="true" />
        <ElTableColumn prop="propertyName" label="属性名" MinWidth="150" ShowOverflowTooltip="true" />
        <ElTableColumn prop="dataType" label="类型" MinWidth="110" />
        <ElTableColumn label="长度" width="90" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<DatabaseColumnView>)(object)cell).row; }@(DisplayLength(row))</template>
        </ElTableColumn>
        <ElTableColumn label="主键" width="82" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<DatabaseColumnView>)(object)cell).row; }
                <ElTag @attributes="@(new TableTagProps(row.isPrimarykey ? "success" : "info"))">@(row.isPrimarykey ? "是" : "否")</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn label="自增" width="82" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<DatabaseColumnView>)(object)cell).row; }
                <ElTag @attributes="@(new TableTagProps(row.isIdentity ? "success" : "info"))">@(row.isIdentity ? "是" : "否")</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn label="可空" width="82" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<DatabaseColumnView>)(object)cell).row; }
                <ElTag @attributes="@(new TableTagProps(row.isNullable ? "success" : "info"))">@(row.isNullable ? "是" : "否")</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn prop="defaultValue" label="默认值" MinWidth="120" ShowOverflowTooltip="true" />
        <ElTableColumn prop="columnDescription" label="描述" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn label="操作" width="264" align="center" fixed="right">
            <template #default context="cell">@{ var row = ((TableSlot<DatabaseColumnView>)(object)cell).row; }
                <ElPopconfirm title='@("确定将列【" + row.dbColumnName + "】上移吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(() => MoveUp(row.dbColumnName))">
                    <template #reference>
                        <ElButton link="true" type="primary" disabled='@(((TableSlot<DatabaseColumnView>)(object)cell).Index == 0 || Busy)' loading='@(BusyKey == "move-column:" + row.dbColumnName)'>上移</ElButton>
                    </template>
                </ElPopconfirm>
                <ElPopconfirm title='@("确定将列【" + row.dbColumnName + "】下移吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(() => MoveDown(row.dbColumnName))">
                    <template #reference>
                        <ElButton link="true" type="primary" disabled='@(((TableSlot<DatabaseColumnView>)(object)cell).Index == Rows.Length - 1 || Busy)' loading='@(BusyKey == "move-column:" + row.dbColumnName)'>下移</ElButton>
                    </template>
                </ElPopconfirm>
                <ElButton link="true" type="primary" disabled='@(Busy)' @onclick="@(() => Edit(row.dbColumnName))">编辑</ElButton>
                <ElPopconfirm title='@("确定删除数据列【" + row.dbColumnName + "】吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(() => Delete(row.dbColumnName))">
                    <template #reference>
                        <ElButton link="true" type="danger" disabled='@(Busy)' loading='@(BusyKey == "delete-column:" + row.dbColumnName)'>删除</ElButton>
                    </template>
                </ElPopconfirm>
            </template>
        </ElTableColumn>
    </ElTable>

@code {
    [Parameter] public DatabaseColumnView[] Rows { get; set; } = [];
    [Parameter] public bool Busy { get; set; } = default!;
    [Parameter] public string BusyKey { get; set; } = default!;
    [Parameter] public Action<string> MoveUp { get; set; } = default!;
    [Parameter] public Action<string> MoveDown { get; set; } = default!;
    [Parameter] public Action<string> Edit { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;

    private static string DisplayLength(DatabaseColumnView row) => row.length <= 0 ? "-" : row.decimalDigits > 0 ? row.length + "," + row.decimalDigits : row.length.ToString();
}

@using Npm.ElementPlus
@using Npm.Jero.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.WechatUser

<ElTable @attributes='@(new TableData<WechatUserView>(State.rows))'
                     border='@(true)'
                     stripe='@(true)'
                     RowKey="id"
                     EmptyText="暂无三方账号">
            <ElTableColumn type="index" label="序号" width='@(70)' align="center" />
            <ElTableColumn prop="openId" label="OpenId" MinWidth='@(220)' ShowOverflowTooltip='@(true)' />
            <ElTableColumn label="UnionId" MinWidth='@(220)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    @(State.DisplayRowValueForView(cell, "unionId"))
                </template>
            </ElTableColumn>
            <ElTableColumn label="平台类型" MinWidth='@(120)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    <ElTag @attributes='@(new TableTagProps(State.PlatformTag(cell)))'>@(State.PlatformLabel(cell))</ElTag>
                </template>
            </ElTableColumn>
            <ElTableColumn label="昵称" MinWidth='@(140)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    @(State.DisplayRowValueForView(cell, "nickName"))
                </template>
            </ElTableColumn>
            <ElTableColumn label="头像" width='@(90)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    <ElAvatar size='@(32)' src='@(State.AvatarSourceForView(cell))' />
                </template>
            </ElTableColumn>
            <ElTableColumn label="手机号码" MinWidth='@(140)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    @(State.DisplayRowValueForView(cell, "mobile"))
                </template>
            </ElTableColumn>
            <ElTableColumn label="性别" width='@(90)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    <ElTag @attributes='@(new TableTagProps(State.GenderTagForView(cell)))'>@(State.GenderTextForView(cell))</ElTag>
                </template>
            </ElTableColumn>
            <ElTableColumn label="城市" MinWidth='@(120)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    @(State.DisplayRowValueForView(cell, "city"))
                </template>
            </ElTableColumn>
            <ElTableColumn label="省份" MinWidth='@(120)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    @(State.DisplayRowValueForView(cell, "province"))
                </template>
            </ElTableColumn>
            <ElTableColumn label="国家" MinWidth='@(120)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    @(State.DisplayRowValueForView(cell, "country"))
                </template>
            </ElTableColumn>
            <ElTableColumn label="修改记录" width='@(110)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                    <ElButton link='@(true)'
                              type="primary"
                              @onclick='@(_ => State.OpenAudit(cell))'>查看</ElButton>
                </template>
            </ElTableColumn>
            @if (State.HasActionColumn) {
                <ElTableColumn label="操作" width='@(180)' align="center" fixed="right">
                    <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<WechatUserView>)(object)scope).row; }
                        @if (State.CanEdit) {
                            <ElButton link='@(true)'
                                      type="primary"
                                      @onclick='@(_ => State.OpenEdit(cell))'>编辑</ElButton>
                        }
                        @if (State.CanDelete) {
                            <ElPopconfirm title='@("确定删除微信账号【" + State.DisplayRowValueForView(cell, "nickName") + "】吗？")'
                                          ConfirmButtonText="确定"
                                          CancelButtonText="取消"
                                          @onconfirm='@(_ => State.Delete(cell))'>
                                <template #reference>
                                    <ElButton link='@(true)'
                                              type="danger"
                                              loading='@(State.IsDeletingRow(cell))'
                                              disabled='@(State.deletingId.Length > 0)'>删除</ElButton>
                                </template>
                            </ElPopconfirm>
                        }
                    </template>
                </ElTableColumn>
            }
        </ElTable>



@code {
    [Parameter] public IWechatUserContentState State { get; set; } = default!;
}

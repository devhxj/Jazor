@using Npm.ElementPlus
@using Npm.Jero.ElementPlus
@using Jero.Web.App.OnlineUser
@using Jero.Web.App.Components

<ProjectSelect ModelValue="@(Value)" Placeholder="请选择租户" Loading="@Loading" Filterable="true" Clearable="true" @attributes="@(new ModelUpdate<object?>(Update))">
    @foreach (var option in Options)
    {
        <ElOption @key="option.value" Value="@option.value" Label='@(string.IsNullOrEmpty(option.host) ? option.label : option.label + " (" + option.host + ")")' />
    }
</ProjectSelect>

@code {
    [Parameter] public OnlineUserTenantOption[] Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = default!;
    [Parameter] public Action<string> Change { get; set; } = default!;
    [Parameter] public bool Loading { get; set; } = default!;

    private void Update(object? value) => Change(value as string ?? "");
}

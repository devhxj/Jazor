@using static ECMAScript.Vue
@using Jero.Web.App.Auth
@using Jero.Web.App.Components
@using Jero.Web.App.Auth
@using App.Components

<main style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:#f5f7fa;box-sizing:border-box;">
    <section style="width:min(100%,440px);">
        <LoginCard Title="验证码登录">
            <p style="margin:0 0 20px;color:#909399;line-height:1.6;">使用手机短信验证码登录 Jero。</p>

            <div style='@(Error.Value is null ? "display:none" : "margin-bottom:16px")'>
                <ElAlert Type="error" Title="@(Error.Value ?? "")" ShowIcon="true" Closable="true" @onclose="DismissError" />
            </div>
            <div style='@(Message.Value is null ? "display:none" : "margin-bottom:16px")'>
                <ElAlert Type="success" Title="@(Message.Value ?? "")" ShowIcon="true" />
            </div>

            <ElForm LabelWidth="78px">
                <ElFormItem Label="租户">
                    <AuthOptionSelect Value="@TenantId.Value" Options="@(Tenants.Value.Select(option => new ConfigurationOption(option.value, option.label)).ToArray())" Placeholder="请选择租户" Loading="@LoadingTenants.Value" Disabled="@SigningIn.Value" Change="@SetTenantId" />
                </ElFormItem>
                <ElFormItem Label="手机号">
                    <ElInput ModelValue="@Phone.Value"
                             @onupdate:modelValue="SetPhone"
                             Placeholder="请输入 11 位手机号码"
                             Maxlength="11"
                             Clearable="true"
                             Disabled="@SigningIn.Value" />
                </ElFormItem>
                <ElFormItem Label="验证码">
                    <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;width:100%;">
                        <ElInput ModelValue="@SmsCode.Value"
                                 @onupdate:modelValue="SetSmsCode"
                                 Placeholder="请输入 6 位验证码"
                                 Maxlength="6"
                                 Clearable="true"
                                 Disabled="@SigningIn.Value" />
                        <ElButton @onclick="SendCode" Loading="@SendingCode.Value" Disabled="@(SigningIn.Value || SendingCode.Value)">发送验证码</ElButton>
                    </div>
                </ElFormItem>
            </ElForm>

            <div style="display:grid;gap:12px;">
                <ElButton Type="primary" @onclick="Submit" Loading="@SigningIn.Value" Disabled="@(LoadingTenants.Value || SigningIn.Value)">登 录</ElButton>
                <ElButton @onclick="BackToLogin" Disabled="@SigningIn.Value">返回账号登录</ElButton>
            </div>
        </LoginCard>
    </section>
</main>

@code {
    private readonly IVueRef<string> TenantId = Ref<string>("");
    private readonly IVueRef<string> Phone = Ref<string>("");
    private readonly IVueRef<string> SmsCode = Ref<string>("");
    private readonly IVueRef<bool> LoadingTenants = Ref<bool>(true);
    private readonly IVueRef<bool> SendingCode = Ref<bool>(false);
    private readonly IVueRef<bool> SigningIn = Ref<bool>(false);
    private readonly IVueRef<string?> Error = Ref<string?>(null);
    private readonly IVueRef<string?> Message = Ref<string?>(null);
    private readonly IVueRef<AuthTenantOption[]> Tenants = Ref<AuthTenantOption[]>([]);

    private ECMAScript.Router router = default!;

    private void BackToLogin() => router.Push("/login");

    [Setup]
    private void Configure()
    {
        router = ECMAScript.VueRoute.UseRouter();
        OnMounted(LoadTenants);
    }

    private void LoadTenants()
    {
        PublicAuth.TenantList().Then(result =>
        {
            if (!result.Ok)
            {
                Error.Value = result.Error ?? "加载租户失败。";
                return;
            }
            Tenants.Value = PublicAuth.ReadTenants(result.Data);
            if (TenantId.Value.Length == 0 && Tenants.Value.Length > 0)
                TenantId.Value = Tenants.Value[0].value;
        }).Catch(_ => Error.Value = "加载租户失败，请检查网络后重试。").Finally(() => LoadingTenants.Value = false);
    }

    private void SendCode()
    {
        Error.Value = null;
        Message.Value = null;
        if (Phone.Value.Length != 11)
        {
            Error.Value = "请输入 11 位手机号码。";
            return;
        }
        SendingCode.Value = true;
        PublicAuth.SendSms(Phone.Value).Then(result =>
        {
            if (result.Ok)
                Message.Value = "短信验证码已发送。";
            else
                Error.Value = result.Error ?? "短信验证码发送失败。";
        }).Catch(_ => Error.Value = "短信验证码发送失败，请检查网络后重试。").Finally(() => SendingCode.Value = false);
    }

    private void Submit()
    {
        Message.Value = null;
        Error.Value = TenantId.Value.Length == 0 ? "请选择租户。"
            : Phone.Value.Length != 11 ? "请输入 11 位手机号码。"
            : SmsCode.Value.Length != 6 ? "请输入 6 位短信验证码。" : null;
        if (Error.Value is not null)
            return;

        SigningIn.Value = true;
        PublicAuth.LoginPhone(Phone.Value, SmsCode.Value, TenantId.Value).Then(result =>
        {
            if (!result.Ok)
            {
                Error.Value = result.Error ?? "验证码登录失败。";
                return ECMAScript.Promise.Resolve();
            }
            Message.Value = "登录成功，正在进入系统…";
            return SignedIn(result.Data);
        }).Catch(_ => Error.Value = "验证码登录请求失败，请检查网络后重试。").Finally(() => SigningIn.Value = false);
    }

    private void DismissError() => Error.Value = null;
    private ECMAScript.IPromise<ECMAScript.RouteNavigationResult?> SignedIn(AuthResponseData? data)
    {
        return AuthSession.CompleteSignIn(router, data?.accessToken, data?.refreshToken, data?.homepage);
    }
    private void SetTenantId(string? value) => TenantId.Value = value ?? "";
    private void SetPhone(string? value) => Phone.Value = value ?? "";
    private void SetSmsCode(string? value) => SmsCode.Value = value ?? "";
}

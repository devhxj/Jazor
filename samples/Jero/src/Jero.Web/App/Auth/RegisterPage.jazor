@using static ECMAScript.Vue
@using Jero.Web.App.Auth
@using Jero.Web.App.Components
@using Jero.Web.App.Auth
@using App.Components

<main style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:#f5f7fa;box-sizing:border-box;">
    <section style="width:min(100%,520px);">
        <LoginCard Title="创建账号">
            <p style="margin:0 0 20px;color:#909399;line-height:1.6;">展示当前租户的注册配置；服务端契约修复前不能提交。</p>

            <div style='@(Error.Value is null ? "display:none" : "margin-bottom:16px")'>
                <ElAlert Type="error" Title="@(Error.Value ?? "")" ShowIcon="true" Closable="true" @onclose="DismissError" />
            </div>
            <div style="margin-bottom:16px;">
                <ElAlert Type="warning" Title="@RegistrationUnavailableReason" ShowIcon="true" Closable="false" />
            </div>
            <div style='@(RegistrationEnabled.Value || Loading.Value ? "display:none" : "margin-bottom:16px")'>
                <ElAlert Type="warning" Title="当前租户未启用用户注册。" ShowIcon="true" Closable="false" />
            </div>

            <ElForm LabelWidth="92px">
                <ElFormItem Label="真实姓名">
                    <ElInput ModelValue="@RealName.Value" @onupdate:modelValue="SetRealName" Placeholder="请输入真实姓名" Clearable="true" Disabled="true" />
                </ElFormItem>
                <ElFormItem Label="账号">
                    <ElInput ModelValue="@Account.Value" @onupdate:modelValue="SetAccount" Placeholder="至少 6 个字符" Clearable="true" Disabled="true" />
                </ElFormItem>
                <ElFormItem Label="手机号">
                    <ElInput ModelValue="@Phone.Value" @onupdate:modelValue="SetPhone" Placeholder="请输入 11 位手机号码" Maxlength="11" Clearable="true" Disabled="true" />
                </ElFormItem>
                <ElFormItem Label="注册方案">
                    <AuthOptionSelect Value="@WayId.Value" Options="@(RegistrationWays.Value.Select(option => new ConfigurationOption(option.value, option.label)).ToArray())" Placeholder="请选择注册方案" Disabled="true" Change="@SetWayId" />
                </ElFormItem>
                <ElFormItem Label="密码">
                    <ElInput ModelValue="@Password.Value" @onupdate:modelValue="SetPassword" Type="password" ShowPassword="true" Placeholder="请输入密码" Disabled="true" />
                </ElFormItem>
                <ElFormItem Label="确认密码">
                    <ElInput ModelValue="@ConfirmPassword.Value" @onupdate:modelValue="SetConfirmPassword" Type="password" ShowPassword="true" Placeholder="请再次输入密码" Disabled="true" />
                </ElFormItem>
                @if (CaptchaEnabled.Value)
                {
                    <ElFormItem Label="验证码">
                        <ElInput ModelValue="@CaptchaCode.Value" @onupdate:modelValue="SetCaptchaCode" Placeholder="服务端仍强制校验验证码" Disabled="true" />
                    </ElFormItem>
                }
            </ElForm>

            <div style="display:grid;gap:12px;">
                <ElButton Type="primary" Disabled="true">注册暂不可用</ElButton>
                <ElButton @onclick="BackToLogin">已有账号，返回登录</ElButton>
            </div>
        </LoginCard>
    </section>
</main>

@code {
    private readonly IVueRef<string> RealName = Ref<string>("");
    private readonly IVueRef<string> Account = Ref<string>("");
    private readonly IVueRef<string> Phone = Ref<string>("");
    private readonly IVueRef<string> Password = Ref<string>("");
    private readonly IVueRef<string> ConfirmPassword = Ref<string>("");
    private readonly IVueRef<string> WayId = Ref<string>("");
    private readonly IVueRef<string> CaptchaCode = Ref<string>("");
    private readonly IVueRef<bool> RegistrationEnabled = Ref<bool>(false);
    private readonly IVueRef<bool> CaptchaEnabled = Ref<bool>(true);
    private readonly IVueRef<bool> Loading = Ref<bool>(true);
    private readonly IVueRef<string?> Error = Ref<string?>(null);
    private readonly IVueRef<AuthRegistrationWayOption[]> RegistrationWays = Ref<AuthRegistrationWayOption[]>([]);

    private ECMAScript.Router router = default!;

    private void BackToLogin() => router.Push("/login");

    private const string RegistrationUnavailableReason = "注册端点在验证码关闭时仍强制校验验证码，且非空密码存储协议未闭环，注册暂不可用。";

    [Setup]
    private void Configure()
    {
        router = ECMAScript.VueRoute.UseRouter();
        OnMounted(LoadConfiguration);
    }

    private void LoadConfiguration()
    {
        PublicAuth.SystemInfo().Then(result =>
        {
            if (!result.Ok)
            {
                Error.Value = result.Error ?? "加载注册配置失败。";
                return;
            }
            RegistrationEnabled.Value = PublicAuth.ReadRegistrationEnabled(result.Data);
            CaptchaEnabled.Value = PublicAuth.ReadCaptchaEnabled(result.Data);
            RegistrationWays.Value = PublicAuth.ReadRegistrationWays(result.Data);
            WayId.Value = PublicAuth.ReadDefaultRegistrationWayId(result.Data);
            if (WayId.Value.Length == 0 && RegistrationWays.Value.Length > 0)
                WayId.Value = RegistrationWays.Value[0].value;
        }).Catch(_ => Error.Value = "加载注册配置失败，请检查网络后重试。").Finally(() => Loading.Value = false);
    }

    private void DismissError() => Error.Value = null;
    private void SetRealName(string? value) => RealName.Value = value ?? "";
    private void SetAccount(string? value) => Account.Value = value ?? "";
    private void SetPhone(string? value) => Phone.Value = value ?? "";
    private void SetPassword(string? value) => Password.Value = value ?? "";
    private void SetConfirmPassword(string? value) => ConfirmPassword.Value = value ?? "";
    private void SetWayId(string? value) => WayId.Value = value ?? "";
    private void SetCaptchaCode(string? value) => CaptchaCode.Value = value ?? "";
}

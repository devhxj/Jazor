@using Npm.ElementPlus
@using Npm.Jero.ElementPlus
@using Jero.Web.App.Components

<ProjectSelect ModelValue="@(Value)" Placeholder="@Placeholder" Filterable="true" Clearable="@Clearable"
          AllowCreate="@AllowCreate" DefaultFirstOption="@DefaultFirstOption" Loading="@Loading" Disabled="@Disabled"
          @attributes="@(new ModelUpdate<string>(Update))">
    @foreach (var option in Options)
    {
        <ElOption @key="option.value" Label="@option.label" Value="@option.value" />
    }
</ProjectSelect>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public ConfigurationOption[] Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool AllowCreate { get; set; }
    [Parameter] public bool DefaultFirstOption { get; set; }
    [Parameter] public Action<string>? Change { get; set; }

    private void Update(string? value) => Change?.Invoke(value ?? "");
}

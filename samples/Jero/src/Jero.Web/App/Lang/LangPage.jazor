@using Npm.ElementPlus
@using App.Components
@using App.Logs
@using App.Auth
@using Jero.Web.App.Components
@using Jero.Web.App.Lang

<ElCard Header="语言管理" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        多语言管理，支持查询、分页排序、字典展示以及新增、编辑、删除。
    </p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            <ElFormItem Label="关键字">
                <ElInput ModelValue="@Keyword"
                         @onupdate:modelValue="SetKeyword"
                         Placeholder="名称、代码、ISO、URL 代码"
                         Clearable="true" />
            </ElFormItem>
            @if (ShowAdvanced)
            {
                <ElFormItem Label="语言名称">
                    <ElInput ModelValue="@Name"
                             @onupdate:modelValue="SetName"
                             Placeholder="请输入语言名称"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="语言代码">
                    <ElInput ModelValue="@QueryCode"
                             @onupdate:modelValue="SetQueryCode"
                             Placeholder="请输入语言代码"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="ISO 语言代码">
                    <ElInput ModelValue="@IsoCode"
                             @onupdate:modelValue="SetIsoCode"
                             Placeholder="请输入 ISO 语言代码"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="URL 语言代码">
                    <ElInput ModelValue="@UrlCode"
                             @onupdate:modelValue="SetUrlCode"
                             Placeholder="请输入 URL 语言代码"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="是否启用">
                    <div style="width:150px">
                        <AuthOptionSelect Value="@ActiveFilter" Options="@ActiveOptions" Placeholder="全部" Clearable="true" Change="@ActiveFilterChanged" />
                    </div>
                </ElFormItem>
            }
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
                <ElButton @onclick="ToggleAdvanced">
                    @(ShowAdvanced ? "收起高级查询" : "展开高级查询")
                </ElButton>
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;">
            <div>
                @if (CanAdd)
                {
                    <ElButton Type="primary" @onclick="OpenCreate">新增</ElButton>
                }
            </div>
            <ElButton @onclick="Refresh" Loading="@(Loading || OptionsLoading)">刷新</ElButton>
        </div>

        @if (Loading)
        {
            <ElText>正在加载语言…</ElText>
        }

        <div class="jero-list-scroll">
            <LangTable Rows="@Rows" CanEdit="@CanEdit" CanDelete="@CanDelete"
                       OnOpenAudit="@OpenAudit" OnOpenEdit="@OpenEdit" OnDelete="@Delete" OnSort="@Sort" />
        </div>

        <LogPagination CurrentPage="@CurrentPage" PageSize="@PageSize" Total="@Total"
                       ChangePage="@ChangePage" ChangePageSize="@ChangePageSize" />
    </ElCard>
</ElCard>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          Width="860px"
          Draggable="true"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="110px">
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;">
            <ElFormItem Label="语言名称">
                <ElInput ModelValue="@EditName"
                         @onupdate:modelValue="SetEditName"
                         Placeholder="请输入语言名称"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="语言代码">
                <ElInput ModelValue="@EditCode"
                         @onupdate:modelValue="SetEditCode"
                         Placeholder="请输入语言代码"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="ISO 语言代码">
                <ElInput ModelValue="@EditIsoCode"
                         @onupdate:modelValue="SetEditIsoCode"
                         Placeholder="请输入 ISO 语言代码"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="URL 语言代码">
                <ElInput ModelValue="@EditUrlCode"
                         @onupdate:modelValue="SetEditUrlCode"
                         Placeholder="请输入 URL 语言代码"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="书写方向">
                <LangNumberSelect Value="@EditDirection" Options="@DirectionOptions" Placeholder="请选择书写方向" Disabled="@OptionsLoading" OnChange="@SetEditDirection" />
            </ElFormItem>
            <ElFormItem Label="每周起始日">
                <LangNumberSelect Value="@EditWeekStart" Options="@WeekOptions" Placeholder="请选择每周起始日" Disabled="@OptionsLoading" OnChange="@SetEditWeekStart" />
            </ElFormItem>
            <ElFormItem Label="日期格式">
                <ElInput ModelValue="@EditDateFormat"
                         @onupdate:modelValue="SetEditDateFormat"
                         Placeholder="请输入日期格式"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="时间格式">
                <ElInput ModelValue="@EditTimeFormat"
                         @onupdate:modelValue="SetEditTimeFormat"
                         Placeholder="请输入时间格式"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="分组符号">
                <ElInput ModelValue="@EditGrouping"
                         @onupdate:modelValue="SetEditGrouping"
                         Placeholder="例如 [3,0]"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="小数点符号">
                <ElInput ModelValue="@EditDecimalPoint"
                         @onupdate:modelValue="SetEditDecimalPoint"
                         Placeholder="请输入小数点符号"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="千分位分隔符">
                <ElInput ModelValue="@EditThousandsSep"
                         @onupdate:modelValue="SetEditThousandsSep"
                         Placeholder="请输入千分位分隔符"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="是否启用">
                <LangActiveInput Value="@EditActive" OnChange="@SetEditActive" />
            </ElFormItem>
        </div>
    </ElForm>

    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <ElButton @onclick="CancelEdit" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="Save"
                  Loading="@Saving"
                  Disabled="@OptionsLoading">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@AuditDialogVisible"
          @onupdate:modelValue="SetAuditDialogVisible"
          Title="@AuditDialogTitle"
          Width="560px">
    <div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px 16px;line-height:1.6;">
        <strong>创建人</strong><span>@AuditCreateUser</span>
        <strong>创建时间</strong><span>@AuditCreateTime</span>
        <strong>最后修改人</strong><span>@AuditUpdateUser</span>
        <strong>最后修改时间</strong><span>@AuditUpdateTime</span>
    </div>
</ElDialog>

@code {
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool ShowAdvanced { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool OptionsLoading { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public bool AuditDialogVisible { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public int EditDirection { get; set; }
    [Parameter] public int EditWeekStart { get; set; }
    [Parameter] public int EditActive { get; set; }
    [Parameter] public string Keyword { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string QueryCode { get; set; } = "";
    [Parameter] public string IsoCode { get; set; } = "";
    [Parameter] public string UrlCode { get; set; } = "";
    [Parameter] public string ActiveFilter { get; set; } = "";
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditCode { get; set; } = "";
    [Parameter] public string EditIsoCode { get; set; } = "";
    [Parameter] public string EditUrlCode { get; set; } = "";
    [Parameter] public string EditDateFormat { get; set; } = "";
    [Parameter] public string EditTimeFormat { get; set; } = "";
    [Parameter] public string EditGrouping { get; set; } = "";
    [Parameter] public string EditDecimalPoint { get; set; } = "";
    [Parameter] public string EditThousandsSep { get; set; } = "";
    [Parameter] public string AuditDialogTitle { get; set; } = "";
    [Parameter] public string AuditCreateUser { get; set; } = "";
    [Parameter] public string AuditCreateTime { get; set; } = "";
    [Parameter] public string AuditUpdateUser { get; set; } = "";
    [Parameter] public string AuditUpdateTime { get; set; } = "";
    [Parameter] public string? Error { get; set; }
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
    [Parameter] public Action<string?> SetKeyword { get; set; } = default!;
    [Parameter] public Action<string?> SetName { get; set; } = default!;
    [Parameter] public Action<string?> SetQueryCode { get; set; } = default!;
    [Parameter] public Action<string?> SetIsoCode { get; set; } = default!;
    [Parameter] public Action<string?> SetUrlCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditIsoCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditUrlCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditDateFormat { get; set; } = default!;
    [Parameter] public Action<string?> SetEditTimeFormat { get; set; } = default!;
    [Parameter] public Action<string?> SetEditGrouping { get; set; } = default!;
    [Parameter] public Action<string?> SetEditDecimalPoint { get; set; } = default!;
    [Parameter] public Action<string?> SetEditThousandsSep { get; set; } = default!;
    [Parameter] public LangTableRow[] Rows { get; set; } = [];
    [Parameter] public ConfigurationOption[] ActiveOptions { get; set; } = [];
    [Parameter] public LangNumberOption[] DirectionOptions { get; set; } = [];
    [Parameter] public LangNumberOption[] WeekOptions { get; set; } = [];
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action<string> OpenAudit { get; set; } = default!;
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action<string> ActiveFilterChanged { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public Action ToggleAdvanced { get; set; } = default!;
    [Parameter] public Action<double> SetEditActive { get; set; } = default!;
    [Parameter] public Action<double> SetEditDirection { get; set; } = default!;
    [Parameter] public Action<double> SetEditWeekStart { get; set; } = default!;
    [Parameter] public Action<double> ChangePage { get; set; } = default!;
    [Parameter] public Action<double> ChangePageSize { get; set; } = default!;
    [Parameter] public Action<string, string> Sort { get; set; } = default!;
}

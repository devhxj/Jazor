@using Npm.ElementPlus
@using App.Components
@using App.Auth
@using App.Ldap
@using Jero.Web.App.Components
@using Jero.Web.App.Menu

<style>
    .menu-page { display:grid; gap:16px; min-width:0; flex:1; min-height:0; grid-template-rows:minmax(0,1fr); }
    .menu-query-actions { display:flex; flex-wrap:wrap; gap:8px; }
    .menu-table-wrap { width:100%; overflow:auto; flex:1; min-height:0; border:1px solid #ebeef5; border-radius:8px; }
    .menu-table { width:100%; min-width:1120px; border-collapse:collapse; background:#fff; color:#606266; font-size:14px; }
    .menu-table th { padding:12px 14px; border-bottom:1px solid #ebeef5; background:#fafafa; color:#303133; font-weight:600; text-align:left; white-space:nowrap; }
    .menu-table td { padding:10px 14px; border-bottom:1px solid #ebeef5; vertical-align:middle; }
    .menu-table tbody tr:last-child td { border-bottom:0; }
    .menu-table tbody tr:nth-child(even) { background:#fcfcfd; }
    .menu-table__center { text-align:center !important; }
    .menu-tree-name { min-width:0; display:flex; align-items:center; gap:7px; }
    .menu-tree-toggle { width:22px; height:22px; flex:none; padding:0; border:0; border-radius:4px; background:transparent; color:#409eff; cursor:pointer; font-size:18px; line-height:22px; }
    .menu-tree-toggle:disabled { color:transparent; cursor:default; }
    .menu-tree-icon { width:22px; height:22px; flex:none; display:grid; place-items:center; border-radius:6px; background:#ecf5ff; color:#409eff; font-size:12px; }
    .menu-tree-title { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#303133; }
    .menu-cell-code { max-width:230px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .menu-status { display:flex; align-items:center; justify-content:center; gap:8px; }
    .menu-status-switch { width:40px; height:21px; accent-color:#409eff; cursor:pointer; }
    .menu-status-switch:disabled { cursor:not-allowed; }
    .menu-actions { display:flex; justify-content:center; align-items:center; gap:4px; white-space:nowrap; }
    .menu-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 20px; }
    .menu-form-span { grid-column:1 / -1; }
    .menu-route-fields, .menu-button-fields { display:contents; }
    .menu-boolean-grid { grid-column:1 / -1; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 20px; margin-bottom:18px; }
    .menu-boolean { min-height:40px; display:flex; align-items:center; justify-content:space-between; gap:16px; border:1px solid #ebeef5; border-radius:7px; padding:8px 12px; color:#606266; }
    .menu-boolean input { width:40px; height:21px; flex:none; accent-color:#409eff; cursor:pointer; }
    .menu-edit-dialog { width:min(760px, calc(100vw - 24px)) !important; }
    .menu-dialog-actions { display:flex; justify-content:flex-end; gap:8px; }
    @@media (max-width: 700px) {
        .menu-form-grid { grid-template-columns:1fr; }
        .menu-form-span { grid-column:auto; }
        .menu-boolean-grid { grid-column:auto; grid-template-columns:1fr; }
    }
</style>

<div class="menu-page">
    <ElCard Header="菜单管理" class="jero-list-page">
        <p style="margin-top:0;color:#606266;">
            菜单管理，支持筛选、树形展开、新增、编辑、复制、删除和状态切换。
        </p>

        <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
            <ElAlert Type="error"
                     Title="@(Error ?? "")"
                     ShowIcon="true"
                     Closable="true"
                     @onclose="DismissError" />
        </div>

        <JeroQueryCard Title="查询条件">
            <ElForm Inline="true">
                @if (IsSuperAdmin)
                {
                    <ElFormItem Label="租户">
                        <div style="width:260px">
                            <AuthOptionSelect Value="@TenantId" Options="@TenantOptions" Placeholder="请选择租户" Clearable="true" Loading="@TenantLoading" Change="@TenantChanged" />
                        </div>
                    </ElFormItem>
                }
                <ElFormItem Label="菜单名称">
                    <ElInput ModelValue="@TitleFilter"
                             @onupdate:modelValue="SetTitleFilter"
                             Placeholder="菜单名称"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="类型">
                    <div style="width:160px">
                        <AuthOptionSelect Value="@TypeFilter" Options="@TypeOptions" Placeholder="菜单类型" Clearable="true" Change="@TypeFilterChanged" />
                    </div>
                </ElFormItem>
                <ElFormItem>
                    <div class="menu-query-actions">
                        <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                        <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
                        @if (CanAdd)
                        {
                            <ElButton Type="primary" @onclick="OpenCreate" Loading="@FormLoading">新增菜单</ElButton>
                        }
                    </div>
                </ElFormItem>
            </ElForm>
        </JeroQueryCard>

        <div style="height:16px"></div>

        <ElCard class="jero-list-card">
            <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
                <ElButton @onclick="LoadMenus" Loading="@Loading">刷新</ElButton>
            </div>

            <div class="menu-table-wrap">
                <table class="menu-table" aria-label="菜单树">
                    <thead>
                        <tr>
                            <th style="min-width:240px;">菜单名称</th>
                            <th class="menu-table__center" style="width:100px;">类型</th>
                            <th style="min-width:170px;">路由路径</th>
                            <th style="min-width:190px;">组件路径</th>
                            <th style="min-width:170px;">权限标识</th>
                            <th class="menu-table__center" style="width:80px;">排序</th>
                            <th class="menu-table__center" style="width:150px;">状态</th>
                            @if (HasActionColumn)
                            {
                                <th class="menu-table__center" style="width:210px;">操作</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Loading)
                        {
                            <tr><td colspan="@(HasActionColumn ? 8 : 7)" class="menu-table__center" style="padding:42px;color:#909399;">正在加载菜单…</td></tr>
                        }
                        else if (Rows.Length == 0)
                        {
                            <tr><td colspan="@(HasActionColumn ? 8 : 7)" class="menu-table__center" style="padding:42px;color:#909399;">暂无菜单</td></tr>
                        }
                        else
                        {
                            @foreach (var row in Rows)
                            {
                                <tr @key="row.id">
                                    <td>
                                        <div class="menu-tree-name" style="@row.padding">
                                            <button class="menu-tree-toggle"
                                                    disabled="@(!row.hasChildren)"
                                                    aria-label="@(row.expanded ? "收起子菜单" : "展开子菜单")"
                                                    @onclick="@(_ => ToggleExpanded(row.id))">@row.toggleText</button>
                                            <span class="menu-tree-icon" title="@row.icon">@row.iconGlyph</span>
                                            <span class="menu-tree-title" title="@row.title">@row.title</span>
                                        </div>
                                    </td>
                                    <td class="menu-table__center">
                                        @if (row.type == 1) { <ElTag Type="warning">@row.typeText</ElTag> }
                                        else if (row.type == 2) { <ElTag Type="success">@row.typeText</ElTag> }
                                        else if (row.type == 3) { <ElTag Type="primary">@row.typeText</ElTag> }
                                        else { <ElTag Type="info">@row.typeText</ElTag> }
                                    </td>
                                    <td><div class="menu-cell-code" title="@row.path">@row.path</div></td>
                                    <td><div class="menu-cell-code" title="@row.component">@row.component</div></td>
                                    <td><div class="menu-cell-code" title="@row.permission">@row.permission</div></td>
                                    <td class="menu-table__center">@row.orderNo</td>
                                    <td>
                                        <div class="menu-status">
                                            <input class="menu-status-switch"
                                                   type="checkbox"
                                                   checked="@(row.status == 1)"
                                                   disabled="@(!CanSetStatus || StatusChanging)"
                                                   aria-label="@("切换" + row.title + "状态")"
                                                   @onclick:preventDefault @onclick="@(_ => ToggleStatus(row.id))" />
                                            <span>@(row.status == 1 ? "启用" : "停用")</span>
                                        </div>
                                    </td>
                                    @if (HasActionColumn)
                                    {
                                        <td>
                                            <div class="menu-actions">
                                                @if (CanEdit)
                                                {
                                                    <ElButton Link="true" Type="primary" Disabled="@FormLoading" @onclick="@(_ => OpenEdit(row.id))">编辑</ElButton>
                                                }
                                                @if (CanAdd)
                                                {
                                                    <ElButton Link="true" Type="primary" Disabled="@FormLoading" @onclick="@(_ => OpenCopy(row.id))">复制</ElButton>
                                                }
                                                @if (CanDelete)
                                                {
                                                    <ElPopconfirm Title="@("确定删除菜单【" + row.title + "】吗？")"
                                                                  ConfirmButtonText="确定"
                                                                  CancelButtonText="取消"
                                                                  @onconfirm="@(_ => Delete(row.id))">
                                                        <template #reference>
                                                            <ElButton Link="true" Type="danger">删除</ElButton>
                                                        </template>
                                                    </ElPopconfirm>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </ElCard>
    </ElCard>
</div>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          class="menu-edit-dialog"
          Draggable="true"
          DestroyOnClose="false"
          CloseOnClickModal="false">
    <ElForm LabelWidth="90px">
        <div class="menu-form-grid">
            @if (IsSuperAdmin)
            {
                <div class="menu-form-span">
                    <ElFormItem Label="租户">
                        <AuthOptionSelect Value="@EditTenantId" Options="@TenantOptions" Placeholder="请选择租户" Disabled="true" />
                    </ElFormItem>
                </div>
            }
            <div class="menu-form-span">
                <ElFormItem Label="上级菜单">
                    <AuthOptionSelect Value="@EditPid" Options="@ParentOptions" Placeholder="不选则为顶级菜单" Clearable="true" Change="@SetEditPid" />
                </ElFormItem>
            </div>
            <div class="menu-form-span">
                <ElFormItem Label="菜单类型">
                    <MenuTypeInput Value="@EditType" Change="@ChangeEditType" />
                </ElFormItem>
            </div>
            <ElFormItem Label="菜单名称">
                <ElInput ModelValue="@EditTitle"
                         @onupdate:modelValue="SetEditTitle"
                         Placeholder="菜单名称，最多64个字符"
                         Maxlength="64"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="排序">
                <ConfigurationNumber Value="@EditOrderNo" Minimum="@(0)" Change="@SetEditOrderNo" />
            </ElFormItem>

            <div class="menu-route-fields" style='@(IsRouteType ? "" : "display:none")'>
                <ElFormItem Label="路由名称">
                    <ElInput ModelValue="@EditName" @onupdate:modelValue="SetEditName" Placeholder="路由名称" Maxlength="64" Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="路由路径">
                    <ElInput ModelValue="@EditPath" @onupdate:modelValue="SetEditPath" Placeholder="路由路径" Maxlength="128" Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="组件路径">
                    <ElInput ModelValue="@EditComponent" @onupdate:modelValue="SetEditComponent" Placeholder="组件路径" Maxlength="128" Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="菜单图标">
                    <ElInput ModelValue="@EditIcon" @onupdate:modelValue="SetEditIcon" Placeholder="lucide:* 或旧 ele-* 图标" Maxlength="128" Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="重定向">
                    <ElInput ModelValue="@EditRedirect" @onupdate:modelValue="SetEditRedirect" Placeholder="重定向地址" Maxlength="128" Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="链接地址">
                    <ElInput ModelValue="@EditOutLink" @onupdate:modelValue="SetEditOutLink" Placeholder="外链或内嵌链接" Maxlength="256" Clearable="true" />
                </ElFormItem>
                <div class="menu-boolean-grid">
                    <label class="menu-boolean"><span>是否隐藏</span><input type="checkbox" checked="@EditIsHide" @onclick="ToggleEditIsHide" /></label>
                    <label class="menu-boolean"><span>是否缓存</span><input type="checkbox" checked="@EditIsKeepAlive" @onclick="ToggleEditIsKeepAlive" /></label>
                    <label class="menu-boolean"><span>是否固定</span><input type="checkbox" checked="@EditIsAffix" @onclick="ToggleEditIsAffix" /></label>
                    <label class="menu-boolean"><span>是否内嵌</span><input type="checkbox" checked="@EditIsIframe" @onclick="ToggleEditIsIframe" /></label>
                </div>
            </div>

            <div class="menu-button-fields" style='@(IsButtonType ? "" : "display:none")'>
                <div class="menu-form-span">
                    <ElFormItem Label="权限标识">
                        <ElInput ModelValue="@EditPermission"
                                 @onupdate:modelValue="SetEditPermission"
                                 Placeholder="例如 sysMenu:add"
                                 Maxlength="128"
                                 Clearable="true" />
                    </ElFormItem>
                </div>
            </div>

            <ElFormItem Label="状态">
                <LdapStatusInput Value="@EditStatus" InactiveLabel="停用" OnChange="@SetEditStatus" />
            </ElFormItem>
            <div class="menu-form-span">
                <ElFormItem Label="备注">
                    <ElInput ModelValue="@EditRemark"
                             @onupdate:modelValue="SetEditRemark"
                             Placeholder="请输入备注"
                             Type="textarea"
                             Rows="3"
                             Maxlength="256"
                             ShowWordLimit="true" />
                </ElFormItem>
            </div>
        </div>
    </ElForm>
    <div class="menu-dialog-actions">
        <ElButton @onclick="CancelEdit" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary" @onclick="Save" Loading="@Saving">确定</ElButton>
    </div>
</ElDialog>

@code {
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool CanSetStatus { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public bool IsRouteType { get; set; }
    [Parameter] public bool IsButtonType { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool FormLoading { get; set; }
    [Parameter] public bool TenantLoading { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool EditIsHide { get; set; }
    [Parameter] public bool EditIsKeepAlive { get; set; }
    [Parameter] public bool EditIsAffix { get; set; }
    [Parameter] public bool EditIsIframe { get; set; }
    [Parameter] public string TenantId { get; set; } = "";
    [Parameter] public string TitleFilter { get; set; } = "";
    [Parameter] public string TypeFilter { get; set; } = "";
    [Parameter] public string EditTenantId { get; set; } = "";
    [Parameter] public string EditPid { get; set; } = "";
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public string EditTitle { get; set; } = "";
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditPath { get; set; } = "";
    [Parameter] public string EditComponent { get; set; } = "";
    [Parameter] public string EditIcon { get; set; } = "";
    [Parameter] public string EditRedirect { get; set; } = "";
    [Parameter] public string EditOutLink { get; set; } = "";
    [Parameter] public string EditPermission { get; set; } = "";
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public int EditType { get; set; }
    [Parameter] public int EditStatus { get; set; }
    [Parameter] public int EditOrderNo { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action LoadMenus { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action<string> ToggleExpanded { get; set; } = default!;
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> OpenCopy { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action<string> ToggleStatus { get; set; } = default!;
    [Parameter] public Action<string?> TenantChanged { get; set; } = default!;
    [Parameter] public Action<string?> TypeFilterChanged { get; set; } = default!;
    [Parameter] public Action<string?> SetTitleFilter { get; set; } = default!;
    [Parameter] public Action<string?> SetEditTitle { get; set; } = default!;
    [Parameter] public Action<string?> SetEditName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditPath { get; set; } = default!;
    [Parameter] public Action<string?> SetEditComponent { get; set; } = default!;
    [Parameter] public Action<string?> SetEditIcon { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRedirect { get; set; } = default!;
    [Parameter] public Action<string?> SetEditOutLink { get; set; } = default!;
    [Parameter] public Action<string?> SetEditPermission { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<string?> SetEditPid { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<double> ChangeEditType { get; set; } = default!;
    [Parameter] public Action<double> SetEditStatus { get; set; } = default!;
    [Parameter] public Action<double?> SetEditOrderNo { get; set; } = default!;
    [Parameter] public Action ToggleEditIsHide { get; set; } = default!;
    [Parameter] public Action ToggleEditIsKeepAlive { get; set; } = default!;
    [Parameter] public Action ToggleEditIsAffix { get; set; } = default!;
    [Parameter] public Action ToggleEditIsIframe { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public bool StatusChanging { get; set; }
    [Parameter] public MenuTableRow[] Rows { get; set; } = [];
    [Parameter] public ConfigurationOption[] TenantOptions { get; set; } = [];
    [Parameter] public ConfigurationOption[] ParentOptions { get; set; } = [];


    private static ConfigurationOption[] TypeOptions =>
    [
        new("1", "目录"),
        new("2", "菜单"),
        new("3", "按钮")
    ];
}

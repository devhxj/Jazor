@using Npm.ElementPlus
@using App.Components
@using App.Tenant
@using App.Auth
@using Jero.Web.App.Components
@using Jero.Web.App.PlatformConfig

<ElCard Header="平台参数" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        管理平台级参数，支持分组筛选、分页排序、新增编辑、批量删除和内置参数保护。
    </p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            <ElFormItem Label="配置名称">
                <ElInput ModelValue="@Name"
                         @onupdate:modelValue="SetName"
                         Placeholder="搜索配置名称"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="配置编码">
                <ElInput ModelValue="@QueryCode"
                         @onupdate:modelValue="SetQueryCode"
                         Placeholder="搜索配置编码"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="分组编码">
                <div style="width:210px">
                    <AuthOptionSelect Value="@GroupCode" Options="@GroupOptions" Placeholder="请选择" Clearable="true" Change="@GroupChanged" />
                </div>
            </ElFormItem>
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
                @if (CanAdd)
                {
                    <ElButton Type="primary" @onclick="OpenCreate">新增</ElButton>
                }
                @if (CanBatchDelete && SelectedCount > 0)
                {
                    <ElPopconfirm Title="@("确定批量删除所选的 " + SelectedCount + " 个配置吗？")"
                                  ConfirmButtonText="确定"
                                  CancelButtonText="取消"
                                  @onconfirm="BatchDelete">
                        <template #reference>
                            <ElButton Type="danger">批量删除</ElButton>
                        </template>
                    </ElPopconfirm>
                }
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
                <ElButton @onclick="Refresh" Loading="@Loading">刷新</ElButton>
            </div>
        </div>

        @if (Loading)
        {
            <ElText>正在加载平台参数…</ElText>
        }

        <div class="jero-list-scroll">
    <PlatformConfigTable Rows="@Rows"
                CanBatchDelete="@CanBatchDelete" CanEdit="@CanEdit" CanDelete="@CanDelete"
                OpenAudit="@OpenAudit" OpenEdit="@OpenEdit" Delete="@Delete" Sort="@Sort" Selection="@SelectionChanged" />
        </div>

        <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <ElPagination CurrentPage="@CurrentPage"
                              PageSize="@PageSize"
                              Total="@Total"
                              PageSizes="@PageSizes"
                              Background="true"
                              Layout="total, sizes, prev, pager, next, jumper"
                              @oncurrent-change="ChangePage"
                              @onsize-change="ChangePageSize" />
        </div>
    </ElCard>
</ElCard>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          Width="720px"
          CloseOnClickModal="false"
          DestroyOnClose="true">
    <ElForm LabelWidth="94px">
        <ElFormItem Label="配置名称">
            <ElInput ModelValue="@EditName"
                     @onupdate:modelValue="SetEditName"
                     Placeholder="配置名称"
                     Clearable="true" />
        </ElFormItem>
        <ElFormItem Label="配置编码">
            <ElInput ModelValue="@EditCode"
                     @onupdate:modelValue="SetEditCode"
                     Placeholder="配置编码"
                     Clearable="true"
                     Disabled="@EditBuiltinLocked" />
        </ElFormItem>
        <ElFormItem Label="属性值">
            <div style="display:flex;width:100%;gap:8px;align-items:center;">
                <div style="flex:1;min-width:0;">
                    <ElInput ModelValue="@EditValue"
                             @onupdate:modelValue="SetEditValue"
                             Placeholder="属性值" />
                </div>
                <ElButton @onclick="SetTrue">True</ElButton>
                <ElButton @onclick="SetFalse">False</ElButton>
            </div>
        </ElFormItem>
        @if (IsSuperAdmin)
        {
            <ElFormItem Label="内置参数">
            <TenantRadio Value="@EditSysFlag" FirstValue="@(1)" FirstLabel="是" SecondValue="@(2)" SecondLabel="否" Disabled="@EditBuiltinLocked" Change="@SetEditSysFlag" />
            </ElFormItem>
        }
        <ElFormItem Label="分组编码">
            <ElInput ModelValue="@EditGroupCode"
                     @onupdate:modelValue="SetEditGroupCode"
                     Placeholder="输入已有或新分组编码"
                     Clearable="true"
                     Disabled="@EditBuiltinLocked" />
        </ElFormItem>
        <ElFormItem Label="排序">
            <ConfigurationNumber Value="@EditOrderNo" Minimum="@(0)" Change="@SetEditOrderNo" />
        </ElFormItem>
        <ElFormItem Label="备注">
            <ElInput ModelValue="@EditRemark"
                     @onupdate:modelValue="SetEditRemark"
                     Type="textarea"
                     Rows="3"
                     Placeholder="请输入备注内容" />
        </ElFormItem>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <ElButton @onclick="CloseEditDialogVisible" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary" @onclick="Save" Loading="@Saving">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@AuditDialogVisible"
          @onupdate:modelValue="SetAuditDialogVisible"
          Title="@AuditDialogTitle"
          Width="600px">
    <div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px 16px;line-height:1.6;">
        <strong>创建人</strong><span>@AuditCreateUser</span>
        <strong>创建时间</strong><span>@AuditCreateTime</span>
        <strong>最后修改人</strong><span>@AuditUpdateUser</span>
        <strong>最后修改时间</strong><span>@AuditUpdateTime</span>
        <strong>备注</strong><span>@AuditRemark</span>
    </div>
</ElDialog>

@code {
    [Parameter] public PlatformConfigTableRow[] Rows { get; set; } = [];
    [Parameter] public bool CanBatchDelete { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public Action<string> OpenAudit { get; set; } = default!;
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action<string, string> Sort { get; set; } = default!;
    [Parameter] public Action<string[]> SelectionChanged { get; set; } = default!;
    [Parameter] public string GroupCode { get; set; } = "";
    [Parameter] public ConfigurationOption[] GroupOptions { get; set; } = [];
    [Parameter] public Action<string> GroupChanged { get; set; } = default!;
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public int EditSysFlag { get; set; }
    [Parameter] public Action<double> SetEditSysFlag { get; set; } = default!;
    [Parameter] public int EditOrderNo { get; set; }
    [Parameter] public Action<double?> SetEditOrderNo { get; set; } = default!;
    [Parameter] public Action<string?> SetName { get; set; } = default!;
    [Parameter] public Action<string?> SetQueryCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditValue { get; set; } = default!;
    [Parameter] public Action<string?> SetEditGroupCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
    [Parameter] public Action SetTrue { get; set; } = default!;
    [Parameter] public Action SetFalse { get; set; } = default!;
    [Parameter] public Action CloseEditDialogVisible { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action BatchDelete { get; set; } = default!;
    [Parameter] public Action<double> ChangePage { get; set; } = default!;
    [Parameter] public Action<double> ChangePageSize { get; set; } = default!;
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public double[] PageSizes { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool EditBuiltinLocked { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public bool AuditDialogVisible { get; set; }
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string QueryCode { get; set; } = "";
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public string EditCode { get; set; } = "";
    [Parameter] public string EditValue { get; set; } = "";
    [Parameter] public string EditGroupCode { get; set; } = "";
    [Parameter] public string AuditDialogTitle { get; set; } = "";
    [Parameter] public string AuditCreateUser { get; set; } = "";
    [Parameter] public string AuditCreateTime { get; set; } = "";
    [Parameter] public string AuditUpdateUser { get; set; } = "";
    [Parameter] public string AuditUpdateTime { get; set; } = "";
    [Parameter] public string AuditRemark { get; set; } = "";
}

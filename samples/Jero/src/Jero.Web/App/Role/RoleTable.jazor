@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.Role

    <ElTable @attributes="@(new TableData<RoleView>(Rows))" border="true" stripe="true" RowKey="id" EmptyText="暂无角色">
        <ElTableColumn type="index" label="序号" width="70" align="center" />
        <ElTableColumn prop="name" label="角色名称" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn prop="code" label="角色编码" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn label="数据范围" MinWidth="140" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<RoleView>)(object)cell).row; }
                <ElTag @attributes="@(new TableTagProps(ScopeType(row.dataScope)))">@(ScopeLabel(row.dataScope))</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn prop="orderNo" label="排序" width="90" align="center" />
        <ElTableColumn label="状态" MinWidth="150" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<RoleView>)(object)cell).row; }
                <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
                    <ElTag @attributes="@(new TableTagProps(row.status == 1 ? "success" : "info"))">@(row.status == 1 ? "启用" : "停用")</ElTag>
                    @if (CanSetStatus) { <ElButton link="true" type="primary" loading='@(StatusLoadingId == row.id)' disabled='@(StatusLoadingId.Length > 0)' @onclick='@(() => OnToggleStatus(row.id))'>@(row.status == 1 ? "停用" : "启用")</ElButton> }
                </div>
            </template>
        </ElTableColumn>
        <ElTableColumn label="修改记录" width="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<RoleView>)(object)cell).row; }
                <ElButton link="true" type="primary" @onclick='@(() => OnOpenAudit(row.id))'>查看</ElButton>
            </template>
        </ElTableColumn>
        @if (HasActionColumn) { <ElTableColumn label="操作" width="230" align="center" fixed="right">
            <template #default context="cell">@{ var row = ((TableSlot<RoleView>)(object)cell).row; }
                @if (CanGrantDataScope) { <ElButton link="true" type="primary" @onclick='@(() => OnOpenGrantData(row.id))'>数据范围</ElButton> }
                @if (CanEdit) { <ElButton link="true" type="primary" @onclick='@(() => OnOpenEdit(row.id))'>编辑</ElButton> }
                @if (CanDelete) { <ElPopconfirm title='@("确定删除角色【" + row.name + "】吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm='@(() => OnDelete(row.id))'>
                    <template #reference>
                        <ElButton link="true" type="danger" loading='@(DeletingId == row.id)' disabled='@(DeletingId.Length > 0)'>删除</ElButton>
                    </template>
                </ElPopconfirm> }
            </template>
        </ElTableColumn> }
    </ElTable>

@code {
    [Parameter] public RoleView[] Rows { get; set; } = [];
    [Parameter] public bool CanSetStatus { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public bool CanGrantDataScope { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public string StatusLoadingId { get; set; } = "";
    [Parameter] public string DeletingId { get; set; } = "";
    [Parameter] public Action<string> OnToggleStatus { get; set; } = default!;
    [Parameter] public Action<string> OnOpenAudit { get; set; } = default!;
    [Parameter] public Action<string> OnOpenGrantData { get; set; } = default!;
    [Parameter] public Action<string> OnOpenEdit { get; set; } = default!;
    [Parameter] public Action<string> OnDelete { get; set; } = default!;

    private static string ScopeLabel(int scope) => scope switch
    {
        1 => "全部数据", 2 => "本部门及以下", 3 => "本部门", 4 => "仅本人", 5 => "自定义", _ => "未设置"
    };
    private static string ScopeType(int scope) => scope switch
    {
        1 => "danger", 2 => "success", 3 => "warning", 4 => "info", _ => "primary"
    };
}

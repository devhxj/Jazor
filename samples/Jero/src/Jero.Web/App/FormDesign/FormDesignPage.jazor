@using Npm.ElementPlus
@using Jero.Web.App.FormDesign

<style>
    .form-design-page { display: grid; gap: 16px; }
    .form-design-heading h1 { margin: 0; color: #303133; font-size: 23px; line-height: 1.25; }
    .form-design-heading p { margin: 7px 0 0; color: #909399; font-size: 13px; line-height: 1.6; }
    .form-design-card { min-height: 760px; }
    .form-design-card > .el-card__body { min-height: 760px; padding: 0; }
    .form-design-host { min-height: 760px; }
    .form-design-host .form-designer { overflow: visible !important; }
    /* VForm fixes this header at 42px. Wrapped actions must reserve their actual height
       so the form canvas cannot cover preview/export buttons on a narrow desktop. */
    #jero-vform-designer .toolbar-header { height: auto !important; min-height: 42px; }
    @@media (max-width: 700px) {
        .form-design-card, .form-design-card > .el-card__body, .form-design-host { min-height: 680px; }
    }
</style>

<div class="form-design-page">
    <header class="form-design-heading">
        <h1>表单设计</h1>
        <p>VForm 3 可视化表单设计器，支持组件拖拽、导入导出、历史记录和渲染预览。</p>
    </header>

    <ElAlert Type="info"
             Title="设计内容保存在当前设计器会话中；导入、导出、预览和历史操作由 VForm 3 本地完成。"
             ShowIcon="true"
             Closable="false" />

    <ElCard class="form-design-card">
        @if (loading.Value)
        {
            <p role="status">正在加载表单设计器…</p>
        }
        @if (loadError.Value is not null)
        {
            <ElAlert Type="error" Title="@(loadError.Value ?? "")" ShowIcon="true" Closable="false" />
        }
        <div id="jero-vform-designer" class="form-design-host"></div>
    </ElCard>
</div>

@code {
    private readonly global::ECMAScript.Vue.IVueRef<bool> loading = global::ECMAScript.Vue.Ref(true);
    private readonly global::ECMAScript.Vue.IVueRef<string?> loadError = global::ECMAScript.Vue.Ref<string?>(null);
    private bool active = true;
    private Action? dispose;

    [Setup]
    private void Configure()
    {
        global::ECMAScript.Vue.OnMounted(Load);
        global::ECMAScript.Vue.OnBeforeUnmount(() =>
        {
            // A pending import must never mount into a subsequent route's host.
            active = false;
            dispose?.Invoke();
        });
    }

    private void Load()
    {
        FormDesignerSdk.Load().Then(designer =>
        {
            if (!active)
                return;

            try
            {
                dispose = designer.Mount();
            }
            catch (Exception failure)
            {
                loadError.Value = "表单设计器加载失败：" + failure.Message;
            }
            finally
            {
                loading.Value = false;
            }
        }, failure =>
        {
            if (!active)
                return;

            loadError.Value = "表单设计器加载失败：" + failure;
            loading.Value = false;
        });
    }
}

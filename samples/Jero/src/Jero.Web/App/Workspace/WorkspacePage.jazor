@using ECMAScript
@using static ECMAScript.Vue

<style>
    .workspace-page { min-width:0; display:grid; gap:20px; }
    .workspace-header { min-width:0; display:flex; align-items:center; gap:22px; border:1px solid #e9edf3; border-radius:12px; padding:24px; background:#fff; box-shadow:0 8px 24px rgba(31,45,61,.04); }
    .workspace-header__avatar { flex:0 0 auto; width:80px; height:80px; display:grid; place-items:center; overflow:hidden; border-radius:50%; background:linear-gradient(135deg,#409eff,#36cfc9); color:#fff; font-size:27px; font-weight:750; }
    .workspace-header__avatar img { width:100%; height:100%; object-fit:cover; }
    .workspace-header__copy { min-width:0; flex:1 1 auto; }
    .workspace-header__copy h1 { margin:0; color:#253247; font-size:clamp(20px,2.6vw,26px); line-height:1.35; }
    .workspace-header__copy p { margin:8px 0 0; color:#7b8493; font-size:14px; }
    .workspace-header__metrics { flex:0 0 auto; display:flex; align-items:center; gap:46px; padding:0 18px; }
    .workspace-header__metric { display:grid; gap:5px; text-align:right; }
    .workspace-header__metric span { color:#7b8493; font-size:13px; }
    .workspace-header__metric strong { color:#273244; font-size:25px; font-weight:720; }
    .workspace-columns { min-width:0; display:grid; grid-template-columns:minmax(0,3fr) minmax(320px,2fr); gap:20px; align-items:start; }
    .workspace-column { min-width:0; display:grid; gap:20px; }
    .workspace-panel { min-width:0; overflow:hidden; border:1px solid #e9edf3; border-radius:12px; background:#fff; box-shadow:0 8px 24px rgba(31,45,61,.04); }
    .workspace-panel__head { padding:17px 20px; border-bottom:1px solid #eef1f5; }
    .workspace-panel__head h2 { margin:0; color:#303133; font-size:17px; font-weight:680; }
    .workspace-projects { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); }
    .workspace-project { min-width:0; border-right:1px solid #eef1f5; border-bottom:1px solid #eef1f5; padding:18px; }
    .workspace-project:nth-child(3n) { border-right:0; }
    .workspace-project:nth-last-child(-n+3) { border-bottom:0; }
    .workspace-project__title { display:flex; align-items:center; gap:12px; }
    .workspace-project__icon { flex:0 0 auto; width:34px; height:34px; display:grid; place-items:center; border:0; border-radius:9px; color:#fff; cursor:pointer; font-size:12px; font-weight:760; transition:transform .18s ease; }
    .workspace-project__icon:hover { transform:scale(1.1); }
    .workspace-project__name { min-width:0; overflow:hidden; color:#303133; text-overflow:ellipsis; white-space:nowrap; font-size:16px; font-weight:650; }
    .workspace-project__content { min-height:42px; margin-top:14px; color:#737b88; font-size:13px; line-height:1.65; }
    .workspace-project__meta { display:flex; justify-content:space-between; gap:8px; margin-top:12px; color:#909399; font-size:12px; }
    .workspace-trends, .workspace-todos { margin:0; padding:0 20px; list-style:none; }
    .workspace-trend, .workspace-todo { min-width:0; display:flex; align-items:center; gap:13px; border-bottom:1px solid #eef1f5; padding:16px 0; }
    .workspace-trend:last-child, .workspace-todo:last-child { border-bottom:0; }
    .workspace-trend__avatar { flex:0 0 auto; width:40px; height:40px; display:grid; place-items:center; border-radius:50%; font-size:14px; font-weight:720; }
    .workspace-trend__copy, .workspace-todo__copy { min-width:0; flex:1 1 auto; }
    .workspace-trend__title, .workspace-todo__title { color:#303133; font-size:14px; font-weight:650; }
    .workspace-trend__content, .workspace-todo__content { min-width:0; overflow:hidden; margin-top:4px; color:#7b8493; text-overflow:ellipsis; white-space:nowrap; font-size:12px; }
    .workspace-trend__content a { color:#409eff; }
    .workspace-trend__date, .workspace-todo__date { flex:0 0 auto; color:#909399; font-size:12px; white-space:nowrap; }
    .workspace-quick { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); }
    .workspace-quick__item { min-width:0; display:grid; place-items:center; gap:9px; border:0; border-right:1px solid #eef1f5; border-bottom:1px solid #eef1f5; padding:22px 8px; background:#fff; color:#4b5565; cursor:pointer; }
    .workspace-quick__item:nth-child(3n) { border-right:0; }
    .workspace-quick__item:nth-last-child(-n+3) { border-bottom:0; }
    .workspace-quick__item:hover { background:#f8fafc; }
    .workspace-quick__glyph { width:32px; height:32px; display:grid; place-items:center; border-radius:10px; color:#fff; font-size:12px; font-weight:750; transition:transform .18s ease; }
    .workspace-quick__item:hover .workspace-quick__glyph { transform:scale(1.12); }
    .workspace-quick__title { max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; }
    .workspace-todo { cursor:pointer; }
    .workspace-todo.is-completed { opacity:.58; }
    .workspace-todo.is-completed .workspace-todo__title, .workspace-todo.is-completed .workspace-todo__content { text-decoration:line-through; }
    .workspace-todo__check { flex:0 0 auto; width:16px; height:16px; accent-color:#409eff; cursor:pointer; }
    .workspace-chart { width:100%; height:300px; padding:4px 12px 12px; }
    @@media(max-width:1180px) {
        .workspace-columns { grid-template-columns:1fr; }
        .workspace-projects { grid-template-columns:repeat(3,minmax(0,1fr)); }
    }
    @@media(max-width:760px) {
        .workspace-header { align-items:flex-start; flex-wrap:wrap; }
        .workspace-header__metrics { width:100%; justify-content:space-between; gap:16px; padding:8px 0 0; }
        .workspace-header__metric { text-align:left; }
        .workspace-projects { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .workspace-project:nth-child(3n) { border-right:1px solid #eef1f5; }
        .workspace-project:nth-child(2n) { border-right:0; }
        .workspace-project:nth-last-child(-n+3) { border-bottom:1px solid #eef1f5; }
        .workspace-project:nth-last-child(-n+2) { border-bottom:0; }
        .workspace-trend__date, .workspace-todo__date { display:none; }
    }
    @@media(max-width:520px) {
        .workspace-page, .workspace-column, .workspace-columns { gap:14px; }
        .workspace-header { gap:16px; padding:18px; }
        .workspace-header__avatar { width:64px; height:64px; }
        .workspace-header__copy { min-width:calc(100% - 80px); }
        .workspace-header__metrics { gap:10px; }
        .workspace-header__metric strong { font-size:20px; }
        .workspace-projects { grid-template-columns:1fr; }
        .workspace-project { border-right:0; border-bottom:1px solid #eef1f5; }
        .workspace-project:nth-child(2n), .workspace-project:nth-child(3n) { border-right:0; }
        .workspace-project:nth-last-child(-n+2) { border-bottom:1px solid #eef1f5; }
        .workspace-project:last-child { border-bottom:0; }
        .workspace-trends, .workspace-todos { padding:0 15px; }
        .workspace-chart { height:270px; padding-left:4px; padding-right:4px; }
    }
    @@media(prefers-reduced-motion:reduce) {
        .workspace-project__icon, .workspace-quick__glyph { transition:none; }
    }
</style>

<div class="workspace-page">
    <section class="workspace-header">
        <div class="workspace-header__avatar">
            @if (Avatar.Length > 0)
            {
                <img src="@Avatar" alt="@UserName" />
            }
            else
            {
                <span>@AvatarInitial()</span>
            }
        </div>
        <div class="workspace-header__copy">
            <h1>早安, @UserName, 开始您一天的工作吧！</h1>
            <p>今日晴，20℃ - 32℃！</p>
        </div>
        <div class="workspace-header__metrics" aria-label="工作空间概览">
            <div class="workspace-header__metric"><span>待办</span><strong>2/10</strong></div>
            <div class="workspace-header__metric"><span>项目</span><strong>8</strong></div>
            <div class="workspace-header__metric"><span>团队</span><strong>300</strong></div>
        </div>
    </section>

    <div class="workspace-columns">
        <div class="workspace-column">
            <section class="workspace-panel">
                <div class="workspace-panel__head"><h2>项目</h2></div>
                <div class="workspace-projects">
                    @foreach (var item in projectItems)
                    {
                        <article class="workspace-project">
                            <div class="workspace-project__title">
                                <button class="workspace-project__icon"
                                        style='@("background:" + item.Color)'
                                        title='@("打开 " + item.Title)'
                                        @onclick="@(() => OpenProject(item.Url))">@item.Glyph</button>
                                <span class="workspace-project__name">@item.Title</span>
                            </div>
                            <div class="workspace-project__content">@item.Content</div>
                            <div class="workspace-project__meta"><span>@item.Group</span><span>@item.Date</span></div>
                        </article>
                    }
                </div>
            </section>

            <section class="workspace-panel">
                <div class="workspace-panel__head"><h2>最新动态</h2></div>
                <ul class="workspace-trends">
                    @foreach (var item in trendItems)
                    {
                        <li class="workspace-trend">
                            <span class="workspace-trend__avatar" style='@("background:" + item.Color + ";color:" + item.Foreground)'>@item.Avatar</span>
                            <div class="workspace-trend__copy">
                                <div class="workspace-trend__title">@item.Title</div>
                                <div class="workspace-trend__content" innerHTML="@item.Content"></div>
                            </div>
                            <span class="workspace-trend__date">@item.Date</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <div class="workspace-column">
            <section class="workspace-panel">
                <div class="workspace-panel__head"><h2>快捷导航</h2></div>
                <div class="workspace-quick">
                    @foreach (var item in quickNavItems)
                    {
                        <button class="workspace-quick__item" @onclick="@(() => OpenQuickNav(item.Route))">
                            <span class="workspace-quick__glyph" style='@("background:" + item.Color)'>@item.Glyph</span>
                            <span class="workspace-quick__title">@item.Title</span>
                        </button>
                    }
                </div>
            </section>

            <section class="workspace-panel">
                <div class="workspace-panel__head"><h2>待办事项</h2></div>
                <ul class="workspace-todos">
                    @for (var todoIndex = 0; todoIndex < todoItems.Value.Length; todoIndex++)
                    {
                        var item = todoItems.Value[todoIndex];
                        var itemIndex = todoIndex;
                        <li class='@("workspace-todo" + (item.Completed ? " is-completed" : ""))'>
                            <input class="workspace-todo__check"
                                   type="checkbox"
                                   checked="@item.Completed"
                                   aria-label='@("切换待办状态：" + item.Title)'
                                   @onchange="@(_ => ToggleTodo(itemIndex))" />
                            <div class="workspace-todo__copy">
                                <div class="workspace-todo__title">@item.Title</div>
                                <div class="workspace-todo__content">@item.Content</div>
                            </div>
                            <span class="workspace-todo__date">@item.Date</span>
                        </li>
                    }
                </ul>
            </section>

            <section class="workspace-panel">
                <div class="workspace-panel__head"><h2>访问来源</h2></div>
                <div id="jero-workspace-visits-source"
                     class="workspace-chart"
                     role="img"
                     aria-label="访问来源环形图：搜索引擎 1048，直接访问 735，邮件营销 580，联盟广告 484"></div>
            </section>
        </div>
    </div>
</div>

@code {
    private readonly WorkspaceProjectItem[] projectItems =
    [
        new() { Glyph = "G", Color = "#24292f", Title = "Github", Content = "不要等待机会，而要创造机会。", Group = "开源组", Date = "2021-04-01", Url = "https://github.com" },
        new() { Glyph = "V", Color = "#3fb27f", Title = "Vue", Content = "现在的你决定将来的你。", Group = "算法组", Date = "2021-04-01", Url = "https://vuejs.org" },
        new() { Glyph = "H5", Color = "#e18525", Title = "Html5", Content = "没有什么才能比努力更重要。", Group = "上班摸鱼", Date = "2021-04-01", Url = "https://developer.mozilla.org/zh-CN/docs/Web/HTML" },
        new() { Glyph = "A", Color = "#bf0c2c", Title = "Angular", Content = "热情和欲望可以突破一切难关。", Group = "UI", Date = "2021-04-01", Url = "https://angular.io" },
        new() { Glyph = "R", Color = "#00a8cc", Title = "React", Content = "健康的身体是实现目标的基石。", Group = "技术牛", Date = "2021-04-01", Url = "https://reactjs.org" },
        new() { Glyph = "JS", Color = "#c5a900", Title = "Js", Content = "路是走出来的，而不是空想出来的。", Group = "架构组", Date = "2021-04-01", Url = "https://developer.mozilla.org/zh-CN/docs/Web/JavaScript" }
    ];

    private readonly WorkspaceQuickNavItem[] quickNavItems =
    [
        new() { Glyph = "首", Color = "#1f9d8a", Title = "首页", Route = "home" },
        new() { Glyph = "析", Color = "#2563eb", Title = "分析页", Route = "analytics" },
        new() { Glyph = "账", Color = "#e18525", Title = "账号管理", Route = "user" },
        new() { Glyph = "机", Color = "#3fb27f", Title = "机构管理", Route = "org" },
        new() { Glyph = "角", Color = "#7c3aed", Title = "角色管理", Route = "role" },
        new() { Glyph = "我", Color = "#0891b2", Title = "个人中心", Route = "profile" }
    ];

    private readonly IVueRef<WorkspaceTodoItem[]> todoItems = Ref<WorkspaceTodoItem[]>(
    [
        new() { Title = "审查前端代码提交", Content = "审查最近提交到 Git 仓库的前端代码，确保代码质量和规范。", Date = "2024-07-30 11:00:00" },
        new() { Title = "系统性能优化", Content = "检查并优化系统性能，降低 CPU 使用率。", Date = "2024-07-30 11:00:00", Completed = true },
        new() { Title = "安全检查", Content = "进行系统安全检查，确保没有安全漏洞或未授权的访问。", Date = "2024-07-30 11:00:00" },
        new() { Title = "更新项目依赖", Content = "更新项目中的所有 npm 依赖包，确保使用最新版本。", Date = "2024-07-30 11:00:00" },
        new() { Title = "修复 UI 显示问题", Content = "修复用户报告的页面 UI 显示问题，确保在不同浏览器中显示一致。", Date = "2024-07-30 11:00:00" }
    ]);

    private readonly WorkspaceTrendItem[] trendItems =
    [
        new() { Avatar = "威", Color = "#dbeafe", Foreground = "#1d4ed8", Title = "威廉", Content = "在 <a>开源组</a> 创建了项目 <a>Vue</a>", Date = "刚刚" },
        new() { Avatar = "艾", Color = "#dcfce7", Foreground = "#15803d", Title = "艾文", Content = "关注了 <a>威廉</a>", Date = "1个小时前" },
        new() { Avatar = "克", Color = "#fef3c7", Foreground = "#a16207", Title = "克里斯", Content = "发布了 <a>个人动态</a>", Date = "1天前" },
        new() { Avatar = "V", Color = "#f3e8ff", Foreground = "#7e22ce", Title = "Vben", Content = "发表文章 <a>如何编写一个 Vite 插件</a>", Date = "2天前" },
        new() { Avatar = "皮", Color = "#dbeafe", Foreground = "#1d4ed8", Title = "皮特", Content = "回复了 <a>杰克</a> 的问题 <a>如何进行项目优化？</a>", Date = "3天前" },
        new() { Avatar = "杰", Color = "#dcfce7", Foreground = "#15803d", Title = "杰克", Content = "关闭了问题 <a>如何运行项目</a>", Date = "1周前" },
        new() { Avatar = "威", Color = "#fef3c7", Foreground = "#a16207", Title = "威廉", Content = "发布了 <a>个人动态</a>", Date = "1周前" },
        new() { Avatar = "威", Color = "#f3e8ff", Foreground = "#7e22ce", Title = "威廉", Content = "推送了代码到 <a>Github</a>", Date = "2021-04-01 20:00" },
        new() { Avatar = "V", Color = "#f3e8ff", Foreground = "#7e22ce", Title = "Vben", Content = "发表文章 <a>如何编写使用 Admin Vben</a>", Date = "2021-03-01 20:00" }
    ];
    public sealed record WorkspaceProjectItem
    {
        public string Glyph { get; init; } = string.Empty;
        public string Color { get; init; } = string.Empty;
        public string Title { get; init; } = string.Empty;
        public string Content { get; init; } = string.Empty;
        public string Group { get; init; } = string.Empty;
        public string Date { get; init; } = string.Empty;
        public string Url { get; init; } = string.Empty;
    }

    public sealed record WorkspaceQuickNavItem
    {
        public string Glyph { get; init; } = string.Empty;
        public string Color { get; init; } = string.Empty;
        public string Title { get; init; } = string.Empty;
        public string Route { get; init; } = string.Empty;
    }

    public sealed record WorkspaceTrendItem
    {
        public string Avatar { get; init; } = string.Empty;
        public string Color { get; init; } = string.Empty;
        public string Foreground { get; init; } = string.Empty;
        public string Title { get; init; } = string.Empty;
        public string Content { get; init; } = string.Empty;
        public string Date { get; init; } = string.Empty;
    }

    private sealed record WorkspaceTodoItem
    {
        public string Title { get; set; } = "";
        public string Content { get; set; } = "";
        public string Date { get; set; } = "";
        public bool Completed { get; set; }
    }

    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string Avatar { get; set; } = "";
    [Parameter] public Action MountChart { get; set; } = default!;
    [Parameter] public Action DestroyChart { get; set; } = default!;
    [Parameter] public Action<string> OpenProject { get; set; } = default!;
    [Parameter] public Action<string> OpenQuickNav { get; set; } = default!;

    [Setup]
    private void SetupChart()
    {
        OnMounted(() => MountChart());
        OnBeforeUnmount(() => DestroyChart());
    }

    private string AvatarInitial() => UserName.Length == 0 ? "管" : UserName.Substring(0, 1);

    private void ToggleTodo(int index)
    {
        var item = todoItems.Value[index];
        item.Completed = !item.Completed;
    }
}

@using Npm.Jero.ElementPlus

<ProjectDropdown SplitButton="true" trigger="click" disabled="@Disabled"
@onclick="Page" @oncommand="Command">
导出
<template #dropdown>
    <ProjectDropdownMenu>
        <ProjectDropdownItem command="page">导出本页数据</ProjectDropdownItem>
        <ProjectDropdownItem command="all">导出全部数据</ProjectDropdownItem>
    </ProjectDropdownMenu>
</template>
</ProjectDropdown>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Action Page { get; set; } = default!;
    [Parameter] public Action<string> Command { get; set; } = default!;

}

@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.Pos

    <ElTable @attributes="@(new TableData<PosTableRow>(Rows))" border="true" stripe="true" RowKey="id" EmptyText="暂无职位">
        <ElTableColumn type="index" label="序号" width="70" align="center" />
        <ElTableColumn prop="name" label="职位名称" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn prop="code" label="职位编码" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn prop="userCount" label="在职人数" width="100" align="center" />
        <ElTableColumn label="人员明细" width="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<PosTableRow>)(object)cell).row; }
                @if (row.userCount > 0) { <ElButton link="true" type="primary" @onclick='@(() => OnOpenUsers(row.id))'>查看</ElButton> }
                else { <span>-</span> }
            </template>
        </ElTableColumn>
        <ElTableColumn prop="orderNo" label="排序" width="90" align="center" />
        <ElTableColumn label="状态" width="90" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<PosTableRow>)(object)cell).row; }
                <ElTag @attributes="@(new TableTagProps(row.status == 1 ? "success" : "info"))">@(row.status == 1 ? "启用" : "停用")</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn label="修改记录" width="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<PosTableRow>)(object)cell).row; }
                <ElButton link="true" type="primary" @onclick='@(() => OnOpenAudit(row.id))'>查看</ElButton>
            </template>
        </ElTableColumn>
        @if (HasActionColumn) { <ElTableColumn label="操作" width="190" align="center" fixed="right">
            <template #default context="cell">@{ var row = ((TableSlot<PosTableRow>)(object)cell).row; }
                @if (CanEdit) { <span title='@(row.editDisabledReason)'>
                    <ElButton link="true" type="primary" disabled='@(!row.canEdit)' @onclick='@(() => OnOpenEdit(row.id))'>编辑</ElButton>
                </span> }
                @if (CanDelete) { <ElPopconfirm title='@("确定删除职位【" + row.name + "】吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm='@(() => OnDelete(row.id))'>
                    <template #reference>
                        <span title='@(row.deleteDisabledReason)'>
                            <ElButton link="true" type="danger" disabled='@(!row.canDelete)'>删除</ElButton>
                        </span>
                    </template>
                </ElPopconfirm> }
                @if (CanAdd) { <ElButton link="true" type="primary" @onclick='@(() => OnOpenCopy(row.id))'>复制</ElButton> }
            </template>
        </ElTableColumn> }
    </ElTable>

@code {
    [Parameter] public PosTableRow[] Rows { get; set; } = [];
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public Action<string> OnOpenUsers { get; set; } = default!;
    [Parameter] public Action<string> OnOpenAudit { get; set; } = default!;
    [Parameter] public Action<string> OnOpenEdit { get; set; } = default!;
    [Parameter] public Action<string> OnOpenCopy { get; set; } = default!;
    [Parameter] public Action<string> OnDelete { get; set; } = default!;
}

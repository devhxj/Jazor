@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.Pos

    <ElTable @attributes="@(new TableData<PosUserTableRow>(Rows))" border="true" stripe="true" RowKey="id" EmptyText="暂无在职人员">
        <ElTableColumn type="index" label="序号" width="70" align="center" />
        <ElTableColumn prop="account" label="账号" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn prop="realName" label="姓名" MinWidth="160" ShowOverflowTooltip="true" />
    </ElTable>

@code {
    [Parameter] public PosUserTableRow[] Rows { get; set; } = [];
}

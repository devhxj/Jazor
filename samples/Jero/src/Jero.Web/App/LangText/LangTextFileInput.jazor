@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.LangText

    <input id='@(Id)' type="file" accept=".xlsx,.xls,.csv" @onchange='@(() => OnChange())' style="display:block;width:100%;padding:8px;border:1px solid #dcdfe6;border-radius:4px;box-sizing:border-box;" />

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public Action OnChange { get; set; } = default!;
}

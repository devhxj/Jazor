@using Npm.ElementPlus
@using Npm.Jero.ElementPlus
@using Jero.Web.App.Components

<ProjectTabs ModelValue="@Value" @attributes="@(new ModelUpdate<object?>(Update))">
    <ElTabPane label="基本信息" name="basic"><slot name="basic" /></ElTabPane>
    <ElTabPane label="数据库配置" name="database"><slot name="database" /></ElTabPane>
    <ElTabPane label="站点信息" name="site" disabled="@SiteDisabled"><slot name="site" /></ElTabPane>
</ProjectTabs>

@code {
    [Parameter] public string Value { get; set; } = default!;
    [Parameter] public bool SiteDisabled { get; set; }
    [Parameter] public Action<string> Change { get; set; } = default!;

    private void Update(object? value) => Change(value as string ?? "basic");
}

@using Npm.ElementPlus
@using Jero.Web.App.Iframe

<style>
    .jero-iframe { min-height: calc(100vh - 208px); display: grid; grid-template-rows: auto minmax(560px, 1fr); border: 1px solid #ebeef5; border-radius: 10px; background: white; overflow: hidden; }
    .jero-iframe__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px; border-bottom: 1px solid #ebeef5; }
    .jero-iframe__copy { min-width: 0; }
    .jero-iframe__title { color: #303133; font-size: 15px; font-weight: 600; }
    .jero-iframe__url { margin-top: 4px; color: #909399; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .jero-iframe__frame { width: 100%; height: 100%; min-height: 560px; border: 0; background: white; }
    .jero-iframe__missing { min-height: 480px; display: grid; place-items: center; padding: 32px; border: 1px solid #ebeef5; border-radius: 10px; background: white; color: #909399; text-align: center; }
</style>

<div>
    @if (!Available)
    {
        <section class="jero-iframe__missing">
            <div>
                <h2>嵌入页面不存在</h2>
                <p>菜单已被移除，或当前会话没有对应入口。</p>
                <ElButton Type="primary" @onclick="GoHome">返回首页</ElButton>
            </div>
        </section>
    }
    else
    {
        <section class="jero-iframe">
            <div class="jero-iframe__toolbar">
                <div class="jero-iframe__copy">
                    <div class="jero-iframe__title">@Title</div>
                    <div class="jero-iframe__url">@Url</div>
                </div>
                <ElButton @onclick="OpenInNewWindow">新窗口打开</ElButton>
            </div>
            <iframe class="jero-iframe__frame"
                    title="@Title"
                    src="@Url"></iframe>
        </section>
    }
</div>

@code {
    private ECMAScript.RouteLocationNormalizedLoaded route = default!;
    private ECMAScript.Router router = default!;

    [Setup]
    private void Configure()
    {
        route = ECMAScript.VueRoute.UseRoute();
        router = ECMAScript.VueRoute.UseRouter();
    }

    private Jero.Web.App.Shell.AppIframeDestination? Destination
        => IframeShell.FindIframe((route.Params["MenuId"] ?? route.Params["menuId"])?.AsString ?? "");

    private bool Available => Destination is not null;
    private string Title => Destination?.Title ?? "";
    private string Url => Destination?.Url ?? "";
    private void GoHome() => router.Push("/home");

    private void OpenInNewWindow()
    {
        if (Destination is { } item)
            ECMAScript.Global.Window.Open(item.Url, "_blank", "");
    }
}

@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.Dict

    <ElRadioGroup ModelValue='@(Value)' @attributes="@(new ModelUpdate<string>(Update))">
        @foreach (var tag in Tags) { <ElRadio @key="tag" value='@(tag)'><ElTag @attributes="@(new TableTagProps(tag))">@(tag == "primary" ? "主题色" : tag)</ElTag></ElRadio> }
    </ElRadioGroup>

@code {
    private void Update(string value) => OnChange(value);
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public Action<string> OnChange { get; set; } = default!;

    private static readonly string[] Tags = ["primary", "success", "info", "warning", "danger"];
}

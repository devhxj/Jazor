@using Npm.ElementPlus
@using App.Components
@using App.Ldap
@using Jero.Web.App.Org

<style>
    .org-page { min-width: 0; }
    .org-layout { display: grid; grid-template-columns: minmax(260px, 300px) minmax(0, 1fr); gap: 16px; align-items: start; }
    .org-tree-card { min-width: 0; }
    .org-tree-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
    .org-tree-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .org-tree { min-height: 360px; max-height: 670px; overflow: auto; margin-top: 12px; border: 1px solid #ebeef5; border-radius: 6px; padding: 8px; }
    .org-tree__toggle { flex: 0 0 24px; width: 24px; height: 24px; border: 0; border-radius: 4px; background: transparent; color: #909399; cursor: pointer; }
    .org-tree__name { min-width: 0; flex: 1 1 auto; overflow: hidden; border: 0; background: transparent; color: inherit; text-align: left; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
    .org-tree__name:disabled { color: #c0c4cc; cursor: not-allowed; }
    .org-main { min-width: 0; display: grid; gap: 16px; }
    .org-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
    .org-detail-grid { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 10px 16px; line-height: 1.65; }
    .org-detail-grid span { min-width: 0; overflow-wrap: anywhere; }
    .org-edit-dialog { width: min(720px, calc(100vw - 24px)) !important; }
    .org-detail-dialog { width: min(620px, calc(100vw - 24px)) !important; }
    @@media (max-width: 980px) {
        .org-layout { grid-template-columns: 1fr; }
        .org-tree { min-height: 220px; max-height: 360px; }
    }
    @@media (max-width: 620px) {
        .org-form-grid { grid-template-columns: 1fr; }
        .org-detail-grid { grid-template-columns: 1fr; gap: 3px; }
        .org-detail-grid strong:not(:first-child) { margin-top: 8px; }
    }
</style>

<div class="org-page">
    <ElCard Header="机构管理" class="jero-list-page">
        <p style="margin-top:0;color:#606266;">
            支持机构树定位、租户与机构条件筛选、级联新增编辑、复制、详情、修改记录和受约束删除。
        </p>

        <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
            <ElAlert Type="error"
                     Title="@(Error ?? "")"
                     ShowIcon="true"
                     Closable="true"
                     @onclose="@(_ => DismissError())" />
        </div>

        <div class="org-layout">
            <ElCard Header="机构树" class="org-tree-card">
                <div class="org-tree-toolbar">
                    <ElInput ModelValue="@TreeFilter"
                             @onupdate:modelValue="TreeFilterChanged"
                             Placeholder="机构名称"
                             Clearable="true" />
                    <ElButton @onclick="@(_ => RefreshTree())" Loading="@TreeLoading">刷新</ElButton>
                </div>
                <div class="org-tree-actions">
                    <ElButton Size="small" @onclick="@(_ => ExpandAll())" Disabled="@TreeLoading">全部展开</ElButton>
                    <ElButton Size="small" @onclick="@(_ => CollapseAll())" Disabled="@TreeLoading">全部折叠</ElButton>
                    <ElButton Size="small" @onclick="@(_ => SelectRoot())" Disabled="@TreeLoading">根节点</ElButton>
                </div>

                <div class="org-tree" aria-label="机构树">
                    @if (TreeLoading)
                    {
                        <ElText>正在加载机构树…</ElText>
                    }
                    else if (VisibleTreeRows.Length == 0)
                    {
                        <ElEmpty Description="暂无机构数据" />
                    }
                    else
                    {
                        @foreach (var treeRow in VisibleTreeRows)
                        {
                            <div @key="treeRow.id" style="@TreeRowStyle(treeRow, SelectedOrgId)">
                                <button class="org-tree__toggle"
                                        disabled="@(!treeRow.hasChildren)"
                                        title="@(treeRow.hasChildren ? "展开或折叠" : "无下级机构")"
                                        @onclick="@(_ => ToggleTree(treeRow))">@TreeToggleText(treeRow, ExpandedIds)</button>
                                <button class="org-tree__name"
                                        disabled="@treeRow.disabled"
                                        title="@(treeRow.disabled ? treeRow.name + "（无操作权限）" : treeRow.name)"
                                        @onclick="@(_ => SelectTreeNode(treeRow))">@treeRow.name</button>
                            </div>
                        }
                    }
                </div>
            </ElCard>

            <div class="org-main">
                <JeroQueryCard Title="查询条件">
                    <ElForm Inline="true">
                        @if (IsSuperAdmin)
                        {
                            <ElFormItem Label="租户">
                                <div style="width:260px">
                                    <OrgTenantSelect Value="@TenantId" Options="@TenantItems" Placeholder="请选择租户" Clearable="true" Loading="@TenantLoading" OnChange="@TenantChanged" />
                                </div>
                            </ElFormItem>
                        }
                        <ElFormItem Label="机构名称">
                            <ElInput ModelValue="@QueryName"
                                     @onupdate:modelValue="SetQueryName"
                                     Placeholder="机构名称"
                                     Clearable="true" />
                        </ElFormItem>
                        <ElFormItem Label="机构编码">
                            <ElInput ModelValue="@QueryCode"
                                     @onupdate:modelValue="SetQueryCode"
                                     Placeholder="机构编码"
                                     Clearable="true" />
                        </ElFormItem>
                        <ElFormItem Label="机构类型">
                            <div style="width:180px">
                                <OrgTypeSelect Value="@QueryType" Options="@TypeItems" Placeholder="机构类型" Clearable="true" OnChange="@SetQueryType" />
                            </div>
                        </ElFormItem>
                        <ElFormItem>
                            <ElButton Type="primary" @onclick="@(_ => Search())" Loading="@ListLoading">查询</ElButton>
                            <ElButton @onclick="@(_ => ResetSearch())" Disabled="@ListLoading">重置</ElButton>
                            @if (CanAdd)
                            {
                                <ElButton Type="primary" @onclick="@(_ => OpenCreate())">新增机构</ElButton>
                            }
                        </ElFormItem>
                    </ElForm>
                </JeroQueryCard>

                <ElCard class="jero-list-card">
                    <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
                        <ElButton @onclick="@(_ => RefreshAll())" Loading="@(TreeLoading || ListLoading)">刷新</ElButton>
                    </div>
                    <div class="jero-list-scroll">
                        <OrgTable Rows="@Rows" Types="@TypeItems" HasActionColumn="@HasActionColumn"
                                  CanAdd="@CanAdd" CanEdit="@CanEdit" CanDelete="@CanDelete" DeletingId="@DeletingId"
                                  OnOpenDetail="@OpenDetail" OnOpenAudit="@OpenAudit"
                                  OnOpenCopy="@OpenCopy" OnOpenEdit="@OpenEdit" OnDelete="@Delete" />
                    </div>
                </ElCard>
            </div>
        </div>
    </ElCard>
</div>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          class="org-edit-dialog"
          Width="720px"
          CloseOnClickModal="false">
    <ElForm LabelWidth="96px">
        <ElFormItem Label="上级机构" Required="true">
            <OrgParentSelect Value="@EditPid" Options="@ParentOptions" Placeholder="请选择上级机构" Clearable="@IsSuperAdmin" OnChange="@ParentChanged" />
        </ElFormItem>
        <div class="org-form-grid">
            <ElFormItem Label="机构名称" Required="true">
                <ElInput ModelValue="@EditName"
                         @onupdate:modelValue="SetEditName"
                         Maxlength="64"
                         ShowWordLimit="true"
                         Clearable="true"
                         Placeholder="机构名称" />
            </ElFormItem>
            <ElFormItem Label="机构编码" Required="true">
                <ElInput ModelValue="@EditCode"
                         @onupdate:modelValue="SetEditCode"
                         Maxlength="64"
                         ShowWordLimit="true"
                         Clearable="true"
                         Placeholder="机构编码" />
            </ElFormItem>
            <ElFormItem Label="级别">
                <OrgNumberInput Value="@EditLevel" Minimum="@(1)" DefaultValue="@(1)" OnChange="@SetEditLevel" />
            </ElFormItem>
            <ElFormItem Label="机构类型">
                <OrgTypeSelect Value="@EditType" Options="@TypeItems" Placeholder="机构类型" Clearable="true" OnChange="@SetEditType" />
            </ElFormItem>
            <ElFormItem Label="排序">
                <OrgNumberInput Value="@EditOrderNo" Minimum="@(0)" DefaultValue="@(100)" OnChange="@SetEditOrderNo" />
            </ElFormItem>
            <ElFormItem Label="状态">
                <LdapStatusInput Value="@EditStatus" InactiveLabel="停用" OnChange="@SetEditStatus" />
            </ElFormItem>
        </div>
        <ElFormItem Label="备注">
            <ElInput ModelValue="@EditRemark"
                     @onupdate:modelValue="SetEditRemark"
                     Type="textarea"
                     Rows="3"
                     Maxlength="128"
                     ShowWordLimit="true"
                     Placeholder="请输入备注" />
        </ElFormItem>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <ElButton @onclick="@(_ => CancelEdit())" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary" @onclick="@(_ => Save())" Loading="@Saving">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@DetailDialogVisible"
          @onupdate:modelValue="SetDetailDialogVisible"
          Title="@DetailDialogTitle"
          class="org-detail-dialog"
          Width="620px">
    <div class="org-detail-grid">
        <strong>机构 ID</strong><span>@DisplayValue(DetailRow?.id ?? "")</span>
        <strong>租户 ID</strong><span>@DisplayValue(DetailRow?.tenantId ?? "")</span>
        <strong>上级机构 ID</strong><span>@DisplayValue(DetailRow?.pid ?? "")</span>
        <strong>机构名称</strong><span>@DisplayValue(DetailRow?.name ?? "")</span>
        <strong>机构编码</strong><span>@DisplayValue(DetailRow?.code ?? "")</span>
        <strong>级别</strong><span>@(DetailRow?.level ?? 1)</span>
        <strong>机构类型</strong><span>@DisplayValue(DetailRow?.type ?? "")</span>
        <strong>负责人 ID</strong><span>@DisplayValue(DetailRow?.directorId ?? "")</span>
        <strong>排序</strong><span>@(DetailRow?.orderNo ?? 100)</span>
        <strong>状态</strong><span>@((DetailRow?.status ?? 1) == 1 ? "启用" : "停用")</span>
        <strong>备注</strong><span>@DisplayValue(DetailRow?.remark ?? "")</span>
    </div>
</ElDialog>

<ElDialog ModelValue="@AuditDialogVisible"
          @onupdate:modelValue="SetAuditDialogVisible"
          Title="@AuditDialogTitle"
          class="org-detail-dialog"
          Width="560px">
    <div class="org-detail-grid">
        <strong>创建人</strong><span>@AuditCreateUser</span>
        <strong>创建时间</strong><span>@AuditCreateTime</span>
        <strong>最后修改人</strong><span>@AuditUpdateUser</span>
        <strong>最后修改时间</strong><span>@AuditUpdateTime</span>
    </div>
</ElDialog>

@code {
    [Parameter] public Action<double> SetEditLevel { get; set; } = default!;
    [Parameter] public Action<double> SetEditOrderNo { get; set; } = default!;
    [Parameter] public Action<double> SetEditStatus { get; set; } = default!;
    [Parameter] public Action<string> SetQueryName { get; set; } = default!;
    [Parameter] public Action<string> SetQueryCode { get; set; } = default!;
    [Parameter] public Action<string> SetQueryType { get; set; } = default!;
    [Parameter] public Action<string> SetEditType { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<string> SetEditName { get; set; } = default!;
    [Parameter] public Action<string> SetEditCode { get; set; } = default!;
    [Parameter] public Action<string> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<bool> SetDetailDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action RefreshTree { get; set; } = default!;
    [Parameter] public Action ExpandAll { get; set; } = default!;
    [Parameter] public Action CollapseAll { get; set; } = default!;
    [Parameter] public Action SelectRoot { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action RefreshAll { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action<string> TenantChanged { get; set; } = default!;
    [Parameter] public Action<string> ParentChanged { get; set; } = default!;
    [Parameter] public Action<string> TreeFilterChanged { get; set; } = default!;
    [Parameter] public Action<string> OpenDetail { get; set; } = default!;
    [Parameter] public Action<string> OpenAudit { get; set; } = default!;
    [Parameter] public Action<string> OpenCopy { get; set; } = default!;
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action<OrgFlatView> ToggleTree { get; set; } = default!;
    [Parameter] public Action<OrgFlatView> SelectTreeNode { get; set; } = default!;
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public OrgFlatView[] VisibleTreeRows { get; set; } = [];
    [Parameter] public OrgFlatView[] Rows { get; set; } = [];
    [Parameter] public OrgTenantOption[] TenantItems { get; set; } = [];
    [Parameter] public OrgTypeOption[] TypeItems { get; set; } = [];
    [Parameter] public string[] ExpandedIds { get; set; } = [];
    [Parameter] public string TreeFilter { get; set; } = "";
    [Parameter] public string SelectedOrgId { get; set; } = "";
    [Parameter] public string TenantId { get; set; } = "";
    [Parameter] public string QueryName { get; set; } = "";
    [Parameter] public string QueryCode { get; set; } = "";
    [Parameter] public string QueryType { get; set; } = "";
    [Parameter] public bool TreeLoading { get; set; }
    [Parameter] public bool ListLoading { get; set; }
    [Parameter] public bool TenantLoading { get; set; }
    [Parameter] public string DeletingId { get; set; } = "";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public bool Saving { get; set; }
    [Parameter] public string EditPid { get; set; } = "";
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditCode { get; set; } = "";
    [Parameter] public int EditLevel { get; set; }
    [Parameter] public string EditType { get; set; } = "";
    [Parameter] public int EditOrderNo { get; set; }
    [Parameter] public int EditStatus { get; set; }
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public OrgParentOption[] ParentOptions { get; set; } = [];
    [Parameter] public bool DetailDialogVisible { get; set; }
    [Parameter] public string DetailDialogTitle { get; set; } = "";
    [Parameter] public OrgFlatView? DetailRow { get; set; }
    [Parameter] public bool AuditDialogVisible { get; set; }
    [Parameter] public string AuditDialogTitle { get; set; } = "";
    [Parameter] public string AuditCreateUser { get; set; } = "";
    [Parameter] public string AuditCreateTime { get; set; } = "";
    [Parameter] public string AuditUpdateUser { get; set; } = "";
    [Parameter] public string AuditUpdateTime { get; set; } = "";

    private static bool ContainsId(string[] values, string id)
    {
        for (var index = 0; index < values.Length; index++)
            if (values[index] == id)
                return true;
        return false;
    }

    private static string TreeRowStyle(OrgFlatView row, string selectedId)
    {
        var background = row.id == selectedId ? "background:#ecf5ff;color:#409eff;" : string.Empty;
        return background + "display:flex;align-items:center;gap:4px;padding:5px 8px 5px " +
               (8 + row.depth * 18) + "px;border-radius:5px;";
    }

    private static string TreeToggleText(OrgFlatView row, string[] expanded)
    {
        if (!row.hasChildren)
            return "·";
        return ContainsId(expanded, row.id) ? "−" : "+";
    }

    private static string DisplayValue(string value)
        => value.Length == 0 ? "-" : value;

}

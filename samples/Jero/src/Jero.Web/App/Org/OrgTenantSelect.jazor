@using Npm.Jero.ElementPlus
@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.Org

    <ProjectSelect ModelValue='@(Value)' placeholder='@(Placeholder)' clearable='@(Clearable)' filterable="true" loading='@(Loading)' @attributes="@(new ModelUpdate<string?>(Update))">
        @foreach (var option in Options) { <ElOption @key="option.value" value='@(option.value)' label='@(!string.IsNullOrEmpty(option.host) ? option.label + " (" + option.host + ")" : option.label)' /> }
    </ProjectSelect>

@code {
    private void Update(string? value) => OnChange(value ?? "");
    [Parameter] public OrgTenantOption[] Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public Action<string> OnChange { get; set; } = default!;
}

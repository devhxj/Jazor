@using Npm.ElementPlus
@using Npm.Jero.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.Job

<ElTable @attributes='@(new TableData<JobView>(State.rows))' border='@(true)' stripe='@(true)' RowKey="jobId" EmptyText="暂无作业">
            <ElTableColumn type="expand" width='@(52)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }
                    <div class="job-trigger-panel">
                        <div class="job-trigger-actions">
                            <ElButton type="primary" @onclick='@(_ => State.OpenCreateTrigger(cell))' disabled='@(State.Busy)'>新增触发器</ElButton>
                        </div>
                        <ElTable @attributes='@(new TableData<JobTriggerView>(State.TriggerRows(cell)))' border='@(true)' stripe='@(true)' RowKey="triggerId" EmptyText="暂无触发器">
                            <ElTableColumn type="index" label="序号" width='@(70)' align="center" />
                            <ElTableColumn prop="triggerId" label="触发器编号" MinWidth='@(180)' ShowOverflowTooltip='@(true)' />
                            <ElTableColumn label="类型" width='@(90)' align="center">
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }@(State.TriggerTypeTextForView(triggerCell))</template>
                            </ElTableColumn>
                            <ElTableColumn prop="args" label="参数" MinWidth='@(170)' ShowOverflowTooltip='@(true)' />
                            <ElTableColumn label="状态" MinWidth='@(130)' align="center">
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.TriggerStatusTagForView(triggerCell)))'>@(State.TriggerStatusTextForRow(triggerCell))</ElTag></template>
                            </ElTableColumn>
                            <ElTableColumn label="起始时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)'>
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(triggerCell, "startTime")))</template>
                            </ElTableColumn>
                            <ElTableColumn label="结束时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)'>
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(triggerCell, "endTime")))</template>
                            </ElTableColumn>
                            <ElTableColumn label="最近运行" MinWidth='@(170)' ShowOverflowTooltip='@(true)'>
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(triggerCell, "lastRunTime")))</template>
                            </ElTableColumn>
                            <ElTableColumn label="下一次运行" MinWidth='@(170)' ShowOverflowTooltip='@(true)'>
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(triggerCell, "nextRunTime")))</template>
                            </ElTableColumn>
                            <ElTableColumn prop="numberOfRuns" label="触发次数" width='@(110)' align="center" />
                            <ElTableColumn prop="maxNumberOfRuns" label="最大触发次数" width='@(130)' align="center" />
                            <ElTableColumn prop="numberOfErrors" label="出错次数" width='@(110)' align="center" />
                            <ElTableColumn prop="maxNumberOfErrors" label="最大出错次数" width='@(130)' align="center" />
                            <ElTableColumn prop="numRetries" label="重试次数" width='@(100)' align="center" />
                            <ElTableColumn prop="retryTimeout" label="重试间隔(ms)" width='@(130)' align="center" />
                            <ElTableColumn label="立即启动" width='@(100)' align="center">
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.RowBoolForView(triggerCell, "startNow") ? "success" : "info"))'>@(State.RowBoolForView(triggerCell, "startNow") ? "是" : "否")</ElTag></template>
                            </ElTableColumn>
                            <ElTableColumn label="启动时执行" width='@(120)' align="center">
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.RowBoolForView(triggerCell, "runOnStart") ? "success" : "info"))'>@(State.RowBoolForView(triggerCell, "runOnStart") ? "是" : "否")</ElTag></template>
                            </ElTableColumn>
                            <ElTableColumn label="重置次数" width='@(110)' align="center">
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.RowBoolForView(triggerCell, "resetOnlyOnce") ? "success" : "info"))'>@(State.RowBoolForView(triggerCell, "resetOnlyOnce") ? "是" : "否")</ElTag></template>
                            </ElTableColumn>
                            <ElTableColumn prop="updatedTime" label="更新时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)' />
                            <ElTableColumn label="操作" width='@(250)' align="center" fixed="right">
                                <template #default context="scope">@{ var triggerCell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerView>)(object)scope).row; }
                                    <div class="job-actions">
                                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.StartTrigger(triggerCell))'
                                                  loading='@(State.IsBusy("start-trigger:" + State.RowStringForView(triggerCell, "jobId") + ":" + State.RowStringForView(triggerCell, "triggerId")))' disabled='@(State.Busy)'>启动</ElButton>
                                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.PauseTrigger(triggerCell))'
                                                  loading='@(State.IsBusy("pause-trigger:" + State.RowStringForView(triggerCell, "jobId") + ":" + State.RowStringForView(triggerCell, "triggerId")))' disabled='@(State.Busy)'>暂停</ElButton>
                                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.OpenEditTrigger(triggerCell))' disabled='@(State.Busy)'>编辑</ElButton>
                                        <ElPopconfirm title='@("确定删除触发器【" + State.RowStringForView(triggerCell, "triggerId") + "】吗？")'
                                                      ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm='@(_ => State.DeleteTrigger(triggerCell))'>
                                            <template #reference>
                                                <ElButton link='@(true)' type="danger"
                                                          loading='@(State.IsBusy("delete-trigger:" + State.RowStringForView(triggerCell, "jobId") + ":" + State.RowStringForView(triggerCell, "triggerId")))'
                                                          disabled='@(State.Busy)'>删除</ElButton>
                                            </template>
                                        </ElPopconfirm>
                                    </div>
                                </template>
                            </ElTableColumn>
                        </ElTable>
                    </div>
                </template>
            </ElTableColumn>
            <ElTableColumn type="index" label="序号" width='@(70)' align="center" />
            <ElTableColumn prop="jobId" label="作业编号" MinWidth='@(180)' ShowOverflowTooltip='@(true)' />
            <ElTableColumn label="作业状态" width='@(110)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.JobStatusTagForView(cell)))'>@(State.JobStatusTextForView(cell))</ElTag></template>
            </ElTableColumn>
            <ElTableColumn prop="groupName" label="组名称" width='@(120)' align="center" />
            <ElTableColumn prop="jobType" label="类型" MinWidth='@(190)' ShowOverflowTooltip='@(true)' />
            <ElTableColumn label="执行方式" width='@(100)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.RowBoolForView(cell, "concurrent") ? "success" : "warning"))'>@(State.RowBoolForView(cell, "concurrent") ? "并行" : "串行")</ElTag></template>
            </ElTableColumn>
            <ElTableColumn label="创建类型" width='@(110)' align="center">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.CreateTypeTagForView(cell)))'>@(State.CreateTypeTextForRow(cell))</ElTag></template>
            </ElTableColumn>
            <ElTableColumn label="描述" MinWidth='@(180)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "description")))</template>
            </ElTableColumn>
            <ElTableColumn label="额外数据" MinWidth='@(220)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "properties")))</template>
            </ElTableColumn>
            <ElTableColumn label="更新时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)'>
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "updatedTime")))</template>
            </ElTableColumn>
            <ElTableColumn label="操作" width='@(430)' align="center" fixed="right">
                <template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobView>)(object)scope).row; }
                    <div class="job-actions">
                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.OpenRecords(cell))'>记录</ElButton>
                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.OpenCreateTrigger(cell))' disabled='@(State.Busy)'>触发器</ElButton>
                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.RunJob(cell))'
                                  loading='@(State.IsBusy("run-job:" + State.RowStringForView(cell, "jobId")))' disabled='@(State.Busy)'>执行</ElButton>
                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.StartJob(cell))'
                                  loading='@(State.IsBusy("start-job:" + State.RowStringForView(cell, "jobId")))' disabled='@(State.Busy)'>启动</ElButton>
                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.PauseJob(cell))'
                                  loading='@(State.IsBusy("pause-job:" + State.RowStringForView(cell, "jobId")))' disabled='@(State.Busy)'>暂停</ElButton>
                        <ElButton link='@(true)' type="primary" @onclick='@(_ => State.CancelJob(cell))'
                                  loading='@(State.IsBusy("cancel-job:" + State.RowStringForView(cell, "jobId")))' disabled='@(State.Busy)'>取消</ElButton>
                        @if (State.CanEdit) {
                            <ElButton link='@(true)' type="primary" @onclick='@(_ => State.OpenEditJob(cell))' disabled='@(State.Busy)'>编辑</ElButton>
                        }
                        @if (State.CanDelete) {
                            <ElPopconfirm title='@("确定删除作业【" + State.RowStringForView(cell, "jobId") + "】吗？对应触发器会一并删除。")'
                                          ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm='@(_ => State.DeleteJob(cell))'>
                                <template #reference>
                                    <ElButton link='@(true)' type="danger" loading='@(State.IsBusy("delete-job:" + State.RowStringForView(cell, "jobId")))' disabled='@(State.Busy)'>删除</ElButton>
                                </template>
                            </ElPopconfirm>
                        }
                    </div>
                </template>
            </ElTableColumn>
        </ElTable>

<ElDialog ModelValue='@(State.jobDialogVisible)'
          @attributes='@(new ModelUpdate<bool>(value => State.jobDialogVisible = value == true))'
          title='@(State.JobDialogTitle)'
          width="min(960px, calc(100vw - 24px))"
          top="3vh"
          draggable='@(true)'
          DestroyOnClose='@(true)'
          CloseOnClickModal='@(false)'>
    <div class="job-dialog-note">
        @if (State.JobIsBuiltIn) {
            <ElAlert type="warning" title="内置作业来自后端注册；编辑时保留作业类型、程序集与运行快照。" ShowIcon='@(true)' closable='@(false)' />
        } else if (State.JobIsHttp && !State.editHttpPropertiesValid) {
            <ElAlert type="warning" title="当前 HTTP 作业属性无法解析，表单已回退为空值；保存前请核对请求信息。" ShowIcon='@(true)' closable='@(false)' />
        } else {
            <ElAlert type="info" title="脚本作业保存时会由后端直接编译；HTTP 作业按 Furion HttpJob 属性格式提交。" ShowIcon='@(true)' closable='@(false)' />
        }
    </div>

    <ElForm LabelWidth="112px">
        <div class="job-form-grid">
            <ElFormItem label="作业编号">
                <ElInput ModelValue='@(State.editJobId)' @attributes='@(new ModelUpdate<string>(value => State.editJobId = value ?? ""))'
                         disabled='@(State.EditingJob)' maxlength='@(64)' ShowWordLimit='@(true)' clearable='@(true)' />
            </ElFormItem>
            <ElFormItem label="组名称">
                <ElInput ModelValue='@(State.editJobGroupName)' @attributes='@(new ModelUpdate<string>(value => State.editJobGroupName = value ?? ""))'
                         maxlength='@(128)' ShowWordLimit='@(true)' clearable='@(true)' />
            </ElFormItem>
            <div class="job-form-wide">
                <ElFormItem label="创建类型">
                    <ElInput ModelValue='@(State.CreateTypeTextForCode(State.editJobCreateType))' readonly='@(true)' />
                </ElFormItem>
            </div>
            <ElFormItem label="执行方式">
                <ElRadioGroup ModelValue='@(State.editJobConcurrent)' @attributes='@(new ModelUpdate<bool>(value => State.editJobConcurrent = value == true))'>
                    <ElRadio value='@(true)'>并行</ElRadio>
                    <ElRadio value='@(false)'>串行</ElRadio>
                </ElRadioGroup>
            </ElFormItem>
            <ElFormItem label="扫描触发器">
                <ElRadioGroup ModelValue='@(State.editJobIncludeAnnotation)' @attributes='@(new ModelUpdate<bool>(value => State.editJobIncludeAnnotation = value == true))'
                              disabled='@(State.EditingJob || State.JobIsHttp)'>
                    <ElRadio value='@(true)'>是</ElRadio>
                    <ElRadio value='@(false)'>否</ElRadio>
                </ElRadioGroup>
            </ElFormItem>
            <div class="job-form-wide">
                <ElFormItem label="描述信息">
                    <ElInput ModelValue='@(State.editJobDescription)' @attributes='@(new ModelUpdate<string>(value => State.editJobDescription = value ?? ""))'
                             type="textarea" rows='@(2)' maxlength='@(128)' ShowWordLimit='@(true)' />
                </ElFormItem>
            </div>
            @if (State.JobIsHttp) {
                <div class="job-form-wide">
                    <ElFormItem label="请求地址">
                        <ElInput ModelValue='@(State.editHttpRequestUri)' @attributes='@(new ModelUpdate<string>(value => State.editHttpRequestUri = value ?? ""))' clearable='@(true)' />
                    </ElFormItem>
                </div>
                <div class="job-form-wide">
                    <ElFormItem label="请求方法">
                        <ElRadioGroup ModelValue='@(State.editHttpMethod)' @attributes='@(new ModelUpdate<object?>(value => State.editHttpMethod = value is string text ? text : "GET"))'>
                            <ElRadio value="GET">GET</ElRadio>
                            <ElRadio value="POST">POST</ElRadio>
                            <ElRadio value="PUT">PUT</ElRadio>
                            <ElRadio value="DELETE">DELETE</ElRadio>
                        </ElRadioGroup>
                    </ElFormItem>
                </div>
                <div class="job-form-wide">
                    <ElFormItem label="请求报文体">
                        <ElInput ModelValue='@(State.editHttpBody)' @attributes='@(new ModelUpdate<string>(value => State.editHttpBody = value ?? ""))' type="textarea" rows='@(4)' />
                    </ElFormItem>
                </div>
            } else {
                <div class="job-form-wide">
                    <ElFormItem label="额外数据">
                        <ElInput ModelValue='@(State.editJobProperties)' @attributes='@(new ModelUpdate<string>(value => State.editJobProperties = value ?? ""))' type="textarea" rows='@(4)' />
                    </ElFormItem>
                </div>
            }
            @if (State.JobIsScript) {
                <div class="job-form-wide">
                    <ElAlert type="info" title="脚本中的 JobDetail 作业编号必须与表单完全一致。当前使用纯文本编辑器；Monaco worker/layout 仍需独立绑定。" ShowIcon='@(true)' closable='@(false)' />
                    <div style="height:10px"></div>
                    <ElFormItem label="脚本代码">
                        <ElInput class="job-script" ModelValue='@(State.editJobScriptCode)' @attributes='@(new ModelUpdate<string>(value => State.editJobScriptCode = value ?? ""))'
                                 type="textarea" rows='@(20)' />
                    </ElFormItem>
                </div>
            }
        </div>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
        <ElButton @onclick='@(_ => State.jobDialogVisible = false)' disabled='@(State.savingJob)'>取消</ElButton>
        <ElButton type="primary" @onclick='@(_ => State.SaveJob())' loading='@(State.savingJob)'>确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue='@(State.triggerDialogVisible)'
          @attributes='@(new ModelUpdate<bool>(value => State.triggerDialogVisible = value == true))'
          title='@(State.TriggerDialogTitle)'
          width="min(820px, calc(100vw - 24px))"
          top="3vh"
          draggable='@(true)'
          DestroyOnClose='@(true)'
          CloseOnClickModal='@(false)'>
    <ElForm LabelWidth="122px">
        <div class="job-form-grid">
            <ElFormItem label="作业编号">
                <ElInput ModelValue='@(State.editTriggerJobId)' readonly='@(true)' />
            </ElFormItem>
            <ElFormItem label="触发器编号">
                <ElInput ModelValue='@(State.editTriggerId)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerId = value ?? ""))'
                         maxlength='@(64)' ShowWordLimit='@(true)' clearable='@(true)' />
            </ElFormItem>
            <div class="job-form-wide">
                <ElFormItem label="触发器类型">
                    <ElRadioGroup ModelValue='@(State.editTriggerType)' @attributes='@(new ModelUpdate<object?>(value => State.editTriggerType = value is string text ? text : "Furion.Schedule.PeriodTrigger"))'>
                        <ElRadio value="Furion.Schedule.PeriodTrigger">间隔</ElRadio>
                        <ElRadio value="Furion.Schedule.CronTrigger">Cron表达式</ElRadio>
                    </ElRadioGroup>
                </ElFormItem>
            </div>
            @if (State.TriggerIsCron) {
                <div class="job-form-wide">
                    <ElFormItem label="Cron Macro">
                        <ProjectSelect ModelValue='@(State.editTriggerCron)' @attributes='@(new ModelUpdate<string>(value => State.ApplyCronMacro(value ?? "")))'
                                      placeholder="选择 Macro 或在下方直接输入" clearable='@(true)' filterable='@(true)'>
                            <ElOption label="@@secondly · 每秒" value="@@secondly" />
                            <ElOption label="@@minutely · 每分钟" value="@@minutely" />
                            <ElOption label="@@hourly · 每小时" value="@@hourly" />
                            <ElOption label="@@daily · 每天" value="@@daily" />
                            <ElOption label="@@monthly · 每月" value="@@monthly" />
                            <ElOption label="@@weekly · 每周" value="@@weekly" />
                            <ElOption label="@@yearly · 每年" value="@@yearly" />
                            <ElOption label="@@workday · 工作日" value="@@workday" />
                        </ProjectSelect>
                    </ElFormItem>
                </div>
                <div class="job-form-wide">
                    <ElFormItem label="Cron表达式">
                        <ElInput ModelValue='@(State.editTriggerCron)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerCron = value ?? ""))'
                                 placeholder="例如 0 0/5 * * * ?" />
                    </ElFormItem>
                </div>
            } else {
                <ElFormItem label="间隔时间(ms)">
                    <ElInput ModelValue='@(State.editTriggerPeriod)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerPeriod = value ?? ""))' />
                </ElFormItem>
            }
            <ElFormItem label="起始时间">
                <ElDatePicker ModelValue='@(State.editTriggerStartTime)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerStartTime = value ?? ""))'
                                  type="datetime" format="YYYY-MM-DD HH:mm:ss" ValueFormat="YYYY-MM-DD HH:mm:ss"
                                  placeholder="请选择起始时间" clearable='@(true)' />
            </ElFormItem>
            <ElFormItem label="结束时间">
                <ElDatePicker ModelValue='@(State.editTriggerEndTime)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerEndTime = value ?? ""))'
                                  type="datetime" format="YYYY-MM-DD HH:mm:ss" ValueFormat="YYYY-MM-DD HH:mm:ss"
                                  placeholder="请选择结束时间" clearable='@(true)' />
            </ElFormItem>
            <ElFormItem label="最大触发次数">
                <ElInput ModelValue='@(State.editTriggerMaxNumberOfRuns)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerMaxNumberOfRuns = value ?? "0"))' />
            </ElFormItem>
            <ElFormItem label="最大出错次数">
                <ElInput ModelValue='@(State.editTriggerMaxNumberOfErrors)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerMaxNumberOfErrors = value ?? "0"))' />
            </ElFormItem>
            <ElFormItem label="重试次数">
                <ElInput ModelValue='@(State.editTriggerNumRetries)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerNumRetries = value ?? "0"))' />
            </ElFormItem>
            <ElFormItem label="重试间隔(ms)">
                <ElInput ModelValue='@(State.editTriggerRetryTimeout)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerRetryTimeout = value ?? "1000"))' />
            </ElFormItem>
            <ElFormItem label="立即启动">
                <ElRadioGroup ModelValue='@(State.editTriggerStartNow)' @attributes='@(new ModelUpdate<bool>(value => State.editTriggerStartNow = value == true))'>
                    <ElRadio value='@(true)'>是</ElRadio><ElRadio value='@(false)'>否</ElRadio>
                </ElRadioGroup>
            </ElFormItem>
            <ElFormItem label="启动时执行一次">
                <ElRadioGroup ModelValue='@(State.editTriggerRunOnStart)' @attributes='@(new ModelUpdate<bool>(value => State.editTriggerRunOnStart = value == true))'>
                    <ElRadio value='@(true)'>是</ElRadio><ElRadio value='@(false)'>否</ElRadio>
                </ElRadioGroup>
            </ElFormItem>
            <div class="job-form-wide">
                <ElFormItem label="重置触发次数">
                    <ElRadioGroup ModelValue='@(State.editTriggerResetOnlyOnce)' @attributes='@(new ModelUpdate<bool>(value => State.editTriggerResetOnlyOnce = value == true))'>
                        <ElRadio value='@(true)'>是</ElRadio><ElRadio value='@(false)'>否</ElRadio>
                    </ElRadioGroup>
                </ElFormItem>
            </div>
            <div class="job-form-wide">
                <ElFormItem label="描述信息">
                    <ElInput ModelValue='@(State.editTriggerDescription)' @attributes='@(new ModelUpdate<string>(value => State.editTriggerDescription = value ?? ""))'
                             type="textarea" rows='@(3)' maxlength='@(128)' ShowWordLimit='@(true)' />
                </ElFormItem>
            </div>
        </div>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
        <ElButton @onclick='@(_ => State.triggerDialogVisible = false)' disabled='@(State.savingTrigger)'>取消</ElButton>
        <ElButton type="primary" @onclick='@(_ => State.SaveTrigger())' loading='@(State.savingTrigger)'>确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue='@(State.recordDialogVisible)'
          @attributes='@(new ModelUpdate<bool>(value => State.recordDialogVisible = value == true))'
          title='@("作业触发器运行记录 · " + State.recordJobId)'
          width="min(1120px, calc(100vw - 24px))"
          top="3vh">
    <div class="job-toolbar">
        <ElForm inline='@(true)'>
            <ElFormItem label="触发器">
                <ProjectSelect ModelValue='@(State.recordTriggerId)' @attributes='@(new ModelUpdate<string>(value => State.FilterRecords(value)))' placeholder="全部触发器" clearable='@(true)' filterable='@(true)'>
                    @foreach (var trigger in State.recordTriggerOptions) {
                        <ElOption label='@(trigger.triggerId)' value='@(trigger.triggerId)' />
                    }
                </ProjectSelect>
            </ElFormItem>
            <ElFormItem><ElButton @onclick='@(_ => State.LoadRecords())' loading='@(State.recordLoading)'>刷新</ElButton></ElFormItem>
        </ElForm>
        <ElPopconfirm title="后端接口会清空所有作业触发器运行记录，确定继续吗？"
                      ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm='@(_ => State.ClearRecords())'>
            <template #reference><ElButton type="danger" disabled='@(State.recordLoading || State.Busy)'>清空记录</ElButton></template>
        </ElPopconfirm>
    </div>
    <div style='@(State.recordLoading ? "" : "display:none")'><ElText>正在加载运行记录…</ElText></div>
    <ElTable @attributes='@(new TableData<JobTriggerRecordView>(State.recordRows))' border='@(true)' stripe='@(true)' RowKey="id" EmptyText="暂无运行记录">
        <ElTableColumn type="index" label="序号" width='@(70)' align="center" />
        <ElTableColumn prop="jobId" label="作业编号" MinWidth='@(150)' ShowOverflowTooltip='@(true)' />
        <ElTableColumn prop="triggerId" label="触发器编号" MinWidth='@(150)' ShowOverflowTooltip='@(true)' />
        <ElTableColumn prop="numberOfRuns" label="当前运行次数" width='@(120)' align="center" />
        <ElTableColumn label="最近运行时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)'><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerRecordView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "lastRunTime")))</template></ElTableColumn>
        <ElTableColumn label="下一次运行时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)'><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerRecordView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "nextRunTime")))</template></ElTableColumn>
        <ElTableColumn label="状态" width='@(130)' align="center"><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerRecordView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.TriggerStatusTagForView(cell)))'>@(State.TriggerStatusTextForRow(cell))</ElTag></template></ElTableColumn>
        <ElTableColumn label="执行结果" MinWidth='@(180)' ShowOverflowTooltip='@(true)'><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerRecordView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "result")))</template></ElTableColumn>
        <ElTableColumn prop="elapsedTime" label="耗时(ms)" width='@(100)' align="center" />
        <ElTableColumn label="创建时间" MinWidth='@(170)' ShowOverflowTooltip='@(true)'><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobTriggerRecordView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "createdTime")))</template></ElTableColumn>
    </ElTable>
    <div style="margin-top:16px;display:flex;justify-content:flex-end;">
        <ElPagination CurrentPage='@(State.recordPage)' PageSize='@(State.recordPageSize)' total='@(State.recordTotal)' PageSizes="@State.pageSizes"
                          background='@(true)' layout="total, sizes, prev, pager, next, jumper"
                          @oncurrent-change='@(value => State.ChangeRecordPage(value))' @onsize-change='@(value => State.ChangeRecordPageSize(value))' />
    </div>
</ElDialog>

<ElDialog ModelValue='@(State.clusterDialogVisible)'
          @attributes='@(new ModelUpdate<bool>(value => State.clusterDialogVisible = value == true))'
          title="作业集群"
          width="min(760px, calc(100vw - 24px))">
    <div class="job-toolbar"><span></span><ElButton @onclick='@(_ => State.LoadClusters())' loading='@(State.clusterLoading)'>刷新</ElButton></div>
    <div style='@(State.clusterLoading ? "" : "display:none")'><ElText>正在加载集群…</ElText></div>
    <ElTable @attributes='@(new TableData<JobClusterView>(State.clusterRows))' border='@(true)' stripe='@(true)' RowKey="clusterId" EmptyText="暂无作业集群数据">
        <ElTableColumn type="index" label="序号" width='@(70)' align="center" />
        <ElTableColumn prop="clusterId" label="集群编号" MinWidth='@(180)' ShowOverflowTooltip='@(true)' />
        <ElTableColumn label="状态" width='@(120)' align="center"><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobClusterView>)(object)scope).row; }<ElTag @attributes='@(new TableTagProps(State.ClusterStatusTagForView(cell)))'>@(State.ClusterStatusTextForView(cell))</ElTag></template></ElTableColumn>
        <ElTableColumn label="描述" MinWidth='@(180)' ShowOverflowTooltip='@(true)'><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobClusterView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "description")))</template></ElTableColumn>
        <ElTableColumn label="更新时间" MinWidth='@(180)' ShowOverflowTooltip='@(true)'><template #default context="scope">@{ var cell = (ECMAScript.Vue.VueProps)(object)((TableSlot<JobClusterView>)(object)scope).row; }@(State.DisplayValueForView(State.RowStringForView(cell, "updatedTime")))</template></ElTableColumn>
    </ElTable>
</ElDialog>

<style>
    .job-actions { display:flex; align-items:center; gap:4px 8px; flex-wrap:wrap; }
    .job-trigger-panel { min-width:0; padding:12px; background:#f8fafc; }
    .job-trigger-actions { display:flex; justify-content:flex-end; margin-bottom:10px; }
    .job-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 18px; }
    .job-form-wide { grid-column:1 / -1; }
    .job-dialog-note { margin-bottom:14px; }
    .job-script { font-family:ui-monospace,SFMono-Regular,Consolas,monospace; }
    @media(max-width:700px) {
        .job-form-grid { grid-template-columns:1fr; }
        .job-form-wide { grid-column:auto; }
    }
</style>

@code {
    [Parameter] public IJobContentState State { get; set; } = default!;
}

@using Npm.ElementPlus
@using Npm.Jero.ElementPlus
@using Jero.Web.App.Components

<ProjectSelect ModelValue="@Value" Loading="@Loading" Placeholder="请选择组名称" Clearable="true" Filterable="true"
          @attributes='@(new ModelUpdate<object?>(value => OnChange(value is string text ? text : "")))'>
    @foreach (var group in Options)
    {
        <ElOption Label="@@group" Value="@@group" />
    }
</ProjectSelect>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string[] Options { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public Action<string> OnChange { get; set; } = default!;
}

@using Jero.Web.App.Job
@using Npm.ElementPlus

<style>
    .job-dashboard-page { min-width:0; display:grid; gap:16px; }
    .job-dashboard-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
    .job-dashboard-heading h1 { margin:0; color:#303133; font-size:23px; }
    .job-dashboard-heading p { margin:7px 0 0; color:#909399; font-size:13px; }
    .job-dashboard-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .job-dashboard-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
    .job-dashboard-card { min-width:0; border:1px solid #ebeef5; border-radius:8px; padding:14px; background:#fafbfc; }
    .job-dashboard-card span { display:block; color:#909399; font-size:12px; }
    .job-dashboard-card strong { display:block; margin-top:8px; color:#303133; font-size:25px; overflow-wrap:anywhere; }
    .job-dashboard-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .job-dashboard-section { min-width:0; padding:16px; border:1px solid #ebeef5; border-radius:8px; background:#fff; }
    .job-dashboard-title { margin:0 0 12px; color:#303133; font-size:15px; }
    @@media(max-width:900px) {
        .job-dashboard-summary { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .job-dashboard-grid { grid-template-columns:1fr; }
    }
    @@media(max-width:700px) {
        .job-dashboard-heading { flex-direction:column; }
        .job-dashboard-summary { grid-template-columns:1fr; }
    }
</style>

<div class="job-dashboard-page">
    <div class="job-dashboard-heading">
        <div>
            <h1>任务看板</h1>
            <p>聚合查看作业、触发器、集群和最近执行记录，便于快速判断调度运行状态。</p>
        </div>
        <div class="job-dashboard-actions">
            <ElButton @onclick="@(_ => LoadDashboard())" Loading="@Loading">刷新</ElButton>
            <ElButton @onclick="@(_ => BackToJobs())">返回</ElButton>
        </div>
    </div>

    @if (Error is not null)
    {
        <ElAlert Title="@(Error ?? "")" Type="error" ShowIcon="true" Closable="false" />
    }

    <div class="job-dashboard-summary">
        <div class="job-dashboard-card"><span>作业总数</span><strong>@TotalJobs</strong></div>
        <div class="job-dashboard-card"><span>触发器总数</span><strong>@TotalTriggers</strong></div>
        <div class="job-dashboard-card"><span>运行中触发器</span><strong>@RunningTriggerCount</strong></div>
        <div class="job-dashboard-card"><span>异常触发器</span><strong>@AbnormalTriggerCount</strong></div>
        <div class="job-dashboard-card"><span>工作中集群</span><strong>@ClusterWorkingCount</strong></div>
        <div class="job-dashboard-card"><span>等待唤醒集群</span><strong>@ClusterWaitingCount</strong></div>
        <div class="job-dashboard-card"><span>暂停触发器</span><strong>@PausedTriggerCount</strong></div>
        <div class="job-dashboard-card"><span>最近记录数</span><strong>@RecordRows.Length</strong></div>
    </div>

    <JobDashboardTables GroupRows="@GroupRows" ClusterRows="@ClusterRows" JobRows="@JobRows" RecordRows="@RecordRows" />
</div>

@code {
    [Parameter] public int TotalJobs { get; set; }
    [Parameter] public int TotalTriggers { get; set; }
    [Parameter] public int RunningTriggerCount { get; set; }
    [Parameter] public int AbnormalTriggerCount { get; set; }
    [Parameter] public int ClusterWorkingCount { get; set; }
    [Parameter] public int ClusterWaitingCount { get; set; }
    [Parameter] public int PausedTriggerCount { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public Action LoadDashboard { get; set; } = default!;
    [Parameter] public Action BackToJobs { get; set; } = default!;
    [Parameter] public JobDashboardGroupView[] GroupRows { get; set; } = [];
    [Parameter] public JobClusterView[] ClusterRows { get; set; } = [];
    [Parameter] public JobView[] JobRows { get; set; } = [];
    [Parameter] public JobTriggerRecordView[] RecordRows { get; set; } = [];
}

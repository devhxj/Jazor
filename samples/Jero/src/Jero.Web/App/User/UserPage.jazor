    private static string OrgButtonClass(string selectedId, string id)
        => "user-org-item" + (selectedId == id ? " is-active" : "");

    private static string OrgIndent(UserTreeRow option)
        => "padding-left:" + (12 + option.depth * 18) + "px";

    private static string RoleButtonClass(string[] selected, string id)
        => "user-role-option" + (ContainsId(selected, id) ? " is-selected" : "");

    private static string PanelStyle(string active, string panel) => active == panel ? "" : "display:none";

    private static bool ContainsId(string[] ids, string id)
    {
        foreach (var value in ids)
            if (value == id)
                return true;
        return false;
    }
}

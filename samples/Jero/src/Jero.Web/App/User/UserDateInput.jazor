@using Npm.ElementPlus
@using Jero.Web.App.Components

<ElDatePicker type="date" ModelValue="@Value" placeholder="@Placeholder"
format="YYYY-MM-DD" ValueFormat="YYYY-MM-DD" clearable="true"
@attributes="@(new ModelUpdate<object?>(Update))" />

@code {
    [Parameter] public string Value { get; set; } = default!;
    [Parameter] public string Placeholder { get; set; } = default!;
    [Parameter] public Action<string> Change { get; set; } = default!;

    private void Update(object? value) => Change(value as string ?? "");
}

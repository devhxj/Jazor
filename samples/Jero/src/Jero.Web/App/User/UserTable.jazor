@using Npm.ElementPlus
@using Jero.Web.App.Components
@using Jero.Web.App.User

<style scoped>
.user-status-cell, .user-action-buttons {
display: flex;
align-items: center;
justify-content: center;
gap: 8px;
}
.user-action-buttons { flex-wrap: wrap; }
.user-action-buttons :deep(.el-button + .el-button) { margin-left: 0; }
</style>

<ElTable @attributes="@(new TableData<UserTableRow>(Rows))"
    border="true"
    stripe="true"
    RowKey="id"
    EmptyText="暂无账号">
    <ElTableColumn type="index" label="序号" width="70" align="center" />
    <ElTableColumn label="头像" width="76" align="center">
        <template #default context="cell">@{ var row = ((TableSlot<UserTableRow>)(object)cell).row; }
                <ElAvatar size='@(32)' src='@(row.avatarSource)' />
            </template>
        </ElTableColumn>
        <ElTableColumn prop="account" label="账号" MinWidth="140" ShowOverflowTooltip="true" />
        <ElTableColumn prop="realName" label="姓名" MinWidth="120" ShowOverflowTooltip="true" />
        <ElTableColumn prop="phone" label="手机" MinWidth="130" ShowOverflowTooltip="true" />
        <ElTableColumn label="账号类型" width="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<UserTableRow>)(object)cell).row; }
                    <ElTag @attributes='@(new TableTagProps(Tag(row.accountTypeTag)))'>@(row.accountTypeLabel)</ElTag>
                </template>
            </ElTableColumn>
            <ElTableColumn prop="roleName" label="角色" MinWidth="170" ShowOverflowTooltip="true" />
            <ElTableColumn prop="orgName" label="机构" MinWidth="150" ShowOverflowTooltip="true" />
            <ElTableColumn prop="posName" label="职位" MinWidth="130" ShowOverflowTooltip="true" />
            <ElTableColumn label="状态" width="126" align="center">
                <template #default context="cell">@{ var row = ((TableSlot<UserTableRow>)(object)cell).row; }
                        <div class="user-status-cell">
                            <ElTag @attributes='@(new TableTagProps(Tag(row.statusTag)))'>@(row.statusText)</ElTag>
                            @if (CanSetStatus) {
                                <ElPopconfirm title='@(row.statusConfirm)'
                                ConfirmButtonText="确定"
                                CancelButtonText="取消"
                                @onconfirm="@(() => SetStatus(row.id))">
                                <template #reference>
                                    <ElButton link="true"
                                    type="primary"
                                    loading='@(row.isChangingStatus)'
                                    disabled='@(StatusLoadingId.Length > 0)'>@(row.statusAction)</ElButton>
                            </template>
                        </ElPopconfirm>

                    }
                </div>
            </template>
        </ElTableColumn>
        <ElTableColumn prop="orderNo" label="排序" width="80" align="center" />
        <ElTableColumn label="修改记录" width="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<UserTableRow>)(object)cell).row; }
                    @if (CanDetail) {
                        <ElButton link="true" type="primary" @onclick="@(() => OpenDetail(row.id))">查看</ElButton>

                        }<template v-else>
                            <span>@(row.updateTime)</span>

                        </template>
                    </template>
                </ElTableColumn>
                @if (HasActionColumn) {
                    <!-- 410px 固定列会在常见桌面宽度覆盖状态列并截获点击；操作区随表格横向滚动才可保证相邻列可用。 -->
                    <ElTableColumn label="操作" MinWidth="410" align="center">
                        <template #default context="cell">@{ var row = ((TableSlot<UserTableRow>)(object)cell).row; }
                                <div class="user-action-buttons">
                                    @if (CanDetail) {
                                        <ElButton link="true" type="primary" @onclick="@(() => OpenDetail(row.id))">详情</ElButton>

                                    }
                                    @if (CanEdit) {
                                        <ElButton link="true" type="primary" @onclick="@(() => OpenEdit(row.id))">编辑</ElButton>

                                    }
                                    @if (CanGrantRole) {
                                        <ElButton link="true" type="primary" @onclick="@(() => OpenGrantRoles(row.id))">授权角色</ElButton>

                                    }
                                    @if (CanAdd) {
                                        <ElButton link="true" type="primary" @onclick="@(() => OpenCopy(row.id))">复制</ElButton>

                                    }
                                    @if (CanResetPassword) {
                                        <ElPopconfirm title='@("确定重置账号【" + row.account + "】的密码吗？")'
                                        ConfirmButtonText="确定"
                                        CancelButtonText="取消"
                                        @onconfirm="@(() => ResetPassword(row.id))">
                                        <template #reference>
                                            <ElButton link="true"
                                            type="warning"
                                            loading='@(row.isResetting)'
                                            disabled='@(ResetLoadingId.Length > 0)'>重置密码</ElButton>
                                    </template>
                                </ElPopconfirm>

                            }
                            @if (CanUnlockLogin) {
                                <ElPopconfirm title='@("确定解除账号【" + row.account + "】的登录锁定吗？")'
                                ConfirmButtonText="确定"
                                CancelButtonText="取消"
                                @onconfirm="@(() => UnlockLogin(row.id))">
                                <template #reference>
                                    <ElButton link="true"
                                    type="primary"
                                    loading='@(row.isUnlocking)'
                                    disabled='@(UnlockLoadingId.Length > 0)'>解除锁定</ElButton>
                            </template>
                        </ElPopconfirm>

                    }
                    @if (CanDelete) {
                        <ElPopconfirm title='@("确定删除账号【" + row.account + "】吗？")'
                        ConfirmButtonText="确定"
                        CancelButtonText="取消"
                        @onconfirm="@(() => Delete(row.id))">
                        <template #reference>
                            <ElButton link="true"
                            type="danger"
                            loading='@(row.isDeleting)'
                            disabled='@(DeletingId.Length > 0)'>删除</ElButton>
                    </template>
                </ElPopconfirm>

            }
        </div>
    </template>
</ElTableColumn>

}
</ElTable>

@code {
    [Parameter] public UserTableRow[] Rows { get; set; } = [];
    [Parameter] public bool CanSetStatus { get; set; }
    [Parameter] public bool CanDetail { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanGrantRole { get; set; }
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanResetPassword { get; set; }
    [Parameter] public bool CanUnlockLogin { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public string StatusLoadingId { get; set; } = default!;
    [Parameter] public string ResetLoadingId { get; set; } = default!;
    [Parameter] public string UnlockLoadingId { get; set; } = default!;
    [Parameter] public string DeletingId { get; set; } = default!;
    [Parameter] public Action<string> SetStatus { get; set; } = default!;
    [Parameter] public Action<string> OpenDetail { get; set; } = default!;
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> OpenGrantRoles { get; set; } = default!;
    [Parameter] public Action<string> OpenCopy { get; set; } = default!;
    [Parameter] public Action<string> ResetPassword { get; set; } = default!;
    [Parameter] public Action<string> UnlockLogin { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;

    private static string Tag(string value) => value is "success" or "warning" or "danger" or "info" ? value : "primary";
}

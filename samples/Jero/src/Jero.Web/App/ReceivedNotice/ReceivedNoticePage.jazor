@using Jero.Web.App.ReceivedNotice
@using Npm.ElementPlus
@using App.Components

<ElCard Header="站内信" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        查看我收到的站内信，打开未读消息详情后自动标记为已读。
    </p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            <ElFormItem Label="标题">
                <ElInput ModelValue="@QueryTitle"
                         @onupdate:modelValue="SetTitle"
                         Placeholder="搜索站内信标题"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="类型">
                <div style="width:180px">
                    <NoticeTypeSelect Value="@QueryType" Options="@TypeOptions" Loading="@OptionsLoading" Change="@SetType" />
                </div>
            </ElFormItem>
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
                <ElButton @onclick="Refresh" Loading="@Loading">刷新</ElButton>
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        @if (Loading)
        {
            <ElText>正在加载站内信…</ElText>
        }

        <div class="jero-list-scroll">
            <NoticeTable Rows="@Rows" TypeOptions="@TypeOptions" MarkingRead="@MarkingRead" OpenDetail="@OpenDetail" />
        </div>

        <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <ElPagination CurrentPage="@CurrentPage"
                              PageSize="@PageSize"
                              Total="@Total"
                              PageSizes="@PageSizes"
                              Background="true"
                              Layout="total, sizes, prev, pager, next, jumper"
                              @oncurrent-change="ChangePage"
                              @onsize-change="ChangePageSize" />
        </div>
    </ElCard>
</ElCard>

<ElDialog ModelValue="@DetailDialogVisible"
          @onupdate:modelValue="SetDialogVisible"
          Title="@DetailTitle"
          Width="720px"
          Draggable="true"
          DestroyOnClose="true">
    <div innerHTML="@DetailContent"
         style="min-height:120px;line-height:1.7;word-break:break-word;"></div>
</ElDialog>

@code {
    [Parameter] public ReceivedNoticeView[] Rows { get; set; } = [];
    [Parameter] public ReceivedNoticeOption[] TypeOptions { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    private readonly double[] PageSizes = [10, 20, 50, 100];
    [Parameter] public string QueryTitle { get; set; } = "";
    [Parameter] public int QueryType { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool OptionsLoading { get; set; }
    [Parameter] public bool MarkingRead { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool DetailDialogVisible { get; set; }
    [Parameter] public string DetailTitle { get; set; } = "";
    [Parameter] public string DetailContent { get; set; } = "";

    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action<string> SetTitle { get; set; } = default!;
    [Parameter] public Action<double> SetType { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action<double> ChangePage { get; set; } = default!;
    [Parameter] public Action<double> ChangePageSize { get; set; } = default!;
    [Parameter] public Action<string> OpenDetail { get; set; } = default!;
    [Parameter] public Action<bool> SetDialogVisible { get; set; } = default!;

}

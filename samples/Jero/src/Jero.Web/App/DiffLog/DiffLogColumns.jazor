@using Npm.ElementPlus
@using Jero.Web.App.DiffLog
@using Jero.Web.App.Components

<ElTable @attributes="@(new TableData<DiffLogColumnView>(Rows))" border="true" stripe="true" EmptyText="暂无字段差异">
                <ElTableColumn label="字段描述" MinWidth="240">
                    <template #default context="cell">@{ var row = ((TableSlot<DiffLogColumnView>)(object)cell).row; }@(ColumnLabel(row))</template>
                </ElTableColumn>
                <ElTableColumn label="主键" width="80" align="center">
                    <template #default context="cell">@{ var row = ((TableSlot<DiffLogColumnView>)(object)cell).row; }@(row.isPrimaryKey ? "是" : "否")</template>
                </ElTableColumn>
                <ElTableColumn label="修改前" MinWidth="320">
                    <template #default context="cell">@{ var row = ((TableSlot<DiffLogColumnView>)(object)cell).row; }
                        <pre style="margin:0;white-space:pre-wrap;word-break:break-word;color:#f56c6c;">@(Display(row.beforeValue))</pre>
                    </template>
                </ElTableColumn>
                <ElTableColumn label="修改后" MinWidth="320">
                    <template #default context="cell">@{ var row = ((TableSlot<DiffLogColumnView>)(object)cell).row; }
                        <pre style="margin:0;white-space:pre-wrap;word-break:break-word;color:#67c23a;">@(Display(row.afterValue))</pre>
                    </template>
                </ElTableColumn>
            </ElTable>

@code {
    [Parameter] public DiffLogColumnView[] Rows { get; set; } = [];

    private static string Display(string value) => string.IsNullOrEmpty(value) ? "-" : value;
    private static string ColumnLabel(DiffLogColumnView row) => Display(string.IsNullOrEmpty(row.columnName) ? row.columnDescription : string.IsNullOrEmpty(row.columnDescription) ? row.columnName : row.columnName + " - " + row.columnDescription);
}

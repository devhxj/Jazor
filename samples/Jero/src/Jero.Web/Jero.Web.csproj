<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <JazorSourceRoot>$(MSBuildThisFileDirectory)../../../../src/</JazorSourceRoot>
  </PropertyGroup>
  <Import Project="$(JazorSourceRoot)Jazor/build/Jazor.props" />
  <Import Project="$(JazorSourceRoot)ECMAScript.Vue/buildTransitive/ECMAScript.Vue.props" />
  <Import Project="$(JazorSourceRoot)ECMAScript.Vue/buildTransitive/ECMAScript.Vue.targets" />
  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <UserSecretsId>ad9369d1-f29b-4f8f-a7df-8b4d7aa0726b</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Version>1.0.0</Version>

    <LangVersion>preview</LangVersion>
    <!-- Keep authored components in the IDE. Only dependencies and build products are hidden. -->
    <_SpaGenerated>node_modules/**;.jazor/**;.jolt/**;bin/**;obj/**;dist/**</_SpaGenerated>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(_SpaGenerated);logs/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jero.Test" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web SDK classifies JSON as deployable content. Vite owns the SPA asset layout. -->
    <Content Update="Pages/**;package.json;pnpm-lock.yaml;runtime.manifest.json;vite.config.mjs;index.html"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <JazorLibraryManifest Remove="$(JazorSourceRoot)ECMAScript.Vue/jazor/vue3/manifest.json" />
    <JazorLibraryManifest Include="$(MSBuildProjectDirectory)/runtime.manifest.json" />
    <JazorLibraryManifest Include="$(JazorSourceRoot)ECMAScript.Vue/manifest.json;$(JazorSourceRoot)ECMAScript.VueRoute/manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\avatar\**;wwwroot\upload\**" CopyToPublishDirectory="Never" />
    <None Update="Jero.db" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="Jero.db" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\template\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="GeoLite2-City.mmdb;ip2region.db" CopyToOutputDirectory="PreserveNewest" />
    <None Update="UpdateScripts\1.0.0.sql" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="sensitive-words.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jero.Application\Jero.Application.csproj" />
    <ProjectReference Include="$(JazorSourceRoot)ECMAScript.VueRoute/ECMAScript.VueRoute.csproj" />
    <ProjectReference Include="$(JazorSourceRoot)Jazor.AspNetCore.Dev/Jazor.AspNetCore.Dev.csproj" />
    <ProjectReference Include="$(JazorSourceRoot)Jazor.Analyzer/Jazor.Analyzer.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(JazorSourceRoot)Jazor.Emit/Jazor.Emit.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <ProjectReference Include="$(JazorSourceRoot)Jolt.Cli/Jolt.Cli.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="$(JazorSourceRoot)Jazor/build/Jazor.targets" />

  <Target Name="ResolveJeroAnalyzer" BeforeTargets="CoreCompile">
    <MSBuild Projects="$(JazorSourceRoot)Jazor.Analyzer/Jazor.Analyzer.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_JeroAnalyzerAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_JeroAnalyzerDirectory>@(_JeroAnalyzerAssembly->'%(RootDir)%(Directory)')</_JeroAnalyzerDirectory>
    </PropertyGroup>
    <ItemGroup>
      <!-- Roslyn needs the same dependency closure as the packaged analyzer. -->
      <Analyzer Include="$(_JeroAnalyzerDirectory)Jazor.Analyzer.dll;$(_JeroAnalyzerDirectory)Jazor.Compiler.dll;$(_JeroAnalyzerDirectory)Jazor.Common.dll;$(_JeroAnalyzerDirectory)ECMAScript.Contract.dll;$(_JeroAnalyzerDirectory)Acornima.dll;$(_JeroAnalyzerDirectory)Acornima.Extras.dll;$(_JeroAnalyzerDirectory)ICSharpCode.Decompiler.dll" />
    </ItemGroup>
  </Target>

</Project>

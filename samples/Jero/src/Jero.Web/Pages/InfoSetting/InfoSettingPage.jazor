@using Npm.ElementPlus
@using Jero.Web.Pages.Tenant
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Components

<style>
    .info-setting { display: grid; gap: 18px; }
    .info-setting__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; border-bottom: 1px solid #e5e7eb; padding: 0 2px 18px; }
    .info-setting__head h1 { margin: 0; color: #172033; font-size: 24px; line-height: 1.25; }
    .info-setting__head p { max-width: 760px; margin: 7px 0 0; color: #667085; line-height: 1.65; }
    .info-setting__surface { overflow: hidden; border: 1px solid #e5e7eb; border-radius: 12px; background: #fff; }
    .info-setting__section { padding: 24px; }
    .info-setting__section + .info-setting__section { border-top: 1px solid #eef0f3; }
    .info-setting__section-title { margin: 0; color: #172033; font-size: 17px; }
    .info-setting__section-copy { margin: 6px 0 20px; color: #7a8493; font-size: 13px; line-height: 1.6; }
    .info-setting__brand-grid { display: grid; grid-template-columns: minmax(250px, 330px) minmax(0, 1fr); gap: 28px; align-items: start; }
    .info-setting__preview { display: grid; gap: 16px; border: 1px solid #dde3ea; border-radius: 12px; padding: 22px; background: #f8fafc; text-align: center; }
    .info-setting__logo-frame { display: grid; width: 138px; height: 138px; place-items: center; justify-self: center; overflow: hidden; border: 1px dashed #b8c2cf; border-radius: 20px; background: #fff; }
    .info-setting__logo-frame img { width: 112px; height: 112px; object-fit: contain; }
    .info-setting__logo-empty { color: #98a2b3; font-size: 13px; }
    .info-setting__preview h2 { margin: 0; color: #172033; font-size: 19px; overflow-wrap: anywhere; }
    .info-setting__preview-subtitle { color: #667085; font-size: 14px; overflow-wrap: anywhere; }
    .info-setting__preview-desc { color: #7a8493; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
    .info-setting__file { width: 100%; color: #667085; font: inherit; font-size: 13px; }
    .info-setting__file-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .info-setting__file-name { color: #667085; font-size: 12px; overflow-wrap: anywhere; }
    .info-setting__fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 20px; }
    .info-setting__span-2 { grid-column: 1 / -1; }
    .info-setting__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .info-setting__tip { min-height: 40px; display: flex; align-items: center; color: #7a8493; font-size: 13px; line-height: 1.6; }
    .info-setting__empty { margin-top: 12px; border: 1px dashed #f3c780; border-radius: 8px; padding: 12px 14px; background: #fff8eb; color: #9a6400; font-size: 13px; }
    @@media (max-width: 920px) {
        .info-setting__brand-grid { grid-template-columns: 1fr; }
        .info-setting__preview { grid-template-columns: 150px minmax(0, 1fr); align-items: center; text-align: left; }
        .info-setting__logo-frame { grid-row: 1 / span 5; }
        .info-setting__file-actions { justify-content: flex-start; }
    }
    @@media (max-width: 640px) {
        .info-setting__head { align-items: stretch; flex-direction: column; }
        .info-setting__head .el-button { width: 100%; }
        .info-setting__section { padding: 18px 14px; }
        .info-setting__fields, .info-setting__row { grid-template-columns: 1fr; }
        .info-setting__span-2 { grid-column: auto; }
        .info-setting__preview { grid-template-columns: 1fr; text-align: center; }
        .info-setting__logo-frame { grid-row: auto; }
        .info-setting__file-actions { justify-content: center; }
    }
</style>

<div class="info-setting">
    <header class="info-setting__head">
        <div>
            <h1>系统配置</h1>
            <p>配置当前租户的品牌信息、后台默认首页和用户注册入口。保存会更新运行时租户信息及 Logo 文件。</p>
        </div>
        <ElButton Type="primary" @onclick="Save" Loading="@Saving" Disabled="@(Loading || ReadingLogo)">保存配置</ElButton>
    </header>

    <div style='@(Error is null ? "display:none" : "")'>
        <ElAlert Type="error" Title="@(Error ?? "")" ShowIcon="true" Closable="true" @onclose="DismissError" />
    </div>

    <ElAlert Type="info"
             Title="@(HideTenantForLogin ? "登录页已隐藏租户选择入口" : "登录页显示租户选择入口")"
             ShowIcon="true"
             Closable="false" />

    <div class="info-setting__surface">
        <section class="info-setting__section">
            <h2 class="info-setting__section-title">品牌配置</h2>
            <p class="info-setting__section-copy">Logo 与文字会用于当前租户站点的对外展示；选择新 Logo 后可先在本页预览。</p>

            <div class="info-setting__brand-grid">
                <aside class="info-setting__preview">
                    <div class="info-setting__logo-frame">
                        <img src="@LogoSource" alt="系统 Logo 预览" style='@(CurrentLogo.Length > 0 ? "" : "display:none")' />
                        <span class="info-setting__logo-empty" style='@(CurrentLogo.Length == 0 ? "" : "display:none")'>暂无 Logo</span>
                    </div>
                    <h2>@(Title.Trim().Length == 0 ? "系统主标题" : Title)</h2>
                    <div class="info-setting__preview-subtitle">@(ViceTitle.Trim().Length == 0 ? "系统副标题" : ViceTitle)</div>
                    <div class="info-setting__preview-desc">@(ViceDesc.Trim().Length == 0 ? "系统描述预览" : ViceDesc)</div>
                    <LogoFileInput Id="@LogoInputId" Change="@SelectLogo" />
                    <div class="info-setting__file-actions">
                        <ElButton @onclick="PreviewSelectedLogo" Loading="@ReadingLogo" Disabled="@Saving">预览已选 Logo</ElButton>
                        <ElButton @onclick="RestoreStoredLogo" Disabled="@(Saving || ReadingLogo)">恢复当前 Logo</ElButton>
                    </div>
                    <div class="info-setting__file-name" style='@(SelectedLogoFileName.Length > 0 ? "" : "display:none")'>待保存：@SelectedLogoFileName</div>
                </aside>

                <ElForm LabelPosition="top">
                    <div class="info-setting__fields">
                        <ElFormItem Label="系统主标题">
                            <ElInput ModelValue="@Title" @onupdate:modelValue="SetTitle" Maxlength="32" ShowWordLimit="true" Clearable="true" Placeholder="请输入系统主标题" />
                        </ElFormItem>
                        <ElFormItem Label="系统副标题">
                            <ElInput ModelValue="@ViceTitle" @onupdate:modelValue="SetViceTitle" Maxlength="32" ShowWordLimit="true" Clearable="true" Placeholder="请输入系统副标题" />
                        </ElFormItem>
                        <div class="info-setting__span-2">
                            <ElFormItem Label="系统描述">
                                <ElInput ModelValue="@ViceDesc" @onupdate:modelValue="SetViceDesc" Maxlength="64" ShowWordLimit="true" Clearable="true" Placeholder="请输入系统描述" />
                            </ElFormItem>
                        </div>
                        <div class="info-setting__span-2">
                            <ElFormItem Label="水印内容">
                                <ElInput ModelValue="@Watermark" @onupdate:modelValue="SetWatermark" Maxlength="32" ShowWordLimit="true" Clearable="true" Placeholder="留空则不启用水印" />
                            </ElFormItem>
                        </div>
                        <div class="info-setting__span-2">
                            <ElFormItem Label="版权说明">
                                <ElInput ModelValue="@Copyright" @onupdate:modelValue="SetCopyright" Maxlength="64" ShowWordLimit="true" Clearable="true" Placeholder="请输入版权说明" />
                            </ElFormItem>
                        </div>
                        <ElFormItem Label="ICP备案号">
                            <ElInput ModelValue="@Icp" @onupdate:modelValue="SetIcp" Maxlength="32" ShowWordLimit="true" Clearable="true" Placeholder="请输入ICP备案号" />
                        </ElFormItem>
                        <ElFormItem Label="ICP 地址">
                            <ElInput ModelValue="@IcpUrl" @onupdate:modelValue="SetIcpUrl" Maxlength="32" ShowWordLimit="true" Clearable="true" Placeholder="请输入 ICP 地址" />
                        </ElFormItem>
                    </div>
                </ElForm>
            </div>
        </section>

        <section class="info-setting__section">
            <h2 class="info-setting__section-title">后台配置</h2>
            <p class="info-setting__section-copy">用户未设置个性化首页时，登录后进入这里配置的后台内部路由。</p>
            <div class="info-setting__row">
                <ElForm LabelPosition="top">
                    <ElFormItem Label="默认首页">
                        <ElInput ModelValue="@DefaultHomePath" @onupdate:modelValue="SetDefaultHomePath" Maxlength="512" ShowWordLimit="true" Clearable="true" Placeholder="@DefaultHomePlaceholder" />
                    </ElFormItem>
                </ElForm>
                <div class="info-setting__tip">仅支持以 <strong style="margin:0 4px;">/</strong> 开头的后台内部路由，不支持外部链接。</div>
            </div>
        </section>

        <section class="info-setting__section">
            <h2 class="info-setting__section-title">注册配置</h2>
            <p class="info-setting__section-copy">控制当前租户是否允许用户注册，并指定注册时使用的默认方案。</p>
            <ElForm LabelPosition="top">
                <div class="info-setting__row">
                    <ElFormItem Label="用户注册">
                        <TenantRadio Value="@EnableReg" FirstValue="@(1)" FirstLabel="启用" SecondValue="@(2)" SecondLabel="禁用" Change="@SetEnableReg" />
                    </ElFormItem>
                    <ElFormItem Label="默认注册方案">
                        <AuthOptionSelect Value="@RegWayId" Options="@WayOptions" Disabled="@(!RegistrationEnabled)" Placeholder="请选择默认注册方案" Clearable="true" Change="@SetRegWayId" />
                    </ElFormItem>
                </div>
            </ElForm>
            <div class="info-setting__empty" style='@(RegistrationEnabled && WayOptions.Length == 0 ? "" : "display:none")'>当前租户尚未配置可用的注册方案。</div>
        </section>
    </div>
</div>

@code {
    [Parameter] public string LogoInputId { get; set; } = "";
    [Parameter] public Action SelectLogo { get; set; } = default!;
    [Parameter] public string LogoSource { get; set; } = "";
    [Parameter] public string CurrentLogo { get; set; } = "";
    [Parameter] public string DefaultHomePlaceholder { get; set; } = "";
    [Parameter] public string SelectedLogoFileName { get; set; } = "";
    [Parameter] public string RegWayId { get; set; } = "";
    [Parameter] public int EnableReg { get; set; }
    [Parameter] public ConfigurationOption[] WayOptions { get; set; } = [];
    [Parameter] public bool RegistrationEnabled { get; set; }
    [Parameter] public bool HideTenantForLogin { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool ReadingLogo { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action PreviewSelectedLogo { get; set; } = default!;
    [Parameter] public Action RestoreStoredLogo { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action<double> SetEnableReg { get; set; } = default!;
    [Parameter] public Action<string> SetRegWayId { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public Action<string?> SetTitle { get; set; } = default!;
    [Parameter] public string ViceTitle { get; set; } = "";
    [Parameter] public Action<string?> SetViceTitle { get; set; } = default!;
    [Parameter] public string ViceDesc { get; set; } = "";
    [Parameter] public Action<string?> SetViceDesc { get; set; } = default!;
    [Parameter] public string Watermark { get; set; } = "";
    [Parameter] public Action<string?> SetWatermark { get; set; } = default!;
    [Parameter] public string Copyright { get; set; } = "";
    [Parameter] public Action<string?> SetCopyright { get; set; } = default!;
    [Parameter] public string Icp { get; set; } = "";
    [Parameter] public Action<string?> SetIcp { get; set; } = default!;
    [Parameter] public string IcpUrl { get; set; } = "";
    [Parameter] public Action<string?> SetIcpUrl { get; set; } = default!;
    [Parameter] public string DefaultHomePath { get; set; } = "";
    [Parameter] public Action<string?> SetDefaultHomePath { get; set; } = default!;
}

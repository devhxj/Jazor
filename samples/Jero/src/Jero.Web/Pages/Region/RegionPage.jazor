@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.Region

<style>
    .region-page { min-width: 0; }
    .region-layout { display: grid; grid-template-columns: minmax(260px, 300px) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); gap: 16px; flex: 1; min-height: 0; }
    .region-tree-card { min-width: 0; display: flex; flex-direction: column; min-height: 0; }
    .region-tree-card > .el-card__body { flex: 1; min-height: 0; display: flex; flex-direction: column; }
    .region-tree-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
    .region-tree-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .region-tree { flex: 1; min-height: 120px; overflow: auto; margin-top: 12px; border: 1px solid #ebeef5; border-radius: 6px; padding: 8px; }
    html.dark .region-tree { border-color: #222c45; }
    .region-tree__toggle { flex: 0 0 24px; width: 24px; height: 24px; border: 0; border-radius: 4px; background: transparent; color: #909399; cursor: pointer; }
    .region-tree__name { min-width: 0; flex: 1 1 auto; overflow: hidden; border: 0; background: transparent; color: inherit; text-align: left; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
    .region-main { min-width: 0; display: grid; gap: 16px; grid-template-rows: auto minmax(0, 1fr); min-height: 0; }
    .region-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
    .region-edit-dialog { width: min(720px, calc(100vw - 24px)) !important; }
    @@media (max-width: 980px) {
        .region-layout { grid-template-columns: 1fr; }
        .region-tree { min-height: 220px; max-height: 360px; }
    }
    @@media (max-width: 620px) {
        .region-form-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="region-page">
    <ElCard Header="行政区域" class="jero-list-page">
        <p style="margin-top:0;color:#606266;">
            支持左侧区域树定位、右侧分页查询、继承当前父节点新增，以及统计区域数据同步。
        </p>

        <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
            <ElAlert Type="error"
                     Title="@(Error ?? "")"
                     ShowIcon="true"
                     Closable="true"
                     @onclose="@(_ => DismissError())" />
        </div>

        <div class="region-layout">
            <ElCard Header="行政区域树" class="region-tree-card">
                <div class="region-tree-toolbar">
                    <ElInput ModelValue="@TreeFilter"
                             @onupdate:modelValue="TreeFilterChanged"
                             Placeholder="行政区域名称"
                             Clearable="true" />
                    <ElButton @onclick="@(_ => LoadTree())" Loading="@TreeLoading">刷新</ElButton>
                </div>
                <div class="region-tree-actions">
                    <ElButton Size="small" @onclick="@(_ => ExpandAll())" Disabled="@TreeLoading">全部展开</ElButton>
                    <ElButton Size="small" @onclick="@(_ => CollapseAll())" Disabled="@TreeLoading">全部折叠</ElButton>
                    <ElButton Size="small" @onclick="@(_ => SelectRoot())" Disabled="@TreeLoading">根节点</ElButton>
                </div>

                <div class="region-tree" aria-label="行政区域树">
                    @if (TreeLoading)
                    {
                        <div>正在加载行政区域树…</div>
                    }
                    else if (VisibleTreeRows.Length == 0)
                    {
                        <ElEmpty Description="暂无行政区域数据" />
                    }
                    else
                    {
                        @foreach (var treeRow in VisibleTreeRows)
                        {
                            <div style="@TreeRowStyle(treeRow, SelectedRegionId)">
                                <button class="region-tree__toggle"
                                        disabled="@(TreeExpandingId.Length > 0 || (treeRow.ChildrenLoaded && !treeRow.HasChildren))"
                                        title="@TreeToggleTitle(treeRow)"
                                        @onclick="@(() => ToggleTree(treeRow))">@TreeToggleText(treeRow, ExpandedIds, TreeExpandingId)</button>
                                <button class="region-tree__name"
                                        title="@treeRow.PathName"
                                        @onclick="@(() => SelectTreeNode(treeRow))">@treeRow.Name</button>
                            </div>
                        }
                    }
                </div>
            </ElCard>

            <div class="region-main">
                <JeroQueryCard Title="查询条件">
                    <ElForm Inline="true">
                        <ElFormItem Label="行政名称">
                            <ElInput ModelValue="@QueryName"
                                     @onupdate:modelValue="SetQueryName"
                                     Placeholder="行政名称"
                                     Clearable="true" />
                        </ElFormItem>
                        <ElFormItem Label="行政代码">
                            <ElInput ModelValue="@QueryCode"
                                     @onupdate:modelValue="SetQueryCode"
                                     Placeholder="行政代码"
                                     Clearable="true" />
                        </ElFormItem>
                        <ElFormItem>
                            <ElButton Type="primary" @onclick="@(_ => Search())" Loading="@ListLoading">查询</ElButton>
                            <ElButton @onclick="@(_ => ResetSearch())" Disabled="@ListLoading">重置</ElButton>
                            @if (CanAdd)
                            {
                                <ElButton Type="primary" @onclick="@(_ => OpenCreate())">新增</ElButton>
                            }
                            @if (CanSync)
                            {
                                <ElPopconfirm Title="确定同步行政区域数据吗？此操作会删除并重建当前区域数据，且同步过程可能较长。"
                                              ConfirmButtonText="确定同步"
                                              CancelButtonText="取消"
                                              @onconfirm="@(_ => SyncRegions())">
                                    <template #reference>
                                        <ElButton Type="danger"
                                                  Loading="@Syncing"
                                                  Disabled="@(Syncing || DeletingId.Length > 0)">同步统计局</ElButton>
                                    </template>
                                </ElPopconfirm>
                            }
                        </ElFormItem>
                    </ElForm>
                </JeroQueryCard>

                <ElCard class="jero-list-card">
                    <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
                        <ElButton @onclick="@(_ => RefreshAll())" Loading="@(TreeLoading || ListLoading)">刷新</ElButton>
                    </div>

                    <div class="jero-list-scroll">
<RegionTable Rows="@Rows" CanEdit="@CanEdit" CanDelete="@CanDelete" HasActionColumn="@HasActionColumn" DeletingId="@DeletingId" Syncing="@Syncing" OnOpenEdit="@OpenEdit" OnDelete="@Delete" />
                    </div>

                    <div style="margin-top:16px;display:flex;justify-content:flex-end;">
                        <ElPagination CurrentPage="@CurrentPage"
                                          PageSize="@PageSize"
                                          Total="@Total"
                                          PageSizes="@PageSizes"
                                          Background="true"
                                          Layout="Total, sizes, prev, pager, next, jumper"
                                          @oncurrent-change="ChangePage"
                                          @onsize-change="ChangePageSize" />
                    </div>
                </ElCard>
            </div>
        </div>
    </ElCard>
</div>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          class="region-edit-dialog"
          Width="720px"
          Draggable="true"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="96px">
        @if (EditId.Length == 0)
        {
            <ElFormItem Label="上级行政">
                <ElInput ModelValue="@EditParentNamePath" Disabled="true" />
            </ElFormItem>
        }
        <ElFormItem Label="行政名称" Required="true">
            <ElInput ModelValue="@EditName"
                     @onupdate:modelValue="SetEditName"
                     Maxlength="128"
                     ShowWordLimit="true"
                     Clearable="true"
                     Placeholder="行政名称" />
        </ElFormItem>
        <ElFormItem Label="行政代码" Required="true">
            <ElInput ModelValue="@EditCode"
                     @onupdate:modelValue="SetEditCode"
                     Maxlength="12"
                     ShowWordLimit="true"
                     Clearable="true"
                     Placeholder="请输入6、9或12位行政代码" />
        </ElFormItem>
        <div class="region-form-grid">
            <ElFormItem Label="区号">
                <ElInput ModelValue="@EditCityCode"
                         @onupdate:modelValue="SetEditCityCode"
                         Maxlength="6"
                         ShowWordLimit="true"
                         Clearable="true"
                         Placeholder="区号" />
            </ElFormItem>
            <ElFormItem Label="排序">
                <ElInputNumber ModelValue="@EditOrderNo"
                               @onupdate:modelValue="SetEditOrderNo"
                               Min="0" />
            </ElFormItem>
        </div>
        <ElFormItem Label="备注">
            <ElInput ModelValue="@EditRemark"
                     @onupdate:modelValue="SetEditRemark"
                     Type="textarea"
                     Rows="3"
                     Maxlength="128"
                     ShowWordLimit="true"
                     Placeholder="请输入备注内容" />
        </ElFormItem>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <ElButton @onclick="@(_ => CancelEdit())" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary" @onclick="@(_ => Save())" Loading="@Saving">确定</ElButton>
    </div>
</ElDialog>

@code {
    [Parameter] public Action<string?> TreeFilterChanged { get; set; } = default!;
    [Parameter] public Action<string?> SetQueryName { get; set; } = default!;
    [Parameter] public Action<string?> SetQueryCode { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<string?> SetEditName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditCityCode { get; set; } = default!;
    [Parameter] public Action<double?> SetEditOrderNo { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRemark { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public string DeletingId { get; set; } = "";
    [Parameter] public bool Syncing { get; set; }
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action LoadTree { get; set; } = default!;
    [Parameter] public Action ExpandAll { get; set; } = default!;
    [Parameter] public Action CollapseAll { get; set; } = default!;
    [Parameter] public Action SelectRoot { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action SyncRegions { get; set; } = default!;
    [Parameter] public Action RefreshAll { get; set; } = default!;
    [Parameter] public Action<double> ChangePage { get; set; } = default!;
    [Parameter] public Action<double> ChangePageSize { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public double[] PageSizes { get; set; } = [];
    [Parameter] public RegionFlatView[] VisibleTreeRows { get; set; } = [];
    [Parameter] public string[] ExpandedIds { get; set; } = [];
    [Parameter] public string TreeFilter { get; set; } = "";
    [Parameter] public string SelectedRegionId { get; set; } = "";
    [Parameter] public string TreeExpandingId { get; set; } = "";
    [Parameter] public bool TreeLoading { get; set; }
    [Parameter] public RegionFlatView[] Rows { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public string QueryName { get; set; } = "";
    [Parameter] public string QueryCode { get; set; } = "";
    [Parameter] public bool ListLoading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public string EditParentNamePath { get; set; } = "";
    [Parameter] public bool Saving { get; set; }
    [Parameter] public string EditId { get; set; } = "";
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditCode { get; set; } = "";
    [Parameter] public string EditCityCode { get; set; } = "";
    [Parameter] public int EditOrderNo { get; set; }
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanSync { get; set; }
    [Parameter] public Action<RegionFlatView> ToggleTree { get; set; } = default!;
    [Parameter] public Action<RegionFlatView> SelectTreeNode { get; set; } = default!;
    private static bool ContainsId(string[] values, string id)
    {
        foreach (var value in values)
            if (value == id) return true;
        return false;
    }

    private static string TreeRowStyle(RegionFlatView row, string selectedId)
    {
        var background = row.Id == selectedId ? "background:#ecf5ff;color:#409eff;" : string.Empty;
        return background + "display:flex;align-items:center;gap:4px;padding:5px 8px 5px " +
               (8 + row.Depth * 18) + "px;border-radius:5px;";
    }

    private static string TreeToggleText(RegionFlatView row, string[] expanded, string loadingId)
    {
        if (row.Id == loadingId)
            return "…";
        if (row.ChildrenLoaded && !row.HasChildren)
            return "·";
        if (!row.ChildrenLoaded)
            return "+";
        return ContainsId(expanded, row.Id) ? "−" : "+";
    }

    private static string TreeToggleTitle(RegionFlatView row)
    {
        if (!row.ChildrenLoaded)
            return "加载下级区域";
        return row.HasChildren ? "展开或折叠" : "无下级区域";
    }

}

@using Npm.ElementPlus
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.UserRegWay

<ElCard Header="注册方案" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        支持租户筛选、查询排序、注册方案维护，以及默认角色、机构和职位绑定。
    </p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            @if (IsSuperAdmin)
            {
                <ElFormItem Label="租户">
                    <div style="width:260px">
                        <AuthOptionSelect Value="@TenantId" Options="@TenantOptions" Placeholder="请选择租户" Clearable="true" Loading="@TenantLoading" Change="@TenantChanged" />
                    </div>
                </ElFormItem>
            }
            <ElFormItem Label="关键字">
                <ElInput ModelValue="@Keyword"
                         @onupdate:modelValue="SetKeyword"
                         Placeholder="关键字"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="名称">
                <ElInput ModelValue="@Name"
                         @onupdate:modelValue="SetName"
                         Placeholder="方案名称"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;">
            <div>
                @if (CanAdd)
                {
                    <ElButton Type="primary" @onclick="OpenCreate">新增</ElButton>
                }
            </div>
            <ElButton @onclick="Refresh" Loading="@Loading">刷新</ElButton>
        </div>

        @if (Loading)
        {
            <ElText>正在加载注册方案…</ElText>
        }

        <div class="jero-list-scroll">
    <UserRegWayTable Rows="@Rows" HasActionColumn="@HasActionColumn" CanEdit="@CanEdit" CanDelete="@CanDelete"
                OpenAudit="@OpenAuditRow" OpenEdit="@OpenEditRow" Delete="@DeleteRow" Sort="@SortRows" />
        </div>
    </ElCard>
</ElCard>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          Width="760px"
          Draggable="true"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="90px">
        @if (IsSuperAdmin)
        {
            <ElFormItem Label="租户">
                <AuthOptionSelect Value="@EditTenantId" Options="@TenantOptions" Placeholder="请选择租户" Disabled="@(Editing || DependencyLoading)" Change="@EditTenantChanged" />
            </ElFormItem>
        }

        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;">
            <ElFormItem Label="方案名称">
                <ElInput ModelValue="@EditName"
                         @onupdate:modelValue="SetEditName"
                         Placeholder="方案名称，最多32个字符"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="账户类型">
                <AuthOptionSelect Value="@EditAccountType" Options="@AccountTypeOptions" Placeholder="账户类型" Change="@SetEditAccountType" />
            </ElFormItem>
            <ElFormItem Label="绑定角色">
                <AuthOptionSelect Value="@EditRoleId" Options="@RoleOptions" Placeholder="绑定角色" Clearable="true" Loading="@DependencyLoading" Disabled="@DependencyLoading" Change="@SetEditRoleId" />
            </ElFormItem>
            <ElFormItem Label="绑定机构">
                <AuthOptionSelect Value="@EditOrgId" Options="@OrgOptions" Placeholder="绑定机构" Clearable="true" Loading="@DependencyLoading" Disabled="@DependencyLoading" Change="@SetEditOrgId" />
            </ElFormItem>
            <ElFormItem Label="绑定职位">
                <AuthOptionSelect Value="@EditPosId" Options="@PosOptions" Placeholder="绑定职位" Clearable="true" Loading="@DependencyLoading" Disabled="@DependencyLoading" Change="@SetEditPosId" />
            </ElFormItem>
            <ElFormItem Label="排序">
                <ConfigurationNumber Value="@EditOrderNo" Minimum="@(0)" Change="@SetEditOrderNo" />
            </ElFormItem>
        </div>

        <ElFormItem Label="备注">
            <ElInput ModelValue="@EditRemark"
                     @onupdate:modelValue="SetEditRemark"
                     Type="textarea"
                     Rows="3"
                     Placeholder="备注，最多128个字符" />
        </ElFormItem>
    </ElForm>

    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <ElButton @onclick="CancelEdit" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="Save"
                  Loading="@Saving"
                  Disabled="@DependencyLoading">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@AuditDialogVisible"
          @onupdate:modelValue="SetAuditDialogVisible"
          Title="@AuditDialogTitle"
          Width="560px">
    <div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px 16px;line-height:1.6;">
        <strong>创建人</strong><span>@AuditCreateUser</span>
        <strong>创建时间</strong><span>@AuditCreateTime</span>
        <strong>最后修改人</strong><span>@AuditUpdateUser</span>
        <strong>最后修改时间</strong><span>@AuditUpdateTime</span>
        <strong>备注</strong><span>@AuditRemark</span>
    </div>
</ElDialog>

@code {
    [Parameter] public ConfigurationOption[] TenantOptions { get; set; } = [];
    [Parameter] public Action<string> TenantChanged { get; set; } = default!;
    [Parameter] public string TenantId { get; set; } = "";
    [Parameter] public Action<string> EditTenantChanged { get; set; } = default!;
    [Parameter] public string EditTenantId { get; set; } = "";
    [Parameter] public ConfigurationOption[] RoleOptions { get; set; } = [];
    [Parameter] public Action<string> SetEditRoleId { get; set; } = default!;
    [Parameter] public string EditRoleId { get; set; } = "";
    [Parameter] public ConfigurationOption[] OrgOptions { get; set; } = [];
    [Parameter] public Action<string> SetEditOrgId { get; set; } = default!;
    [Parameter] public string EditOrgId { get; set; } = "";
    [Parameter] public ConfigurationOption[] PosOptions { get; set; } = [];
    [Parameter] public Action<string> SetEditPosId { get; set; } = default!;
    [Parameter] public string EditPosId { get; set; } = "";
    [Parameter] public ConfigurationOption[] AccountTypeOptions { get; set; } = [];
    [Parameter] public string EditAccountType { get; set; } = "";
    [Parameter] public Action<string> SetEditAccountType { get; set; } = default!;
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public Action<string> OpenAuditRow { get; set; } = default!;
    [Parameter] public Action<string> OpenEditRow { get; set; } = default!;
    [Parameter] public Action<string> DeleteRow { get; set; } = default!;
    [Parameter] public Action<string, string> SortRows { get; set; } = default!;
    [Parameter] public UserRegWayTableRow[] Rows { get; set; } = [];
    [Parameter] public int EditOrderNo { get; set; }
    [Parameter] public Action<double?> SetEditOrderNo { get; set; } = default!;
    [Parameter] public Action<string?> SetKeyword { get; set; } = default!;
    [Parameter] public Action<string?> SetName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public bool TenantLoading { get; set; }
    [Parameter] public string Keyword { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public bool Editing { get; set; }
    [Parameter] public bool DependencyLoading { get; set; }
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool AuditDialogVisible { get; set; }
    [Parameter] public string AuditDialogTitle { get; set; } = "";
    [Parameter] public string AuditCreateUser { get; set; } = "";
    [Parameter] public string AuditCreateTime { get; set; } = "";
    [Parameter] public string AuditUpdateUser { get; set; } = "";
    [Parameter] public string AuditUpdateTime { get; set; } = "";
    [Parameter] public string AuditRemark { get; set; } = "";
}

@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.Template

<ElCard Header="模板管理" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        支持查询、分组筛选、分页排序、编辑、删除、富文本预览和参数渲染。
    </p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            <ElFormItem Label="模板名称">
                <ElInput ModelValue="@Name"
                         @onupdate:modelValue="SetName"
                         Placeholder="搜索模板名称"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="模板编码">
                <ElInput ModelValue="@QueryCode"
                         @onupdate:modelValue="SetQueryCode"
                         Placeholder="搜索模板编码"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="模板类型">
                <div style="width:180px">
                    <TemplateFilters Kind="type" TypeValue="@QueryType" Options="@TypeOptions" Groups="@Groups" TypeChange="@SetQueryType" />
                </div>
            </ElFormItem>
            <ElFormItem Label="分组名称">
                <div style="width:220px">
                    <TemplateFilters Kind="group" GroupValue="@GroupName" Options="@TypeOptions" Groups="@Groups" GroupChange="@SetGroupName" />
                </div>
            </ElFormItem>
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;">
            <div>
                @if (CanAdd)
                {
                    <ElButton Type="primary" @onclick="OpenCreate">新增</ElButton>
                }
            </div>
            <ElButton @onclick="Refresh" Loading="@Loading">刷新</ElButton>
        </div>

        @if (Loading)
        {
            <ElText>正在加载模板…</ElText>
        }

        <div class="jero-list-scroll">
<TemplateTable Rows="@Rows" Options="@TypeOptions" CanEdit="@CanEdit" CanPreview="@CanPreview" CanDelete="@CanDelete"
                       Edit="@Edit" Preview="@Preview" Delete="@Delete" Audit="@Audit" Sort="@Sort" />
        </div>

        <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <ElPagination CurrentPage="@CurrentPage"
                              PageSize="@PageSize"
                              Total="@Total"
                              PageSizes="@(new double[] { 10, 20, 50, 100 })"
                              Background="true"
                              Layout="total, sizes, prev, pager, next, jumper"
                              @oncurrent-change="ChangePage"
                              @onsize-change="ChangePageSize" />
        </div>
    </ElCard>
</ElCard>

<slot />

@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public string Name { get; set; } = default!;
    [Parameter] public string QueryCode { get; set; } = default!;
    [Parameter] public int QueryType { get; set; }
    [Parameter] public string GroupName { get; set; } = default!;
    [Parameter] public TemplateTypeOption[] TypeOptions { get; set; } = default!;
    [Parameter] public string[] Groups { get; set; } = default!;
    [Parameter] public TemplateView[] Rows { get; set; } = default!;
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanPreview { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action<string> SetName { get; set; } = default!;
    [Parameter] public Action<string> SetQueryCode { get; set; } = default!;
    [Parameter] public Action<double> SetQueryType { get; set; } = default!;
    [Parameter] public Action<string> SetGroupName { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action<string> Edit { get; set; } = default!;
    [Parameter] public Action<string> Preview { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action<string> Audit { get; set; } = default!;
    [Parameter] public Action<string, string> Sort { get; set; } = default!;
    [Parameter] public Action<double> ChangePage { get; set; } = default!;
    [Parameter] public Action<double> ChangePageSize { get; set; } = default!;
}

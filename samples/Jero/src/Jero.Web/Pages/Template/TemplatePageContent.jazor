@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using static ECMAScript.Vue
@using ECMAScript
@using Jero.Web.Pages.Template

<ElDialog ModelValue='@(EditDialogVisible)'
          @onupdate:modelValue='@(value => SetEditDialogVisible(value == true))'
          title='@(EditDialogTitle)'
          width="1080px"
          Draggable='@(true)'
          DestroyOnClose='@(true)'
          CloseOnClickModal='@(false)'>
    <ElTabs ModelValue='@(SelectedTab)'
            @attributes='@(new ModelUpdate<string>(value => SetSelectedTab(value ?? "basic")))'>
        <ElTabPane label="基础信息" name="basic">
            <ElForm LabelWidth="90px">
                <ElFormItem label="模板名称">
                    <ElInput ModelValue='@(EditName)'
                             @onupdate:modelValue='@(value => SetEditName(value ?? ""))'
                             placeholder="模板名称，最多128个字符"
                             Clearable='@(true)'
                             Disabled='@(EditReadonly)' />
                </ElFormItem>
                <ElFormItem label="模板编码">
                    <ElInput ModelValue='@(EditCode)'
                             @onupdate:modelValue='@(value => SetEditCode(value ?? ""))'
                             placeholder="模板编码，最多128个字符"
                             Clearable='@(true)'
                             Disabled='@(EditReadonly)' />
                </ElFormItem>
                <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;">
                    <ElFormItem label="分组名称">
                        <ElSelect ModelValue='@(EditGroupName)'
                                      @attributes='@(new ModelUpdate<string>(value => SetEditGroupName(value ?? "")))'
                                      placeholder="选择或输入分组名称"
                                      Clearable='@(true)'
                                      Filterable='@(true)'
                                      AllowCreate='@(true)'
                                      DefaultFirstOption='@(true)'
                                      Disabled='@(EditReadonly)'>
                            @foreach (var group in Groups) {
                                <ElOption Label='@(group)' Value='@(group)' />
                            }
                        </ElSelect>
                    </ElFormItem>
                    <ElFormItem label="模板类型">
                        <ElSelect ModelValue='@(EditType)'
                                  @attributes='@(new ModelUpdate<double?>(value => SetEditType((int)(Math.Truncate(value ?? 1)))))'
                                  placeholder="模板类型"
                                  Disabled='@(EditReadonly)'>
                            @foreach (var option in TypeOptions) {
                                <ElOption Label='@(option.Label)' Value='@(option.Value)' />
                            }
                        </ElSelect>
                    </ElFormItem>
                    <ElFormItem label="排序">
                        <ElInputNumber ModelValue='@(EditOrderNo)'
                                       @onupdate:modelValue='@(value => SetEditOrderNo((int)(Math.Truncate(value ?? 100))))'
                                       Min='@(0)'
                                       Disabled='@(EditReadonly)' />
                    </ElFormItem>
                </div>
                <ElFormItem label="备注">
                    <ElInput ModelValue='@(EditRemark)'
                             @onupdate:modelValue='@(value => SetEditRemark(value ?? ""))'
                             type="textarea"
                             Rows='@(3)'
                             placeholder="备注，最多128个字符"
                             Disabled='@(EditReadonly)' />
                </ElFormItem>
            </ElForm>
        </ElTabPane>

        <ElTabPane label="模板内容" name="content">
            <div style="display:grid;gap:16px;">
                <ElAlert type="info"
                         ShowIcon='@(true)'
                         title="模板参数使用 @@(参数名) 语法，例如 @@(name)。预览时会按下方参数表传值。" />

                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                    <strong>内容类型</strong>
                    <ElRadioGroup ModelValue='@(ContentMode)'
                                  @attributes='@(new ModelUpdate<string>(value => ChangeContentMode(value ?? "rich")))'
                                  Disabled='@(EditReadonly)'>
                        <ElRadio value="rich">富文本</ElRadio>
                        <ElRadio value="plain">纯文本</ElRadio>
                    </ElRadioGroup>
                    <ElButton @onclick='@(() => InsertParameter())' Disabled='@(EditReadonly)'>插入参数</ElButton>
                </div>

                @if (ContentMode == "rich") {
                    <div style="border:1px solid #dcdfe6;border-radius:4px;overflow:hidden;">
                        @if (!EditReadonly) {
                            <div style="display:flex;flex-wrap:wrap;gap:6px;padding:8px;border-bottom:1px solid #ebeef5;background:#f5f7fa;">
                                <ElButton @onclick='@(() => RichCommand("bold"))'>加粗</ElButton>
                                <ElButton @onclick='@(() => RichCommand("italic"))'>斜体</ElButton>
                                <ElButton @onclick='@(() => RichCommand("underline"))'>下划线</ElButton>
                                <ElButton @onclick='@(() => RichBlock("h2"))'>标题</ElButton>
                                <ElButton @onclick='@(() => RichBlock("p"))'>正文</ElButton>
                                <ElButton @onclick='@(() => RichCommand("insertUnorderedList"))'>无序列表</ElButton>
                                <ElButton @onclick='@(() => RichCommand("insertOrderedList"))'>有序列表</ElButton>
                                <ElButton @onclick='@(() => RichCommand("removeFormat"))'>清除格式</ElButton>
                            </div>
                        }
                        <div id='@(RichEditorIdValue)'
                             contenteditable='@(EditReadonly ? "false" : "true")'
                             v-html="state.richEditorHtml"
                             @oninput='@(() => SyncRichContent())'
                             style="min-height:240px;padding:14px;outline:none;line-height:1.7;word-break:break-word;background:white;"></div>
                    </div>
                }
                else {
                    <ElInput ModelValue='@(EditContent)'
                             @onupdate:modelValue='@(value => ContentChanged(value ?? ""))'
                             type="textarea"
                             Rows='@(12)'
                             ShowWordLimit='@(true)'
                             Disabled='@(EditReadonly)' />
                }

                <div style="border:1px dashed #dcdfe6;border-radius:8px;padding:16px;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                        <strong>预览参数</strong>
                        <ElButton Link='@(true)' type="primary" @onclick='@(() => AddRenderEntry())'>新增参数</ElButton>
                    </div>

                    @if (RenderEntries.Length == 0) {
                        <ElEmpty description="模板中暂无参数，可手动新增或先在内容中输入 @@(参数名)" ImageSize='@(72)' />
                    }
                    else {
                        <div style="display:grid;gap:10px;">
                            @for (var entryIndex = 0; entryIndex < RenderEntries.Length; entryIndex++) {
    var entry = RenderEntries[entryIndex];
                                <div style="display:grid;grid-template-columns:180px minmax(0,1fr) auto;gap:10px;align-items:center;">
                                    <ElInput ModelValue='@(entry.Key)'
                                             @onupdate:modelValue='@(value => entry.Key = value ?? "")'
                                             placeholder="参数名" />
                                    <ElInput ModelValue='@(entry.Value)'
                                             @onupdate:modelValue='@(value => entry.Value = value ?? "")'
                                             placeholder="参数值" />
                                    <ElButton Link='@(true)' type="danger" @onclick='@(() => RemoveRenderEntry(entryIndex))'>删除</ElButton>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div style="border:1px solid #dcdfe6;border-radius:8px;padding:16px;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                        <strong>预览结果</strong>
                        @if (CanPreview) {
                            <ElButton type="primary" @onclick='@(() => RenderPreview())' Loading='@(Previewing)'>生成预览</ElButton>
                        }
                    </div>
                    @if (PreviewHtml.Length == 0) {
                        <ElEmpty description="点击“生成预览”查看模板渲染结果" ImageSize='@(88)' />
                    }
                    else {
                        <div v-html="state.previewHtml"
                             style="min-height:160px;padding:14px;border-radius:6px;background:#f5f7fa;word-break:break-word;"></div>
                    }
                </div>
            </div>
        </ElTabPane>
    </ElTabs>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;">
        <ElButton @onclick='@(() => SetEditDialogVisible(false))' Disabled='@(Saving || Previewing)'>
            @(EditReadonly ? "关闭" : "取消")
        </ElButton>
        @if (CanPreview) {
            <ElButton @onclick='@(() => RenderPreview())' Loading='@(Previewing)'>预览</ElButton>
        }
        @if (!EditReadonly) {
            <ElButton type="primary" @onclick='@(() => Save())' Loading='@(Saving)'>确定</ElButton>
        }
    </div>
</ElDialog>

<ElDialog ModelValue='@(AuditDialogVisible)'
          @onupdate:modelValue='@(value => SetAuditDialogVisible(value == true))'
          title='@(AuditDialogTitle)'
          width="600px">
    <div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px 16px;line-height:1.6;">
        <strong>创建人</strong><span>@(AuditCreateUser)</span>
        <strong>创建时间</strong><span>@(AuditCreateTime)</span>
        <strong>最后修改人</strong><span>@(AuditUpdateUser)</span>
        <strong>最后修改时间</strong><span>@(AuditUpdateTime)</span>
        <strong>备注</strong><span>@(AuditRemark)</span>
    </div>
</ElDialog>

@code {
    [Parameter] public string RichEditorIdValue { get; set; } = default!;
    [Parameter] public string[] Groups { get; set; } = default!;
    [Parameter] public TemplateTypeOption[] TypeOptions { get; set; } = default!;
    [Parameter] public bool EditDialogVisible { get; set; } = default!;
    [Parameter] public string EditDialogTitle { get; set; } = default!;
    [Parameter] public bool EditReadonly { get; set; } = default!;
    [Parameter] public bool Saving { get; set; } = default!;
    [Parameter] public bool Previewing { get; set; } = default!;
    [Parameter] public string SelectedTab { get; set; } = default!;
    [Parameter] public string ContentMode { get; set; } = default!;
    [Parameter] public string EditName { get; set; } = default!;
    [Parameter] public string EditCode { get; set; } = default!;
    [Parameter] public int EditType { get; set; } = default!;
    [Parameter] public string EditGroupName { get; set; } = default!;
    [Parameter] public int EditOrderNo { get; set; } = default!;
    [Parameter] public string EditRemark { get; set; } = default!;
    [Parameter] public string EditContent { get; set; } = default!;
    [Parameter] public string RichEditorHtml { get; set; } = default!;
    [Parameter] public string PreviewHtml { get; set; } = default!;
    [Parameter] public TemplateRenderEntry[] RenderEntries { get; set; } = default!;
    [Parameter] public bool AuditDialogVisible { get; set; } = default!;
    [Parameter] public string AuditDialogTitle { get; set; } = default!;
    [Parameter] public string AuditCreateUser { get; set; } = default!;
    [Parameter] public string AuditCreateTime { get; set; } = default!;
    [Parameter] public string AuditUpdateUser { get; set; } = default!;
    [Parameter] public string AuditUpdateTime { get; set; } = default!;
    [Parameter] public string AuditRemark { get; set; } = default!;
    [Parameter] public bool CanPreview { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<string> SetSelectedTab { get; set; } = default!;
    [Parameter] public Action<string> SetEditName { get; set; } = default!;
    [Parameter] public Action<string> SetEditCode { get; set; } = default!;
    [Parameter] public Action<string> SetEditGroupName { get; set; } = default!;
    [Parameter] public Action<int> SetEditType { get; set; } = default!;
    [Parameter] public Action<int> SetEditOrderNo { get; set; } = default!;
    [Parameter] public Action<string> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<string> ChangeContentMode { get; set; } = default!;
    [Parameter] public Action InsertParameter { get; set; } = default!;
    [Parameter] public Action<string> RichCommand { get; set; } = default!;
    [Parameter] public Action<string> RichBlock { get; set; } = default!;
    [Parameter] public Action SyncRichContent { get; set; } = default!;
    [Parameter] public Action<string> ContentChanged { get; set; } = default!;
    [Parameter] public Action AddRenderEntry { get; set; } = default!;
    [Parameter] public Action<int> RemoveRenderEntry { get; set; } = default!;
    [Parameter] public Action RenderPreview { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
}

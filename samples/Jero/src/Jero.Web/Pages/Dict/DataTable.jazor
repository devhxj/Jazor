@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.Dict

<ElTable @attributes="@(new TableData<DictDataView>(Rows) { OnSortChange = SortChanged })" border="true" stripe="true" RowKey="id" EmptyText="暂无字典值">
                    <ElTableColumn type="index" label="序号" width="70" align="center" />
                    <ElTableColumn label="显示文本" MinWidth="130">
                        <template #default context="cell">@{ var row = ((TableSlot<DictDataView>)(object)cell).Row; }
                            <ElTag @attributes="@(new TableTagProps(DataTagType(row)))" class='@(row.ClassSetting)' style='@(row.StyleSetting)'>
                                @(row.Label)
                            </ElTag>
                        </template>
                    </ElTableColumn>
                    <ElTableColumn prop="@(nameof(DictDataView.Value))" label="字典值" MinWidth="110" />
                    <ElTableColumn prop="@(nameof(DictDataView.Code))" label="编码" MinWidth="110" />
                    <ElTableColumn label="拓展数据" width="90" align="center">
                        <template #default context="cell">@{ var row = ((TableSlot<DictDataView>)(object)cell).Row; }
                            <ElTag @attributes="@(new TableTagProps(string.IsNullOrEmpty(row.ExtData) ? "warning" : "success"))">
                                @(string.IsNullOrEmpty(row.ExtData) ? "空" : "有值")
                            </ElTag>
                        </template>
                    </ElTableColumn>
                    <ElTableColumn label="状态" width="80" align="center">
                        <template #default context="cell">@{ var row = ((TableSlot<DictDataView>)(object)cell).Row; }
                            <ElTag @attributes="@(new TableTagProps(StatusTagType(row)))">@(StatusText(row))</ElTag>
                        </template>
                    </ElTableColumn>
                    <ElTableColumn prop="orderNo" label="排序" width="80" align="center" sortable="custom" />
                        @if (CanEditData || CanDeleteData || CanAddData) { <ElTableColumn label="操作" width="164" align="center" fixed="right">
                            <template #default context="cell">@{ var row = ((TableSlot<DictDataView>)(object)cell).Row; }
                                @if (CanEditData) { <ElButton link="true" type="primary" disabled='@(!CanOperateSelectedType)' @onclick='@(() => OnOpenEditData(row.Id))'>编辑</ElButton> }
                                @if (CanDeleteData) { <ElPopconfirm title='@("确定删除字典值【" + row.Value + "】吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm='@(() => OnDeleteData(row.Id))'>
                                        <template #reference>
                                            <ElButton link="true" type="danger" disabled='@(!CanOperateSelectedType)'>删除</ElButton>
                                        </template>
                                    </ElPopconfirm> }
                                @if (CanAddData) { <ElButton link="true" type="primary" disabled='@(!CanOperateSelectedType)' @onclick='@(() => OnOpenCopyData(row.Id))'>复制</ElButton> }
                            </template>
                        </ElTableColumn> }
                </ElTable>

@code {
    [Parameter] public DictDataView[] Rows { get; set; } = [];
    [Parameter] public bool CanAddData { get; set; }
    [Parameter] public bool CanEditData { get; set; }
    [Parameter] public bool CanDeleteData { get; set; }
    [Parameter] public bool CanOperateSelectedType { get; set; }
    [Parameter] public Action<string> OnOpenEditData { get; set; } = default!;
    [Parameter] public Action<string> OnOpenCopyData { get; set; } = default!;
    [Parameter] public Action<string> OnDeleteData { get; set; } = default!;
    [Parameter] public Action<string, string> OnSortData { get; set; } = default!;

    private static string StatusText(DictDataView row) => row.Status == 1 ? "启用" : "停用";
    private static string StatusTagType(DictDataView row) => row.Status == 1 ? "success" : "info";
    private static string DataTagType(DictDataView row) => row.TagType is "success" or "warning" or "info" or "danger" ? row.TagType : "primary";
    private void SortChanged(TableSortScope sort) => OnSortData(sort.Prop ?? "", sort.Order ?? "");
}

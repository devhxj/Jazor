@using Npm.ElementPlus
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Ldap
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.Pos

<ElCard Header="职位管理" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        支持租户筛选、职位查询、新增编辑、复制、删除和在职人员明细查看。
    </p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            @if (IsSuperAdmin)
            {
                <ElFormItem Label="租户">
                    <div style="width:260px">
                    <AuthOptionSelect Value="@TenantId" Options="@TenantOptions" Placeholder="请选择租户" Clearable="true" Loading="@TenantLoading" Change="@TenantChanged" />
                    </div>
                </ElFormItem>
            }
            <ElFormItem Label="职位名称">
                <ElInput ModelValue="@Name"
                         @onupdate:modelValue="SetName"
                         Placeholder="职位名称"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="职位编码">
                <ElInput ModelValue="@PosCode"
                         @onupdate:modelValue="SetPosCode"
                         Placeholder="职位编码"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
                @if (CanAdd)
                {
                    <ElButton Type="primary" @onclick="OpenCreate">新增</ElButton>
                }
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        <div style="margin-bottom:16px;display:flex;justify-content:flex-end;">
            <ElButton @onclick="LoadPositions" Loading="@Loading">刷新</ElButton>
        </div>

        <div class="jero-list-scroll">
            <PosTable Rows="@Rows" CanAdd="@CanAdd" CanEdit="@CanEdit" CanDelete="@CanDelete" HasActionColumn="@HasActionColumn"
                      OnOpenUsers="@OpenUsers" OnOpenAudit="@OpenAudit" OnOpenEdit="@OpenEdit" OnOpenCopy="@OpenCopy" OnDelete="@Delete" />
        </div>
    </ElCard>
</ElCard>

<ElDialog ModelValue="@EditDialogVisible"
          @onupdate:modelValue="SetEditDialogVisible"
          Title="@EditDialogTitle"
          Width="700px"
          Draggable="true"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="90px">
        @if (IsSuperAdmin)
        {
            <ElFormItem Label="租户">
                <AuthOptionSelect Value="@EditTenantId" Options="@TenantOptions" Placeholder="请选择租户" Disabled="@Editing" Change="@SetEditTenantId" />
            </ElFormItem>
        }
        <ElFormItem Label="职位名称">
            <ElInput ModelValue="@EditName"
                     @onupdate:modelValue="SetEditName"
                     Placeholder="职位名称，最多64个字符"
                     Clearable="true" />
        </ElFormItem>
        <ElFormItem Label="职位编码">
            <ElInput ModelValue="@EditCode"
                     @onupdate:modelValue="SetEditCode"
                     Placeholder="职位编码，最多64个字符"
                     Clearable="true" />
        </ElFormItem>
        <ElFormItem Label="排序">
            <ConfigurationNumber Value="@EditOrderNo" Minimum="@(0)" Change="@SetEditOrderNo" />
        </ElFormItem>
        <ElFormItem Label="状态">
            <LdapStatusInput Value="@EditStatus" InactiveLabel="停用" OnChange="@SetEditStatus" />
        </ElFormItem>
        <ElFormItem Label="备注">
            <ElInput ModelValue="@EditRemark"
                     @onupdate:modelValue="SetEditRemark"
                     Placeholder="备注，最多128个字符"
                     Type="textarea"
                     Rows="3" />
        </ElFormItem>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <ElButton @onclick="CancelEdit" Disabled="@Saving">取消</ElButton>
        <ElButton Type="primary" @onclick="Save" Loading="@Saving">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@UsersDialogVisible"
          @onupdate:modelValue="SetUsersDialogVisible"
          Title="@UsersDialogTitle"
          Width="620px"
          DestroyOnClose="true">
    <PosUsersTable Rows="@UserRows" />
</ElDialog>

<ElDialog ModelValue="@AuditDialogVisible"
          @onupdate:modelValue="SetAuditDialogVisible"
          Title="@AuditDialogTitle"
          Width="560px">
    <div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px 16px;line-height:1.6;">
        <strong>创建人</strong><span>@AuditCreateUser</span>
        <strong>创建时间</strong><span>@AuditCreateTime</span>
        <strong>最后修改人</strong><span>@AuditUpdateUser</span>
        <strong>最后修改时间</strong><span>@AuditUpdateTime</span>
    </div>
</ElDialog>

@code {
    [Parameter] public PosTableRow[] Rows { get; set; } = [];
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public Action<string> OpenUsers { get; set; } = default!;
    [Parameter] public Action<string> OpenAudit { get; set; } = default!;
    [Parameter] public Action<string> OpenEdit { get; set; } = default!;
    [Parameter] public Action<string> OpenCopy { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public PosUserTableRow[] UserRows { get; set; } = [];
    [Parameter] public ConfigurationOption[] TenantOptions { get; set; } = [];
    [Parameter] public string TenantId { get; set; } = "";
    [Parameter] public bool TenantLoading { get; set; }
    [Parameter] public Action<string> TenantChanged { get; set; } = default!;
    [Parameter] public string EditTenantId { get; set; } = "";
    [Parameter] public bool Editing { get; set; }
    [Parameter] public Action<string> SetEditTenantId { get; set; } = default!;
    [Parameter] public int EditOrderNo { get; set; }
    [Parameter] public Action<double?> SetEditOrderNo { get; set; } = default!;
    [Parameter] public int EditStatus { get; set; }
    [Parameter] public Action<double> SetEditStatus { get; set; } = default!;
    [Parameter] public Action<string?> SetName { get; set; } = default!;
    [Parameter] public Action<string?> SetPosCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetUsersDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action LoadPositions { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public string? Error { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string PosCode { get; set; } = "";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public string EditName { get; set; } = "";
    [Parameter] public string EditCode { get; set; } = "";
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public bool UsersDialogVisible { get; set; }
    [Parameter] public string UsersDialogTitle { get; set; } = "";
    [Parameter] public bool AuditDialogVisible { get; set; }
    [Parameter] public string AuditDialogTitle { get; set; } = "";
    [Parameter] public string AuditCreateUser { get; set; } = "";
    [Parameter] public string AuditCreateTime { get; set; } = "";
    [Parameter] public string AuditUpdateUser { get; set; } = "";
    [Parameter] public string AuditUpdateTime { get; set; } = "";
}

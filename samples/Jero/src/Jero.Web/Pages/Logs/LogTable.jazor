@using Npm.ElementPlus
@using Jero.Web.Pages.Logs
@using Jero.Web.Pages.Components

<ElTable @attributes="@(new TableData<LogRow>(Rows) { OnSortChange = SortRows })" border="true" stripe="true" RowKey="@(nameof(LogRow.Id))" EmptyText='@(EmptyText)'>
        <ElTableColumn type="index" label="序号" width="70" align="center" />
        @if (Kind != "visit") { <ElTableColumn prop="@(nameof(LogRow.ControllerName))" label="模块名称" MinWidth="140" ShowOverflowTooltip="true" /> }
        <ElTableColumn prop="@(nameof(LogRow.DisplayTitle))" label="显示名称" MinWidth="180" ShowOverflowTooltip="true" />
        <ElTableColumn prop="@(nameof(LogRow.ActionName))" label="方法名称" MinWidth='@(Kind == "visit" ? 160 : 150)' ShowOverflowTooltip="true" />
        @if (Kind != "visit") {
            <ElTableColumn prop="@(nameof(LogRow.HttpMethod))" label="请求方式" width="100" align="center" />
            <ElTableColumn prop="@(nameof(LogRow.RequestUrl))" label="请求地址" MinWidth="280" ShowOverflowTooltip="true" />
            <ElTableColumn label="级别" width="90" align="center">
                <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }<ElTag @attributes="@(new TableTagProps(LevelType(row.LogLevel)))">@(LevelText(row.LogLevel))</ElTag></template>
            </ElTableColumn>
            <ElTableColumn prop="@(nameof(LogRow.EventId))" label="事件 ID" width="90" align="center" />
            <ElTableColumn prop="threadId" label="线程 ID" width="100" align="center" sortable="custom" />
            <ElTableColumn prop="traceId" label="请求跟踪 ID" MinWidth="180" sortable="custom" ShowOverflowTooltip="true" />
        }
        <ElTableColumn prop="@(nameof(LogRow.Account))" label="账号名称" MinWidth="120" ShowOverflowTooltip="true" />
        <ElTableColumn prop="@(nameof(LogRow.RealName))" label="真实姓名" MinWidth="120" ShowOverflowTooltip="true" />
        <ElTableColumn prop="@(nameof(LogRow.RemoteIp))" label="IP 地址" MinWidth="140" ShowOverflowTooltip="true" />
        <ElTableColumn prop="@(nameof(LogRow.Location))" label="登录地点" MinWidth='@(Kind == "visit" ? 180 : 160)' ShowOverflowTooltip="true" />
        @if (Kind == "visit") {
            <ElTableColumn label="经度" MinWidth="110" align="center">
                <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }@(Display(row.Longitude))</template>
            </ElTableColumn>
            <ElTableColumn label="纬度" MinWidth="110" align="center">
                <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }@(Display(row.Latitude))</template>
            </ElTableColumn>
        }
        <ElTableColumn prop="@(nameof(LogRow.Browser))" label="浏览器" MinWidth="160" ShowOverflowTooltip="true" />
        <ElTableColumn prop="@(nameof(LogRow.Os))" label="操作系统" MinWidth="130" ShowOverflowTooltip="true" />
        <ElTableColumn label="状态" width="90" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }
                <ElTag @attributes="@(new TableTagProps(row.Status == "200" ? "success" : "danger"))">@(row.Status == "200" ? "成功" : "失败")</ElTag>
            </template>
        </ElTableColumn>
        @if (Kind == "visit") { <ElTableColumn label="耗时(ms)" MinWidth="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }@(Display(row.Elapsed))</template>
        </ElTableColumn> }
        else { <ElTableColumn prop="@(nameof(LogRow.Elapsed))" label="耗时(ms)" width="110" align="center" /> }
        @if (Kind == "exception") { <ElTableColumn label="异常对象" MinWidth="220" ShowOverflowTooltip="true">
            <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }@(Display(row.Exception))</template>
        </ElTableColumn> }
        <ElTableColumn label="日志时间" MinWidth="180" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }@(Display(row.LogDateTime))</template>
        </ElTableColumn>
        @if (CanViewDetail) { <ElTableColumn label="操作" width="100" align="center" fixed="right">
            <template #default context="cell">@{ var row = ((TableSlot<LogRow>)(object)cell).Row; }
                <ElButton link="true" type="primary" @onclick="@(() => Detail(row.Id))">详情</ElButton>
            </template>
        </ElTableColumn> }
    </ElTable>

@code {
    [Parameter] public LogRow[] Rows { get; set; } = [];
    [Parameter] public string Kind { get; set; } = default!;
    [Parameter] public string EmptyText { get; set; } = default!;
    [Parameter] public bool CanViewDetail { get; set; } = default!;
    [Parameter] public Action<string> Detail { get; set; } = default!;
    [Parameter] public Action<string, string> Sort { get; set; } = default!;

    private static string Display(string value) => string.IsNullOrEmpty(value) ? "-" : value;
    private static int Level(string value) => (int)ECMAScript.Global.ParseInt(value, 10);
    private static string LevelText(string value) => Level(value) switch { 1 => "调试", 2 => "消息", 3 => "警告", 4 => "错误", 0 => "其他", var level => "级别" + level };
    private static string LevelType(string value) => Level(value) switch { 2 => "primary", 3 => "warning", 4 => "danger", _ => "info" };
    private void SortRows(TableSortScope change) => Sort(change.Prop ?? "", change.Order ?? "");
}

@using Npm.ElementPlus
@using Jero.Web.Pages.Logs
@using Jero.Web.Pages.Components

<ElSelect ModelValue="@(Value)" Placeholder="@Placeholder" Loading="@Loading" Filterable="@Filterable" Clearable="true" @attributes="@(new ModelUpdate<object?>(Update))">
    @foreach (var option in Options)
    {
        <ElOption @key="option.Value" Value="@option.Value" Label='@option.Label' />
    }
</ElSelect>

@code {
    [Parameter] public LogOption[] Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = default!;
    [Parameter] public Action<string> Change { get; set; } = default!;
    [Parameter] public string Placeholder { get; set; } = default!;
    [Parameter] public bool Loading { get; set; } = default!;
    [Parameter] public bool Filterable { get; set; } = default!;

    private void Update(object? value) => Change(value as string ?? "");
}

@using Npm.ElementPlus
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.Ldap

<ElCard Header="LDAP 配置" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">支持租户筛选、分页查询、增删改，以及域账户和组织同步。</p>

    <div style='@(Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error" Title="@(Error ?? "")" ShowIcon="true" Closable="true" @onclose="DismissError" />
    </div>

    <JeroQueryCard Title="查询条件">
        <ElForm Inline="true">
            @if (IsSuperAdmin)
            {
                <ElFormItem Label="租户">
                    <div style="width:260px">
                        <AuthOptionSelect Value="@TenantId" Options="@TenantOptions" Placeholder="请选择租户" Clearable="true" Loading="@TenantLoading" Change="@TenantChanged" />
                    </div>
                </ElFormItem>
            }
            <ElFormItem Label="关键字">
                <ElInput ModelValue="@Keyword" @onupdate:modelValue="SetKeyword" Placeholder="主机关键字" Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="主机">
                <ElInput ModelValue="@Host" @onupdate:modelValue="SetHost" Placeholder="主机" Clearable="true" />
            </ElFormItem>
            <ElFormItem>
                <ElButton Type="primary" @onclick="Search" Loading="@Loading">查询</ElButton>
                <ElButton @onclick="ResetSearch" Disabled="@Loading">重置</ElButton>
                @if (CanAdd)
                {
                    <ElButton Type="primary" @onclick="OpenCreate">新增</ElButton>
                }
            </ElFormItem>
        </ElForm>
    </JeroQueryCard>

    <div style="height:16px"></div>

    <ElCard class="jero-list-card">
        <div style="margin-bottom:16px;display:flex;justify-content:flex-end;">
            <ElButton @onclick="Refresh" Loading="@Loading">刷新</ElButton>
        </div>
        @if (Loading)
        {
            <ElText>正在加载 LDAP 配置…</ElText>
        }
        <div class="jero-list-scroll">
    <LdapTable Rows="@Rows" IsSuperAdmin="@IsSuperAdmin" HasActionColumn="@HasActionColumn" CanEdit="@CanEdit" CanDelete="@CanDelete" CanSyncUser="@CanSyncUser" CanSyncOrg="@CanSyncOrg" DetailLoading="@DetailLoading" ActionLoading="@ActionLoading" TenantOptions="@TenantOptions"
                OnOpenAudit="@OpenAuditRow" OnOpenEdit="@OpenEditRow" OnDelete="@DeleteRow" OnSyncUser="@SyncUserRow" OnSyncOrg="@SyncOrgRow" />
        </div>
        <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <ElPagination CurrentPage="@CurrentPage" PageSize="@PageSize" Total="@Total" PageSizes="@PageSizes" Background="true" Layout="total, sizes, prev, pager, next, jumper" @oncurrent-change="ChangePage" @onsize-change="ChangePageSize" />
        </div>
    </ElCard>
</ElCard>

<ElDialog ModelValue="@EditDialogVisible" @onupdate:modelValue="SetEditDialogVisible" Title="@EditDialogTitle" Width="900px" Draggable="true" DestroyOnClose="true" CloseOnClickModal="false">
    <ElForm LabelWidth="110px">
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;">
            @if (IsSuperAdmin)
            {
                <ElFormItem Label="租户">
                    <AuthOptionSelect Value="@EditTenantId" Options="@TenantOptions" Placeholder="请选择租户" Disabled="@(Editing)" Change="@SetEditTenantId" />
                </ElFormItem>
            }
            <ElFormItem Label="主机"><ElInput ModelValue="@EditHost" @onupdate:modelValue="SetEditHost" Placeholder="例：ldap.jero.local" Clearable="true" /></ElFormItem>
            <ElFormItem Label="端口"><ConfigurationNumber Value="@EditPort" Minimum="@(1)" Maximum="@(65535)" Change="@SetEditPort" /></ElFormItem>
            <ElFormItem Label="用户搜索基准"><ElInput ModelValue="@EditBaseDn" @onupdate:modelValue="SetEditBaseDn" Placeholder="例：DC=jero,DC=local" Clearable="true" /></ElFormItem>
            <ElFormItem Label="用户过滤规则"><ElInput ModelValue="@EditAuthFilter" @onupdate:modelValue="SetEditAuthFilter" Placeholder="例：sAMAccountName=%s" Clearable="true" /></ElFormItem>
            <ElFormItem Label="绑定 DN"><ElInput ModelValue="@EditBindDn" @onupdate:modelValue="SetEditBindDn" Placeholder="绑定 DN" Clearable="true" /></ElFormItem>
            <ElFormItem Label="绑定密码"><ElInput ModelValue="@EditBindPass" @onupdate:modelValue="SetEditBindPass" Placeholder="@(Editing ? "留空保持原密码" : "请输入绑定密码")" Type="password" ShowPassword="true" Clearable="true" /></ElFormItem>
            <ElFormItem Label="账号字段属性"><ElInput ModelValue="@EditBindAttrAccount" @onupdate:modelValue="SetEditBindAttrAccount" Clearable="true" /></ElFormItem>
            <ElFormItem Label="EmployeeId 属性"><ElInput ModelValue="@EditBindAttrEmployeeId" @onupdate:modelValue="SetEditBindAttrEmployeeId" Clearable="true" /></ElFormItem>
            <ElFormItem Label="对象编码属性"><ElInput ModelValue="@EditBindAttrCode" @onupdate:modelValue="SetEditBindAttrCode" Clearable="true" /></ElFormItem>
            <ElFormItem Label="LDAP 版本"><ConfigurationNumber Value="@EditVersion" Minimum="@(1)" Maximum="@(10)" Change="@SetEditVersion" /></ElFormItem>
            <ElFormItem Label="状态"><LdapStatusInput Value="@EditStatus" OnChange="@SetEditStatus" /></ElFormItem>
        </div>
        <ElFormItem Label="备注"><ElInput ModelValue="@EditRemark" @onupdate:modelValue="SetEditRemark" Type="textarea" Rows="3" Clearable="true" /></ElFormItem>
    </ElForm>
    <div style="display:flex;justify-content:flex-end;gap:8px;"><ElButton @onclick="CancelEdit" Disabled="@Saving">取消</ElButton><ElButton Type="primary" @onclick="Save" Loading="@Saving">确定</ElButton></div>
</ElDialog>

<ElDialog ModelValue="@AuditDialogVisible" @onupdate:modelValue="SetAuditDialogVisible" Title="@AuditDialogTitle" Width="560px">
    <div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px 16px;line-height:1.6;"><strong>创建人</strong><span>@AuditCreateUser</span><strong>创建时间</strong><span>@AuditCreateTime</span><strong>最后修改人</strong><span>@AuditUpdateUser</span><strong>最后修改时间</strong><span>@AuditUpdateTime</span></div>
</ElDialog>

@code {
    [Parameter] public ConfigurationOption[] TenantOptions { get; set; } = [];
    [Parameter] public Action<string> TenantChanged { get; set; } = default!;
    [Parameter] public string TenantId { get; set; } = "";
    [Parameter] public Action<string> SetEditTenantId { get; set; } = default!;
    [Parameter] public string EditTenantId { get; set; } = "";
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public bool HasActionColumn { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool CanSyncUser { get; set; }
    [Parameter] public bool CanSyncOrg { get; set; }
    [Parameter] public bool DetailLoading { get; set; }
    [Parameter] public bool ActionLoading { get; set; }
    [Parameter] public Action<string> OpenAuditRow { get; set; } = default!;
    [Parameter] public Action<string> OpenEditRow { get; set; } = default!;
    [Parameter] public Action<string> DeleteRow { get; set; } = default!;
    [Parameter] public Action<string> SyncUserRow { get; set; } = default!;
    [Parameter] public Action<string> SyncOrgRow { get; set; } = default!;
    [Parameter] public LdapTableRow[] Rows { get; set; } = [];
    [Parameter] public int EditStatus { get; set; }
    [Parameter] public Action<double> SetEditStatus { get; set; } = default!;
    [Parameter] public int EditPort { get; set; }
    [Parameter] public Action<double?> SetEditPort { get; set; } = default!;
    [Parameter] public int EditVersion { get; set; }
    [Parameter] public Action<double?> SetEditVersion { get; set; } = default!;
    [Parameter] public Action<string?> SetKeyword { get; set; } = default!;
    [Parameter] public Action<string?> SetHost { get; set; } = default!;
    [Parameter] public Action<string?> SetEditHost { get; set; } = default!;
    [Parameter] public Action<string?> SetEditBaseDn { get; set; } = default!;
    [Parameter] public Action<string?> SetEditAuthFilter { get; set; } = default!;
    [Parameter] public Action<string?> SetEditBindDn { get; set; } = default!;
    [Parameter] public Action<string?> SetEditBindPass { get; set; } = default!;
    [Parameter] public Action<string?> SetEditBindAttrAccount { get; set; } = default!;
    [Parameter] public Action<string?> SetEditBindAttrEmployeeId { get; set; } = default!;
    [Parameter] public Action<string?> SetEditBindAttrCode { get; set; } = default!;
    [Parameter] public Action<string?> SetEditRemark { get; set; } = default!;
    [Parameter] public Action<bool> SetEditDialogVisible { get; set; } = default!;
    [Parameter] public Action<bool> SetAuditDialogVisible { get; set; } = default!;
    [Parameter] public Action CancelEdit { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action ResetSearch { get; set; } = default!;
    [Parameter] public Action OpenCreate { get; set; } = default!;
    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action Save { get; set; } = default!;
    [Parameter] public Action<double> ChangePage { get; set; } = default!;
    [Parameter] public Action<double> ChangePageSize { get; set; } = default!;
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool TenantLoading { get; set; }
    [Parameter] public string Keyword { get; set; } = "";
    [Parameter] public string Host { get; set; } = "";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool EditDialogVisible { get; set; }
    [Parameter] public string EditDialogTitle { get; set; } = "";
    [Parameter] public bool Editing { get; set; }
    [Parameter] public string EditHost { get; set; } = "";
    [Parameter] public string EditBaseDn { get; set; } = "";
    [Parameter] public string EditAuthFilter { get; set; } = "";
    [Parameter] public string EditBindDn { get; set; } = "";
    [Parameter] public string EditBindPass { get; set; } = "";
    [Parameter] public string EditBindAttrAccount { get; set; } = "";
    [Parameter] public string EditBindAttrEmployeeId { get; set; } = "";
    [Parameter] public string EditBindAttrCode { get; set; } = "";
    [Parameter] public string EditRemark { get; set; } = "";
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool AuditDialogVisible { get; set; }
    [Parameter] public string AuditDialogTitle { get; set; } = "";
    [Parameter] public string AuditCreateUser { get; set; } = "";
    [Parameter] public string AuditCreateTime { get; set; } = "";
    [Parameter] public string AuditUpdateUser { get; set; } = "";
    [Parameter] public string AuditUpdateTime { get; set; } = "";
    [Parameter] public double[] PageSizes { get; set; } = [];
}

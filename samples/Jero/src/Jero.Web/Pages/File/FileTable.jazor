@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.File

<ElTable @attributes="@(new TableData<FileView>(Rows))" border="true" stripe="true" RowKey="@(nameof(FileView.Id))" EmptyText="暂无文件">
    <ElTableColumn type="index" label="序号" width="70" align="center" />
    <ElTableColumn label="名称" MinWidth="220" ShowOverflowTooltip="true">
        <template #default context="cell">@{ var row = ((TableSlot<FileView>)(object)cell).Row; }
            <div>@(DisplayName(row))</div>
            @if (!string.IsNullOrEmpty(row.FileAlias)) { <div style="margin-top:3px;color:#909399;font-size:11px;">别名：@(row.FileAlias)</div> }
        </template>
    </ElTableColumn>
    <ElTableColumn label="后缀" width="90" align="center">
        <template #default context="cell">@{ var row = ((TableSlot<FileView>)(object)cell).Row; }<ElTag>@(Suffix(row).Length == 0 ? "-" : Suffix(row))</ElTag></template>
    </ElTableColumn>
    <ElTableColumn label="大小" width="110" align="center">
        <template #default context="cell">@{ var row = ((TableSlot<FileView>)(object)cell).Row; }@(!string.IsNullOrEmpty(row.SizeInfo) ? row.SizeInfo : (row.SizeKb.Length > 0 ? row.SizeKb + " KB" : "-"))</template>
    </ElTableColumn>
    <ElTableColumn prop="@(nameof(FileView.BucketName))" label="存储位置" MinWidth="120" ShowOverflowTooltip="true" />
    <ElTableColumn prop="@(nameof(FileView.Id))" label="存储标识" MinWidth="180" ShowOverflowTooltip="true" />
    <ElTableColumn prop="@(nameof(FileView.FileType))" label="文件类型" MinWidth="130" ShowOverflowTooltip="true" />
    <ElTableColumn label="可见性" width="90" align="center">
        <template #default context="cell">@{ var row = ((TableSlot<FileView>)(object)cell).Row; }<ElTag @attributes='@(new TableTagProps(row.IsPublic ? "success" : "info"))'>@(row.IsPublic ? "公开" : "私有")</ElTag></template>
    </ElTableColumn>
    <ElTableColumn prop="@(nameof(FileView.DataId))" label="业务数据 ID" MinWidth="170" ShowOverflowTooltip="true" />
    <ElTableColumn label="修改记录" width="100" align="center">
        <template #default context="cell">@{ var row = ((TableSlot<FileView>)(object)cell).Row; }
            <ElButton link="true" type="primary" @onclick="@(() => Audit(row.Id))">详情</ElButton>
        </template>
    </ElTableColumn>
    <ElTableColumn label="操作" width="250" align="center" fixed="right">
        <template #default context="cell">@{ var row = ((TableSlot<FileView>)(object)cell).Row; }
            <ElButton link="true" type="primary" Loading='@(PreviewingId == row.Id)' Disabled='@(!CanPreviewFile(row))' @onclick="@(() => Preview(row.Id))">预览</ElButton>
            @if (CanDownload) { <ElButton link="true" type="primary" Loading='@(DownloadingId == row.Id)' @onclick="@(() => Download(row.Id))">下载</ElButton> }
            @if (CanEdit) { <ElButton link="true" type="primary" @onclick="@(() => Edit(row.Id))">编辑</ElButton> }
            @if (CanDelete) { <ElPopconfirm Title='@("确定删除文件【" + DisplayName(row) + "】吗？")' ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(() => Delete(row.Id))">
                <template #reference><ElButton link="true" type="danger" Loading='@(DeletingId == row.Id)'>删除</ElButton></template>
            </ElPopconfirm> }
        </template>
    </ElTableColumn>
</ElTable>

@code {
    [Parameter] public FileView[] Rows { get; set; } = [];
    [Parameter] public bool CanDownload { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public Action<string> Preview { get; set; } = default!;
    [Parameter] public Action<string> Download { get; set; } = default!;
    [Parameter] public Action<string> Edit { get; set; } = default!;
    [Parameter] public Action<string> Delete { get; set; } = default!;
    [Parameter] public Action<string> Audit { get; set; } = default!;
    [Parameter] public string PreviewingId { get; set; } = "";
    [Parameter] public string DownloadingId { get; set; } = "";
    [Parameter] public string DeletingId { get; set; } = "";
    private static string Suffix(FileView row) => (row.Suffix ?? "").Trim().ToLowerInvariant();
    private static string DisplayName(FileView row) => (!string.IsNullOrEmpty(row.FileName) ? row.FileName : !string.IsNullOrEmpty(row.FileAlias) ? row.FileAlias : "未命名文件") + Suffix(row);
    private static bool CanPreviewFile(FileView row) => Suffix(row) is ".jpg" or ".jpeg" or ".png" or ".bmp" or ".gif" or ".webp" or ".pdf" or ".docx" or ".xls" or ".xlsx";
}

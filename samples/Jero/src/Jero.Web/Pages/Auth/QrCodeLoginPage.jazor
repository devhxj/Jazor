@using static ECMAScript.Vue
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Components
<main class="qr-login-page">
    <section class="qr-login-panel" aria-labelledby="qr-login-title">
        <h1 id="qr-login-title">欢迎回来 📱</h1>
        <p class="qr-login-subtitle">使用移动设备扫描下方二维码</p>

        <div class="qr-login-code" aria-live="polite">
            @if (_loading.Value)
            {
                <span>正在生成二维码…</span>
            }
            else if (_qrImage.Value.Length > 0)
            {
                <img src="@_qrImage.Value" alt="Vben 演示站二维码" />
            }
            else
            {
                <span>二维码生成失败</span>
            }
        </div>

        <p class="qr-login-prompt">当前页面展示固定演示二维码，不会创建登录会话或交换登录凭据。</p>
        <ElButton @onclick="BackToLogin">返回</ElButton>
    </section>
</main>

<style scoped>
.qr-login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    box-sizing: border-box;
    background: #f5f7fa;
}

.qr-login-panel {
    width: min(100%, 420px);
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 32px;
    box-sizing: border-box;
    border: 1px solid #ebeef5;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 32px rgba(31, 45, 61, .08);
    text-align: center;
}

.qr-login-panel h1 {
    margin: 0;
    color: #303133;
    font-size: 28px;
    line-height: 1.3;
}

.qr-login-subtitle,
.qr-login-prompt {
    margin: 0;
    color: #909399;
    line-height: 1.6;
}

.qr-login-code {
    width: 240px;
    height: 240px;
    display: grid;
    place-items: center;
    margin: 12px 0 4px;
    color: #909399;
}

.qr-login-code img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.qr-login-prompt {
    max-width: 320px;
    font-size: 13px;
}

.qr-login-panel .el-button {
    width: 100%;
    margin-top: 4px;
}

@media (max-width: 420px) {
    .qr-login-page { padding: 16px; }
    .qr-login-panel { padding: 24px 18px; }
    .qr-login-code { width: 220px; height: 220px; }
}
</style>

@code {
    private readonly IVueRef<string> _qrImage = Ref<string>("");
    private readonly IVueRef<bool> _loading = Ref<bool>(true);

    private ECMAScript.Router _router = default!;

    private void BackToLogin() => _router.Push("/login");

    [Setup]
    private void Configure()
    {
        _router = ECMAScript.VueRoute.UseRouter();
        OnMounted(LoadQrCode);
    }

    private void LoadQrCode()
    {
        // 二维码指向固定的演示站点，扫描后不会返回登录凭据。
        LoginQrCode.ToDataUrl("https://vben.vvbin.cn", new LoginQrOptions(320, 4, "H")).Then(image => _qrImage.Value = image)
          .Catch(_ => _qrImage.Value = "")
          .Finally(() => _loading.Value = false);
    }
}

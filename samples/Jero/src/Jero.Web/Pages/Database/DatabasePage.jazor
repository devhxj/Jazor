@using Jero.Web.Application
@using Jero.Web.Pages.Components

<style>
    .database-page { min-width:0; display:grid; gap:16px; }
    .database-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
    .database-heading h1 { margin:0; color:#303133; font-size:23px; }
    .database-heading p { margin:7px 0 0; color:#909399; font-size:13px; }
    .database-filters { display:flex; align-items:flex-end; gap:0 16px; flex-wrap:wrap; }
    .database-select { width:min(320px, 78vw); }
    .database-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
    .database-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .database-summary { color:#606266; font-size:13px; }
    .database-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 18px; }
    .database-form-wide { grid-column:1 / -1; }
    .database-draft-editor { padding:14px; border:1px solid #ebeef5; border-radius:8px; background:#fafbfc; }
    .database-draft-title { margin:0 0 14px; font-size:15px; color:#303133; }
    .database-preset-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
    .database-dialog-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:16px; }
    @media (max-width: 760px) {
        .database-heading { align-items:stretch; flex-direction:column; }
        .database-form-grid { grid-template-columns:1fr; }
        .database-form-wide { grid-column:auto; }
        .database-select { width:100%; }
    }
</style>

<div class="database-page">
    <div class="database-heading">
        <div>
            <h1>数据库管理</h1>
            <p>库表管理，支持库表维护、列编辑、实体生成、种子生成和结构可视化。</p>
        </div>
        <ElButton @onclick="Refresh"
                  Loading="@(LoadingDatabases || LoadingTables || LoadingColumns)"
                  Disabled="@Busy">刷新</ElButton>
    </div>

    <div style='@(Error is null ? "display:none" : "")'>
        <ElAlert Type="error"
                 Title="@(Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="DismissError" />
    </div>

    <ElCard>
        <ElForm Inline="true" LabelWidth="72px">
            <div class="database-filters">
                <ElFormItem Label="库名">
                    <div class="database-select">
                        <AuthOptionSelect Value="@ConfigId" Options="@DatabaseOptions" Placeholder="请选择库名" Clearable="true" Loading="@LoadingDatabases" Change="@ChangeDatabase" />
                    </div>
                </ElFormItem>
                <ElFormItem Label="表名">
                    <div class="database-select">
                        <AuthOptionSelect Value="@SelectedTableName" Options="@TableOptions" Placeholder="请选择表名" Clearable="true" Loading="@LoadingTables" Disabled="@(!HasDatabase)" Change="@ChangeTable" />
                    </div>
                </ElFormItem>
            </div>
        </ElForm>
    </ElCard>

    <ElCard>
        <div class="database-toolbar">
            <div class="database-actions">
                <ElButton Type="primary"
                          @onclick="OpenAddTable"
                          Disabled="@(!HasDatabase || Busy)">增加表</ElButton>
                <ElButton @onclick="OpenEditTable" Disabled="@(!HasTable || Busy)">编辑表</ElButton>
                <ElPopconfirm Title="@("确定删除数据表【" + SelectedTableName + "】吗？")"
                              ConfirmButtonText="确定"
                              CancelButtonText="取消"
                              @onconfirm="DeleteTable">
                    <template #reference>
                        <ElButton Type="danger"
                                  Disabled="@(!HasTable || Busy)"
                                  Loading='@(BusyKey == "delete-table")'>删除表</ElButton>
                    </template>
                </ElPopconfirm>
                <ElButton @onclick="OpenVisual" Disabled="@(!HasDatabase || Busy)">可视化</ElButton>
                <ElButton Type="primary"
                          Plain="true"
                          @onclick="OpenAddColumn"
                          Disabled="@(!HasTable || Busy)">增加列</ElButton>
            </div>
            <span class="database-summary">
                @(HasTable ? "当前表：" + SelectedTableName + "，共 " + ColumnRows.Length + " 列" : "请选择数据库和数据表")
            </span>
        </div>

        @if (LoadingColumns)
        {
            <ElText>正在加载字段…</ElText>
        }

        <div style='@(HasTable ? "margin-bottom:12px" : "display:none")'>
            <ElAlert Type="info"
                     ShowIcon="true"
                     Closable="false"
                     Title="列上移/下移由后端执行，当前仅支持 MySQL 数据库。" />
        </div>

        <DatabaseColumnTable Rows="@ColumnRows" Busy="@Busy" BusyKey="@BusyKey" MoveUp="@MoveColumnUp" MoveDown="@MoveColumnDown" Edit="@OpenEditColumn" Delete="@DeleteColumn" />
    </ElCard>
</div>

<ElDialog ModelValue="@AddTableDialogVisible"
          @onupdate:modelValue="SetAddTableDialogVisible"
          Title="增加数据表"
          Width="min(1120px, calc(100vw - 24px))"
          Top="3vh"
          Draggable="true"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="82px">
        <div class="database-form-grid">
            <ElFormItem Label="表名称">
                <ElInput ModelValue="@AddTableName"
                         @onupdate:modelValue="SetAddTableName"
                         Placeholder="请输入表名称"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="描述">
                <ElInput ModelValue="@AddTableDescription"
                         @onupdate:modelValue="SetAddTableDescription"
                         Placeholder="请输入表描述"
                         Clearable="true" />
            </ElFormItem>
        </div>
    </ElForm>

    <div class="database-preset-row">
        <ElButton @onclick="AddPrimaryPreset">主键字段</ElButton>
        <ElButton @onclick="AddTenantPreset">租户字段</ElButton>
        <ElButton @onclick="AddOrgPreset">机构字段</ElButton>
        <ElButton @onclick="AddBasePresets">基础字段</ElButton>
        <ElButton @onclick="AddSoftDeletePreset">软删除字段</ElButton>
    </div>

    <div class="database-draft-editor">
        <h3 class="database-draft-title">@(EditingDraftKey == 0 ? "添加字段到清单" : "编辑字段清单项")</h3>
        <ElForm LabelWidth="76px">
            <div class="database-form-grid">
                <ElFormItem Label="字段名">
                    <ElInput ModelValue="@DraftColumnName"
                             @onupdate:modelValue="SetDraftColumnName"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="描述">
                    <ElInput ModelValue="@DraftColumnDescription"
                             @onupdate:modelValue="SetDraftColumnDescription"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="类型">
                    <AuthOptionSelect Value="@DraftDataType" Options="@DataTypeOptions" Placeholder="请选择数据类型" Change="@ChangeDraftDataType" />
                </ElFormItem>
                <ElFormItem Label="默认值">
                    <ElInput ModelValue="@DraftDefaultValue"
                             @onupdate:modelValue="SetDraftDefaultValue"
                             Clearable="true" />
                </ElFormItem>
                <ElFormItem Label="长度">
                    <ConfigurationNumber Value="@DraftLength" Minimum="@(0)" Change="@SetDraftLength" />
                </ElFormItem>
                <ElFormItem Label="小数位">
                    <ConfigurationNumber Value="@DraftDecimalDigits" Minimum="@(0)" Change="@SetDraftDecimalDigits" />
                </ElFormItem>
                <ElFormItem Label="主键">
                    <DatabaseBitInput Value="@DraftIsPrimaryKey" Change="@SetDraftIsPrimaryKey" />
                </ElFormItem>
                <ElFormItem Label="自增">
                    <DatabaseBitInput Value="@DraftIsIdentity" Change="@SetDraftIsIdentity" />
                </ElFormItem>
                <ElFormItem Label="可空">
                    <DatabaseBitInput Value="@DraftIsNullable" Change="@SetDraftIsNullable" />
                </ElFormItem>
            </div>
        </ElForm>
        <div class="database-dialog-actions">
            @if (EditingDraftKey != 0)
            {
                <ElButton @onclick="ResetDraftEditor">取消编辑</ElButton>
            }
            <ElButton Type="primary" @onclick="SaveDraftColumn">
                @(EditingDraftKey == 0 ? "加入字段清单" : "更新字段清单")
            </ElButton>
        </div>
    </div>

    <div style="height:14px"></div>
    <DatabaseDraftTable Rows="@AddTableColumnRows" MoveUp="@MoveDraftUp" MoveDown="@MoveDraftDown" Edit="@EditDraft" Delete="@RemoveDraft" />

    <div class="database-dialog-actions">
        <ElButton @onclick="@(() => SetAddTableDialogVisible(false))" Disabled="@Busy">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="SaveAddTable"
                  Loading='@(BusyKey == "add-table")'>确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@EditTableDialogVisible"
          @onupdate:modelValue="SetEditTableDialogVisible"
          Title="编辑数据表"
          Width="min(620px, calc(100vw - 24px))"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="82px">
        <ElFormItem Label="表名称">
            <ElInput ModelValue="@EditTableName"
                     @onupdate:modelValue="SetEditTableName"
                     Clearable="true" />
        </ElFormItem>
        <ElFormItem Label="描述">
            <ElInput ModelValue="@EditTableDescription"
                     @onupdate:modelValue="SetEditTableDescription"
                     Clearable="true" />
        </ElFormItem>
    </ElForm>
    <div class="database-dialog-actions">
        <ElButton @onclick="@(() => SetEditTableDialogVisible(false))" Disabled="@Busy">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="SaveEditTable"
                  Loading='@(BusyKey == "edit-table")'>确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@AddColumnDialogVisible"
          @onupdate:modelValue="SetAddColumnDialogVisible"
          Title="增加数据列"
          Width="min(760px, calc(100vw - 24px))"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="78px">
        <div class="database-form-grid">
            <ElFormItem Label="列名称">
                <ElInput ModelValue="@AddColumnName"
                         @onupdate:modelValue="SetAddColumnName"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="描述">
                <ElInput ModelValue="@AddColumnDescription"
                         @onupdate:modelValue="SetAddColumnDescription"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="类型">
                <AuthOptionSelect Value="@AddColumnDataType" Options="@DataTypeOptions" Placeholder="请选择数据类型" Change="@ChangeAddColumnDataType" />
            </ElFormItem>
            <ElFormItem Label="默认值">
                <ElInput ModelValue="@AddColumnDefaultValue"
                         @onupdate:modelValue="SetAddColumnDefaultValue"
                         Clearable="true" />
            </ElFormItem>
            <ElFormItem Label="长度">
                <ConfigurationNumber Value="@AddColumnLength" Minimum="@(0)" Change="@SetAddColumnLength" />
            </ElFormItem>
            <ElFormItem Label="小数位">
                <ConfigurationNumber Value="@AddColumnDecimalDigits" Minimum="@(0)" Change="@SetAddColumnDecimalDigits" />
            </ElFormItem>
            <ElFormItem Label="主键">
                <DatabaseBitInput Value="@AddColumnIsPrimaryKey" Change="@SetAddColumnIsPrimaryKey" />
            </ElFormItem>
            <ElFormItem Label="自增">
                <DatabaseBitInput Value="@AddColumnIsIdentity" Change="@SetAddColumnIsIdentity" />
            </ElFormItem>
            <ElFormItem Label="可空">
                <DatabaseBitInput Value="@AddColumnIsNullable" Change="@SetAddColumnIsNullable" />
            </ElFormItem>
        </div>
    </ElForm>
    <div class="database-dialog-actions">
        <ElButton @onclick="@(() => SetAddColumnDialogVisible(false))" Disabled="@Busy">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="SaveAddColumn"
                  Loading='@(BusyKey == "add-column")'>确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@EditColumnDialogVisible"
          @onupdate:modelValue="SetEditColumnDialogVisible"
          Title="编辑数据列"
          Width="min(620px, calc(100vw - 24px))"
          DestroyOnClose="true"
          CloseOnClickModal="false">
    <ElForm LabelWidth="82px">
        <ElFormItem Label="列名称">
            <ElInput ModelValue="@EditColumnName"
                     @onupdate:modelValue="SetEditColumnName"
                     Clearable="true" />
        </ElFormItem>
        <ElFormItem Label="描述">
            <ElInput ModelValue="@EditColumnDescription"
                     @onupdate:modelValue="SetEditColumnDescription"
                     Clearable="true" />
        </ElFormItem>
        <ElFormItem Label="默认值">
            <ElInput ModelValue="@EditColumnDefaultValue"
                     @onupdate:modelValue="SetEditColumnDefaultValue"
                     Clearable="true" />
        </ElFormItem>
    </ElForm>
    <div class="database-dialog-actions">
        <ElButton @onclick="@(() => SetEditColumnDialogVisible(false))" Disabled="@Busy">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="SaveEditColumn"
                  Loading='@(BusyKey == "edit-column")'>确定</ElButton>
    </div>
</ElDialog>

@code {
    [Parameter] public DatabaseColumnView[] ColumnRows { get; set; } = [];
    [Parameter] public string ConfigId { get; set; } = "";
    [Parameter] public string SelectedTableName { get; set; } = "";
    [Parameter] public bool LoadingDatabases { get; set; }
    [Parameter] public bool LoadingTables { get; set; }
    [Parameter] public bool LoadingColumns { get; set; }
    [Parameter] public string BusyKey { get; set; } = "";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool AddTableDialogVisible { get; set; }
    [Parameter] public string AddTableName { get; set; } = "";
    [Parameter] public string AddTableDescription { get; set; } = "";
    [Parameter] public DatabaseColumnDraft[] AddTableColumnRows { get; set; } = [];
    [Parameter] public int EditingDraftKey { get; set; }
    [Parameter] public string DraftColumnName { get; set; } = "";
    [Parameter] public string DraftColumnDescription { get; set; } = "";
    [Parameter] public string DraftDataType { get; set; } = "";
    [Parameter] public int DraftLength { get; set; }
    [Parameter] public int DraftDecimalDigits { get; set; }
    [Parameter] public string DraftDefaultValue { get; set; } = "";
    [Parameter] public int DraftIsPrimaryKey { get; set; }
    [Parameter] public int DraftIsIdentity { get; set; }
    [Parameter] public int DraftIsNullable { get; set; }
    [Parameter] public bool EditTableDialogVisible { get; set; }
    [Parameter] public string EditTableName { get; set; } = "";
    [Parameter] public string EditTableDescription { get; set; } = "";
    [Parameter] public bool AddColumnDialogVisible { get; set; }
    [Parameter] public string AddColumnName { get; set; } = "";
    [Parameter] public string AddColumnDescription { get; set; } = "";
    [Parameter] public string AddColumnDataType { get; set; } = "";
    [Parameter] public int AddColumnLength { get; set; }
    [Parameter] public int AddColumnDecimalDigits { get; set; }
    [Parameter] public string AddColumnDefaultValue { get; set; } = "";
    [Parameter] public int AddColumnIsPrimaryKey { get; set; }
    [Parameter] public int AddColumnIsIdentity { get; set; }
    [Parameter] public int AddColumnIsNullable { get; set; }
    [Parameter] public bool EditColumnDialogVisible { get; set; }
    [Parameter] public string EditColumnName { get; set; } = "";
    [Parameter] public string EditColumnDescription { get; set; } = "";
    [Parameter] public string EditColumnDefaultValue { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool HasTable { get; set; }
    [Parameter] public bool HasDatabase { get; set; }
    [Parameter] public ConfigurationOption[] DatabaseOptions { get; set; } = [];
    [Parameter] public ConfigurationOption[] TableOptions { get; set; } = [];
    [Parameter] public ConfigurationOption[] DataTypeOptions { get; set; } = [];

    [Parameter] public Action Refresh { get; set; } = default!;
    [Parameter] public Action DismissError { get; set; } = default!;
    [Parameter] public Action<string> ChangeDatabase { get; set; } = default!;
    [Parameter] public Action<string> ChangeTable { get; set; } = default!;
    [Parameter] public Action OpenAddTable { get; set; } = default!;
    [Parameter] public Action OpenEditTable { get; set; } = default!;
    [Parameter] public Action DeleteTable { get; set; } = default!;
    [Parameter] public Action OpenVisual { get; set; } = default!;
    [Parameter] public Action OpenAddColumn { get; set; } = default!;
    [Parameter] public Action<string> MoveColumnUp { get; set; } = default!;
    [Parameter] public Action<string> MoveColumnDown { get; set; } = default!;
    [Parameter] public Action<string> OpenEditColumn { get; set; } = default!;
    [Parameter] public Action<string> DeleteColumn { get; set; } = default!;
    [Parameter] public Action<bool> SetAddTableDialogVisible { get; set; } = default!;
    [Parameter] public Action<string?> SetAddTableName { get; set; } = default!;
    [Parameter] public Action<string?> SetAddTableDescription { get; set; } = default!;
    [Parameter] public Action AddPrimaryPreset { get; set; } = default!;
    [Parameter] public Action AddTenantPreset { get; set; } = default!;
    [Parameter] public Action AddOrgPreset { get; set; } = default!;
    [Parameter] public Action AddBasePresets { get; set; } = default!;
    [Parameter] public Action AddSoftDeletePreset { get; set; } = default!;
    [Parameter] public Action<string?> SetDraftColumnName { get; set; } = default!;
    [Parameter] public Action<string?> SetDraftColumnDescription { get; set; } = default!;
    [Parameter] public Action<string> ChangeDraftDataType { get; set; } = default!;
    [Parameter] public Action<string?> SetDraftDefaultValue { get; set; } = default!;
    [Parameter] public Action<double?> SetDraftLength { get; set; } = default!;
    [Parameter] public Action<double?> SetDraftDecimalDigits { get; set; } = default!;
    [Parameter] public Action<double> SetDraftIsPrimaryKey { get; set; } = default!;
    [Parameter] public Action<double> SetDraftIsIdentity { get; set; } = default!;
    [Parameter] public Action<double> SetDraftIsNullable { get; set; } = default!;
    [Parameter] public Action ResetDraftEditor { get; set; } = default!;
    [Parameter] public Action SaveDraftColumn { get; set; } = default!;
    [Parameter] public Action<double> MoveDraftUp { get; set; } = default!;
    [Parameter] public Action<double> MoveDraftDown { get; set; } = default!;
    [Parameter] public Action<double> EditDraft { get; set; } = default!;
    [Parameter] public Action<double> RemoveDraft { get; set; } = default!;
    [Parameter] public Action SaveAddTable { get; set; } = default!;
    [Parameter] public Action<bool> SetEditTableDialogVisible { get; set; } = default!;
    [Parameter] public Action<string?> SetEditTableName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditTableDescription { get; set; } = default!;
    [Parameter] public Action SaveEditTable { get; set; } = default!;
    [Parameter] public Action<bool> SetAddColumnDialogVisible { get; set; } = default!;
    [Parameter] public Action<string?> SetAddColumnName { get; set; } = default!;
    [Parameter] public Action<string?> SetAddColumnDescription { get; set; } = default!;
    [Parameter] public Action<string> ChangeAddColumnDataType { get; set; } = default!;
    [Parameter] public Action<string?> SetAddColumnDefaultValue { get; set; } = default!;
    [Parameter] public Action<double?> SetAddColumnLength { get; set; } = default!;
    [Parameter] public Action<double?> SetAddColumnDecimalDigits { get; set; } = default!;
    [Parameter] public Action<double> SetAddColumnIsPrimaryKey { get; set; } = default!;
    [Parameter] public Action<double> SetAddColumnIsIdentity { get; set; } = default!;
    [Parameter] public Action<double> SetAddColumnIsNullable { get; set; } = default!;
    [Parameter] public Action SaveAddColumn { get; set; } = default!;
    [Parameter] public Action<bool> SetEditColumnDialogVisible { get; set; } = default!;
    [Parameter] public Action<string?> SetEditColumnName { get; set; } = default!;
    [Parameter] public Action<string?> SetEditColumnDescription { get; set; } = default!;
    [Parameter] public Action<string?> SetEditColumnDefaultValue { get; set; } = default!;
    [Parameter] public Action SaveEditColumn { get; set; } = default!;
}

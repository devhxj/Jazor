@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.ReceivedNotice
@using Jero.Web.Pages.Components

<ElTable @attributes="@(new TableData<ReceivedNoticeView>(Rows))" border="true" stripe="true" RowKey="@(nameof(ReceivedNoticeView.Id))" EmptyText="暂无站内信">
        <ElTableColumn type="index" label="序号" width="70" align="center" />
        <ElTableColumn label="标题" MinWidth="220" ShowOverflowTooltip="true">
            <template #default context="cell">@{ var row = ((TableSlot<ReceivedNoticeView>)(object)cell).Row; }
                <span style='@(row.ReadStatus == 1 ? "" : "font-weight:600;")'>@((string.IsNullOrEmpty(row.Title) ? "-" : row.Title))</span>
            </template>
        </ElTableColumn>
        <ElTableColumn prop="@(nameof(ReceivedNoticeView.ContentSummary))" label="内容摘要" MinWidth="280" ShowOverflowTooltip="true" />
        <ElTableColumn label="类型" width="100" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<ReceivedNoticeView>)(object)cell).Row; }
                <ElTag @attributes="@(new TableTagProps(TypeTag(row.Type)))">@(TypeLabel(row.Type))</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn label="阅读状态" width="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<ReceivedNoticeView>)(object)cell).Row; }
                <ElTag @attributes="@(new TableTagProps(row.ReadStatus == 1 ? "success" : "warning"))">@(row.ReadStatus == 1 ? "已读" : "未读")</ElTag>
            </template>
        </ElTableColumn>
        <ElTableColumn label="发布者" MinWidth="110" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<ReceivedNoticeView>)(object)cell).Row; }@((string.IsNullOrEmpty(row.PublicUserName) ? "-" : row.PublicUserName))</template>
        </ElTableColumn>
        <ElTableColumn label="发布时间" MinWidth="170" align="center">
            <template #default context="cell">@{ var row = ((TableSlot<ReceivedNoticeView>)(object)cell).Row; }@((string.IsNullOrEmpty(row.PublicTime) ? "-" : row.PublicTime))</template>
        </ElTableColumn>
        <ElTableColumn label="操作" width="100" align="center" fixed="right">
            <template #default context="cell">@{ var row = ((TableSlot<ReceivedNoticeView>)(object)cell).Row; }
                <ElButton link="true" type="primary" disabled='@(MarkingRead)' @onclick="@(() => OpenDetail(row.Id))">详情</ElButton>
            </template>
        </ElTableColumn>
    </ElTable>

@code {
    [Parameter] public ReceivedNoticeView[] Rows { get; set; } = [];
    [Parameter] public ReceivedNoticeOption[] TypeOptions { get; set; } = default!;
    [Parameter] public bool MarkingRead { get; set; } = default!;
    [Parameter] public Action<string> OpenDetail { get; set; } = default!;

    private string TypeLabel(int value) => TypeOptions.FirstOrDefault(option => option.Value == value)?.Label ?? (value == 0 ? "类型-" : "类型" + value);
    private string TypeTag(int value)
    {
        var option = TypeOptions.FirstOrDefault(option => option.Value == value);
        if (option is null) return "info";
        return option.TagType is "success" or "warning" or "danger" or "info" ? option.TagType : "primary";
    }
}

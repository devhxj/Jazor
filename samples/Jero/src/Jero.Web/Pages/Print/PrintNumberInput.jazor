@using Npm.ElementPlus
@using Jero.Web.Pages.Print

<ElInputNumber @attributes="@(new PrintNumberProps(Maximum ?? double.PositiveInfinity, Precision ?? ECMAScript.Global.Undefined<double>()))"
    ModelValue="@Value" Min="@Minimum" Step="@Step"
    Disabled="@Disabled" ControlsPosition="right"
    @onupdate:modelValue="Update" />

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public double Minimum { get; set; }
    [Parameter] public double? Maximum { get; set; }
    [Parameter] public double Step { get; set; }
    [Parameter] public double? Precision { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Action<double?> Change { get; set; } = default!;

    private void Update(double? value) => Change(value);
}

@using Npm.ElementPlus
@using Jero.Web.Pages.Components

<ElTabs ModelValue="@Value" @attributes="@(new ModelUpdate<object?>(Update))">
    <ElTabPane label="插件信息" name="basic"><slot name="basic" /></ElTabPane>
    <ElTabPane label="C# 代码" name="code"><slot name="code" /></ElTabPane>
</ElTabs>

@code {
    [Parameter] public string Value { get; set; } = default!;
    [Parameter] public Action<string> Change { get; set; } = default!;

    private void Update(object? value) => Change(value as string ?? "basic");
}

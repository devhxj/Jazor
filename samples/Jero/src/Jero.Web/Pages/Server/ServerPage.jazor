@using Jero.Web.Application
@using Jero.Web.Pages.Server
@using Npm.ElementPlus

<style>
    .server-page { display: grid; gap: 16px; }
    .server-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 4px 2px; }
    .server-heading h1 { margin: 0; color: #303133; font-size: 23px; line-height: 1.25; }
    .server-heading p { margin: 7px 0 0; color: #909399; font-size: 13px; }
    .server-overview { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(360px, .82fr); gap: 16px; }
    .server-section-title { margin: 0 0 3px; font-size: 16px; font-weight: 650; }
    .server-section-note { margin: 0 0 18px; color: #909399; font-size: 12px; }
    .server-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid #ebeef5; }
    .server-fact { min-width: 0; display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid #ebeef5; }
    .server-fact:nth-child(odd) { padding-right: 20px; }
    .server-fact__label { color: #909399; font-size: 13px; }
    .server-fact__value { min-width: 0; color: #303133; font-size: 13px; overflow-wrap: anywhere; }
    .server-resource-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .server-resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .server-resource { display: grid; justify-items: center; gap: 14px; }
    .server-gauge { width: 150px; height: 150px; display: grid; place-items: center; border-radius: 50%; transition: background .25s ease; }
    .server-gauge__inner { width: 116px; height: 116px; display: grid; place-content: center; gap: 4px; border-radius: 50%; background: white; text-align: center; box-shadow: inset 0 0 0 1px #f0f2f5; }
    .server-gauge__inner strong { color: #303133; font-size: 23px; }
    .server-gauge__inner span { color: #909399; font-size: 12px; }
    .server-resource-meta { width: 100%; display: grid; gap: 7px; color: #606266; font-size: 12px; }
    .server-resource-meta div { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px dashed #ebeef5; padding-bottom: 7px; }
    .server-resource-meta span:last-child { color: #303133; text-align: right; overflow-wrap: anywhere; }
    .server-disks { display: grid; grid-template-columns: repeat(auto-fit, minmax(245px, 1fr)); gap: 14px; }
    .server-disk { min-width: 0; border: 1px solid #ebeef5; border-radius: 10px; padding: 16px; background: #fafbfc; }
    .server-disk__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 15px; }
    .server-disk__name { min-width: 0; font-weight: 650; overflow-wrap: anywhere; }
    .server-disk__bar { height: 8px; margin-bottom: 14px; border-radius: 999px; background: #e9eef5; overflow: hidden; }
    .server-disk__fill { height: 100%; border-radius: inherit; background: #409eff; transition: width .25s ease; }
    .server-disk__meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .server-disk__metric { min-width: 0; }
    .server-disk__metric span { display: block; color: #909399; font-size: 11px; }
    .server-disk__metric strong { display: block; margin-top: 5px; color: #303133; font-size: 12px; overflow-wrap: anywhere; }
    .server-assemblies { display: flex; flex-wrap: wrap; gap: 9px; }
    .server-assembly { display: inline-flex; align-items: center; gap: 7px; max-width: 100%; border: 1px solid #d9ecff; border-radius: 999px; padding: 6px 11px; background: #ecf5ff; color: #337ecc; font-size: 12px; }
    .server-assembly__name { font-family: Consolas, "SFMono-Regular", Menlo, monospace; overflow-wrap: anywhere; }
    .server-assembly__version { color: #909399; font-size: 10px; }
    .server-empty { padding: 30px 0; color: #909399; text-align: center; }
    @@media (max-width: 1100px) {
        .server-overview { grid-template-columns: 1fr; }
    }
    @@media (max-width: 700px) {
        .server-heading { align-items: flex-start; flex-direction: column; }
        .server-facts, .server-resource-grid { grid-template-columns: 1fr; }
        .server-fact:nth-child(odd) { padding-right: 0; }
        .server-disk__meta { grid-template-columns: 1fr; }
    }
</style>

<div class="server-page">
    <div class="server-heading">
        <div>
            <h1>系统监控</h1>
            <p>查看服务环境、CPU、内存、磁盘和程序集；运行指标每 10 秒自动刷新。</p>
        </div>
        <ElButton Type="primary" @onclick="RefreshAll" Loading="@IsRefreshing">刷新全部</ElButton>
    </div>

    <div style='@(Error is null ? "display:none" : "")'>
        <ElAlert Type="error" Title="@(Error ?? "")" ShowIcon="true" Closable="false" />
    </div>

    <div class="server-overview">
        <ElCard>
            <div class="server-section-title">系统信息</div>
            <div class="server-section-note">当前服务进程、部署环境与网络信息。</div>
            @if (BaseLoading && BaseInfo.HostName.Length == 0)
            {
                <div class="server-empty">正在加载系统信息…</div>
            }
            else
            {
                <div class="server-facts">
                    <div class="server-fact"><span class="server-fact__label">主机名称</span><span class="server-fact__value">@Display(BaseInfo.HostName)</span></div>
                    <div class="server-fact"><span class="server-fact__label">操作系统</span><span class="server-fact__value">@Display(BaseInfo.SystemOs)</span></div>
                    <div class="server-fact"><span class="server-fact__label">系统架构</span><span class="server-fact__value">@Display(BaseInfo.OsArchitecture)</span></div>
                    <div class="server-fact"><span class="server-fact__label">CPU 核数</span><span class="server-fact__value">@Display(BaseInfo.ProcessorCount)</span></div>
                    <div class="server-fact"><span class="server-fact__label">系统运行时长</span><span class="server-fact__value">@Display(BaseInfo.SysRunTime)</span></div>
                    <div class="server-fact"><span class="server-fact__label">服务启动时间</span><span class="server-fact__value">@Display(UsedInfo.StartTime)</span></div>
                    <div class="server-fact"><span class="server-fact__label">外网地址</span><span class="server-fact__value">@Display(BaseInfo.RemoteIp)</span></div>
                    <div class="server-fact"><span class="server-fact__label">内网地址</span><span class="server-fact__value">@Display(BaseInfo.LocalIp)</span></div>
                    <div class="server-fact"><span class="server-fact__label">运行框架</span><span class="server-fact__value">@Display(BaseInfo.FrameworkDescription)</span></div>
                    <div class="server-fact"><span class="server-fact__label">开发环境</span><span class="server-fact__value">@Display(BaseInfo.Environment)</span></div>
                    <div class="server-fact"><span class="server-fact__label">环境变量</span><span class="server-fact__value">@Display(BaseInfo.Stage)</span></div>
                    <div class="server-fact"><span class="server-fact__label">网站目录</span><span class="server-fact__value">@Display(BaseInfo.Wwwroot)</span></div>
                </div>
            }
        </ElCard>

        <ElCard>
            <div class="server-resource-head">
                <div>
                    <div class="server-section-title">使用信息</div>
                    <div class="server-section-note">CPU 与内存指标自动轮询。</div>
                </div>
                <ElTag Type="info">最近刷新：@Display(LastRefreshTime)</ElTag>
            </div>
            @if (UsedLoading && UsedInfo.StartTime.Length == 0)
            {
                <div class="server-empty">正在加载资源使用信息…</div>
            }
            else
            {
                <div class="server-resource-grid">
                    <div class="server-resource">
                        <div class="server-gauge" style="@GaugeStyle(MemoryPercentage)">
                            <div class="server-gauge__inner">
                                <strong>@(UsedInfo.RamRate.Length == 0 ? "0%" : UsedInfo.RamRate)</strong>
                                <span>内存使用率</span>
                            </div>
                        </div>
                        <div class="server-resource-meta">
                            <div><span>总内存</span><span>@Display(UsedInfo.TotalRam)</span></div>
                            <div><span>已用</span><span>@Display(UsedInfo.UsedRam)</span></div>
                            <div><span>剩余</span><span>@Display(UsedInfo.FreeRam)</span></div>
                        </div>
                    </div>
                    <div class="server-resource">
                        <div class="server-gauge" style="@GaugeStyle(CpuPercentage)">
                            <div class="server-gauge__inner">
                                <strong>@(UsedInfo.CpuRate.Length == 0 ? "0%" : UsedInfo.CpuRate)</strong>
                                <span>CPU 使用率</span>
                            </div>
                        </div>
                        <div class="server-resource-meta">
                            <div><span>服务运行时长</span><span>@Display(UsedInfo.RunTime)</span></div>
                            <div><span>服务启动时间</span><span>@Display(UsedInfo.StartTime)</span></div>
                            <div><span>多核数据</span><span>@Display(UsedInfo.CpuRates)</span></div>
                        </div>
                    </div>
                </div>
            }
        </ElCard>
    </div>

    <ElCard>
        <div class="server-section-title">磁盘信息</div>
        <div class="server-section-note">后端返回的容量单位为 GB，百分比表示已使用空间。</div>
        @if (DiskLoading && Disks.Length == 0)
        {
            <div class="server-empty">正在加载磁盘信息…</div>
        }
        else if (Disks.Length == 0)
        {
            <div class="server-empty">暂无磁盘信息</div>
        }
        else
        {
            <div class="server-disks">
                @for (var index = 0; index < Disks.Length; index++)
                {
                    var disk = Disks[index];
                    <div class="server-disk">
                        <div class="server-disk__head">
                            <div class="server-disk__name">@DiskName(disk, index)</div>
                            <ElTag Type="info">使用率 @DiskPercent(disk)</ElTag>
                        </div>
                        <div class="server-disk__bar">
                            <div class="server-disk__fill" style='@("width:" + disk.AvailablePercent.ToString() + "%")'></div>
                        </div>
                        <div class="server-disk__meta">
                            <div class="server-disk__metric"><span>总容量</span><strong>@Capacity(disk.TotalSize)</strong></div>
                            <div class="server-disk__metric"><span>已使用</span><strong>@Capacity(disk.Used)</strong></div>
                            <div class="server-disk__metric"><span>剩余</span><strong>@Capacity(disk.AvailableFreeSpace)</strong></div>
                        </div>
                        <div style="margin-top:12px;color:#909399;font-size:11px;">类型：@Display(disk.TypeName)</div>
                    </div>
                }
            </div>
        }
    </ElCard>

    <ElCard>
        <div class="server-section-title">程序集信息</div>
        <div class="server-section-note">当前 Jero 服务进程加载的主要依赖版本。</div>
        @if (AssemblyLoading && Assemblies.Length == 0)
        {
            <div class="server-empty">正在加载程序集信息…</div>
        }
        else if (Assemblies.Length == 0)
        {
            <div class="server-empty">暂无程序集信息</div>
        }
        else
        {
            <div class="server-assemblies">
                @foreach (var assembly in Assemblies)
                {
                    <span class="server-assembly">
                        <span class="server-assembly__name">@Display(assembly.Name)</span>
                        <span class="server-assembly__version">@AssemblyVersion(assembly)</span>
                    </span>
                }
            </div>
        }
    </ElCard>
</div>

@code {
    [Parameter] public ServerBaseView BaseInfo { get; set; } = new();
    [Parameter] public ServerUsedView UsedInfo { get; set; } = new();
    [Parameter] public ServerDiskView[] Disks { get; set; } = [];
    [Parameter] public ServerAssemblyView[] Assemblies { get; set; } = [];
    [Parameter] public bool BaseLoading { get; set; }
    [Parameter] public bool UsedLoading { get; set; }
    [Parameter] public bool DiskLoading { get; set; }
    [Parameter] public bool AssemblyLoading { get; set; }
    [Parameter] public string LastRefreshTime { get; set; } = "";
    [Parameter] public bool IsRefreshing { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public int MemoryPercentage { get; set; }
    [Parameter] public int CpuPercentage { get; set; }
    [Parameter] public Action RefreshAll { get; set; } = default!;

    private static string Display(string value)
        => value.Length == 0 ? "-" : value;

    private static string Capacity(string value)
        => value.Length == 0 ? "-" : value + " GB";

    private static string AssemblyVersion(ServerAssemblyView assembly)
        => assembly.Version.Length == 0 ? "-" : "v" + assembly.Version;

    private static string DiskName(ServerDiskView disk, int index)
        => disk.DiskName.Length == 0 ? "磁盘 " + (index + 1).ToString() : disk.DiskName;

    private static string DiskPercent(ServerDiskView disk)
        => disk.AvailablePercentText.Length == 0 ? "0%" : disk.AvailablePercent.ToString() + "%";

    private static string GaugeStyle(int percentage)
        => "background:conic-gradient(#409eff 0 " + percentage.ToString() + "%,#edf2f7 " + percentage.ToString() + "% 100%);";
}

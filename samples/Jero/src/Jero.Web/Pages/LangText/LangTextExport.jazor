@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.LangText

    <ElDropdown SplitButton="true" trigger="click" disabled='@(Disabled)' @onclick='@(() => OnExportPage())'
                @attributes="@(new ExportMenuCommand(OnCommand))">
        导出
        <template #dropdown>
            <ElDropdownMenu>
                <ElDropdownItem command="select" disabled='@(!HasSelection)'>导出选中数据</ElDropdownItem>
                <ElDropdownItem command="page">导出本页数据</ElDropdownItem>
                <ElDropdownItem command="all">导出全部数据</ElDropdownItem>
            </ElDropdownMenu>
        </template>
    </ElDropdown>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool HasSelection { get; set; }
    [Parameter] public Action OnExportPage { get; set; } = default!;
    [Parameter] public Action<string> OnCommand { get; set; } = default!;
}

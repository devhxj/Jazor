@using Jero.Web.Application
@using Npm.ElementPlus
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.StressTest

<style>
    .stress-page { display:grid; gap:16px; }
    .stress-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
    .stress-heading h1 { margin:0; color:#303133; font-size:23px; }
    .stress-heading p { margin:7px 0 0; color:#909399; font-size:13px; }
    .stress-layout { display:grid; grid-template-columns:minmax(300px, 36%) minmax(0, 1fr); gap:16px; align-items:start; }
    .stress-tools { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; margin-top:12px; }
    .stress-tree { display:grid; gap:12px; max-height:720px; overflow:auto; padding-right:4px; }
    .stress-groups { display:grid; gap:12px; }
    .stress-group { border:1px solid #ebeef5; border-radius:9px; overflow:hidden; }
    .stress-group__head { padding:10px 12px; background:#f5f7fa; color:#606266; font-size:13px; font-weight:650; }
    .stress-item { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:9px; align-items:center; padding:10px 12px; border-top:1px solid #f0f2f5; cursor:pointer; }
    .stress-item:hover, .stress-item.is-active { background:#ecf5ff; }
    .stress-item__text { min-width:0; }
    .stress-item__summary { color:#303133; font-size:13px; overflow-wrap:anywhere; }
    .stress-item__path { margin-top:3px; color:#909399; font:11px Consolas,monospace; overflow-wrap:anywhere; }
    .stress-method { min-width:48px; border-radius:5px; padding:3px 5px; text-align:center; font-size:10px; font-weight:700; }
    .stress-method--get { background:#f0f9eb; color:#529b2e; }
    .stress-method--post { background:#ecf5ff; color:#337ecc; }
    .stress-method--put { background:#fdf6ec; color:#b88230; }
    .stress-method--delete { background:#fef0f0; color:#c45656; }
    .stress-empty { padding:42px 12px; color:#909399; text-align:center; }
    .stress-right { display:grid; gap:16px; }
    .stress-card-head { display:flex; align-items:flex-start; justify-content:space-between; gap:14px; margin-bottom:14px; }
    .stress-card-title { color:#303133; font-size:16px; font-weight:650; }
    .stress-card-note { margin-top:4px; color:#909399; font-size:12px; }
    .stress-facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid #ebeef5; }
    .stress-fact { display:grid; grid-template-columns:120px minmax(0,1fr); gap:10px; padding:11px 0; border-bottom:1px solid #ebeef5; }
    .stress-fact:nth-child(odd) { padding-right:18px; }
    .stress-fact__label { color:#909399; font-size:12px; }
    .stress-fact__value { color:#303133; font-size:13px; overflow-wrap:anywhere; }
    .stress-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
    .stress-metric { border:1px solid #ebeef5; border-radius:8px; padding:12px; background:#fafbfc; }
    .stress-metric span { display:block; color:#909399; font-size:11px; }
    .stress-metric strong { display:block; margin-top:6px; color:#303133; font-size:18px; overflow-wrap:anywhere; }
    @media(max-width:1000px) { .stress-layout { grid-template-columns:1fr; } .stress-tree { max-height:480px; } }
    @media(max-width:700px) { .stress-heading,.stress-card-head { flex-direction:column; } .stress-facts,.stress-metrics { grid-template-columns:1fr; } .stress-fact:nth-child(odd) { padding-right:0; } }
    .stress-empty { padding:42px 12px; color:#909399; text-align:center; }
    .stress-form-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
    .stress-form-wide { grid-column:1/-1; }
    .stress-label { display:block; margin-bottom:6px; color:#606266; font-size:12px; }
    .stress-pair-tabs { display:flex; flex-wrap:wrap; gap:7px; margin:16px 0 12px; }
    .stress-pair-tab { border:1px solid #dcdfe6; border-radius:6px; padding:6px 12px; background:white; color:#606266; cursor:pointer; }
    .stress-pair-tab.is-active { border-color:#409eff; background:#ecf5ff; color:#337ecc; }
    .stress-pair-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px; }
    .stress-pair-list { display:grid; gap:9px; }
    .stress-pair-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto; gap:9px; align-items:center; }
    .stress-pair-input { width:100%; height:32px; border:1px solid #dcdfe6; border-radius:4px; padding:0 11px; outline:none; background:white; color:#606266; font:inherit; transition:border-color .2s; }
    .stress-pair-input:focus { border-color:#409eff; }
    .stress-dialog-actions { display:flex; justify-content:flex-end; gap:9px; margin-top:18px; }
    @media(max-width:700px) { .stress-form-grid,.stress-pair-row { grid-template-columns:1fr; } .stress-form-wide { grid-column:auto; } }
</style>

<div class="stress-page">
    <div class="stress-heading">
        <div>
            <h1>接口压测</h1>
            <p>解析 Swagger 接口分组，编辑请求参数并查看长耗时压测统计。</p>
        </div>
        <ElButton @onclick="LoadResources" Loading="@Busy">刷新接口</ElButton>
    </div>

    <div style='@(Error is null ? "display:none" : "")'>
        <ElAlert Type="error" Title="@(Error ?? "")" ShowIcon="true" Closable="false" />
    </div>
    <div style='@(IsSuperAdmin ? "display:none" : "")'>
        <ElAlert Type="warning" Title="该功能仅超级管理员可执行；当前账号仍可浏览接口元数据。" ShowIcon="true" Closable="false" />
    </div>

    <div class="stress-layout">
        <ElCard>
            <AuthOptionSelect Value="@SelectedSwaggerUrl" Options="@ResourceOptions" Placeholder="接口分组" Clearable="true" Loading="@LoadingResources" Change="@SwaggerChanged" />
            <div class="stress-tools">
                <ElInput ModelValue="@Keywords" @onupdate:modelValue="ChangeKeywords" Placeholder="接口名称、路径或方法" Clearable="true" />
                <ElButton @onclick="Search" Loading="@LoadingDocument">查询</ElButton>
            </div>

            <div class="stress-tree">
                @if (Busy)
                {
                    <div class="stress-empty">正在加载接口元数据…</div>
                }
                else if (Groups.Length == 0)
                {
                    <div class="stress-empty">暂无接口数据</div>
                }
                else
                {
                    <div class="stress-groups">
                        @foreach (var group in Groups)
                        {
                            <div class="stress-group" @key="group.Name">
                                <div class="stress-group__head">@group.Summary</div>
                                @foreach (var node in group.Nodes)
                                {
                                    <div class='@(SelectedNodeId == node.Id ? "stress-item is-active" : "stress-item")' @key="node.Id">
                                        <span class="@MethodClass(node.Method)">@node.Method</span>
                                        <div class="stress-item__text">
                                            <div class="stress-item__summary">@node.Summary</div>
                                            <div class="stress-item__path">@node.Path</div>
                                        </div>
                                        <div style="display:flex;gap:5px;">
                                            <ElButton Link="true" @onclick="@(() => SelectNodeAt(node.GroupIndex, node.NodeIndex))">选择</ElButton>
                                            <ElButton Link="true" Type="primary" @onclick="@(() => OpenDialogAt(node.GroupIndex, node.NodeIndex))" Disabled="@(!IsSuperAdmin)">压测</ElButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </ElCard>

        <div class="stress-right">
            <ElCard>
                <div class="stress-card-head">
                    <div><div class="stress-card-title">当前压测参数</div><div class="stress-card-note">先选择接口，再调整参数并开始压测。</div></div>
                    <ElButton Type="primary" @onclick="OpenCurrentDialog" Disabled="@(!IsSuperAdmin || SelectedNodeId is null)">开始测试</ElButton>
                </div>
                <div class="stress-facts">
                    <div class="stress-fact"><span class="stress-fact__label">请求方式</span><span class="stress-fact__value">@EditMethod</span></div>
                    <div class="stress-fact"><span class="stress-fact__label">请求地址</span><span class="stress-fact__value">@(EditUri.Length == 0 ? "-" : EditUri)</span></div>
                    <div class="stress-fact"><span class="stress-fact__label">轮数</span><span class="stress-fact__value">@EditRounds</span></div>
                    <div class="stress-fact"><span class="stress-fact__label">每轮请求数</span><span class="stress-fact__value">@EditRequests</span></div>
                    <div class="stress-fact"><span class="stress-fact__label">最大并发量</span><span class="stress-fact__value">@EditParallelism</span></div>
                    <div class="stress-fact"><span class="stress-fact__label">参数数量</span><span class="stress-fact__value">@(ParameterCount)</span></div>
                </div>
            </ElCard>

            <ElCard>
                <div class="stress-card-title" style="margin-bottom:14px;">压测结果</div>
                <div class="stress-metrics">
                    <div class="stress-metric"><span>总请求数</span><strong>@Count(Result.TotalRequests)</strong></div>
                    <div class="stress-metric"><span>成功请求数</span><strong>@Count(Result.SuccessfulRequests)</strong></div>
                    <div class="stress-metric"><span>失败请求数</span><strong>@Count(Result.FailedRequests)</strong></div>
                    <div class="stress-metric"><span>总用时（秒）</span><strong>@Metric(Result.TotalTimeInSeconds)</strong></div>
                    <div class="stress-metric"><span>QPS</span><strong>@Metric(Result.QueriesPerSecond)</strong></div>
                    <div class="stress-metric"><span>平均响应（ms）</span><strong>@Metric(Result.AverageResponseTime)</strong></div>
                    <div class="stress-metric"><span>最小 / 最大（ms）</span><strong>@Metric(Result.MinResponseTime) / @Metric(Result.MaxResponseTime)</strong></div>
                    <div class="stress-metric"><span>P10 / P25（ms）</span><strong>@Metric(Result.Percentile10ResponseTime) / @Metric(Result.Percentile25ResponseTime)</strong></div>
                    <div class="stress-metric"><span>P50 / P75（ms）</span><strong>@Metric(Result.Percentile50ResponseTime) / @Metric(Result.Percentile75ResponseTime)</strong></div>
                    <div class="stress-metric"><span>P90（ms）</span><strong>@Metric(Result.Percentile90ResponseTime)</strong></div>
                    <div class="stress-metric"><span>P99（ms）</span><strong>@Metric(Result.Percentile99ResponseTime)</strong></div>
                    <div class="stress-metric"><span>P999（ms）</span><strong>@Metric(Result.Percentile999ResponseTime)</strong></div>
                </div>
            </ElCard>
        </div>
    </div>
</div>

<ElDialog ModelValue="@DialogVisible"
          @onupdate:modelValue="SetDialogVisible"
          Title="接口压测参数"
          Width="min(860px, calc(100vw - 24px))"
          CloseOnClickModal="false">
    <div class="stress-form-grid">
        <div>
            <label class="stress-label">请求方式</label>
            <StressMethodSelect Value="@EditMethod" Change="@SetEditMethod" />
        </div>
        <div class="stress-form-wide">
            <label class="stress-label">请求地址</label>
            <ElInput ModelValue="@EditUri" @onupdate:modelValue="SetEditUri" Placeholder="请输入完整请求地址" />
        </div>
        <div>
            <label class="stress-label">轮数</label>
            <ElInputNumber ModelValue="@EditRounds" @onupdate:modelValue="SetEditRounds" Min="1" Max="10000" />
        </div>
        <div>
            <label class="stress-label">每轮请求数</label>
            <ElInputNumber ModelValue="@EditRequests" @onupdate:modelValue="SetEditRequests" Min="1" Max="100000" />
        </div>
        <div>
            <label class="stress-label">最大并发量</label>
            <ElInputNumber ModelValue="@EditParallelism" @onupdate:modelValue="SetEditParallelism" Min="1" Max="10000" />
        </div>
    </div>

    <StressPairEditor ActiveTab="@ActivePairTab" Headers="@Headers" Body="@Body" PathPairs="@PathPairs" Query="@Query"
                      TabChange="@SetActivePairTab" Add="@AddPair" Remove="@RemovePair" UpdatePair="@UpdatePair" />

    <div class="stress-dialog-actions">
        <ElButton @onclick="@(() => SetDialogVisible(false))" Disabled="@Submitting">取消</ElButton>
        <ElPopconfirm Title="确定按当前参数发起接口压测吗？" ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="Submit">
            <template #reference><ElButton Type="primary" Loading="@Submitting">开始压测</ElButton></template>
        </ElPopconfirm>
    </div>
</ElDialog>

@code {
    [Parameter] public string SelectedSwaggerUrl { get; set; } = "";
    [Parameter] public ConfigurationOption[] ResourceOptions { get; set; } = [];
    [Parameter] public StressBrowseGroup[] Groups { get; set; } = [];
    [Parameter] public string? SelectedNodeId { get; set; }
    [Parameter] public string Keywords { get; set; } = "";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool LoadingResources { get; set; }
    [Parameter] public bool LoadingDocument { get; set; }
    [Parameter] public string EditMethod { get; set; } = "";
    [Parameter] public string EditUri { get; set; } = "";
    [Parameter] public int EditRounds { get; set; }
    [Parameter] public int EditRequests { get; set; }
    [Parameter] public int EditParallelism { get; set; }
    [Parameter] public int ParameterCount { get; set; }
    [Parameter] public StressTestResult Result { get; set; } = new();

    [Parameter] public Action LoadResources { get; set; } = default!;
    [Parameter] public Action<string> SwaggerChanged { get; set; } = default!;
    [Parameter] public Action<string?> ChangeKeywords { get; set; } = default!;
    [Parameter] public Action Search { get; set; } = default!;
    [Parameter] public Action<int, int> SelectNodeAt { get; set; } = default!;
    [Parameter] public Action<int, int> OpenDialogAt { get; set; } = default!;
    [Parameter] public Action OpenCurrentDialog { get; set; } = default!;

    [Parameter] public bool DialogVisible { get; set; }
    [Parameter] public string ActivePairTab { get; set; } = "headers";
    [Parameter] public StressPairView[] Headers { get; set; } = [];
    [Parameter] public StressPairView[] Body { get; set; } = [];
    [Parameter] public StressPairView[] PathPairs { get; set; } = [];
    [Parameter] public StressPairView[] Query { get; set; } = [];
    [Parameter] public bool Submitting { get; set; }
    [Parameter] public Action<bool> SetDialogVisible { get; set; } = default!;
    [Parameter] public Action<string> SetEditMethod { get; set; } = default!;
    [Parameter] public Action<string?> SetEditUri { get; set; } = default!;
    [Parameter] public Action<double?> SetEditRounds { get; set; } = default!;
    [Parameter] public Action<double?> SetEditRequests { get; set; } = default!;
    [Parameter] public Action<double?> SetEditParallelism { get; set; } = default!;
    [Parameter] public Action<string> SetActivePairTab { get; set; } = default!;
    [Parameter] public Action AddPair { get; set; } = default!;
    [Parameter] public Action<double> RemovePair { get; set; } = default!;
    [Parameter] public Action<string, double, bool, string> UpdatePair { get; set; } = default!;
    [Parameter] public Action Submit { get; set; } = default!;

    private static string Metric(double value) => (Math.Round(value * 100) / 100).ToString();
    private static string Count(string value) => value.Length == 0 ? "0" : value;
    private static string MethodClass(string method) => "stress-method stress-method--" + method.ToLower();
}

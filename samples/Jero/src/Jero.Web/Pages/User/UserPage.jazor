@using Npm.ElementPlus
@using Jero.Web.Pages.Auth
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.User

<ElCard Header="账号管理" class="jero-list-page">
    <p style="margin-top:0;color:#606266;">
        支持组织和租户筛选、账号档案维护、角色授权、状态控制、重置密码与解除登录锁定。
    </p>

    <div style='@(Model.Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error"
                 Title="@(Model.Error ?? "")"
                 ShowIcon="true"
                 Closable="true"
                 @onclose="@(Model.DismissError)" />
    </div>

    <div class="user-page-layout">
        <ElCard Header="组织机构" class="user-org-card">
            <div style='@(Model.IsSuperAdmin ? "margin-bottom:14px" : "display:none")'>
                <AuthOptionSelect Value="@Model.TenantId" Options="@Model.TenantOptions" Placeholder="请选择租户" Clearable="true" Loading="@Model.TenantLoading" Change="@Model.TenantChanged" />
            </div>

            <button type="button"
                    class="@OrgButtonClass(Model.SelectedOrgId, "-1")"
                    @onclick='@(_ => Model.SelectOrganization("-1", "全部机构", string.Empty))'>
                全部机构
            </button>
            @foreach (var org in Model.OrgTreeItems)
            {
                <button type="button"
                        class="@OrgButtonClass(Model.SelectedOrgId, org.Id)"
                        style="@OrgIndent(org)"
                        disabled="@org.Disabled"
                        @onclick="@(_ => Model.SelectOrganization(org.Id, org.Path, org.TenantId))">
                    @org.Name
                </button>
            }
            <p style='@(Model.OrgLoading ? "color:#909399;padding:8px 12px" : "display:none")'>正在加载组织机构…</p>
            <p style='@(!Model.OrgLoading && Model.OrgTreeItems.Length == 0 ? "color:#909399;padding:8px 12px" : "display:none")'>暂无组织数据</p>
        </ElCard>

        <div class="user-page-main">
            <JeroQueryCard Title="查询条件">
                <ElForm Inline="true">
                    <ElFormItem Label="账号">
                        <ElInput ModelValue="@Model.Account"
                                 @onupdate:modelValue="@(Model.SetAccount)"
                                 Placeholder="账号"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="姓名">
                        <ElInput ModelValue="@Model.RealName"
                                 @onupdate:modelValue="@(Model.SetRealName)"
                                 Placeholder="姓名"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="职位">
                        <ElInput ModelValue="@Model.PosName"
                                 @onupdate:modelValue="@(Model.SetPosName)"
                                 Placeholder="职位"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="手机">
                        <ElInput ModelValue="@Model.Phone"
                                 @onupdate:modelValue="@(Model.SetPhone)"
                                 Placeholder="手机号"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem>
                        <ElButton Type="primary" @onclick="@(Model.Search)" Loading="@Model.Loading">查询</ElButton>
                        <ElButton @onclick="@(Model.ResetSearch)" Disabled="@Model.Loading">重置</ElButton>
                    </ElFormItem>
                </ElForm>
            </JeroQueryCard>

            <ElCard class="jero-list-card">
                <div class="user-toolbar">
                    <div>
                        @if (Model.Table.CanAdd)
                        {
                            <ElButton Type="primary" @onclick="@(Model.OpenCreate)">新增</ElButton>
                        }
                        <span class="user-selected-org">当前组织：@Model.SelectedOrgName</span>
                    </div>
                    <ElButton @onclick="@(Model.Refresh)" Loading="@Model.Loading">刷新</ElButton>
                </div>

                <div class="jero-list-scroll">
                    <UserTable Model="@Model.Table" />
                </div>

                <div style="margin-top:16px;display:flex;justify-content:flex-end;">
                    <ElPagination CurrentPage="@Model.CurrentPage"
                                      PageSize="@Model.PageSize"
                                      Total="@Model.Total"
                                      PageSizes="@Model.PageSizes"
                                      Background="true"
                                      Layout="total, sizes, prev, pager, next, jumper"
                                      @oncurrent-change="@(Model.ChangePage)"
                                      @onsize-change="@(Model.ChangePageSize)" />
                </div>
            </ElCard>
        </div>
    </div>
</ElCard>

<ElDialog ModelValue="@Model.EditDialogVisible"
          @onupdate:modelValue="@(Model.SetEditDialogVisible)"
          Title="@Model.EditDialogTitle"
          Width="min(1040px, calc(100vw - 32px))"
          Draggable="true"
          CloseOnClickModal="false">
    <div class="user-edit-tabs" role="tablist" aria-label="账号编辑分类">
        <button type="button" class='@("user-edit-tab" + (Model.EditTab == "basic" ? " is-active" : ""))' @onclick='@(_ => Model.SelectEditTab("basic"))'>基础信息</button>
        <button type="button" class='@("user-edit-tab" + (Model.EditTab == "roles" ? " is-active" : ""))' @onclick='@(_ => Model.SelectEditTab("roles"))'>角色授权</button>
        <button type="button" class='@("user-edit-tab" + (Model.EditTab == "profile" ? " is-active" : ""))' @onclick='@(_ => Model.SelectEditTab("profile"))'>档案信息</button>
        <button type="button" class='@("user-edit-tab" + (Model.EditTab == "binding" ? " is-active" : ""))' @onclick='@(_ => Model.SelectEditTab("binding"))'>账号绑定</button>
    </div>

    <div class="user-dialog-scroll">
        <div style="@PanelStyle(Model.EditTab, "basic")">
            <ElForm LabelWidth="92px">
                <div class="user-form-grid">
                    <ElFormItem Label="账号名称">
                        <ElInput ModelValue="@Model.Draft.Account"
                                 @onupdate:modelValue='@(value => Model.Draft.Account = value ?? "")'
                                 Placeholder="账号名称"
                                 Maxlength="32"
                                 Clearable="true"
                                 Disabled="@(Model.Editing)" />
                    </ElFormItem>
                    <ElFormItem Label="真实姓名">
                        <ElInput ModelValue="@Model.Draft.RealName"
                                 @onupdate:modelValue='@(value => Model.Draft.RealName = value ?? "")'
                                 Placeholder="真实姓名"
                                 Maxlength="32"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="昵称">
                        <ElInput ModelValue="@Model.Draft.NickName"
                                 @onupdate:modelValue='@(value => Model.Draft.NickName = value ?? "")'
                                 Placeholder="昵称"
                                 Maxlength="32"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="手机号码">
                        <ElInput ModelValue="@Model.Draft.Phone"
                                 @onupdate:modelValue='@(value => Model.Draft.Phone = value ?? "")'
                                 Placeholder="手机号码"
                                 Maxlength="16"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="账号类型">
                        <AuthOptionSelect Value="@Model.DraftAccountType" Options="@Model.AccountTypeOptions" Placeholder="账号类型" Change="@Model.SetDraftAccountType" />
                    </ElFormItem>
                    <ElFormItem Label="邮箱">
                        <ElInput ModelValue="@Model.Draft.Email"
                                 @onupdate:modelValue='@(value => Model.Draft.Email = value ?? "")'
                                 Placeholder="邮箱"
                                 Maxlength="64"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="语言">
                        <AuthOptionSelect Value="@Model.Draft.LangCode" Options="@Model.LanguageOptions" Placeholder="语言" Loading="@Model.DependencyLoading" Change='@(value => Model.Draft.LangCode = value)' />
                    </ElFormItem>
                    <ElFormItem Label="排序">
                        <ConfigurationNumber Value="@Model.Draft.OrderNo" Minimum="@(0)" Change="@Model.SetDraftOrderNo" />
                    </ElFormItem>
                    <ElFormItem Label="状态">
                        <AuthOptionSelect Value="@Model.DraftStatus" Options="@Model.StatusOptions" Placeholder="" Disabled="@(Model.Editing)" Change="@Model.SetDraftStatus" />
                    </ElFormItem>
                    <ElFormItem Label="所属机构">
                        <AuthOptionSelect Value="@Model.Draft.OrgId" Options="@Model.EditorOrganizationOptions" Placeholder="所属机构" Clearable="true" Loading="@Model.DependencyLoading" Change='@(value => Model.Draft.OrgId = value)' />
                    </ElFormItem>
                    <ElFormItem Label="职位">
                        <AuthOptionSelect Value="@Model.Draft.PosId" Options="@Model.PositionOptions" Placeholder="职位" Clearable="true" Loading="@Model.DependencyLoading" Change='@(value => Model.Draft.PosId = value)' />
                    </ElFormItem>
                    <ElFormItem Label="工号">
                        <ElInput ModelValue="@Model.Draft.JobNum"
                                 @onupdate:modelValue='@(value => Model.Draft.JobNum = value ?? "")'
                                 Placeholder="工号"
                                 Maxlength="32"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="入职日期">
                        <UserDateInput Value="@Model.Draft.JoinDate" Placeholder="入职日期" Change='@(value => Model.Draft.JoinDate = value)' />
                    </ElFormItem>
                    <ElFormItem Label="个性化首页" class="user-form-span-two">
                        <ElInput ModelValue="@Model.Draft.Homepage"
                                 @onupdate:modelValue='@(value => Model.Draft.Homepage = value ?? "")'
                                 Placeholder="个性化首页"
                                 Maxlength="512"
                                 Clearable="true" />
                    </ElFormItem>
                </div>

                <div class="user-section-heading">
                    <strong>附属机构</strong>
                    <ElButton Plain="true" Type="primary" @onclick="@(Model.AddExtOrganization)">增加附属机构</ElButton>
                </div>
                <p style='@(Model.EditExtOrganizations.Length == 0 ? "color:#909399;text-align:center" : "display:none")'>暂无附属机构</p>
                @for (var index = 0; index < Model.EditExtOrganizations.Length; index++)
                {
                    var rowIndex = index;
                    var ext = Model.EditExtOrganizations[index];
                    <div class="user-ext-org-row">
                        <ElFormItem Label="机构">
                            <AuthOptionSelect Value="@ext.OrgId" Options="@Model.EditorOrganizationOptions" Placeholder="机构" Clearable="true" Change="@((string value) => Model.ChangeExtOrganization(rowIndex, value))" />
                        </ElFormItem>
                        <ElFormItem Label="职位">
                            <AuthOptionSelect Value="@ext.PosId" Options="@Model.PositionOptions" Placeholder="职位" Clearable="true" Change="@((string value) => Model.ChangeExtPosition(rowIndex, value))" />
                        </ElFormItem>
                        <ElButton Link="true" Type="danger" @onclick="@(_ => Model.RemoveExtOrganization(rowIndex))">删除</ElButton>
                    </div>
                }
            </ElForm>
        </div>

        <div style="@PanelStyle(Model.EditTab, "roles")">
            <p class="user-panel-tip">选择账号拥有的角色。编辑保存时会与账号资料一并提交。</p>
            <div class="user-role-grid">
                @foreach (var role in Model.RoleOptions)
                {
                    <button type="button"
                            class="@RoleButtonClass(Model.EditRoleIds, role.Id)"
                            disabled="@(!Model.CanEditDraftRoles || Model.DependencyLoading)"
                            @onclick="@(_ => Model.ToggleEditRole(role.Id))">
                        <span>@role.Name</span>
                        <small>@(ContainsId(Model.EditRoleIds, role.Id) ? "已授权" : "未授权")</small>
                    </button>
                }
            </div>
            <p style='@(Model.RoleOptions.Length == 0 ? "color:#909399;text-align:center" : "display:none")'>暂无可授权角色</p>
        </div>

        <div style="@PanelStyle(Model.EditTab, "profile")">
            <ElForm LabelWidth="92px">
                <div class="user-form-grid">
                    <ElFormItem Label="证件类型">
                        <AuthOptionSelect Value="@Model.DraftCardType" Options="@Model.CardTypeOptions" Placeholder="" Clearable="true" Change="@Model.SetDraftCardType" />
                    </ElFormItem>
                    <ElFormItem Label="证件号码">
                        <ElInput ModelValue="@Model.Draft.IdCardNum"
                                 @onupdate:modelValue='@(value => Model.Draft.IdCardNum = value ?? "")'
                                 Placeholder="证件号码"
                                 Maxlength="32"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="出生日期">
                        <UserDateInput Value="@Model.Draft.Birthday" Placeholder="出生日期" Change='@(value => Model.Draft.Birthday = value)' />
                    </ElFormItem>
                    <ElFormItem Label="性别">
                        <AuthOptionSelect Value="@Model.DraftSex" Options="@Model.GenderOptions" Placeholder="" Change="@Model.SetDraftSex" />
                    </ElFormItem>
                    <ElFormItem Label="年龄">
                        <ConfigurationNumber Value="@Model.Draft.Age" Minimum="@(0)" Maximum="@(150)" Change="@Model.SetDraftAge" />
                    </ElFormItem>
                    <ElFormItem Label="民族">
                        <AuthOptionSelect Value="@Model.Draft.Nation" Options="@Model.NationOptions" Placeholder="民族" Clearable="true" Change='@(value => Model.Draft.Nation = value)' />
                    </ElFormItem>
                    <ElFormItem Label="毕业学校">
                        <ElInput ModelValue="@Model.Draft.College"
                                 @onupdate:modelValue='@(value => Model.Draft.College = value ?? "")'
                                 Placeholder="毕业学校"
                                 Maxlength="128"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="文化程度">
                        <AuthOptionSelect Value="@Model.DraftCultureLevel" Options="@Model.CultureLevelOptions" Placeholder="" Clearable="true" Change="@Model.SetDraftCultureLevel" />
                    </ElFormItem>
                    <ElFormItem Label="政治面貌">
                        <ElInput ModelValue="@Model.Draft.PoliticalOutlook"
                                 @onupdate:modelValue='@(value => Model.Draft.PoliticalOutlook = value ?? "")'
                                 Placeholder="政治面貌"
                                 Maxlength="16"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="办公电话">
                        <ElInput ModelValue="@Model.Draft.OfficePhone"
                                 @onupdate:modelValue='@(value => Model.Draft.OfficePhone = value ?? "")'
                                 Placeholder="办公电话"
                                 Maxlength="16"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="地址" class="user-form-span-two">
                        <ElInput ModelValue="@Model.Draft.Address"
                                 @onupdate:modelValue='@(value => Model.Draft.Address = value ?? "")'
                                 Placeholder="地址"
                                 Type="textarea"
                                 Rows="2"
                                 Maxlength="256" />
                    </ElFormItem>
                    <ElFormItem Label="紧急联系人">
                        <ElInput ModelValue="@Model.Draft.EmergencyContact"
                                 @onupdate:modelValue='@(value => Model.Draft.EmergencyContact = value ?? "")'
                                 Placeholder="紧急联系人"
                                 Maxlength="32"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="联系人电话">
                        <ElInput ModelValue="@Model.Draft.EmergencyPhone"
                                 @onupdate:modelValue='@(value => Model.Draft.EmergencyPhone = value ?? "")'
                                 Placeholder="联系人电话"
                                 Maxlength="16"
                                 Clearable="true" />
                    </ElFormItem>
                    <ElFormItem Label="联系人地址" class="user-form-span-two">
                        <ElInput ModelValue="@Model.Draft.EmergencyAddress"
                                 @onupdate:modelValue='@(value => Model.Draft.EmergencyAddress = value ?? "")'
                                 Placeholder="联系人地址"
                                 Type="textarea"
                                 Rows="2"
                                 Maxlength="256" />
                    </ElFormItem>
                    <ElFormItem Label="个人简介" class="user-form-span-two">
                        <ElInput ModelValue="@Model.Draft.Introduction"
                                 @onupdate:modelValue='@(value => Model.Draft.Introduction = value ?? "")'
                                 Placeholder="个人简介"
                                 Type="textarea"
                                 Rows="3"
                                 Maxlength="512" />
                    </ElFormItem>
                    <ElFormItem Label="备注" class="user-form-span-two">
                        <ElInput ModelValue="@Model.Draft.Remark"
                                 @onupdate:modelValue='@(value => Model.Draft.Remark = value ?? "")'
                                 Placeholder="备注"
                                 Type="textarea"
                                 Rows="3"
                                 Maxlength="256" />
                    </ElFormItem>
                </div>
            </ElForm>
        </div>

        <div style="@PanelStyle(Model.EditTab, "binding")">
            <ElForm LabelWidth="92px">
                <div class="user-form-grid">
                    <ElFormItem Label="登录账号">
                        <ElInput ModelValue="@Model.Draft.Account" Disabled="true" />
                    </ElFormItem>
                    <ElFormItem Label="域账号">
                        <ElInput ModelValue="@Model.Draft.DomainAccount"
                                 @onupdate:modelValue='@(value => Model.Draft.DomainAccount = value ?? "")'
                                 Placeholder="域账号"
                                 Maxlength="32"
                                 Clearable="true" />
                    </ElFormItem>
                </div>
            </ElForm>
        </div>
    </div>

    <div class="user-dialog-footer">
        <ElButton @onclick="@(Model.CloseEditDialogVisible)" Disabled="@Model.Saving">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="@(Model.Save)"
                  Loading="@Model.Saving"
                  Disabled="@(Model.DependencyLoading || Model.DependencyFailed)">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@Model.DetailDialogVisible"
          @onupdate:modelValue="@(Model.SetDetailDialogVisible)"
          Title="账号详情"
          Width="780px">
    <div class="user-detail-grid">
        <strong>账号</strong><span>@Model.DetailAccount</span>
        <strong>姓名</strong><span>@Model.DetailRealName</span>
        <strong>昵称</strong><span>@Model.DetailNickName</span>
        <strong>手机</strong><span>@Model.DetailPhone</span>
        <strong>邮箱</strong><span>@Model.DetailEmail</span>
        <strong>账号类型</strong><span>@Model.DetailAccountType</span>
        <strong>角色</strong><span>@Model.DetailRoleName</span>
        <strong>所属机构</strong><span>@Model.DetailOrgName</span>
        <strong>职位</strong><span>@Model.DetailPosName</span>
        <strong>工号</strong><span>@Model.DetailJobNum</span>
        <strong>状态</strong><span>@Model.DetailStatus</span>
        <strong>语言</strong><span>@Model.DetailLangCode</span>
        <strong>最后登录 IP</strong><span>@Model.DetailLastLoginIp</span>
        <strong>最后登录地点</strong><span>@Model.DetailLastLoginAddress</span>
        <strong>最后登录时间</strong><span>@Model.DetailLastLoginTime</span>
        <strong>最后登录设备</strong><span>@Model.DetailLastLoginDevice</span>
        <strong>创建人</strong><span>@Model.DetailCreateUserName</span>
        <strong>创建时间</strong><span>@Model.DetailCreateTime</span>
        <strong>最后修改人</strong><span>@Model.DetailUpdateUserName</span>
        <strong>最后修改时间</strong><span>@Model.DetailUpdateTime</span>
        <strong>备注</strong><span class="user-detail-span">@Model.DetailRemark</span>
    </div>
</ElDialog>

<ElDialog ModelValue="@Model.GrantDialogVisible"
          @onupdate:modelValue="@(Model.SetGrantDialogVisible)"
          Title="角色授权"
          Width="720px"
          CloseOnClickModal="false">
    <p class="user-panel-tip">账号：@Model.GrantAccount · @Model.GrantRealName</p>
    <div class="user-role-grid">
        @foreach (var role in Model.GrantRoleOptions)
        {
            <button type="button"
                    class="@RoleButtonClass(Model.GrantRoleIds, role.Id)"
                    disabled="@Model.GrantLoading"
                    @onclick="@(_ => Model.ToggleGrantRole(role.Id))">
                <span>@role.Name</span>
                <small>@(ContainsId(Model.GrantRoleIds, role.Id) ? "已授权" : "未授权")</small>
            </button>
        }
    </div>
    <p style='@(Model.GrantLoading ? "color:#909399;text-align:center" : "display:none")'>正在加载角色…</p>
    <p style='@(!Model.GrantLoading && Model.GrantRoleOptions.Length == 0 ? "color:#909399;text-align:center" : "display:none")'>暂无可授权角色</p>
    <div class="user-dialog-footer">
        <ElButton @onclick="@(Model.CloseGrantDialogVisible)" Disabled="@Model.Granting">取消</ElButton>
        <ElButton Type="primary"
                  @onclick="@(Model.SaveGrantRoles)"
                  Loading="@Model.Granting"
                  Disabled="@(Model.GrantLoading || Model.GrantFailed)">确定</ElButton>
    </div>
</ElDialog>

<ElDialog ModelValue="@Model.PasswordDialogVisible"
          @onupdate:modelValue="@(Model.SetPasswordDialogVisible)"
          Title="密码重置成功"
          Width="460px">
    <p>新密码：</p>
    <ElInput ModelValue="@Model.ResetPasswordValue" Readonly="true" />
    <p style="color:#909399;font-size:13px;">请安全地将密码交给账号本人。</p>
    <div class="user-dialog-footer">
        <ElButton Type="primary" @onclick="@(Model.ClosePasswordDialogVisible)">知道了</ElButton>
    </div>
</ElDialog>

<style scoped>
.user-page-layout{display:grid;grid-template-columns:280px minmax(0,1fr);grid-template-rows:minmax(0,1fr);gap:16px;flex:1;min-height:0}.user-page-main{display:grid;min-width:0;gap:16px;grid-template-rows:auto minmax(0,1fr);min-height:0}.user-org-item{display:block;width:100%;margin:2px 0;padding:9px 12px;border:0;border-radius:6px;background:transparent;color:#303133;text-align:left;cursor:pointer}.user-org-item:hover{background:#f5f7fa}.user-org-item.is-active{background:#ecf5ff;color:#409eff;font-weight:600}.user-org-item:disabled{color:#c0c4cc;cursor:not-allowed}.user-toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.user-org-card{display:flex;flex-direction:column;min-height:0}.user-org-card > :deep(.el-card__body){flex:1;min-height:0;overflow:auto}.user-selected-org{margin-left:12px;color:#909399;font-size:13px}.user-edit-tabs{display:flex;gap:4px;margin:-8px 0 18px;border-bottom:1px solid #ebeef5}.user-edit-tab{padding:10px 18px;border:0;border-bottom:2px solid transparent;background:transparent;color:#606266;cursor:pointer}.user-edit-tab.is-active{border-bottom-color:#409eff;color:#409eff;font-weight:600}.user-dialog-scroll{max-height:calc(100vh - 230px);overflow:auto;padding:2px 4px}.user-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}.user-form-span-two{grid-column:1/-1}.user-section-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:8px 0 16px;padding-top:16px;border-top:1px solid #ebeef5}.user-ext-org-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;gap:12px;align-items:start;padding:12px;border:1px solid #ebeef5;border-radius:8px}.user-panel-tip{margin:0 0 16px;color:#606266}.user-role-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.user-role-option{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:48px;padding:10px 14px;border:1px solid #dcdfe6;border-radius:8px;background:#fff;color:#303133;cursor:pointer}.user-role-option small{color:#909399}.user-role-option.is-selected{border-color:#409eff;background:#ecf5ff;color:#409eff}.user-role-option:disabled{cursor:not-allowed;opacity:.65}.user-dialog-footer{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.user-detail-grid{display:grid;grid-template-columns:110px minmax(0,1fr) 110px minmax(0,1fr);gap:12px 16px;line-height:1.65}.user-detail-grid strong{color:#606266}.user-detail-span{grid-column:2/-1}@media(max-width:1100px){.user-page-layout{grid-template-columns:220px minmax(0,1fr)}.user-role-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:820px){.user-page-layout{grid-template-columns:1fr}.user-form-grid,.user-detail-grid{grid-template-columns:1fr}.user-form-span-two,.user-detail-span{grid-column:auto}.user-ext-org-row{grid-template-columns:1fr}.user-role-grid{grid-template-columns:1fr}.user-selected-org{display:block;margin:8px 0 0}}
</style>

@code {
    [Parameter] public UserPageModel Model { get; set; } = default!;

    private static string OrgButtonClass(string selectedId, string id)
        => "user-org-item" + (selectedId == id ? " is-active" : "");

    private static string OrgIndent(UserTreeRow option)
        => "padding-left:" + (12 + option.Depth * 18) + "px";

    private static string RoleButtonClass(string[] selected, string id)
        => "user-role-option" + (ContainsId(selected, id) ? " is-selected" : "");

    // 切换标签时保留表单子树，避免销毁并重建输入组件。
    private static string PanelStyle(string active, string panel) => active == panel ? "" : "display:none";

    private static bool ContainsId(string[] ids, string id)
    {
        foreach (var value in ids)
            if (value == id)
                return true;
        return false;
    }
}

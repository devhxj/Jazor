@using Npm.ElementPlus
@using Jero.Web.Pages.Components
@using Jero.Web.Pages.Lang

    <ElSelect ModelValue='@(Value)' placeholder='@(Placeholder)' filterable="true" disabled='@(Disabled)' @attributes="@(new ModelUpdate<double?>(Update))">
        @foreach (var option in Options) { <ElOption @key="option.Value" label='@(option.Label)' value='@(option.Value)' /> }
    </ElSelect>

@code {
    private void Update(double? value) => OnChange(value ?? Value);
    [Parameter] public LangNumberOption[] Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public double Value { get; set; }
    [Parameter] public Action<double> OnChange { get; set; } = default!;
}

@using Jero.Web.Pages.Cache
@using Npm.ElementPlus

<ElCard Header="缓存管理">
    <p style="margin-top:0;color:#606266;">按冒号前缀查看缓存层级，支持键筛选、值预览、单键删除、前缀删除和全量清空。</p>

    <div style='@(Model.Error is null ? "display:none" : "margin-bottom:16px")'>
        <ElAlert Type="error" Title="@(Model.Error ?? "")" ShowIcon="true" Closable="true" @onclose="@(Model.DismissError)" />
    </div>

    <div style="display:grid;grid-template-columns:minmax(320px,0.9fr) minmax(460px,1.4fr);gap:16px;align-items:stretch;">
        <ElCard Header="缓存列表">
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;">
                <ElButton @onclick="@(Model.LoadKeys)" Loading="@(Model.LoadingKeys)" Disabled="@(!Model.CanQuery)">刷新</ElButton>
                @if (Model.CanClear)
                {
                    <ElPopconfirm Title="确定清空全部缓存吗？此操作不可恢复。" ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(Model.ClearAll)">
                        <template #reference><ElButton Type="danger" Loading="@(Model.Clearing)" Disabled="@(Model.Clearing)">清空全部</ElButton></template>
                    </ElPopconfirm>
                }
            </div>

            <ElInput ModelValue="@(Model.KeyFilter)" @onupdate:modelValue="@(Model.FilterChanged)" Placeholder="筛选缓存键、前缀或片段" Clearable="true" />

            <div style="height:16px"></div>
            <div style="min-height:500px;max-height:640px;overflow:auto;border:1px solid #ebeef5;border-radius:4px;padding:8px;">
                @if (Model.LoadingKeys)
                {
                    <ElText>正在加载缓存键…</ElText>
                }
                else if (Model.VisibleNodes.Length == 0)
                {
                    <ElEmpty Description="暂无匹配的缓存键" />
                }
                else
                {
                    @foreach (var node in Model.VisibleNodes)
                    {
                        <div style="@NodeStyle(node)">
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
                                <ElButton Link="true" Type="primary" @onclick="@(_ => Model.SelectPrefix(node.PrefixKey))">@node.Label</ElButton>
                                <div style="display:flex;align-items:center;gap:6px;">
                                    @if (node.CacheKey.Length > 0) { <ElTag Type="success">缓存键</ElTag> } else { <ElTag Type="info">前缀</ElTag> }
                                    <ElTag Type="info">@node.KeyCount</ElTag>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </ElCard>

        <ElCard Header="缓存详情">
            <div style="min-height:600px;display:flex;flex-direction:column;gap:18px;">
                <div style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:12px;">
                    <div style="min-width:0;">
                        <strong>当前节点</strong>
                        <div style="margin-top:6px;color:#606266;word-break:break-all;">@(Model.DetailTitle)</div>
                    </div>
                    @if (Model.SelectedNode is not null)
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                            @if (Model.HasSelectedKey)
                            {
                                <ElButton @onclick="@(Model.RefreshValue)" Loading="@(Model.LoadingValue)">刷新值</ElButton>
                            }
                            @if (Model.CanDelete && Model.HasSelectedKey)
                            {
                                <ElPopconfirm Title="@("确定删除缓存键【" + Model.SelectedNode.CacheKey + "】吗？")" ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(Model.DeleteSelectedKey)">
                                    <template #reference><ElButton Type="danger" Loading="@(Model.DeletingKey)" Disabled="@(Model.DeletingKey)">删除缓存</ElButton></template>
                                </ElPopconfirm>
                            }
                            @if (Model.CanDelete && Model.HasSelectedPrefixChildren)
                            {
                                <ElPopconfirm Title="@(Model.PrefixDeleteTitle)" ConfirmButtonText="确定" CancelButtonText="取消" @onconfirm="@(Model.DeleteSelectedPrefix)">
                                    <template #reference><ElButton Type="danger" Plain="true" Loading="@(Model.DeletingPrefix)" Disabled="@(Model.DeletingPrefix)">删除此前缀</ElButton></template>
                                </ElPopconfirm>
                            }
                        </div>
                    }
                </div>

                @if (Model.SelectedNode is null)
                {
                    <div style="flex:1;display:flex;align-items:center;justify-content:center;"><ElEmpty Description="请选择左侧缓存节点" /></div>
                }
                else
                {
                    <div style="display:flex;flex-wrap:wrap;gap:8px;">
                        @if (Model.HasSelectedKey) { <ElTag Type="success">缓存键</ElTag> } else { <ElTag Type="info">前缀分组</ElTag> }
                        <ElTag Type="info">命中 @(Model.SelectedKeys.Length) 项</ElTag>
                        @if (Model.HasSelectedKey && Model.ValueLoaded && Model.LoadedValueKey == Model.SelectedNode.CacheKey)
                        {
                            <ElTag Type="warning">@(Model.ValuePreview.TypeLabel)</ElTag>
                            @if (Model.ValuePreview.SizeLabel.Length > 0)
                            {
                                <ElTag Type="info">@(Model.ValuePreview.SizeLabel)</ElTag>
                            }
                        }
                    </div>

                    <section>
                        <strong>当前键名</strong>
                        <div style="margin-top:8px;padding:12px 14px;border:1px solid #dcdfe6;border-radius:4px;background:#f5f7fa;font-family:Consolas,monospace;word-break:break-all;">@(Model.HasSelectedKey ? Model.SelectedNode.CacheKey : Model.SelectedNode.PrefixKey)</div>
                    </section>

                    @if (Model.HasSelectedKey)
                    {
                        <section>
                            <strong>缓存值</strong>
                            @if (Model.LoadingValue)
                            {
                                <div style="margin-top:10px;"><ElText>正在读取缓存值…</ElText></div>
                            }
                            else
                            {
                                <pre style="margin:8px 0 0;min-height:280px;max-height:480px;overflow:auto;padding:14px;border:1px solid #dcdfe6;border-radius:4px;background:#f5f7fa;white-space:pre-wrap;word-break:break-word;">@(Model.ValuePreview.DisplayText)</pre>
                            }
                        </section>
                    }
                    else
                    {
                        <section>
                            <strong>关联缓存键</strong>
                            <div style="margin-top:8px;max-height:440px;overflow:auto;padding:12px;border:1px solid #dcdfe6;border-radius:4px;background:#f5f7fa;">
                                @foreach (var relatedKey in Model.SelectedKeys)
                                {
                                    <div style="padding:6px 0;font-family:Consolas,monospace;word-break:break-all;">@relatedKey</div>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        </ElCard>
    </div>
</ElCard>

@code {
    [Parameter] public CachePageModel Model { get; set; } = default!;

    private string NodeStyle(CacheTreeNode node)
    {
        var background = Model.SelectedNode?.PrefixKey == node.PrefixKey ? "background:#ecf5ff;" : string.Empty;
        return background + "padding:8px 10px 8px " + (12 + node.Depth * 22).ToString() + "px;border-radius:4px;";
    }
}

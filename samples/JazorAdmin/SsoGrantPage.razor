@* Lists operational OpenIddict grants and revokes them through manager-owned state transitions. *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="sso" data-sso-view="@(View == GrantView.Authorizations ? "authorizations" : "tokens")">
    <TLoading Loading="@loading" TextValue="@(View == GrantView.Authorizations ? L("Loading authorizations", "正在加载授权记录") : L("Loading tokens", "正在加载令牌"))">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }
            else if (View == GrantView.Authorizations)
            {
                <section class="ja-panel" aria-labelledby="sso-authorizations-title">
                    <header class="ja-panel__header"><div><h2 id="sso-authorizations-title">@L("Authorizations", "授权记录")</h2><p>@L("Persistent grants created by OpenIddict protocol flows", "由 OpenIddict 协议流程创建的持久授权")</p></div></header>
                    @if (authorizations.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No authorizations are stored.", "尚无授权记录。")" />
                    }
                    else
                    {
                        <TTable T="AuthorizationView"
                                Data="@authorizations"
                                Columns="@AuthorizationColumns"
                                RowKey="Id" />
                    }
                </section>
            }
            else
            {
                <section class="ja-panel" aria-labelledby="sso-tokens-title">
                    <header class="ja-panel__header"><div><h2 id="sso-tokens-title">@L("Tokens", "令牌")</h2><p>@L("Latest 200 tokens stored by OpenIddict", "OpenIddict 存储的最新 200 条令牌")</p></div></header>
                    @if (tokens.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No tokens are stored.", "尚无令牌记录。")" />
                    }
                    else
                    {
                        <TTable T="TokenView"
                                Data="@tokens"
                                Columns="@TokenColumns"
                                RowKey="Id" />
                    }
                </section>
            }
        </ContentSlot>
    </TLoading>
</section>

@* Lists operational OpenIddict grants and revokes them through manager-owned state transitions. *@
@inherits AppComponentBase

<section class="ja-management" data-management-area="sso" data-sso-view="@(View == GrantView.Authorizations ? "authorizations" : "tokens")">
    @if (loading)
    {
        <p class="ja-management__loading" aria-live="polite">Loading @(View == GrantView.Authorizations ? "authorizations" : "tokens")</p>
    }
    else if (error is not null)
    {
        <p class="ja-management__error" role="alert">@error</p>
    }
    else if (View == GrantView.Authorizations)
    {
        <section class="ja-management__panel" aria-labelledby="sso-authorizations-title">
            <header class="ja-management__panel-header"><div><h2 id="sso-authorizations-title">Authorizations</h2><p>Persistent grants created by OpenIddict protocol flows</p></div></header>
            <div class="ja-management__table-wrap">
                <table class="ja-management__table">
                    <thead><tr><th>Application</th><th>Subject</th><th>Type</th><th>Status</th><th>Scopes</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var authorization in authorizations)
                        {
                            <tr data-sso-authorization="@authorization.Id">
                                <td>@(authorization.ClientId ?? "-")</td><td>@(authorization.Subject ?? "-")</td><td>@authorization.Type</td><td>@authorization.Status</td><td>@Join(authorization.Scopes)</td>
                                <td><button type="button" class="ja-management__text-button" disabled="@(authorization.Status == "revoked")" @onclick="() => RevokeAuthorization(authorization.Id)">Revoke</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <section class="ja-management__panel" aria-labelledby="sso-tokens-title">
            <header class="ja-management__panel-header"><div><h2 id="sso-tokens-title">Tokens</h2><p>Latest 200 tokens stored by OpenIddict</p></div></header>
            <div class="ja-management__table-wrap">
                <table class="ja-management__table">
                    <thead><tr><th>Application</th><th>Subject</th><th>Type</th><th>Status</th><th>Expires</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var token in tokens)
                        {
                            <tr data-sso-token="@token.Id">
                                <td>@(token.ClientId ?? "-")</td><td>@(token.Subject ?? "-")</td><td>@token.Type</td><td>@token.Status</td><td>@(token.ExpiresAt ?? "-")</td>
                                <td><button type="button" class="ja-management__text-button" disabled="@(token.Status == "revoked")" @onclick="() => RevokeToken(token.Id)">Revoke</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>

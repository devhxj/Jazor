@inherits AdminContentComponentBase

<section class="@RootCssClass"
         style="@CssStyle"
         data-page-container=""
         @attributes="AdditionalAttributes">
    @if (HasHeader)
    {
        <div class='@("ja-tdesign-page-container__header")'>
            @if (HasTitles)
            {
                <div class='@("ja-tdesign-page-container__titles")'>
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <div class='@("ja-tdesign-page-container__title")'
                             data-page-region="title">@Title</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <div class='@("ja-tdesign-page-container__subtitle")'>@Subtitle</div>
                    }
                </div>
            }

            @if ((Actions?.Length ?? 0) > 0 || Extra is not null)
            {
                <TSpace Align="@TSpaceAlignValue.Center">
                    @if (Actions is not null)
                    {
                        @foreach (var action in Actions)
                        {
                            <TButton Theme="@MapTheme(action.Kind)"
                                     Disabled="@(action.Disabled ?? false)"
                                     Href="@MapActionHref(action)"
                                     ContentValue="@action.Text"
                                     data-action-key="@action.Key"
                                     OnClick="@(_ => InvokeAction(action))" />
                        }
                    }
                    @Extra
                </TSpace>
            }
        </div>
    }

    <div class='@("ja-tdesign-page-container__body")'
         data-page-region="body">
        @ChildContent
    </div>
</section>

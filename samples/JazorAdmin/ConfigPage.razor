@* Configures OpenIddict clients and scopes for the single sign-on center. 配置单点登录中心的 OpenIddict 客户端与 scope。 *@
@inherits AppComponentBase

<section class="jazor-admin-management" data-management-area="configuration">
    @if (loading)
    {
        <p class="jazor-admin-management__loading" aria-live="polite">Loading identity configuration</p>
    }
    else if (error is not null)
    {
        <p class="jazor-admin-management__error" role="alert">@error</p>
    }
    else if (View == ConfigView.Clients)
    {
        <div class="jazor-admin-management__split">
            <section class="jazor-admin-management__panel" aria-labelledby="clients-title">
                <header class="jazor-admin-management__panel-header"><div><h2 id="clients-title">OIDC clients</h2><p>Public clients registered with the authorization server</p></div></header>
                <div class="jazor-admin-management__table-wrap">
                    <table class="jazor-admin-management__table">
                        <thead><tr><th>Client</th><th>Redirect URI</th><th>Scopes</th></tr></thead>
                        <tbody>
                            @foreach (var client in clients)
                            {
                                <tr><td><strong>@client.DisplayName</strong><span>@client.ClientId</span></td><td>@Join(client.RedirectUris)</td><td>@Join(client.Scopes)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="jazor-admin-management__panel" aria-labelledby="create-client-title">
                <header class="jazor-admin-management__panel-header"><div><h2 id="create-client-title">Register client</h2><p>Authorization code with PKCE is assigned automatically</p></div></header>
                <form class="jazor-admin-management__form" @onsubmit="CreateClient" @onsubmit:preventDefault>
                    <label><span>Client ID</span><input required autocomplete="off" @bind="clientId" @bind:event="oninput" /></label>
                    <label><span>Display name</span><input required autocomplete="off" @bind="clientDisplayName" @bind:event="oninput" /></label>
                    <label><span>Redirect URI</span><input required type="url" placeholder="https://client.example/auth/callback" @bind="redirectUri" @bind:event="oninput" /></label>
                    <label><span>Post-logout URI</span><input required type="url" placeholder="https://client.example/logout" @bind="postLogoutUri" @bind:event="oninput" /></label>
                    <label><span>Scopes</span><input autocomplete="off" placeholder="jazoradmin_api reports" @bind="clientScopes" @bind:event="oninput" /></label>
                    <button type="submit">Register client</button>
                </form>
            </section>
        </div>
    }
    else
    {
        <div class="jazor-admin-management__split">
            <section class="jazor-admin-management__panel" aria-labelledby="scopes-title">
                <header class="jazor-admin-management__panel-header"><div><h2 id="scopes-title">OIDC scopes</h2><p>Scopes are issued for the JazorAdmin API resource</p></div></header>
                <div class="jazor-admin-management__table-wrap">
                    <table class="jazor-admin-management__table">
                        <thead><tr><th>Scope</th><th>Resources</th></tr></thead>
                        <tbody>
                            @foreach (var scope in scopes)
                            {
                                <tr><td><strong>@scope.DisplayName</strong><span>@scope.Name</span></td><td>@Join(scope.Resources)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="jazor-admin-management__panel" aria-labelledby="create-scope-title">
                <header class="jazor-admin-management__panel-header"><div><h2 id="create-scope-title">Create scope</h2><p>The scope is available to registered OIDC clients</p></div></header>
                <form class="jazor-admin-management__form" @onsubmit="CreateScope" @onsubmit:preventDefault>
                    <label><span>Scope name</span><input required autocomplete="off" @bind="scopeName" @bind:event="oninput" /></label>
                    <label><span>Display name</span><input required autocomplete="off" @bind="scopeDisplayName" @bind:event="oninput" /></label>
                    <button type="submit">Create scope</button>
                </form>
            </section>
        </div>
    }
</section>

@* Maintains organization roles and their resource-operation grants. 管理组织角色及其资源操作授权。 *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="authorization">
    @if (OrganizationId is null)
    {
        <TEmpty TitleValue="@L("Select an organization from the header to inspect authorization.", "请先从页头选择一个组织再查看授权。")" />
    }
    else
    {
        <TLoading Loading="@loading" TextValue="@L("Loading authorization data", "正在加载授权数据")">
            <ContentSlot>
                @if (error is not null)
                {
                    <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
                }
                else if (View == AccessControlView.Roles)
                {
                    <div class="ja-page__split">
                        <section class="ja-panel" aria-labelledby="organization-roles-title">
                            <header class="ja-panel__header">
                                <div>
                                    <h2 id="organization-roles-title">@L("Organization roles", "组织角色")</h2>
                                    <p>@L("Select a role to edit its resource operations", "选择一个角色以编辑其资源操作权限")</p>
                                </div>
                            </header>
                            <TForm FormData="TJsonObject" LabelAlign="@TFormLabelAlignValue.Top">
                                <TFormItem LabelValue="@L("Role code", "角色编码")" Name="roleCode">
                                    <span data-authorization-field="roleCode"><TInput T="string" Value="@roleCode" OnChange="@(value => roleCode = value)" /></span>
                                </TFormItem>
                                <TFormItem LabelValue="@L("Display name", "显示名称")" Name="roleDisplayName">
                                    <span data-authorization-field="roleDisplayName"><TInput T="string" Value="@roleDisplayName" OnChange="@(value => roleDisplayName = value)" /></span>
                                </TFormItem>
                                <div class="ja-form__commands">
                                    <TButton Theme="@TButtonThemeValue.Primary" data-authorization-command="create-role" OnClick="@(_ => CreateRole())">@L("Add role", "添加角色")</TButton>
                                </div>
                            </TForm>
                            @if (roles.Length == 0)
                            {
                                <TEmpty TitleValue="@L("No roles are defined.", "尚未定义角色。")" />
                            }
                            else
                            {
                                <ul class="ja-role-list">
                                    @foreach (var role in roles)
                                    {
                                        <li class="@(role.Id == selectedRoleId ? "is-selected" : string.Empty)">
                                            <button type="button" data-role-option="@role.Id" @onclick="() => SelectRole(role)">
                                                <span>@role.DisplayName</span>
                                                <small>@role.Code</small>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="ja-panel" aria-labelledby="role-grants-title">
                            <header class="ja-panel__header">
                                <div>
                                    <h2 id="role-grants-title">@L("Resource operations", "资源操作")</h2>
                                    <p>@(SelectedRole?.DisplayName ?? L("Select a role", "请选择角色"))</p>
                                </div>
                            </header>
                            @if (SelectedRole is not null)
                            {
                                <div class="ja-option-list">
                                    @foreach (var operation in resourceOperations)
                                    {
                                        <label class="ja-form__option">
                                            <TSwitch T="bool" Value="@HasGrant(operation)" OnChange="@(_ => ToggleGrant(operation))" />
                                            <span>@operation.DisplayName</span>
                                            <small>@operation.Resource / @operation.Operation</small>
                                        </label>
                                    }
                                </div>
                                <TButton Theme="@TButtonThemeValue.Primary" data-authorization-command="save-grants" OnClick="@(_ => SaveRoleGrants())">@L("Save grants", "保存授权")</TButton>
                            }
                            else
                            {
                                <TEmpty TitleValue="@L("No role is selected.", "尚未选择角色。")" />
                            }
                        </section>
                    </div>
                }
                else
                {
                    <section class="ja-panel" aria-labelledby="available-operations-title">
                        <header class="ja-panel__header">
                            <div>
                                <h2 id="available-operations-title">@L("Available resource operations", "可用的资源操作")</h2>
                                <p>@L("These operations can be assigned to organization roles", "这些操作可以分配给组织角色")</p>
                            </div>
                        </header>
                        @if (resourceOperations.Length == 0)
                        {
                            <TEmpty TitleValue="@L("No resource operations are registered.", "尚未注册资源操作。")" />
                        }
                        else
                        {
                            <TTable T="ResourceOperationResponse"
                                    Data="@resourceOperations"
                                    Columns="@OperationColumns"
                                    RowKey="Operation" />
                        }
                    </section>
                }
            </ContentSlot>
        </TLoading>
    }
</section>

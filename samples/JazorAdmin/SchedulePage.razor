@* Presents Quartz schedule configuration and execution history for registered administration tasks. *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="schedules">
    <TLoading Loading="@loading" TextValue="@L("Loading scheduled tasks", "正在加载计划任务")">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }

            <div class="ja-page__split">
                <section class="ja-panel" aria-labelledby="schedule-list-title">
                    <header class="ja-panel__header"><div><h2 id="schedule-list-title">@L("Scheduled tasks", "计划任务")</h2><p>@L("Quartz triggers registered application maintenance tasks", "Quartz 触发器注册的应用维护任务")</p></div></header>
                    @if (schedules.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No scheduled tasks are registered.", "尚未注册计划任务。")" />
                    }
                    else
                    {
                        <AdminScheduleTable Data="@schedules"
                                    Columns="@Columns"
                                    RowKey="Key"
                                    RowClassName="@SelectedRowClassName" />
                    }
                </section>

                <section class="ja-panel" aria-labelledby="schedule-editor-title">
                    <header class="ja-panel__header"><div><h2 id="schedule-editor-title">@name</h2><p>@description</p></div></header>
                    <AdminForm LabelAlign="@TFormLabelAlignValue.Top">
                        <TFormItem LabelValue="@L("Quartz Cron (UTC)", "Quartz Cron（UTC）")" Name="cron">
                            <span data-schedule-field="cron"><AdminInput Value="@cron" OnChange="@(value => cron = value)" /></span>
                        </TFormItem>
                        <TFormItem Name="enabled">
                            <AdminToggle Value="@enabled" OnChange="@(value => enabled = value)" />
                            <span class="ja-form__inline-label">@L("Enable scheduled execution", "启用定时执行")</span>
                        </TFormItem>
                        <dl class="ja-form__summary">
                            <div><dt>@L("Next run", "下次执行")</dt><dd>@(nextRunAt ?? L("Paused", "已暂停"))</dd></div>
                            <div><dt>@L("Last result", "上次结果")</dt><dd>@(lastStatus ?? L("Not run", "尚未执行"))</dd></div>
                            @if (lastMessage is not null)
                            {
                                <div><dt>@L("Last message", "上次消息")</dt><dd>@lastMessage</dd></div>
                            }
                        </dl>
                        <div class="ja-form__commands">
                            <TButton Theme="@TButtonThemeValue.Primary" data-schedule-command="save" OnClick="@(_ => Save())">@L("Save schedule", "保存调度")</TButton>
                            <TButton Variant="@TButtonVariantValue.Outline" data-schedule-command="run" OnClick="@(_ => RunNow())">@L("Run now", "立即执行")</TButton>
                            <TButton Variant="@TButtonVariantValue.Text" data-schedule-command="refresh-runs" OnClick="@(_ => LoadRuns())">@L("Refresh history", "刷新历史")</TButton>
                        </div>
                    </AdminForm>
                </section>
            </div>

            <section class="ja-panel" aria-labelledby="schedule-runs-title">
                <header class="ja-panel__header"><div><h2 id="schedule-runs-title">@L("Execution history", "执行历史")</h2><p>@L("Most recent 100 runs for the selected task", "所选任务最近 100 次执行")</p></div></header>
                @if (runs.Length == 0)
                {
                    <TEmpty TitleValue="@L("This task has not run yet.", "该任务尚未执行。")" />
                }
                else
                {
                    <AdminScheduleRunTable Data="@runs"
                                Columns="@RunColumns"
                                RowKey="Id" />
                }
            </section>
        </ContentSlot>
    </TLoading>
</section>

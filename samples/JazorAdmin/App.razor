@inherits ComponentBase

@{ EnsureShellStyles(); }

<ApplicationFrame Theme="@Theme" Language="@languageTag" CssStyle="@ApplicationStyle">
    <style data-starter-theme="">@BrandThemeCss</style>
    @if (sessionRestoring && currentRoute.Path != "/login" && currentRoute.Path != "/lock")
    {
        <main class="ja-session-state" data-session-state="restoring" aria-live="polite">
            <span class="ja-session-state__spinner" aria-hidden="true"></span>
            <span>@Localization.Get(Language, TextKey.RestoringSession)</span>
        </main>
    }
    else if (currentRoute.Path == "/login" || currentRoute.Path == "/lock")
    {
        <main class="@(IsLoginPage ? "ja-access ja-access--login" : "ja-access ja-access--lock")"
              data-access-page="@(IsLoginPage ? "login" : "lock")">
            <aside class="ja-access__visual">
                <strong class="ja-access__brand">
                    <img class="ja-access__brand-mark" src="/brand/jazor-mark.svg" alt="" aria-hidden="true" />
                    <span class="ja-access__brand-copy">
                        <span>JazorAdmin</span>
                        <small>Identity control plane</small>
                    </span>
                </strong>
                <div class="ja-access__visual-copy">
                    <h2>JazorAdmin</h2>
                    <p>@Localization.Get(Language, IsLoginPage ? TextKey.LoginSubtitle : TextKey.LockSubtitle)</p>
                </div>
            </aside>
            <section class="ja-access__panel">
                <strong class="ja-access__brand">
                    <img class="ja-access__brand-mark" src="/brand/jazor-mark.svg" alt="" aria-hidden="true" />
                    <span class="ja-access__brand-copy">
                        <span>JazorAdmin</span>
                        <small>Identity control plane</small>
                    </span>
                </strong>
                <div class="ja-access__intro">
                    <h1>@Localization.Get(Language, IsLoginPage ? TextKey.LoginTitle : TextKey.LockTitle)</h1>
                    <p>@Localization.Get(Language, IsLoginPage ? TextKey.LoginSubtitle : TextKey.LockSubtitle)</p>
                </div>

                <form @onsubmit="@(IsLoginPage ? SignIn : Unlock)" @onsubmit:preventDefault>
                    <label>
                        @Localization.Get(Language, TextKey.Account)
                        <input data-access-field="account"
                               name="account"
                               type="email"
                               readonly="@(!IsLoginPage)"
                               required
                               @bind="loginAccount"
                               @bind:event="oninput" />
                    </label>
                    <label>
                        @Localization.Get(Language, TextKey.Password)
                        @if (IsLoginPage)
                        {
                            <input data-access-field="password" name="password" type="password" required @bind="loginPassword" @bind:event="oninput" />
                        }
                        else
                        {
                            <input data-access-field="password" name="password" type="password" required @bind="unlockPassword" @bind:event="oninput" />
                        }
                    </label>
                    @if (IsLoginPage)
                    {
                        <label class="ja-access__captcha">
                            @Localization.Get(Language, TextKey.VerificationCode)
                            <span class="ja-access__captcha-control">
                                <input data-access-field="captcha"
                                       name="captcha"
                                       type="text"
                                       maxlength="4"
                                       autocomplete="off"
                                       required
                                       @bind="loginCaptcha"
                                       @bind:event="oninput" />
                                @if (loginCaptchaImageUrl is not null)
                                {
                                    <img class="ja-access__captcha-image"
                                         src="@loginCaptchaImageUrl"
                                         alt="@Localization.Get(Language, TextKey.VerificationCode)" />
                                }
                                <button class="ja-access__captcha-refresh"
                                        type="button"
                                        data-access-command="refresh-captcha"
                                        aria-label="@Localization.Get(Language, TextKey.RefreshVerificationCode)"
                                        title="@Localization.Get(Language, TextKey.RefreshVerificationCode)"
                                        @onclick="RefreshCaptcha"><span aria-hidden="true">&#8635;</span></button>
                            </span>
                        </label>
                    }
                    <button type="submit" data-access-submit="@(IsLoginPage ? "login" : "lock")">
                        @Localization.Get(Language, IsLoginPage ? TextKey.SignIn : TextKey.Unlock)
                    </button>
                    @if (accessError is not null)
                    {
                        <p class="ja-access__error" role="alert">@accessError</p>
                    }
                </form>
            </section>
        </main>
    }
    else if (!HasSession)
    {
        <main class="ja-session-state" data-session-state="anonymous" aria-live="polite">
            <span>@Localization.Get(Language, TextKey.RedirectingToSignIn)</span>
        </main>
    }
    else if (IsErrorRoute)
    {
        <ErrorPage Kind="@(IsInternalErrorPage ? ErrorKind.InternalServerError : ErrorKind.NotFound)"
                             Title="@Localization.Get(Language, IsInternalErrorPage ? TextKey.InternalErrorTitle : TextKey.NotFoundTitle)"
                             Description="@Localization.Get(Language, IsInternalErrorPage ? TextKey.InternalErrorDescription : TextKey.NotFoundDescription)"
                             ActionText="@Localization.Get(Language, TextKey.ReturnHome)"
                             Action="@ReturnHome" />
    }
    else
    {
        <TDesignLayout Mode="@LayoutMode"
                          Theme="@Theme"
                          SidebarTheme="@SidebarTheme"
                          SplitMenu="@splitMenu"
                          SidebarFixed="@isSidebarFixed"
                          ShowHeader="@showHeader"
                          ShowBreadcrumb="@showBreadcrumb"
                          ShowTabs="@isUseTabsRouter"
                          ShowFooter="@showFooter"
                          MenuAutoCollapsed="@menuAutoCollapsed"
                          Title="JazorAdmin"
                          Subtitle="@Localization.Get(Language, TextKey.IdentitySubtitle)"
                          NavItems="@NavigationItems"
                          Collapsed="@collapsed"
                          CollapsedChanged="@(value => collapsed = value)"
                          CollapseLabel="@Localization.Get(Language, TextKey.CollapseSidebar)"
                          ExpandLabel="@Localization.Get(Language, TextKey.ExpandSidebar)"
                          QuickActionsLabel="@Localization.Get(Language, TextKey.QuickActions)"
                          SelectedKey="@SelectedKey"
                          ExpandedKeys="@EffectiveExpandedKeys"
                          ExpandedKeysChanged="@(value => expandedKeys = value)">
            <Logo>
                <span class="ja-brand-logo">
                    <img class="ja-brand-mark" src="/brand/jazor-mark.svg" alt="" aria-hidden="true" />
                    <span>Jazor</span>
                </span>
            </Logo>
            <IconBarActions>
                <TTooltip ContentValue="@Localization.Get(Language, TextKey.Documentation)" Placement="@TPopupPlacement.Right">
                    <a class="ja-iconbar__quick-action ja-starter-link-button"
                       href="https://github.com/devhxj/Jazor/tree/main/docs"
                       target="_blank"
                       rel="noopener noreferrer"
                       data-iconbar-action="documentation"
                       aria-label="@Localization.Get(Language, TextKey.Documentation)">
                        <TIcon Name="file-paste" Size="20px" aria-hidden="true" />
                    </a>
                </TTooltip>
                <TTooltip ContentValue="@Localization.Get(Language, TextKey.Assistant)" Placement="@TPopupPlacement.Right">
                    <a class="ja-iconbar__quick-action ja-starter-link-button"
                       href="https://github.com/devhxj/Jazor/issues"
                       target="_blank"
                       rel="noopener noreferrer"
                       data-iconbar-action="assistant"
                       aria-label="@Localization.Get(Language, TextKey.Assistant)">
                        <TIcon Name="chat" Size="20px" aria-hidden="true" />
                    </a>
                </TTooltip>
                <TTooltip ContentValue="@Localization.Get(Language, TextKey.Account)" Placement="@TPopupPlacement.Right">
                    <TButton CssClass="@("ja-iconbar__quick-action")"
                             Variant="@TButtonVariantValue.Text"
                             Shape="@TButtonShapeValue.Square"
                             data-iconbar-action="account"
                             aria-label="@Localization.Get(Language, TextKey.Account)"
                             OnClick="@(_ => OpenAccounts())">
                        <IconContent><TIcon Name="user-circle" Size="20px" aria-hidden="true" /></IconContent>
                    </TButton>
                </TTooltip>
                <TTooltip ContentValue="@Localization.Get(Language, TextKey.SignOut)" Placement="@TPopupPlacement.Right">
                    <TButton CssClass="@("ja-iconbar__quick-action ja-iconbar__quick-action--danger")"
                             Variant="@TButtonVariantValue.Text"
                             Shape="@TButtonShapeValue.Square"
                             data-iconbar-action="sign-out"
                             aria-label="@Localization.Get(Language, TextKey.SignOut)"
                             OnClick="@(_ => SignOut())">
                        <IconContent><TIcon Name="poweroff" Size="20px" aria-hidden="true" /></IconContent>
                    </TButton>
                </TTooltip>
            </IconBarActions>
            <HeaderActions>
                <div class="ja-starter-operations">
                    <form class="ja-starter-search"
                          data-search-active="@(HasSearchQuery ? "true" : "false")"
                          title="@Localization.Get(Language, TextKey.Search)"
                          @onsubmit="SubmitSearch"
                          @onsubmit:preventDefault>
                        <TIcon Name="search" Size="18px" aria-hidden="true" />
                        <input type="search"
                               placeholder="@Localization.Get(Language, TextKey.SearchPlaceholder)"
                               aria-label="@Localization.Get(Language, TextKey.Search)"
                               data-search-input=""
                               @bind="searchText"
                               @bind:event="oninput" />
                        @if (HasSearchQuery)
                        {
                            <div class="ja-starter-search__panel" role="listbox" data-search-panel="">
                                @if (SearchResults.Length == 0)
                                {
                                    <p class="ja-starter-search__empty">@Localization.Get(Language, TextKey.SearchNoResults)</p>
                                }
                                else
                                {
                                    @foreach (var result in SearchResults)
                                    {
                                        <button type="button"
                                                class="ja-starter-search__item"
                                                role="option"
                                                aria-selected="false"
                                                data-search-key="@result.Key"
                                                @onclick="() => NavigateToSearchResult(result)">
                                            <span>@result.Title</span>
                                            <small>@result.Path</small>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </form>
                    @if (organizations.Length > 0)
                    {
                        <label class="ja-starter-organization">
                            <TIcon Name="location" Size="18px" aria-hidden="true" />
                            <span>@Localization.Get(Language, TextKey.Organization)</span>
                            <select data-organization-picker=""
                                    @bind="selectedOrganizationId">
                                @foreach (var organization in organizations)
                                {
                                    <option value="@organization.Id">@organization.DisplayName</option>
                                }
                            </select>
                        </label>
                    }
                    <div class="ja-starter-notifications" data-notifications-open="@(notificationsOpen ? "true" : "false")">
                        <TButton Variant="@TButtonVariantValue.Text" Shape="@TButtonShapeValue.Square"
                                 aria-label="@Localization.Get(Language, TextKey.Notifications)"
                                 data-notification-command="toggle"
                                 OnClick="@(_ => ToggleNotifications())">
                            <IconContent><TIcon Name="notification" Size="20px" /></IconContent>
                        </TButton>
                        @if (notifications.Length > 0)
                        {
                            <span class="ja-starter-notifications__badge" data-notification-count="@notifications.Length">@notifications.Length</span>
                        }
                        @if (notificationsOpen)
                        {
                            <div class="ja-starter-notifications__panel" role="dialog" aria-label="@Localization.Get(Language, TextKey.Notifications)" data-notifications-panel="">
                                <header>@Localization.Get(Language, TextKey.Notifications)</header>
                                @if (notificationsLoading)
                                {
                                    <p class="ja-starter-notifications__empty">@Localization.Get(Language, TextKey.NotificationsLoading)</p>
                                }
                                else if (notifications.Length == 0)
                                {
                                    <p class="ja-starter-notifications__empty">@Localization.Get(Language, TextKey.NotificationsEmpty)</p>
                                }
                                else
                                {
                                    <ul>
                                        @foreach (var notification in notifications)
                                        {
                                            <li data-notification-source="@notification.Source">
                                                <strong>@notification.Title</strong>
                                                <small>@FormatNotificationTime(notification.StartedAt)@(notification.Message is null ? string.Empty : " · " + notification.Message)</small>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                    <a class="ja-starter-link-button"
                       href="https://github.com/devhxj/Jazor"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="GitHub"
                       title="GitHub"
                       data-header-link="github">
                        <TIcon Name="logo-github" Size="20px" aria-hidden="true" />
                    </a>
                    <TTooltip ContentValue="@Localization.Get(Language, TextKey.Help)">
                        <TButton Variant="@TButtonVariantValue.Text" Shape="@TButtonShapeValue.Square"
                                 aria-label="@Localization.Get(Language, TextKey.Help)"
                                 data-header-command="help"
                                 OnClick="@(_ => showHelpDialog = true)">
                            <IconContent><TIcon Name="help-circle" Size="20px" /></IconContent>
                        </TButton>
                    </TTooltip>
                    <TDropdown Trigger="@TDropdownTriggerValue.Click" Options="@LanguageOptions">
                        <TButton Variant="@TButtonVariantValue.Text" Shape="@TButtonShapeValue.Square"
                                 data-preference="language"
                                 aria-label="@Localization.Get(Language, TextKey.Language)"
                                 title="@Localization.Get(Language, TextKey.Language)">
                            <IconContent><TIcon Name="translate" Size="20px" /></IconContent>
                        </TButton>
                    </TDropdown>
                </div>
            </HeaderActions>
            <UserRegion>
                <div class="ja-starter-user" data-user-menu="">
                    <TDropdown Trigger="@TDropdownTriggerValue.Click" Options="@UserMenuOptions" MinColumnWidth="@UserMenuWidth">
                        <TButton CssClass="@("ja-starter-user__trigger")" Variant="@TButtonVariantValue.Text">
                            <IconContent><span class="ja-starter-user__avatar">@CurrentUserInitial</span></IconContent>
                            <ContentSlot>@CurrentUserLabel</ContentSlot>
                            <SuffixContent><TIcon Name="chevron-down" Size="16px" /></SuffixContent>
                        </TButton>
                    </TDropdown>
                </div>
            </UserRegion>
            <Tabs>
                <RouteTabs Routes="@LocalizedItems" CurrentPath="@currentRoute.Path" HomePath="/" />
            </Tabs>
            <Breadcrumb>
                <RouteBreadcrumb Items="@SelectedBreadcrumbItems" />
            </Breadcrumb>
            <ChildContent>
                <TDesignPageContainer>
                    @if (IsOrganizationPage)
                    {
                        <OrganizationPage Language="@Language"
                                          OrganizationId="@selectedOrganizationId"
                                          View="@(IsOrganizationMembersPage ? OrganizationView.Members : OrganizationView.Structure)" />
                    }
                    else if (IsAuthorizationPage)
                    {
                        <AccessControlPage Language="@Language"
                                           OrganizationId="@selectedOrganizationId"
                                           View="@(IsAuthorizationResourcesPage ? AccessControlView.Resources : AccessControlView.Roles)" />
                    }
                    else if (IsAccountsPage)
                    {
                        <AccountPage Language="@Language" />
                    }
                    else if (IsSsoPage)
                    {
                        @if (IsSsoApplicationsPage)
                        {
                            <SsoAppPage Language="@Language" />
                        }
                        else if (IsSsoScopesPage)
                        {
                            <SsoScopePage Language="@Language" />
                        }
                        else
                        {
                            <SsoGrantPage Language="@Language"
                                          View="@(IsSsoAuthorizationsPage ? GrantView.Authorizations : GrantView.Tokens)" />
                        }
                    }
                    else if (IsSettingsPage)
                    {
                        <SettingsPage Language="@Language" />
                    }
                    else if (IsSchedulesPage)
                    {
                        <SchedulePage Language="@Language" />
                    }
                    else if (IsStarterPage)
                    {
                        @if (SelectedKey == "starter.dashboard.base")
                        {
                            <DashboardPage Language="@Language"
                                           Session="@session"
                                           SelectedOrganization="@SelectedOrganization" />
                        }
                        else
                        {
                            <StarterPage Language="@Language"
                                         Template="@SelectedStarterTemplate"
                                         Session="@session" />
                        }
                    }
                    else
                    {
                        <DashboardPage Language="@Language"
                                       Session="@session"
                                       SelectedOrganization="@SelectedOrganization" />
                    }
                </TDesignPageContainer>
            </ChildContent>
            <Footer>
                <div class="ja-footer">@Localization.Get(Language, TextKey.Copyright)</div>
            </Footer>
        </TDesignLayout>

        <HelpDialog Visible="@showHelpDialog"
                    VisibleChanged="@(value => showHelpDialog = value)"
                    Language="@Language" />

        @if (CanConfigureAppearance)
        {
            <TTooltip ContentValue="@Localization.Get(Language, TextKey.Appearance)" Placement="@TPopupPlacement.Top">
                <TButton CssClass="@("ja-starter-setting-trigger")"
                         Theme="@TButtonThemeValue.Primary"
                         Shape="@TButtonShapeValue.Circle"
                         data-preference="setting"
                         aria-label="@Localization.Get(Language, TextKey.Appearance)"
                         OnClick="@(_ => showSettingPanel = true)">
                    <IconContent><TIcon Name="setting" Size="20px" aria-hidden="true" /></IconContent>
                </TButton>
            </TTooltip>

            <StarterSettings @bind-Visible="showSettingPanel"
                             ThemeKey="@themeKey"
                             ThemeKeyChanged="@ChangeTheme"
                             BrandTheme="@brandTheme"
                             BrandThemeChanged="@ChangeBrandTheme"
                             LayoutKey="@layoutKey"
                             LayoutKeyChanged="@ChangeLayout"
                             SplitMenu="@splitMenu"
                             SplitMenuChanged="@ChangeSplitMenu"
                             SideModeKey="@sideModeKey"
                             SideModeKeyChanged="@ChangeSideMode"
                             IsSidebarFixed="@isSidebarFixed"
                             IsSidebarFixedChanged="@ChangeSidebarFixed"
                             ShowHeader="@showHeader"
                             ShowHeaderChanged="@ChangeShowHeader"
                             ShowBreadcrumb="@showBreadcrumb"
                             ShowBreadcrumbChanged="@ChangeShowBreadcrumb"
                             ShowFooter="@showFooter"
                             ShowFooterChanged="@ChangeShowFooter"
                             IsUseTabsRouter="@isUseTabsRouter"
                             IsUseTabsRouterChanged="@ChangeUseTabs"
                             MenuAutoCollapsed="@menuAutoCollapsed"
                             MenuAutoCollapsedChanged="@ChangeMenuAutoCollapsed"
                             Language="@Language" />
        }
    }
</ApplicationFrame>

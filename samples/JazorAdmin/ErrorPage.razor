@inherits AppComponentBase

<main class="@RootCssClass"
      style="@CssStyle"
      data-error-kind="@Kind"
      role="@(Kind == ErrorKind.InternalServerError ? "alert" : "status")"
      aria-labelledby="ja-error-title"
      aria-describedby="ja-error-description">
    <section class="ja-error__content">
        <strong class="ja-error__code">@ErrorCode</strong>
        <h1 id="ja-error-title">@Text.Normalize(Title)</h1>
        <p id="ja-error-description">@Text.Normalize(Description)</p>
        <button type="button"
                class="ja-error__action"
                data-error-action="home"
                @onclick="OnAction">@Text.Normalize(ActionText)</button>
    </section>
</main>

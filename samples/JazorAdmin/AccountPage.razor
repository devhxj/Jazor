@* Administers Identity accounts and their platform access. 管理 Identity 账户及其平台访问权限。 *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="accounts">
    <TLoading Loading="@loading" TextValue="@L("Loading accounts", "正在加载账户")">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }

            <div class="ja-page__split">
                <section class="ja-panel" aria-labelledby="accounts-title">
                    <header class="ja-panel__header">
                        <div>
                            <h2 id="accounts-title">@L("Accounts", "账户管理")</h2>
                            <p>@L("Identity accounts accepted by the single sign-on center", "单点登录中心接受的 Identity 账户")</p>
                        </div>
                    </header>
                    @if (accounts.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No accounts are registered.", "尚未注册账户。")" />
                    }
                    else
                    {
                        <TTable T="AccountResponse"
                                Data="@accounts"
                                Columns="@Columns"
                                RowKey="Id"
                                RowClassName="@SelectedRowClassName"
                                data-accounts-table="" />
                    }
                </section>

                <section class="ja-panel" aria-labelledby="create-account-title">
                    <header class="ja-panel__header">
                        <div>
                            <h2 id="create-account-title">@L("Create account", "创建账户")</h2>
                            <p>@L("New accounts can then be assigned to organizations and roles", "创建后可将账户分配到组织和角色")</p>
                        </div>
                    </header>
                    <TForm FormData="AccountDraft"
                           Data="@Draft"
                           Rules="@DraftRules"
                           OnSubmit="@CreateAccount"
                           OnReset="@ResetDraft"
                           LabelAlign="@TFormLabelAlignValue.Top"
                           data-account-form="create">
                        <TFormItem LabelValue="@L("Email", "邮箱")" Name="email">
                            <span data-account-field="email"><TInput T="string"
                                @bind-Value="Draft.Email"
                                @bind-Value:event="OnChange"
                                Placeholder="operator@jazor.local" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Display name", "显示名称")" Name="displayName">
                            <span data-account-field="displayName"><TInput T="string"
                                @bind-Value="Draft.DisplayName"
                                @bind-Value:event="OnChange" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Initial password", "初始密码")" Name="password">
                            <span data-account-field="password"><TInput T="string"
                                @bind-Value="Draft.Password"
                                @bind-Value:event="OnChange"
                                Type="@TInputTypeValue.Password" /></span>
                        </TFormItem>
                        <TFormItem Name="platformAdministrator">
                            <TSwitch T="bool"
                                @bind-Value="Draft.PlatformAdministrator"
                                @bind-Value:event="OnChange" />
                            <span class="ja-form__inline-label">@L("Platform administrator", "平台管理员")</span>
                        </TFormItem>
                        <div class="ja-form__commands">
                            <TButton Type="@TButtonTypeValue.Reset" Variant="@TButtonVariantValue.Text" data-account-command="reset-draft">@L("Reset", "重置")</TButton>
                            <TButton Type="@TButtonTypeValue.Submit" Theme="@TButtonThemeValue.Primary" data-account-command="create">@L("Create account", "创建账户")</TButton>
                        </div>
                    </TForm>

                    @if (SelectedAccount is not null)
                    {
                        <div class="ja-panel__section">
                            <h3>@L("Reset password", "重置密码")</h3>
                            <p>@SelectedAccount.Email</p>
                            <TForm FormData="PasswordDraft"
                                   Data="@Password"
                                   Rules="@PasswordRules"
                                   OnSubmit="@ResetPassword"
                                   OnReset="@ResetPasswordDraft"
                                   LabelAlign="@TFormLabelAlignValue.Top"
                                   data-account-form="reset-password">
                                <TFormItem LabelValue="@L("New password", "新密码")" Name="password">
                                    <span data-account-field="newPassword"><TInput T="string"
                                        @bind-Value="Password.Value"
                                        @bind-Value:event="OnChange"
                                        Type="@TInputTypeValue.Password"
                                        Placeholder="@L("New password", "新密码")" /></span>
                                </TFormItem>
                                <div class="ja-form__commands">
                                    <TButton Type="@TButtonTypeValue.Reset" Variant="@TButtonVariantValue.Text" data-account-command="reset-password-clear">@L("Clear", "清空")</TButton>
                                    <TButton Type="@TButtonTypeValue.Submit" data-account-command="reset-password">@L("Update password", "更新密码")</TButton>
                                </div>
                            </TForm>
                        </div>
                    }
                </section>
            </div>
        </ContentSlot>
    </TLoading>
</section>

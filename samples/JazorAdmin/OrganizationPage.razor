@* Operates the selected organization's hierarchy and membership records. 管理当前组织的层级与成员记录。 *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="organizations">
    @if (OrganizationId is null)
    {
        <TEmpty TitleValue="@L("Select an organization from the header to manage it.", "请先从页头选择一个组织再进行管理。")" />
    }
    else
    {
        <TLoading Loading="@loading" TextValue="@L("Loading organization data", "正在加载组织数据")">
            <ContentSlot>
                @if (error is not null)
                {
                    <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
                }
                else if (View == OrganizationView.Structure)
                {
                    <div class="ja-page__split">
                        <section class="ja-panel" aria-labelledby="organization-detail-title">
                            <header class="ja-panel__header">
                                <div>
                                    <h2 id="organization-detail-title">@L("Organization structure", "组织架构")</h2>
                                    <p>@organization?.Code</p>
                                </div>
                            </header>
                            <dl class="ja-form__summary">
                                <div><dt>@L("Name", "名称")</dt><dd>@organization?.DisplayName</dd></div>
                                <div><dt>@L("Code", "编码")</dt><dd>@organization?.Code</dd></div>
                                <div><dt>@L("Parent", "上级组织")</dt><dd>@(organization?.ParentId ?? L("Root organization", "根组织"))</dd></div>
                            </dl>
                            <h3>@L("Child organizations", "下级组织")</h3>
                            @if (organization?.Children is { Length: > 0 } children)
                            {
                                <ul class="ja-item-list">
                                    @foreach (var child in children)
                                    {
                                        <li>
                                            <span class="ja-item-list__code">@child.Code</span>
                                            <span>@child.DisplayName</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <TEmpty TitleValue="@L("No child organizations.", "暂无下级组织。")" Size="@TSizeEnum.Small" />
                            }
                        </section>

                        <section class="ja-panel" aria-labelledby="create-child-title">
                            <header class="ja-panel__header">
                                <div>
                                    <h2 id="create-child-title">@L("Add child organization", "新增下级组织")</h2>
                                    <p>@L("Create a direct child under the active organization", "在当前组织下创建直接下级组织")</p>
                                </div>
                            </header>
                            <TForm FormData="TJsonObject" LabelAlign="@TFormLabelAlignValue.Top">
                                <TFormItem LabelValue="@L("Code", "编码")" Name="childCode">
                                    <span data-organization-field="childCode"><TInput T="string" Value="@childCode" OnChange="@(value => childCode = value)" /></span>
                                </TFormItem>
                                <TFormItem LabelValue="@L("Display name", "显示名称")" Name="childDisplayName">
                                    <span data-organization-field="childDisplayName"><TInput T="string" Value="@childDisplayName" OnChange="@(value => childDisplayName = value)" /></span>
                                </TFormItem>
                                <div class="ja-form__commands">
                                    <TButton Theme="@TButtonThemeValue.Primary" data-organization-command="create-child" OnClick="@(_ => CreateChild())">@L("Create organization", "创建组织")</TButton>
                                </div>
                            </TForm>
                        </section>
                    </div>
                }
                else
                {
                    <div class="ja-page__split">
                        <section class="ja-panel" aria-labelledby="organization-members-title">
                            <header class="ja-panel__header">
                                <div>
                                    <h2 id="organization-members-title">@L("Members", "成员管理")</h2>
                                    <p>@L("Memberships in the active organization", "当前组织的成员记录")</p>
                                </div>
                            </header>
                            @if (members.Length == 0)
                            {
                                <TEmpty TitleValue="@L("No members are assigned.", "尚未分配成员。")" />
                            }
                            else
                            {
                                <TTable T="OrganizationMemberResponse"
                                        Data="@members"
                                        Columns="@MemberColumns"
                                        RowKey="MembershipId"
                                        RowClassName="@SelectedMemberRowClassName" />
                            }
                        </section>

                        <section class="ja-panel" aria-labelledby="membership-actions-title">
                            <header class="ja-panel__header">
                                <div>
                                    <h2 id="membership-actions-title">@L("Membership", "成员操作")</h2>
                                    <p>@L("Add a known account or change the selected member's roles", "添加已有账号或修改所选成员的角色")</p>
                                </div>
                            </header>
                            <TForm FormData="TJsonObject" LabelAlign="@TFormLabelAlignValue.Top">
                                <TFormItem LabelValue="@L("Account email", "账号邮箱")" Name="memberEmail">
                                    <span data-organization-field="memberEmail"><TInput T="string" Value="@memberEmail" OnChange="@(value => memberEmail = value)" Placeholder="operator@jazor.local" /></span>
                                </TFormItem>
                                <TFormItem LabelValue="@L("Initial role", "初始角色")" Name="newMemberRoleId">
                                    <TRadioGroup T="string" Value="@newMemberRoleId" OnChange="@(value => newMemberRoleId = value)">
                                        <TRadioButton T="string" Value="@string.Empty" LabelValue="@L("No role", "不分配角色")" />
                                        @foreach (var role in roles)
                                        {
                                            <TRadioButton T="string" Value="@role.Id" LabelValue="@role.DisplayName" />
                                        }
                                    </TRadioGroup>
                                </TFormItem>
                                <div class="ja-form__commands">
                                    <TButton Theme="@TButtonThemeValue.Primary" data-organization-command="create-member" OnClick="@(_ => CreateMember())">@L("Add member", "添加成员")</TButton>
                                </div>
                            </TForm>

                            @if (editingMembershipId is not null)
                            {
                                <div class="ja-panel__section">
                                    <h3>@L("Member roles", "成员角色")</h3>
                                    <div class="ja-option-list">
                                        @foreach (var role in roles)
                                        {
                                            <label class="ja-form__option">
                                                <TSwitch T="bool" Value="@HasEditedMemberRole(role.Id)" OnChange="@(_ => ToggleEditedMemberRole(role.Id))" />
                                                <span>@role.DisplayName</span>
                                            </label>
                                        }
                                    </div>
                                    <TButton Theme="@TButtonThemeValue.Primary" Variant="@TButtonVariantValue.Outline" data-organization-command="save-roles" OnClick="@(_ => SaveMemberRoles())">@L("Save roles", "保存角色")</TButton>
                                </div>
                            }
                        </section>
                    </div>
                }
            </ContentSlot>
        </TLoading>
    }
</section>

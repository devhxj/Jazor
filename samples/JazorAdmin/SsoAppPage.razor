@* Manages every OpenIddict application profile through one exact permission surface. *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="sso" data-sso-view="applications">
    <TLoading Loading="@loading" TextValue="@L("Loading OpenID applications", "正在加载 OpenID 应用")">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }

            <div class="ja-page__split">
                <section class="ja-panel" aria-labelledby="sso-apps-title">
                    <header class="ja-panel__header">
                        <div><h2 id="sso-apps-title">@L("OpenID applications", "OpenID 应用")</h2><p>@L("Interactive clients, machine clients, and API resources", "交互客户端、机器客户端与 API 资源")</p></div>
                        <TButton Theme="@TButtonThemeValue.Primary" data-sso-command="new-application" OnClick="@(_ => NewInteractive())">@L("New", "新建")</TButton>
                    </header>
                    @if (applications.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No OpenID applications are registered.", "尚未注册 OpenID 应用。")" />
                    }
                    else
                    {
                        <TTable T="AppView"
                                Data="@applications"
                                Columns="@Columns"
                                RowKey="Id"
                                RowClassName="@SelectedRowClassName" />
                    }
                </section>

                <section class="ja-panel" aria-labelledby="sso-app-editor-title">
                    <header class="ja-panel__header">
                        <div><h2 id="sso-app-editor-title">@(IsNew ? L("Register application", "注册应用") : L("Application settings", "应用设置"))</h2><p>@L("Protocol permissions are stored directly by OpenIddict", "协议权限由 OpenIddict 直接存储")</p></div>
                    </header>

                    @if (issuedSecret is not null)
                    {
                        <div class="ja-secret" role="status" data-issued-secret="">
                            <strong>@L("Client secret", "客户端密钥")</strong>
                            <code>@issuedSecret</code>
                            <span>@L("This value is shown once. Store it before leaving this view.", "该值仅显示一次，请离开本页前妥善保存。")</span>
                        </div>
                    }

                    @if (IsNew)
                    {
                        <TRadioGroup T="string" Value="@profile" OnChange="@(value => SelectProfile(value))" CssClass="@("ja-profiles")">
                            <span data-sso-profile="interactive"><TRadioButton T="string" Value="@("interactive")" LabelValue="@L("Interactive", "交互应用")" /></span>
                            <span data-sso-profile="machine"><TRadioButton T="string" Value="@("machine")" LabelValue="@L("Machine", "机器应用")" /></span>
                            <span data-sso-profile="api"><TRadioButton T="string" Value="@("api")" LabelValue="API" /></span>
                        </TRadioGroup>
                    }

                    <TForm FormData="AppDraft"
                           Data="@Draft"
                           Rules="@DraftRules"
                           OnSubmit="@Save"
                           OnReset="@ResetDraft"
                           LabelAlign="@TFormLabelAlignValue.Top"
                           data-sso-form="application">
                        <div class="ja-form__grid">
                            <TFormItem LabelValue="@L("Client ID", "客户端 ID")" Name="clientId">
                                <span data-app-field="clientId"><TInput T="string"
                                    @bind-Value="Draft.ClientId"
                                    @bind-Value:event="OnChange"
                                    Readonly="@(!IsNew)" /></span>
                            </TFormItem>
                            <TFormItem LabelValue="@L("Display name", "显示名称")" Name="displayName">
                                <span data-app-field="displayName"><TInput T="string"
                                    @bind-Value="Draft.DisplayName"
                                    @bind-Value:event="OnChange" /></span>
                            </TFormItem>
                        </div>
                        <TFormItem LabelValue="@L("Application type", "应用类型")" Name="applicationType">
                            <TRadioGroup T="string"
                                          @bind-Value="Draft.ApplicationType"
                                          @bind-Value:event="OnChange">
                                <TRadioButton T="string" Value="@("web")" LabelValue="Web" />
                                <TRadioButton T="string" Value="@("native")" LabelValue="Native" />
                            </TRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Client type", "客户端类型")" Name="clientType">
                            <TRadioGroup T="string"
                                          @bind-Value="Draft.ClientType"
                                          @bind-Value:event="OnChange">
                                <TRadioButton T="string" Value="@("public")" LabelValue="@L("Public", "公开")" />
                                <TRadioButton T="string" Value="@("confidential")" LabelValue="@L("Confidential", "机密")" />
                            </TRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Consent", "授权同意")" Name="consentType">
                            <TRadioGroup T="string"
                                          @bind-Value="Draft.ConsentType"
                                          @bind-Value:event="OnChange">
                                <TRadioButton T="string" Value="@("implicit")" LabelValue="@L("Implicit", "隐式")" />
                                <TRadioButton T="string" Value="@("explicit")" LabelValue="@L("Explicit", "显式")" />
                                <TRadioButton T="string" Value="@("systematic")" LabelValue="@L("Systematic", "系统式")" />
                            </TRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Redirect URIs", "回调地址")" Name="redirectUris">
                            <span data-app-field="redirectUris"><TTextarea
                                @bind-Value="Draft.RedirectUris"
                                @bind-Value:event="OnChange"
                                Placeholder="https://client.example/auth/callback" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Post-logout URIs", "登出回调地址")" Name="postLogoutRedirectUris">
                            <span data-app-field="postLogoutRedirectUris"><TTextarea
                                @bind-Value="Draft.PostLogoutRedirectUris"
                                @bind-Value:event="OnChange"
                                Placeholder="https://client.example/logout" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Allowed scopes", "允许的 Scope")" Name="scopeValues">
                            <span data-app-field="scopeValues"><TInput T="string"
                                @bind-Value="Draft.ScopeValues"
                                @bind-Value:event="OnChange"
                                Placeholder="openid profile api" /></span>
                        </TFormItem>

                        <fieldset class="ja-form__options">
                            <legend>@L("Endpoint access", "端点访问")</legend>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.EndpointAuthorization" @bind-Value:event="OnChange" /><span>@L("Authorization", "授权端点")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.EndpointToken" @bind-Value:event="OnChange" /><span>@L("Token", "令牌端点")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.EndpointEndSession" @bind-Value:event="OnChange" /><span>@L("End session", "登出端点")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.EndpointIntrospection" @bind-Value:event="OnChange" /><span>@L("Introspection", "内省端点")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.EndpointRevocation" @bind-Value:event="OnChange" /><span>@L("Revocation", "撤销端点")</span></label>
                        </fieldset>

                        <fieldset class="ja-form__options">
                            <legend>@L("Grant and response types", "授权与响应类型")</legend>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.GrantAuthorizationCode" @bind-Value:event="OnChange" /><span>@L("Authorization code", "授权码")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.GrantClientCredentials" @bind-Value:event="OnChange" /><span>@L("Client credentials", "客户端凭证")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.GrantRefreshToken" @bind-Value:event="OnChange" /><span>@L("Refresh token", "刷新令牌")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.ResponseCode" @bind-Value:event="OnChange" /><span>@L("Code response", "Code 响应")</span></label>
                            <label class="ja-form__option"><TSwitch T="bool" @bind-Value="Draft.RequirePkce" @bind-Value:event="OnChange" /><span>@L("Require PKCE", "要求 PKCE")</span></label>
                        </fieldset>

                        <div class="ja-form__commands">
                            <TButton Type="@TButtonTypeValue.Reset" Variant="@TButtonVariantValue.Text" data-sso-command="reset-application">@L("Reset", "重置")</TButton>
                            <TButton Type="@TButtonTypeValue.Submit" Theme="@TButtonThemeValue.Primary" data-sso-command="save-application">@(IsNew ? L("Register", "注册") : L("Save changes", "保存修改"))</TButton>
                            @if (!IsNew && IsConfidential)
                            {
                                <TButton Variant="@TButtonVariantValue.Outline" data-sso-command="rotate-secret" OnClick="@(_ => RotateSecret())">@L("Rotate secret", "轮换密钥")</TButton>
                            }
                            @if (!IsNew)
                            {
                                <TButton Theme="@TButtonThemeValue.Danger" Variant="@TButtonVariantValue.Outline" data-sso-command="delete-application" OnClick="@(_ => DeleteApp())">@(deleteArmed ? L("Confirm delete", "确认删除") : L("Delete", "删除"))</TButton>
                            }
                        </div>
                    </TForm>
                </section>
            </div>
        </ContentSlot>
    </TLoading>
</section>

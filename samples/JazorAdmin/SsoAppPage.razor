@* Manages every OpenIddict application profile through one exact permission surface. *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="sso" data-sso-view="applications">
    <TLoading Loading="@loading" TextValue="@L("Loading OpenID applications", "正在加载 OpenID 应用")">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }

            <div class="ja-page__split">
                <section class="ja-panel" aria-labelledby="sso-apps-title">
                    <header class="ja-panel__header">
                        <div><h2 id="sso-apps-title">@L("OpenID applications", "OpenID 应用")</h2><p>@L("Interactive clients, machine clients, and API resources", "交互客户端、机器客户端与 API 资源")</p></div>
                        <TButton Theme="@TButtonThemeValue.Primary" data-sso-command="new-application" OnClick="@(_ => NewInteractive())">@L("New", "新建")</TButton>
                    </header>
                    @if (applications.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No OpenID applications are registered.", "尚未注册 OpenID 应用。")" />
                    }
                    else
                    {
                        <AdminAppTable Data="@applications"
                                    Columns="@Columns"
                                    RowKey="Id"
                                    RowClassName="@SelectedRowClassName" />
                    }
                </section>

                <section class="ja-panel" aria-labelledby="sso-app-editor-title">
                    <header class="ja-panel__header">
                        <div><h2 id="sso-app-editor-title">@(IsNew ? L("Register application", "注册应用") : L("Application settings", "应用设置"))</h2><p>@L("Protocol permissions are stored directly by OpenIddict", "协议权限由 OpenIddict 直接存储")</p></div>
                    </header>

                    @if (issuedSecret is not null)
                    {
                        <div class="ja-secret" role="status" data-issued-secret="">
                            <strong>@L("Client secret", "客户端密钥")</strong>
                            <code>@issuedSecret</code>
                            <span>@L("This value is shown once. Store it before leaving this view.", "该值仅显示一次，请离开本页前妥善保存。")</span>
                        </div>
                    }

                    @if (IsNew)
                    {
                        <AdminRadioGroup Value="@profile" OnChange="@(value => SelectProfile(value))" CssClass="@("ja-profiles")">
                            <span data-sso-profile="interactive"><AdminRadioButton Value="interactive" LabelValue="@L("Interactive", "交互应用")" /></span>
                            <span data-sso-profile="machine"><AdminRadioButton Value="machine" LabelValue="@L("Machine", "机器应用")" /></span>
                            <span data-sso-profile="api"><AdminRadioButton Value="api" LabelValue="API" /></span>
                        </AdminRadioGroup>
                    }

                    <AdminForm LabelAlign="@TFormLabelAlignValue.Top">
                        <div class="ja-form__grid">
                            <TFormItem LabelValue="@L("Client ID", "客户端 ID")" Name="clientId">
                                <span data-app-field="clientId"><AdminInput Value="@clientId" OnChange="@(value => clientId = value)" Readonly="@(!IsNew)" /></span>
                            </TFormItem>
                            <TFormItem LabelValue="@L("Display name", "显示名称")" Name="displayName">
                                <span data-app-field="displayName"><AdminInput Value="@displayName" OnChange="@(value => displayName = value)" /></span>
                            </TFormItem>
                        </div>
                        <TFormItem LabelValue="@L("Application type", "应用类型")" Name="applicationType">
                            <AdminRadioGroup Value="@applicationType" OnChange="@(value => applicationType = value)">
                                <AdminRadioButton Value="web" LabelValue="Web" />
                                <AdminRadioButton Value="native" LabelValue="Native" />
                            </AdminRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Client type", "客户端类型")" Name="clientType">
                            <AdminRadioGroup Value="@clientType" OnChange="@(value => clientType = value)">
                                <AdminRadioButton Value="public" LabelValue="@L("Public", "公开")" />
                                <AdminRadioButton Value="confidential" LabelValue="@L("Confidential", "机密")" />
                            </AdminRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Consent", "授权同意")" Name="consentType">
                            <AdminRadioGroup Value="@consentType" OnChange="@(value => consentType = value)">
                                <AdminRadioButton Value="implicit" LabelValue="@L("Implicit", "隐式")" />
                                <AdminRadioButton Value="explicit" LabelValue="@L("Explicit", "显式")" />
                                <AdminRadioButton Value="systematic" LabelValue="@L("Systematic", "系统式")" />
                            </AdminRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Redirect URIs", "回调地址")" Name="redirectUris">
                            <span data-app-field="redirectUris"><AdminTextarea Value="@redirectUris" OnChange="@(value => redirectUris = value)" Placeholder="https://client.example/auth/callback" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Post-logout URIs", "登出回调地址")" Name="postLogoutRedirectUris">
                            <span data-app-field="postLogoutRedirectUris"><AdminTextarea Value="@postLogoutRedirectUris" OnChange="@(value => postLogoutRedirectUris = value)" Placeholder="https://client.example/logout" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Allowed scopes", "允许的 Scope")" Name="scopeValues">
                            <span data-app-field="scopeValues"><AdminInput Value="@scopeValues" OnChange="@(value => scopeValues = value)" Placeholder="openid profile api" /></span>
                        </TFormItem>

                        <fieldset class="ja-form__options">
                            <legend>@L("Endpoint access", "端点访问")</legend>
                            <label class="ja-form__option"><AdminToggle Value="@endpointAuthorization" OnChange="@(value => endpointAuthorization = value)" /><span>@L("Authorization", "授权端点")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@endpointToken" OnChange="@(value => endpointToken = value)" /><span>@L("Token", "令牌端点")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@endpointEndSession" OnChange="@(value => endpointEndSession = value)" /><span>@L("End session", "登出端点")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@endpointIntrospection" OnChange="@(value => endpointIntrospection = value)" /><span>@L("Introspection", "内省端点")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@endpointRevocation" OnChange="@(value => endpointRevocation = value)" /><span>@L("Revocation", "撤销端点")</span></label>
                        </fieldset>

                        <fieldset class="ja-form__options">
                            <legend>@L("Grant and response types", "授权与响应类型")</legend>
                            <label class="ja-form__option"><AdminToggle Value="@grantAuthorizationCode" OnChange="@(value => grantAuthorizationCode = value)" /><span>@L("Authorization code", "授权码")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@grantClientCredentials" OnChange="@(value => grantClientCredentials = value)" /><span>@L("Client credentials", "客户端凭证")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@grantRefreshToken" OnChange="@(value => grantRefreshToken = value)" /><span>@L("Refresh token", "刷新令牌")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@responseCode" OnChange="@(value => responseCode = value)" /><span>@L("Code response", "Code 响应")</span></label>
                            <label class="ja-form__option"><AdminToggle Value="@requirePkce" OnChange="@(value => requirePkce = value)" /><span>@L("Require PKCE", "要求 PKCE")</span></label>
                        </fieldset>

                        <div class="ja-form__commands">
                            <TButton Theme="@TButtonThemeValue.Primary" data-sso-command="save-application" OnClick="@(_ => Save())">@(IsNew ? L("Register", "注册") : L("Save changes", "保存修改"))</TButton>
                            @if (!IsNew && IsConfidential)
                            {
                                <TButton Variant="@TButtonVariantValue.Outline" data-sso-command="rotate-secret" OnClick="@(_ => RotateSecret())">@L("Rotate secret", "轮换密钥")</TButton>
                            }
                            @if (!IsNew)
                            {
                                <TButton Theme="@TButtonThemeValue.Danger" Variant="@TButtonVariantValue.Outline" data-sso-command="delete-application" OnClick="@(_ => DeleteApp())">@(deleteArmed ? L("Confirm delete", "确认删除") : L("Delete", "删除"))</TButton>
                            }
                        </div>
                    </AdminForm>
                </section>
            </div>
        </ContentSlot>
    </TLoading>
</section>

@* Provides the platform operation log with explicit, persistent query filters. *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="audit" data-audit-view="events">
    <TLoading Loading="@loading" TextValue="@L("Loading audit events", "正在加载审计日志")">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }

            <section class="ja-panel" aria-labelledby="audit-events-title">
                <header class="ja-panel__header">
                    <div>
                        <h2 id="audit-events-title">@L("Operation audit log", "操作审计日志")</h2>
                        <p>@L("The latest 200 management and OpenID protocol events", "最近 200 条管理操作与 OpenID 协议事件")</p>
                    </div>
                </header>

                <TForm FormData="AuditFilterDraft"
                       Data="@Filters"
                       OnSubmit="@ApplyFilters"
                       OnReset="@ResetFilters"
                       LabelAlign="@TFormLabelAlignValue.Top"
                       data-audit-form="filters">
                    <div class="ja-audit__filters">
                        <TFormItem LabelValue="@L("From (UTC)", "开始时间（UTC）")" Name="from">
                            <span data-audit-filter="from"><TInput T="string"
                                @bind-Value="Filters.From"
                                @bind-Value:event="OnChange"
                                Placeholder="2026-08-19T00:00:00Z" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("To (UTC)", "结束时间（UTC）")" Name="to">
                            <span data-audit-filter="to"><TInput T="string"
                                @bind-Value="Filters.To"
                                @bind-Value:event="OnChange"
                                Placeholder="2026-08-19T23:59:59Z" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Actor", "操作者")" Name="actor">
                            <span data-audit-filter="actor"><TInput T="string"
                                @bind-Value="Filters.Actor"
                                @bind-Value:event="OnChange"
                                Clearable="@true"
                                Placeholder="admin@jazor.local" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Object", "对象")" Name="object">
                            <span data-audit-filter="object"><TInput T="string"
                                @bind-Value="Filters.Target"
                                @bind-Value:event="OnChange"
                                Clearable="@true"
                                Placeholder="sso-application" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Action", "操作类型")" Name="action">
                            <span data-audit-filter="action"><TInput T="string"
                                @bind-Value="Filters.Action"
                                @bind-Value:event="OnChange"
                                Clearable="@true"
                                Placeholder="created / revoked" /></span>
                        </TFormItem>
                    </div>
                    <div class="ja-form__commands">
                        <TButton Type="@TButtonTypeValue.Reset" Variant="@TButtonVariantValue.Text" data-audit-command="clear">@L("Clear", "清空")</TButton>
                        <TButton Type="@TButtonTypeValue.Submit" Theme="@TButtonThemeValue.Primary" data-audit-command="apply">@L("Apply filters", "应用筛选")</TButton>
                    </div>
                </TForm>

                @if (events.Length == 0)
                {
                    <TEmpty TitleValue="@L("No audit events match the current filters.", "当前筛选条件下没有审计日志。")" />
                }
                else
                {
                    <TTable T="AuditEventView" Data="@events" Columns="@Columns" RowKey="Id" />
                }
            </section>
        </ContentSlot>
    </TLoading>
</section>

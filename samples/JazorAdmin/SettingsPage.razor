@* Manages typed runtime settings without coupling configuration storage to OpenIddict protocol configuration. *@
@inherits AppComponentBase

<section class="ja-page" data-management-area="settings">
    <TLoading Loading="@loading" TextValue="@L("Loading system settings", "正在加载系统配置")">
        <ContentSlot>
            @if (error is not null)
            {
                <TAlert Theme="@TAlertThemeValue.Error" MessageValue="@error" role="alert" />
            }

            <div class="ja-page__split">
                <section class="ja-panel" aria-labelledby="settings-title">
                    <header class="ja-panel__header">
                        <div><h2 id="settings-title">@L("System settings", "系统配置")</h2><p>@L("Typed values grouped for application runtime use", "按运行时用途分组的强类型配置值")</p></div>
                        <TButton Theme="@TButtonThemeValue.Primary" data-settings-command="new" OnClick="@(_ => NewSetting())">@L("New", "新建")</TButton>
                    </header>
                    @if (settings.Length == 0)
                    {
                        <TEmpty TitleValue="@L("No system settings are defined.", "尚未定义系统配置。")">
                            <ActionContent>
                                <TButton Theme="@TButtonThemeValue.Primary" Variant="@TButtonVariantValue.Outline" data-settings-command="new-empty" OnClick="@(_ => NewSetting())">@L("Create the first setting", "创建第一条配置")</TButton>
                            </ActionContent>
                        </TEmpty>
                    }
                    else
                    {
                        <TTable T="SettingView"
                                Data="@settings"
                                Columns="@Columns"
                                RowKey="Key"
                                RowClassName="@SelectedRowClassName" />
                    }
                </section>

                <section class="ja-panel" aria-labelledby="setting-editor-title">
                    <header class="ja-panel__header">
                        <div><h2 id="setting-editor-title">@(IsNew ? L("Create setting", "创建配置") : L("Setting details", "配置详情"))</h2><p>@L("Keys are immutable after creation", "键名创建后不可修改")</p></div>
                    </header>
                    <TForm FormData="TJsonObject" LabelAlign="@TFormLabelAlignValue.Top">
                        <TFormItem LabelValue="@L("Key", "键名")" Name="key">
                            <span data-setting-field="key"><TInput T="string" Value="@key" OnChange="@(value => key = value)" Readonly="@(!IsNew)" Placeholder="feature.audit.enabled" /></span>
                        </TFormItem>
                        <div class="ja-form__grid">
                            <TFormItem LabelValue="@L("Group", "分组")" Name="group">
                                <span data-setting-field="group"><TInput T="string" Value="@group" OnChange="@(value => group = value)" Placeholder="feature" /></span>
                            </TFormItem>
                            <TFormItem LabelValue="@L("Label", "标签")" Name="label">
                                <span data-setting-field="label"><TInput T="string" Value="@label" OnChange="@(value => label = value)" /></span>
                            </TFormItem>
                        </div>
                        <TFormItem LabelValue="@L("Type", "类型")" Name="kind">
                            <TRadioGroup T="string" Value="@kind" OnChange="@(value => kind = value)">
                                <TRadioButton T="string" Value="@("text")" LabelValue="@L("Text", "文本")" />
                                <TRadioButton T="string" Value="@("boolean")" LabelValue="@L("Boolean", "布尔")" />
                                <TRadioButton T="string" Value="@("number")" LabelValue="@L("Number", "数值")" />
                                <TRadioButton T="string" Value="@("json")" LabelValue="JSON" />
                            </TRadioGroup>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Description", "描述")" Name="description">
                            <span data-setting-field="description"><TInput T="string" Value="@description" OnChange="@(value => description = value)" /></span>
                        </TFormItem>
                        <TFormItem LabelValue="@L("Value", "值")" Name="value">
                            <span data-setting-field="value"><TTextarea Value="@value" OnChange="@(newValue => value = newValue.Value as string ?? string.Empty)" Placeholder="true" /></span>
                        </TFormItem>
                        <div class="ja-form__commands">
                            <TButton Theme="@TButtonThemeValue.Primary" data-settings-command="save" OnClick="@(_ => Save())">@(IsNew ? L("Create", "创建") : L("Save changes", "保存修改"))</TButton>
                            @if (!IsNew)
                            {
                                <TButton Theme="@TButtonThemeValue.Danger" Variant="@TButtonVariantValue.Outline" data-settings-command="delete" OnClick="@(_ => DeleteSetting())">@(deleteArmed ? L("Confirm delete", "确认删除") : L("Delete", "删除"))</TButton>
                            }
                        </div>
                    </TForm>
                </section>
            </div>
        </ContentSlot>
    </TLoading>
</section>

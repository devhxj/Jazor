@* Administration overview with real session and platform statistics. 管理首页：会话与平台两级真实统计数据。 *@
@inherits AppComponentBase

<section class="ja-starter-dashboard" data-dashboard="administration" data-starter-page="dashboard-base">
    @if (error is not null)
    {
        <p class="ja-management__error" role="alert">@error</p>
    }
    <div class="ja-starter-dashboard__metrics" aria-label="@L("Administration overview", "管理概览")">
        <TCard Bordered="false" CssClass="@(C("ja-starter-metric"))">
            <div class="ja-starter-metric__label"><span>@L("Organizations", "组织总数")</span><TIcon Name="tree-square-dot" Size="20px" /></div>
            <strong>@(overview?.Organizations ?? 0)</strong>
            <div class="ja-starter-metric__footer"><span>@(Session?.Organizations.Length ?? 0) @L("in this session", "当前会话可用")</span></div>
        </TCard>
        <TCard Bordered="false" CssClass="@(C("ja-starter-metric"))">
            <div class="ja-starter-metric__label"><span>@L("Platform roles", "平台角色")</span><TIcon Name="secured" Size="20px" /></div>
            <strong>@(overview?.PlatformRoles ?? 0)</strong>
            <div class="ja-starter-metric__footer"><span>@(overview?.OrganizationRoles ?? 0) @L("organization roles", "组织角色")</span></div>
        </TCard>
        <TCard Bordered="false" CssClass="@(C("ja-starter-metric"))">
            <div class="ja-starter-metric__label"><span>@L("Accounts", "平台账户")</span><TIcon Name="usergroup" Size="20px" /></div>
            <strong>@(overview?.Accounts ?? 0)</strong>
            <div class="ja-starter-metric__footer"><span>@(overview?.EnabledAccounts ?? 0) @L("enabled", "已启用")</span></div>
        </TCard>
        <TCard Bordered="false" CssClass="@(C("ja-starter-metric"))">
            <div class="ja-starter-metric__label"><span>@L("Current organization", "当前组织")</span><TIcon Name="location" Size="20px" /></div>
            <strong class="is-code">@(SelectedOrganization?.Code ?? L("None", "未选择"))</strong>
            <div class="ja-starter-metric__footer"><span>@(SelectedOrganization?.DisplayName ?? L("Choose from the header", "请从页头选择"))</span></div>
        </TCard>
    </div>

    <div class="ja-starter-dashboard__analysis">
        <TCard Bordered="false" CssClass="@(C("ja-starter-card", "ja-starter-chart-card"))">
            <header class="ja-starter-card__header">
                <div><h2>@L("Administration activity", "管理活动趋势")</h2><p>@L("Quartz task executions over the last 7 days (UTC)", "近 7 天 Quartz 任务执行情况（UTC）")</p></div>
                <div class="ja-starter-segments" role="group" aria-label="@L("Period", "统计周期")"><button class="is-selected">@L("Last 7 days", "近 7 天")</button></div>
            </header>
            <div class="ja-starter-chart" role="img" aria-label="@L("Administration activity bar chart", "管理活动柱状图")">
                <div class="ja-starter-chart__axis"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
                <div class="ja-starter-chart__plot" data-chart-loading="@(loading ? "true" : "false")">
                    @if (loading)
                    {
                        <p class="ja-management__loading" aria-live="polite">@L("Loading execution history", "正在加载执行记录")</p>
                    }
                    else if (overview?.RecentRuns is { Length: > 0 } runs)
                    {
                        @foreach (var run in runs)
                        {
                            <div><i style="height:@(ToChartHeight(run.Succeeded))%"></i><b style="height:@(ToChartHeight(run.Failed))%"></b><span>@ToDayLabel(run.Date)</span></div>
                        }
                    }
                </div>
            </div>
            <div class="ja-starter-chart__legend"><span><i class="is-primary"></i>@L("Succeeded", "成功")</span><span><i class="is-secondary"></i>@L("Failed", "失败")</span></div>
        </TCard>

        <TCard Bordered="false" CssClass="@(C("ja-starter-card", "ja-starter-distribution"))">
            <header class="ja-starter-card__header"><div><h2>@L("Access distribution", "访问分布")</h2><p>@L("Platform resource dimensions", "平台资源维度")</p></div></header>
            <div class="ja-starter-donut" aria-hidden="true"><span>@((overview?.Organizations ?? 0) + (overview?.PlatformRoles ?? 0) + (overview?.Applications ?? 0))<small>@L("items", "项")</small></span></div>
            <dl>
                <div><dt><i class="is-brand"></i>@L("Organizations", "组织")</dt><dd>@(overview?.Organizations ?? 0)</dd></div>
                <div><dt><i class="is-cyan"></i>@L("OpenID applications", "OpenID 应用")</dt><dd>@(overview?.Applications ?? 0)</dd></div>
                <div><dt><i class="is-gray"></i>@L("Scopes", "Scope")</dt><dd>@(overview?.Scopes ?? 0)</dd></div>
            </dl>
        </TCard>
    </div>

    <div class="ja-starter-dashboard__rankings">
        <TCard Bordered="false" CssClass="@(C("ja-starter-card", "ja-starter-rank"))">
            <header class="ja-starter-card__header"><div><h2>@L("Organization access", "组织访问")</h2><p>@L("Organizations available to this account", "当前账号可管理的组织")</p></div><TIcon Name="more" Size="20px" /></header>
            <table><thead><tr><th>#</th><th>@L("Organization", "组织")</th><th>@L("Code", "编码")</th><th>@L("Status", "状态")</th></tr></thead><tbody>
                @if (Session?.Organizations is { Length: > 0 } organizations)
                {
                    @foreach (var organization in organizations)
                    {
                        <tr><td><span class="ja-starter-rank__index">#</span></td><td>@organization.DisplayName</td><td><code>@organization.Code</code></td><td><span class="ja-starter-status is-success">@L("Available", "可用")</span></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="ja-starter-empty">@L("No organizations assigned", "尚未分配组织")</td></tr>
                }
            </tbody></table>
        </TCard>

        <TCard Bordered="false" CssClass="@(C("ja-starter-card", "ja-starter-rank"))">
            <header class="ja-starter-card__header"><div><h2>@L("Access profile", "访问配置")</h2><p>@L("Effective platform roles", "当前生效的平台角色")</p></div><TIcon Name="more" Size="20px" /></header>
            <table><thead><tr><th>#</th><th>@L("Role", "角色")</th><th>@L("Scope", "范围")</th><th>@L("Status", "状态")</th></tr></thead><tbody>
                @if (Session?.Roles is { Length: > 0 } roles)
                {
                    @foreach (var role in roles)
                    {
                        <tr><td><span class="ja-starter-rank__index">#</span></td><td>@role</td><td>@L("Platform", "平台")</td><td><span class="ja-starter-status is-success">@L("Effective", "生效")</span></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="ja-starter-empty">@L("No platform roles assigned", "尚未分配平台角色")</td></tr>
                }
            </tbody></table>
        </TCard>
    </div>

    <TCard Bordered="false" CssClass="@(C("ja-starter-card", "ja-starter-output"))">
        <header class="ja-starter-card__header"><div><h2>@L("Service overview", "服务概览")</h2><p>@L("Production paths exercised by JazorAdmin", "JazorAdmin 已接入的生产链路")</p></div></header>
        <div class="ja-starter-output__grid">
            <article><TIcon Name="user-safety" Size="22px" /><div><strong>Identity</strong><span>@L("Local accounts and sessions", "本地账号与会话")</span></div><em>@(overview is null ? "--" : (overview.EnabledAccounts + "/" + overview.Accounts))</em></article>
            <article><TIcon Name="link" Size="22px" /><div><strong>OpenIddict</strong><span>@L("SSO applications and grants", "SSO 应用与授权")</span></div><em>@(overview is null ? "--" : overview.Applications.ToString())</em></article>
            <article><TIcon Name="setting-1" Size="22px" /><div><strong>Quartz</strong><span>@L("Scheduled operations", "计划任务与执行记录")</span></div><em>@(overview is null ? "--" : (overview.EnabledSchedules + "/" + overview.Schedules))</em></article>
            <article><TIcon Name="server" Size="22px" /><div><strong>RazorVue</strong><span>@L("Package-contained frontend", "包内自包含前端")</span></div><em>@L("Online", "在线")</em></article>
        </div>
    </TCard>
</section>

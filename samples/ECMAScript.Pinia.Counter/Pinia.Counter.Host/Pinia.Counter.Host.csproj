<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JazorMode>debug</JazorMode>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- extern-based JS host contracts are intentional in this sample. -->
    <NoWarn>$(NoWarn);CS0626</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jazor" Version="$(JazorPackageVersion)" />
    <PackageReference Include="ECMAScript.Pinia" Version="$(JazorPackageVersion)" />
    <PackageReference Include="ECMAScript.Pinia.Testing" Version="$(JazorPackageVersion)" />
  </ItemGroup>
</Project>

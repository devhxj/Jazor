<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <JazorMode>debug</JazorMode>
    <!-- Source references stay the default for repository development. Set TodoUsePackages=true
         to verify the same host as an isolated NuGet consumer (SSR release gate). -->
    <TodoUsePackages Condition="'$(TodoUsePackages)' == ''">false</TodoUsePackages>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0626</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\..\src\Jazor\buildTransitive\Jazor.props"
          Condition="'$(TodoUsePackages)' != 'true'" />

  <ItemGroup>
    <Compile Remove="jazor\**" />
    <Content Remove="jazor\**" />
    <EmbeddedResource Remove="jazor\**" />
    <None Remove="jazor\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TodoUsePackages)' != 'true'">
    <!-- Source builds do not import ECMAScript.Vue's packaged buildTransitive target. -->
    <JazorLibraryManifest Include="..\..\..\src\ECMAScript.Vue\manifest.json" />
    <ProjectReference Include="..\Todo.Library\Todo.Library.csproj" />
    <ProjectReference Include="..\..\..\src\ECMAScript\ECMAScript.csproj" />
    <ProjectReference Include="..\..\..\src\ECMAScript.Vue\ECMAScript.Vue.csproj" />
    <ProjectReference Include="..\..\..\src\ECMAScript.Style\ECMAScript.Style.csproj" />
    <ProjectReference Include="..\..\..\src\Jazor.AspNetCore\Jazor.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\src\Jazor.AspNetCore.Dev\Jazor.AspNetCore.Dev.csproj" />
    <ProjectReference Include="..\..\..\src\Jazor.CLR\Jazor.CLR.csproj" />
    <ProjectReference Include="..\..\..\src\Jazor.Emit\Jazor.Emit.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\src\Jazor.Compiler\Jazor.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\src\Jazor.Analyzer\Jazor.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TodoUsePackages)' == 'true'">
    <ProjectReference Include="..\Todo.Library\Todo.Library.csproj" />
    <PackageReference Include="Jazor" Version="$(JazorPackageVersion)" />
    <PackageReference Include="Jazor.Vue" Version="$(JazorPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorPackageVersion)" />
  </ItemGroup>

  <Target Name="AddLocalJazorAnalyzerDependencies"
          BeforeTargets="CoreCompile"
          Condition="'$(TodoUsePackages)' != 'true'">
    <ItemGroup>
      <!-- Source builds register analyzers as separate files. Keep their dependency closure
           beside the analyzer, matching the packaged analyzer layout. -->
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\..\src\Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll"
                Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll')" />
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\..\src\ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll"
                Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll')" />
      <Analyzer Include="$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll"
                Condition="Exists('$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll')" />
      <Analyzer Include="$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll"
                Condition="Exists('$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll')" />
    </ItemGroup>
  </Target>

  <Target Name="RegisterLocalRazorVueArtifactProvider"
          BeforeTargets="JazorDebug;JazorRelease"
          Condition="'$(TodoUsePackages)' != 'true'">
    <ItemGroup>
      <JazorArtifactProviderAssembly Include="$(MSBuildProjectDirectory)\..\..\..\src\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll"
                                     Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll')" />
    </ItemGroup>
  </Target>

  <Import Project="..\..\..\src\Jazor\buildTransitive\Jazor.targets"
          Condition="'$(TodoUsePackages)' != 'true'" />
</Project>

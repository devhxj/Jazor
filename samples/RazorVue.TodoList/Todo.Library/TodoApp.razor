<VContainer Fluid="true">
    <VRow Justify="center">
        <VCol Cols="12" Md="10" Lg="8">
            <VCard>
                <VCardTitle Text="RazorVue Todo Workspace" />
                <VCardText>
                    <VRow>
                        <VCol Cols="12" Md="8">
                            <VTextField Label="New task title"
                                        ModelValue="@DraftTitle"
                                        ModelValueChanged="@DraftTitleChanged" />
                        </VCol>
                        <VCol Cols="12" Md="4">
                            <VTextField Label="Category"
                                        ModelValue="@DraftCategory"
                                        ModelValueChanged="@DraftCategoryChanged" />
                        </VCol>
                    </VRow>

                    <VRow>
                        <VCol Cols="12" Md="4">
                            <VCheckbox Label="Create pinned task"
                                       ModelValue="@DraftPinned"
                                       ModelValueChanged="@DraftPinnedChanged" />
                        </VCol>
                        <VCol Cols="12" Md="4">
                            <VSwitch Label="Show completed"
                                     ModelValue="@ShowCompleted"
                                     ModelValueChanged="@ShowCompletedChanged" />
                        </VCol>
                        <VCol Cols="12" Md="4">
                            <VBtn Text='@("Add task")'
                                  OnClick="@AddRequested" />
                        </VCol>
                    </VRow>

                    @if (StatusMessage != null && StatusMessage != "")
                    {
                        <p>@StatusMessage</p>
                    }
                </VCardText>
            </VCard>
        </VCol>
    </VRow>

    <VRow Justify="center">
        <VCol Cols="12" Md="10" Lg="8">
            <TodoSummaryCard TotalCount="@TotalCount"
                             CompletedCount="@CompletedCount"
                             OpenCount="@OpenCount"
                             PinnedCount="@PinnedCount"
                             TotalText="@($"{TotalCount} tasks in scope")"
                             CompletedText="@($"{CompletedCount} completed")"
                             OpenText="@($"{OpenCount} still active")"
                             PinnedText="@($"{PinnedCount} pinned for focus")" />
        </VCol>
    </VRow>

    <VRow Justify="center">
        <VCol Cols="12" Md="10" Lg="8">
            <VCard>
                <VCardTitle Text="Tasks" />
                <VCardText>
                    @if (VisibleCount == 0)
                    {
                        <VAlert Type="@VuetifyAlertType.Info"
                                Variant="@VuetifyVariant.Tonal"
                                Text="No tasks match the current filter." />
                    }
                    else
                    {
                        <VList Density="@VuetifyDensity.Comfortable">
                            @foreach (var item in Tasks!)
                            {
                                @if (ShowCompleted || !item.IsDone)
                                {
                                    <VListItem Title="@item.Title"
                                               Subtitle="@(item.Category + " | " + (item.IsDone ? "Completed" : "Active"))">
                                        @if (item.IsPinned)
                                        {
                                            <VChip Text='@("Pinned")' Color="primary" />
                                        }
                                    </VListItem>
                                }
                            }
                        </VList>
                    }
                </VCardText>
            </VCard>
        </VCol>
    </VRow>
</VContainer>

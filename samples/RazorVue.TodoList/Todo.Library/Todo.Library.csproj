<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RazorLangVersion>11.0</RazorLangVersion>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <NoWarn>$(NoWarn);CS0626;CS0824;IDE0130;CA1822;IDE0060;IDE1006</NoWarn>
    <!-- Source references stay the default for repository development. Set TodoUsePackages=true
         to verify the same library as an isolated NuGet consumer. -->
    <TodoUsePackages Condition="'$(TodoUsePackages)' == ''">false</TodoUsePackages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TodoUsePackages)' != 'true'">
    <ProjectReference Include="..\..\..\src\ECMAScript\ECMAScript.csproj" />
    <ProjectReference Include="..\..\..\src\ECMAScript.Vue\ECMAScript.Vue.csproj" />
    <ProjectReference Include="..\..\..\src\ECMAScript.Style\ECMAScript.Style.csproj" />
    <ProjectReference Include="..\..\..\src\Jazor.RazorVue\Jazor.RazorVue.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- The Jazor package carries the ECMAScript contract assemblies; Jazor.Vue supplies the
       RazorVue analyzer/generator that a package consumer loses with the source references. -->
  <ItemGroup Condition="'$(TodoUsePackages)' == 'true'">
    <PackageReference Include="Jazor.Vue" Version="$(JazorPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ECMAScript.Style" Version="$(JazorPackageVersion)" />
  </ItemGroup>

  <Target Name="AddLocalRazorVueAnalyzerDependencies"
          BeforeTargets="CoreCompile"
          Condition="'$(TodoUsePackages)' != 'true'">
    <ItemGroup>
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\..\src\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll"
                Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\Jazor.RazorVue\bin\$(Configuration)\netstandard2.0\Jazor.RazorVue.dll')" />
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\..\src\Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll"
                Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\Jazor.Compiler\bin\$(Configuration)\netstandard2.0\Jazor.Compiler.dll')" />
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\..\src\Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll"
                Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\Jazor.Common\bin\$(Configuration)\netstandard2.0\Jazor.Common.dll')" />
      <Analyzer Include="$(MSBuildProjectDirectory)\..\..\..\src\ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll"
                Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\src\ECMAScript.Contract\bin\$(Configuration)\netstandard2.0\ECMAScript.Contract.dll')" />
      <Analyzer Include="$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll"
                Condition="Exists('$(NuGetPackageRoot)acornima\$(AcornimaVersion)\lib\netstandard2.0\Acornima.dll')" />
      <Analyzer Include="$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll"
                Condition="Exists('$(NuGetPackageRoot)acornima.extras\$(AcornimaVersion)\lib\netstandard2.0\Acornima.Extras.dll')" />
      <!-- RazorVue parses static markup in the analyzer load context; local source builds must
           supply the same parser sidecar that the Jazor.Vue package ships beside the analyzer. -->
      <Analyzer Include="$(NuGetPackageRoot)anglesharp\$(AngleSharpVersion)\lib\netstandard2.0\AngleSharp.dll"
                Condition="Exists('$(NuGetPackageRoot)anglesharp\$(AngleSharpVersion)\lib\netstandard2.0\AngleSharp.dll')" />
    </ItemGroup>
  </Target>
</Project>
